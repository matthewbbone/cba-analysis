        {
            "block_label": "text",
            "block_content": "15-2. The Board and the Association recognize that meetings requiring attendance of the entire faculty of a building after regular school hours should only be called for such items as those which relate to the safety and welfare of students and teachers and for other significant purposes.",
            "block_bbox": [
                67,
                291,
                507,
                395
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
