                    203.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "17-1. The Board and the Association believe that frequent transfers of teachers from one school to another are inimical to the educational process and interfere with optimum teacher performance. Only true vacancies caused by establishment of new positions, resignation, retirement, termination or death shall be filled by transfers. Therefore, they agree as follows:",
            "block_bbox": [
                67,
                212,
                506,
                350
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    67.0,
                    212.0
                ],
                [
                    506.0,
                    212.0
                ],
                [
                    506.0,
                    350.0
                ],
                [
                    67.0,
                    350.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "17-2. In all cases of transfer, the following shall apply:",
            "block_bbox": [
                68,
                358,
                505,
                395
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    68.0,
                    358.0
                ],
                [
                    505.0,
                    358.0
                ],
                [
                    505.0,
                    395.0
                ],
                [
                    68.0,
                    395.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "17-2.1. In cases of Voluntary transfer, seniority begins when the teacher assumes the new position.",
            "block_bbox": [
                67,
                403,
                506,
                441
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    67.0,
                    403.0
                ],
                [
                    506.0,
                    403.0
                ],
                [
                    506.0,
                    441.0
                ],
                [
                    67.0,
                    441.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "17-2.2. In cases of Involuntary transfer, the teacher shall retain all accrued seniority.",
            "block_bbox": [
                68,
                449,
                506,
                486
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    68.0,
                    449.0
                ],
                [
                    506.0,
                    449.0
                ],
                [
                    506.0,
                    486.0
                ],
                [
                    68.0,
                    486.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "17-2.3. For the purposes of this Article, promotional and extra compensation positions applied for shall be deemed voluntary transfers.",
            "block_bbox": [
                67,
                495,
                506,
                549
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
