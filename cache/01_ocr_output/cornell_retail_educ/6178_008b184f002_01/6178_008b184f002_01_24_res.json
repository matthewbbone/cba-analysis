        {
            "block_label": "text",
            "block_content": "This article is subject to the New Jersey Supreme Court decision, August 2, 1978 (Ridgefield Park Education Association vs. the Board of Education of Ridgefield Park.)",
            "block_bbox": [
                67,
                133,
                505,
                203
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    67.0,
                    133.0
                ],
                [
                    505.0,
