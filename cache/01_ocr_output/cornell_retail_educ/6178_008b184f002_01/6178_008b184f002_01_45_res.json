        {
            "block_label": "text",
            "block_content": "38-1. FIELD TRAINING OR ATTENDANCE AT SERVICE SCHOOLS—A regularly appointed or contract teacher who is required to undergo military field training or to attend service school for a period of two (2) weeks or less during any school year shall be granted leave of absence with pay.",
            "block_bbox": [
                73,
                552,
                512,
                656
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
