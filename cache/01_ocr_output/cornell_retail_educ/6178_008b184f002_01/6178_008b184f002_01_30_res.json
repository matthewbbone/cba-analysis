        {
            "block_label": "text",
            "block_content": "22-1. The Board will provide such legal services as may be necessary to any teacher on whom any assault and/or assault and battery is made during the course of his-her employment.",
            "block_bbox": [
                80,
                308,
                517,
                378
            ],
