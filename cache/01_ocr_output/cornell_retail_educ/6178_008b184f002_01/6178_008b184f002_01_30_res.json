        },
        {
            "block_label": "text",
            "block_content": "22-3. Teachers shall immediately report cases of assault, physical or verbal, suffered by them in connection with their employment to their principal or other immediate superior.",
            "block_bbox": [
                80,
                500,
                518,
                570
            ],
