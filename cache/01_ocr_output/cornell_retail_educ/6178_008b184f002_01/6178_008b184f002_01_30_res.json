            ]
        },
        {
            "block_label": "text",
            "block_content": "22-2. When absence arises out of or from assault or injury while acting in discharge of duties, the teacher shall be entitled to full salary and other benefits for the period of such absence but shall not forfeit any sick leave or personal leave.",
            "block_bbox": [
                80,
                387,
                518,
                490
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
