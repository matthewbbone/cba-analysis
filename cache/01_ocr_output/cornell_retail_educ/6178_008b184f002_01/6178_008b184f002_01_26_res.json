        },
        {
            "block_label": "text",
            "block_content": "18-3. Teachers have the right to recommend the suspension of pupils from their classes.",
            "block_bbox": [
                72,
                259,
                508,
                297
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
