            ]
        },
        {
            "block_label": "text",
            "block_content": "18-2. It is the responsibility of administrators to support the teacher in this role.",
            "block_bbox": [
                72,
                201,
                509,
                239
            ],
            "block_id": 3,
            "block_order": 4,
