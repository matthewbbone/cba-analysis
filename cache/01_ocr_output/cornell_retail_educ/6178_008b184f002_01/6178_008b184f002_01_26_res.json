                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "18-4. This procedure shall not contravene any statutory provision affecting the right of the principal to suspend.",
            "block_bbox": [
                72,
                305,
                509,
                359
            ],
            "block_id": 5,
