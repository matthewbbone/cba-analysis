        {
            "block_label": "text",
            "block_content": "32-1. Every teacher shall be credited with fourteen (14) days of accumulative sick leave annually.",
            "block_bbox": [
                64,
                235,
                501,
                289
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
