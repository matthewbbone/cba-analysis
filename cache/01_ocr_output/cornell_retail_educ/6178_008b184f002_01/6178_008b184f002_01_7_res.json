                    87.0,
                    372.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2-2. A grievance may be considered to exist when an employee believes that an administrative procedure or policy adversely affects his-her working conditions or his-her welfare or violates the terms of this Agreement or any subsequent agreement entered into pursuant to this Agreement.",
            "block_bbox": [
                88,
                382,
                528,
                486
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
