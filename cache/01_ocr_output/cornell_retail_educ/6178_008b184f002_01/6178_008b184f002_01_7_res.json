            ]
        },
        {
            "block_label": "text",
            "block_content": "2-4 Any employee shall have the right to present his-her grievance through the steps described in the following paragraphs with assured freedom from restraint, interference, coercion, discrimination, or reprisal.",
            "block_bbox": [
                89,
                617,
                529,
                703
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
