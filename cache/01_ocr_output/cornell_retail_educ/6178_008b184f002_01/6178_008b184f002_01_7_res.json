        },
        {
            "block_label": "text",
            "block_content": "2-3.1 Any aggrieved person may be represented at any stage of the grievance procedure by a representative selected or approved by the Association.",
            "block_bbox": [
                89,
                556,
                528,
                609
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
