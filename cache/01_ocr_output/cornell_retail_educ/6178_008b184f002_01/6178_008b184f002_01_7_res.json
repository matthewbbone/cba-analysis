        {
            "block_label": "text",
            "block_content": "2-1. To promote, to the highest possible degree, harmonious employer-employee relations, it is essential that procedures to resolve grievances be established.",
            "block_bbox": [
                87,
                303,
                527,
                372
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
