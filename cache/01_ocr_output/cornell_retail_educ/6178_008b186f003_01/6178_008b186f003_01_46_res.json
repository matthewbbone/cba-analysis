        {
            "block_label": "text",
            "block_content": "A. Salaries for teachers shall be as set forth in Appendix A, which is incorporated into, and hereby made a part of this Contract. All salary increases shall be effective beginning July 1, 1987.",
            "block_bbox": [
                53,
