        {
            "block_label": "text",
            "block_content": "1. The Board shall issue paychecks in equal semi-monthly installments. Ten (10) month employees shall receive their checks on the 8th and 22nd of each month. Eleven (11) and twelve (12) month teachers shall receive their checks on the 15th and the last day of the month. If a scheduled payday is not a regular duty day, paychecks shall be issued on the last duty day prior to the scheduled payday.",
            "block_bbox": [
                77,
                728,
                511,
                853
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
