        {
            "block_label": "text",
            "block_content": "A. The Board hereby recognizes and acknowledges the Orange County Classroom Teachers Association, Inc., as the exclusive bargaining agent and agrees to negotiate with the Association's designated representative pursuant to the provisions of Part II, Chapter 447, Florida Statutes for all certified non-administrative personnel as defined herein, whether under contract or on Board-approved leave of absence.",
            "block_bbox": [
                40,
