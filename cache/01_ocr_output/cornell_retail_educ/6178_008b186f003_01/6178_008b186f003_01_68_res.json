        },
        {
            "block_label": "text",
            "block_content": "B. Members of the Teacher Education Center Council shall be granted release time if their responsibilities to the Council require them to attend meetings of the Council during the work day.",
            "block_bbox": [
                44,
                385,
                501,
                438
            ],
