        {
            "block_label": "text",
            "block_content": "A. The Board agrees to participate in a Teacher Education Center as provided by law.",
            "block_bbox": [
                45,
                349,
                500,
                385
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
