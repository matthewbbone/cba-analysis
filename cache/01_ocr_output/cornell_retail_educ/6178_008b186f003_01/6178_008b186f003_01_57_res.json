        },
        {
            "block_label": "paragraph_title",
            "block_content": "8. Abuse of Benefits",
            "block_bbox": [
                88,
                496,
                241,
                514
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    88.0,
                    496.0
                ],
                [
                    240.0,
                    496.0
                ],
                [
                    240.0,
