                    36.0,
                    636.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "F. For purposes of this Contract, the regular vocational certificate shall be equivalent to the certificate held by a teacher with a bachelor's degree; the advanced vocational certificate shall be equivalent to the master's degree.",
            "block_bbox": [
                36,
                635,
                492,
                706
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    36.0,
                    635.0
