                    36.0,
                    706.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "G. A teacher shall be responsible for providing documentation relating to salary credit to the Personnel Department. This shall include current or changed teaching certificates.",
            "block_bbox": [
                36,
                706,
                492,
                760
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
