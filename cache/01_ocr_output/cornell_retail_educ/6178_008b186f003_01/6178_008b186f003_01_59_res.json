                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Applications for leave, except short-term sick leave with or without pay, shall be submitted to the principal or immediate supervisor on a form provided by the Board. In the event of an unforeseen absence, every effort shall be made to contact the principal or immediate supervisor so arrangements can be made to secure a substitute teacher if necessary.",
            "block_bbox": [
                102,
                174,
                510,
                280
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    102.0,
                    174.0
                ],
                [
                    510.0,
                    174.0
                ],
                [
                    510.0,
                    280.0
                ],
                [
                    102.0,
                    280.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. A teacher shall be entitled to take leaves of absence in increments of full or half days.",
            "block_bbox": [
                101,
                281,
                508,
                315
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    101.0,
                    281.0
                ],
                [
                    508.0,
                    281.0
                ],
                [
                    508.0,
                    315.0
                ],
                [
                    101.0,
                    315.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. A teacher shall not be permitted or required to arrange for a substitute in the event of his absence.",
            "block_bbox": [
                101,
                316,
                508,
                351
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    101.0,
                    316.0
                ],
                [
                    508.0,
                    316.0
                ],
                [
                    508.0,
                    351.0
                ],
                [
                    101.0,
                    351.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. If at any time the reasons given for requesting leave have changed, the teacher shall promptly notify the worksite supervisor and shall either be directed to return to duty or continue leave.",
            "block_bbox": [
                100,
                352,
                508,
                422
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    100.0,
                    352.0
                ],
                [
                    508.0,
                    352.0
                ],
                [
                    508.0,
                    422.0
                ],
                [
                    100.0,
                    422.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. Upon return from leave, the teacher shall complete a certificate of absence.",
            "block_bbox": [
                101,
                423,
                508,
                458
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    101.0,
                    423.0
                ],
                [
                    508.0,
                    423.0
                ],
                [
                    508.0,
                    458.0
                ],
                [
                    101.0,
                    458.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f. During leaves of six (6) or more duty days, a teacher shall not be required to keep records, prepare lessons, nor perform any of the duties required while in attendance.",
            "block_bbox": [
                101,
                459,
                509,
                513
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
