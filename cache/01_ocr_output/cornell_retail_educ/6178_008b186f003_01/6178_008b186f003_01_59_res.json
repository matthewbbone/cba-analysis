        {
            "block_label": "paragraph_title",
            "block_content": "2. General - Long-Term Leaves",
            "block_bbox": [
                75,
                569,
                304,
                588
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
