        {
            "block_label": "text",
            "block_content": "1. General - All Leaves",
            "block_bbox": [
                81,
                155,
                253,
                173
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    81.0,
