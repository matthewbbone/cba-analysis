        },
        {
            "block_label": "text",
            "block_content": "c. Return from long-term leave",
            "block_bbox": [
                97,
                715,
                309,
                733
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
