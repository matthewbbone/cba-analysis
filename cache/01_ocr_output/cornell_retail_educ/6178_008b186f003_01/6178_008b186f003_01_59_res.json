            ]
        },
        {
            "block_label": "text",
            "block_content": "a. All long-term leaves of absence, unless specifically stipulated otherwise, shall terminate on June 30 of the fiscal year for which the leave was granted.",
            "block_bbox": [
                98,
                588,
                505,
                642
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    98.0,
                    588.0
                ],
                [
                    505.0,
                    588.0
                ],
                [
                    505.0,
                    642.0
                ],
                [
                    98.0,
                    642.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. A teacher granted a long-term leave of absence may not be employed in a full-time capacity while on leave. This condition may be waived by action of the Superintendent or his designee.",
            "block_bbox": [
                97,
                642,
                506,
                713
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
