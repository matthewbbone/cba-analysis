                    55.0,
                    327.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The assessment of a teacher's performance is the responsibility of the principal or his designee, or the teacher's immediate supervisor. Members of the bargaining unit shall not be required or permitted to participate in the assessment or evaluation of other members of the bargaining unit. An evaluator shall not be precluded from utilizing records of student progress toward instructional goals based on student ability.",
            "block_bbox": [
                56,
                326,
                490,
                452
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
