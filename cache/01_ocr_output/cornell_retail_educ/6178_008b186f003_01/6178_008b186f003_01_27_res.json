        },
        {
            "block_label": "text",
            "block_content": "4. Each annual contract teacher on duty prior to the close of the first nine (9) weeks of school shall be formally observed at least twice prior to annual assessment. Annual contract teachers reporting to duty after that time shall be formally observed one or more times prior to assessment. The first observation period shall be between September 10 and the close of the first semester or its equivalent. The second observation period shall be between the end of the Winter break and March 15. The annual assessment shall be made prior to recommendation by the principal concerning reappointment, but no later than April 1.",
            "block_bbox": [
                58,
                524,
                491,
                702
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
