                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Any formal observation or assessment of a teacher will be recorded on the Observation Report or Assessment Report as set forth in the Appendices to this Contract which are incorporated into and hereby made a part of this Contract.",
            "block_bbox": [
                56,
                452,
                489,
