                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. A principal may deny requests for personal leave under this Section if the number of teachers requesting such leave for any one day exceeds ten percent (10%) of the teaching staff.",
            "block_bbox": [
                112,
                267,
                520,
                321
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
