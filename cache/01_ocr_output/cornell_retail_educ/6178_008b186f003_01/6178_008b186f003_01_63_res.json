                    231.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. Teachers shall not be required to divulge the reasons for taking personal leave.",
            "block_bbox": [
                112,
                231,
                520,
                267
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
