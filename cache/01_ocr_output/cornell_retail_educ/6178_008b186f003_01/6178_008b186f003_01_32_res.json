    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "misconduct or other basis of potential discipline is; who the witnesses are and other sources of information upon which the potential discipline is being based; what the witnesses said and what other sources of information indicate which are the basis for potential discipline; and what form of discipline is being considered. Reasonable advance notice of the formal conference shall be given.",
            "block_bbox": [
                129,
                96,
                514,
                221
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
