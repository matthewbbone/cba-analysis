                    107.0,
                    789.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The Superintendent shall direct a fair and objective investigation of the alleged misconduct or other basis for potential action.",
            "block_bbox": [
                131,
                789,
                513,
                842
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
