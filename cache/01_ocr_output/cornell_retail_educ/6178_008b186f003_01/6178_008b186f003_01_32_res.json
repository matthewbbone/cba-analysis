        },
        {
            "block_label": "text",
            "block_content": "a. The following procedures shall be used prior to the filing of any formal written charges against a teacher for immorality, misconduct in office, gross insubordination, willful neglect of duty, drunkenness, or conviction of any crime involving moral turpitude:",
            "block_bbox": [
                107,
                702,
                514,
                789
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
