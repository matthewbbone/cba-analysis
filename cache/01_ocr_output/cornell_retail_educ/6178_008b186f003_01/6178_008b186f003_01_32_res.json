                    789.0
                ],
                [
                    513.0,
                    842.0
                ],
                [
                    131.0,
                    842.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) The affected teacher shall be informed verbally of the circumstances leading to the investigation and shall be informed that he is not required to make a written or oral statement if he chooses not to do so.",
            "block_bbox": [
                131,
                842,
                514,
                912
            ],
            "block_id": 11,
