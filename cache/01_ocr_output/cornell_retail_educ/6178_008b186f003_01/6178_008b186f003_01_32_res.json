                    106.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "g. Any written reprimand shall contain the statement that the letter shall be removed from the teacher's file if there are no similar problems for a specified period of time which shall not exceed two (2) years.",
