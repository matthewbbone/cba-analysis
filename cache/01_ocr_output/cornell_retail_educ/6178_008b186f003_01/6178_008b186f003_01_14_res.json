        {
            "block_label": "text",
            "block_content": "G. Each school year all teachers shall be provided with a copy of the Orange County Code of Student Conduct within their first ten (10) duty days. The Code and the proper procedures to follow in implementing the Code will be reviewed with all teachers.",
            "block_bbox": [
                53,
                421,
                512,
                495
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
