        },
        {
            "block_label": "text",
            "block_content": "I. Each teacher shall assume such authority for the control of students as may be assigned to him by the principal, and shall keep order in the classroom and in other places in which he is assigned to be in charge of students.",
            "block_bbox": [
                53,
