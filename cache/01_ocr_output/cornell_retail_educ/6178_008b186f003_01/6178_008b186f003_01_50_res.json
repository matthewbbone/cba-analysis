            ]
        },
        {
            "block_label": "text",
            "block_content": "8. If a teacher is retained at his existing step for the subsequent year and demonstrates satisfactory performance he shall be advanced on the salary schedule as if a freeze had not occurred.",
            "block_bbox": [
                74,
                631,
