                ],
                [
                    72.0,
                    595.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7. The teacher is entitled to Association representation throughout the procedure.",
            "block_bbox": [
                74,
                595,
                503,
                630
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    74.0,
