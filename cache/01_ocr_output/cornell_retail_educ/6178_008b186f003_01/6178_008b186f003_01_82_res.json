        {
            "block_label": "text",
            "block_content": "Each school shall fill this position with a Certified Athletic Trainer, if available. If a Certified Athletic Trainer is not available an Associate Athletic Trainer may be hired. If an Associate Trainer is not available, an Appointed Athletic Trainer may be hired. If no full-time instructional employee will accept the position, or there is no full-time employee available, the worksite supervisor may offer this position to a qualified non-faculty employee with recommendation and approval of the Program Consultant for Extracurricular Activities.",
            "block_bbox": [
