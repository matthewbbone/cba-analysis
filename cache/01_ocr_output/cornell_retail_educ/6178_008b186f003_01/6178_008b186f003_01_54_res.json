                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. If a teacher retires during the fourth through sixth year of service, the daily rate of pay multiplied by forty percent times the number of days of accumulated sick leave.",
            "block_bbox": [
                83,
