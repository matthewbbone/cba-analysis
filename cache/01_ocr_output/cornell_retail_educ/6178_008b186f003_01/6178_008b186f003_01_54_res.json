        {
            "block_label": "text",
            "block_content": "Upon retirement a teacher shall receive terminal pay as follows:\na. If a teacher retires during the first three years of service, the daily rate of pay multiplied by thirty-five percent times the number of days of accumulated sick leave.",
            "block_bbox": [
                78,
                269,
