        {
            "block_label": "paragraph_title",
            "block_content": "TEACHER RIGHTS AND RESPONSIBILITIES",
            "block_bbox": [
                105,
                506,
                443,
                526
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
