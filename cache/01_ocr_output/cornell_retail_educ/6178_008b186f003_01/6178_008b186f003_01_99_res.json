                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. In case of a tie, the applications shall be referred to the Association for recommendations to the Superintendent.",
            "block_bbox": [
                102,
                305,
                523,
                340
            ],
            "block_id": 3,
