        {
            "block_label": "text",
            "block_content": "6. Order of Consideration - The order in which the approved applications for sabbatical leaves will be considered shall be based on the following formula:",
            "block_bbox": [
                76,
                165,
                526,
                220
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
