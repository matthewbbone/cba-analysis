            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Count one (1) point for each year in Orange County Public Schools in excess of seven (7) consecutive years. Persons in each category shall be considered in descending order of their accrued points. Sabbatical leave time does not count as a point.",
            "block_bbox": [
                103,
                232,
