            ]
        },
        {
            "block_label": "text",
            "block_content": "The School Board may identify up to three (3) areas of teacher certification within the bargaining unit where a critical need exists. The Board shall post an announcement at each worksite by December 1 of each year inviting teachers to apply for sabbatical leave for purposes of retraining in the identified area of critical need. The order of selection of such persons shall be done in the same manner as set forth above. This shall not preclude a teacher applying for a sabbatical in an area of critical need from also being considered with applicants for sabbaticals in other areas.",
            "block_bbox": [
