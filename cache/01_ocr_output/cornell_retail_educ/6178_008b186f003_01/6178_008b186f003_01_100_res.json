        {
            "block_label": "text",
            "block_content": "1. The compressed four day work week shall be Monday through Thursday. When July 4 falls on a Tuesday or Thursday, the work week shall be three (3) days and the week immediately preceding this shall be a five (5) day work week.",
            "block_bbox": [
