        },
        {
            "block_label": "text",
            "block_content": "J. Corporal punishment may be administered by a teacher only if the principal has delegated such authority to the teacher, and the teacher consents. The teacher shall then administer the corporal punishment as follows:",
            "block_bbox": [
                35,
                427,
                492,
                498
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    35.0,
                    427.0
