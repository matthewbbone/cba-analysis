        },
        {
            "block_label": "text",
            "block_content": "6. No student expelled under Section I.5. above shall be returned to the affected teacher's class without the teacher's consent.",
            "block_bbox": [
                59,
                385,
                491,
                423
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
