                    35.0,
                    498.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Corporal punishment may be administered only in the presence of another adult who is informed beforehand, and in the student's presence, of the reason for the punishment.",
            "block_bbox": [
                61,
                498,
                493,
                552
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
