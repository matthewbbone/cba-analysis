                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. If in the course of negotiations impasse is reached, the parties shall submit all tentative agreements reached prior to and during mediation for ratification prior to the beginning of the Special Master proceeding. Other items upon which tentative agreement has not been reached shall continue through the procedures as described in this Article.",
            "block_bbox": [
                60,
                288,
                491,
                394
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
