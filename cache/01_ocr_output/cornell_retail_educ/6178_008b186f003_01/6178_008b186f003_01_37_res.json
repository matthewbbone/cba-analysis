        },
        {
            "block_label": "text",
            "block_content": "B. A teacher may express his own opinions in regard to political, social and religious issues, provided that the total presentation is essentially balanced and fair. He shall not use his professional contacts with students to impose upon them his personal convictions or those of any other individual or group.",
            "block_bbox": [
                32,
                666,
