        },
        {
            "block_label": "text",
            "block_content": "(4) An annual contract teacher who has been granted a long-term leave of absence which extends beyond his contractual period may be reemployed without prejudice upon the expiration of his leave provided he is recommended for employment. He shall retain full credit for years of teaching experience prior to the leave.",
            "block_bbox": [
                112,
                292,
