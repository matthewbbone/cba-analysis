                ],
                [
                    121.0,
                    311.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) a copy of an official diploma from the institution indicating the date the advanced degree was awarded.",
            "block_bbox": [
                121,
                311,
                503,
                348
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
