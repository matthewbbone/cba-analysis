                [
                    121.0,
                    275.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) a copy of an official letter from the institution indicating the date the degree was awarded; or",
            "block_bbox": [
                121,
                277,
                503,
                311
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    121.0,
                    277.0
                ],
                [
                    503.0,
                    277.0
                ],
                [
                    503.0,
