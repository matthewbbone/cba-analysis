            ]
        },
        {
            "block_label": "text",
            "block_content": "M. Members of the same family may be employed at the same school or work location except that members of the same family shall not be assigned in direct line of supervision without the approval of the Superintendent.",
            "block_bbox": [
                51,
                507,
                510,
