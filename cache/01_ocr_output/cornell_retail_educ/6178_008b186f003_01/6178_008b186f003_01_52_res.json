                ],
                [
                    483.0,
                    118.0
                ],
                [
                    483.0,
                    172.0
                ],
                [
                    77.0,
                    172.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The effective date for teachers beginning after pre-planning, subject to policy limitations, shall be the first duty day of the month which follows the receipt of a pay check on the 22nd of the previous month.",
            "block_bbox": [
                75,
                173,
                483,
                243
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
