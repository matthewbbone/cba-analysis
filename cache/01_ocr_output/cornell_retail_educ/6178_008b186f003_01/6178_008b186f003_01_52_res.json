        {
            "block_label": "text",
            "block_content": "a. The effective date of health insurance for a teacher beginning during pre-planning and receiving a paycheck on September 22, shall be October 1.",
            "block_bbox": [
                77,
                118,
                483,
                172
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    77.0,
