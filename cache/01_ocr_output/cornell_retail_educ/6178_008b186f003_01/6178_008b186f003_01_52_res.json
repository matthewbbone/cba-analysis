            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "9. Alternative to Health Insurance",
            "block_bbox": [
                63,
                511,
                311,
                529
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    63.0,
