        {
            "block_label": "text",
            "block_content": "1. The Association's building unit may be permitted the use of its school's facilities for the purpose of conducting professional meetings. Such meetings shall be arranged in advance with the principal of the school in the manner in which such meetings are usually arranged and permission shall not be unreasonably denied.",
            "block_bbox": [
                54,
                445,
                486,
                535
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
