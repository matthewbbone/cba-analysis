        },
        {
            "block_label": "text",
            "block_content": "4. Upon conclusion of any faculty meeting, the Association faculty representative shall be given the opportunity to make announcements relating to official business of the Association, or the Association president or his designee may make announcements in lieu of the faculty representative. Continued attendance by teachers for these announcements shall be voluntary.",
            "block_bbox": [
                55,
                695,
                488,
                801
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
