                    518.0,
                    691.0
                ],
                [
                    86.0,
                    691.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. The parties shall share equally the cost of arbitration.",
            "block_bbox": [
                86,
                695,
                458,
                715
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    86.0,
                    695.0
                ],
                [
                    457.0,
                    695.0
                ],
                [
                    457.0,
                    714.0
                ],
                [
                    86.0,
                    714.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Should either party request a stenographic transcript of the proceedings, then that party will bear the full costs for said transcript. If both parties mutually agree to a stenographic transcript, then the cost of said transcript will be divided equally between the parties.",
            "block_bbox": [
                86,
                717,
                516,
                806
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
