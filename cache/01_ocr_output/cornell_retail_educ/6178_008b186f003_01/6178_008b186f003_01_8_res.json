                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7. The parties may, by mutual agreement, elect to submit statements and proofs to the arbitrator in lieu of an oral hearing.",
            "block_bbox": [
                86,
                807,
                515,
                844
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
