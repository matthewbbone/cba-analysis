        {
            "block_label": "text",
            "block_content": "D. Observations of a teacher's performance shall be made in accordance with the following provisions:",
            "block_bbox": [
                64,
                237,
                515,
                272
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
