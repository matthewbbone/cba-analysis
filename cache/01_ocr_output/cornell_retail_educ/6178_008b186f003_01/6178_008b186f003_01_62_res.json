            "block_label": "text",
            "block_content": "Long-term sick leave without pay may be renewed each year upon written request by the teacher. All requests for long-term sick leave shall be accompanied by a doctor's certificate that the teacher is unable to perform his duties.",
            "block_bbox": [
                115,
                99,
                499,
                171
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
