                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. A teacher on long term sick leave may not be employed in any capacity unless this provision is waived by the Superintendent after a request for waiver is made by the teacher. If the teacher desires to return from leave prior to the date of intent to return and no position for which the teacher is certified and/or qualified is vacant, this provision shall be waived.",
            "block_bbox": [
                91,
                171,
                499,
                294
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
