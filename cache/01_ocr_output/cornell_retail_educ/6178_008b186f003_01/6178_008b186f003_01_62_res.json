            ]
        },
        {
            "block_label": "text",
            "block_content": "d. When the teacher finds it necessary to be absent, he shall notify his immediate supervisor or the designee the night before, or at least one (1) hour prior to the time the teacher is scheduled to report for duty, except in case of emergency.",
            "block_bbox": [
                91,
