                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. A teacher shall be entitled to illness/injury in-line-of-duty leave with pay when he has to be absent from duty because of:",
            "block_bbox": [
                71,
                385,
                499,
                422
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    71.0,
                    385.0
                ],
                [
                    499.0,
                    385.0
                ],
                [
                    499.0,
                    422.0
                ],
                [
                    71.0,
                    422.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. a personal injury in the discharge of duty",
            "block_bbox": [
                93,
                421,
                387,
                438
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    93.0,
                    421.0
                ],
                [
                    93.0,
                    437.0
                ],
                [
                    386.0,
                    437.0
                ],
                [
                    386.0,
                    421.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. an illness contracted as a direct result of his employment, if it can be proven that the illness was not contracted from another source.",
            "block_bbox": [
                92,
                438,
                500,
                490
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    92.0,
