        {
            "block_label": "paragraph_title",
            "block_content": "C. Illness/Injury In-Line-of-Duty Leave",
            "block_bbox": [
                45,
                365,
                324,
                385
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    45.0,
                    365.0
                ],
                [
                    45.0,
