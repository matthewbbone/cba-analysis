        {
            "block_label": "paragraph_title",
            "block_content": "3. Filing of Formal Charges",
            "block_bbox": [
                47,
                164,
                249,
                184
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
