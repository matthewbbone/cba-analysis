                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Selection of eligible teachers shall be based upon the anticipated need for substitutes.",
            "block_bbox": [
                74,
                565,
                504,
                600
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
