        },
        {
            "block_label": "text",
            "block_content": "5. The Board reserves the right to terminate the retired teacher from this program for misconduct or upon recommendation of a work site supervisor, provided the teacher has been warned of possible termination and has been given reasons for the termination.",
            "block_bbox": [
                76,
