                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The Board will select applicants which best serve the instructional needs of the district.",
            "block_bbox": [
                74,
                600,
                505,
                635
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
