        },
        {
            "block_label": "text",
            "block_content": "Q. Teachers retiring from the Orange County School System, who are not eligible for Medicare at the time of retirement, will be eligible for a position as a retired substitute teacher and will, under this provision, be entitled to extended medical benefits.",
            "block_bbox": [
                49,
                441,
                504,
                511
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
