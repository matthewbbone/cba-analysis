        },
        {
            "block_label": "text",
            "block_content": "N. The parties agree to continue cooperative efforts in providing an Employee Assistance Program The Board shall continue to provide basic funds for the continuing operation of the program.",
            "block_bbox": [
                48,
                228,
                502,
                281
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
