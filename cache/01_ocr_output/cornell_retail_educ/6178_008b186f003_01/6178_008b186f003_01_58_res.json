        {
            "block_label": "text",
            "block_content": "O. The Board shall provide one hundred fifty dollars ($150) per year for each teacher for a multi-optional insurance program. The money may be applied toward the purchase of additional insurance coverage such as family health insurance, dental, optical, disability, additional life and hospital indemnity insurance and retirement annuity programs. Details for the implementation of the program shall be the responsibility of the Fringe Benefit Committee.",
            "block_bbox": [
                48,
                281,
                504,
                405
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
