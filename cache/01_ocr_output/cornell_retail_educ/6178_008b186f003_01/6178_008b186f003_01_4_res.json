            ]
        },
        {
            "block_label": "text",
            "block_content": "E. If any provision or application of this Contract is held to be contrary to law, then such provision or application shall not be deemed valid and subsisting except to the extent permitted by law, but all other provisions or applications shall continue in full force and effect. The parties shall either immediately meet to reopen negotiations on that provision or application or mutually agree to deal with the matter in subsequent negotiations.",
            "block_bbox": [
