                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "D. This Contract may not be modified in whole or in part except by mutual written agreement. During the term of this Contract, except as otherwise provided herein, neither party will be required to negotiate with respect to any such matter whether or not covered by this Contract.",
            "block_bbox": [
                60,
