        },
        {
            "block_label": "text",
            "block_content": "C. Neither party shall have any control over the selection of the bargaining representatives of the other party, and the parties mutually pledge that their representatives will be empowered to reach tentative agreement on items being negotiated. Either party may utilize the services of outside consultants to assist in negotiations provided the party using the consultants shall pay for any cost incurred for such services.",
            "block_bbox": [
                60,
                325,
                514,
                432
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
