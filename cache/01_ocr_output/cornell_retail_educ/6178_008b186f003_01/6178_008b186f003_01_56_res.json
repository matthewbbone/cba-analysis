        },
        {
            "block_label": "paragraph_title",
            "block_content": "6. Eligibility",
            "block_bbox": [
                60,
                408,
                157,
                425
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
