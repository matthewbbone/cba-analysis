                    68.0,
                    605.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "T. Teachers shall not be required to check for the existence of headlice. Supplies of headlice shampoo shall be available to each school site and provided to the teacher at no cost, for the teacher's personal use.",
            "block_bbox": [
                68,
                606,
                521,
                661
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
