                    513.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "S. A teacher shall report to the principal any student he believes has a contagious or infectious disease or headlice. The student shall not be returned to class until the principal has taken appropriate action. Students with headlice, pinkeye, or impetigo shall not be readmitted to the classroom while they present a health threat.",
            "block_bbox": [
                68,
                515,
                522,
                605
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    68.0,
                    515.0
                ],
                [
                    522.0,
                    515.0
                ],
                [
                    522.0,
