                    797.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Two teachers may voluntarily change schools upon recommendation of the principals involved with the approval of the Superintendent or his designee.",
            "block_bbox": [
                57,
                817,
                489,
                869
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
