        {
            "block_label": "paragraph_title",
            "block_content": "P. Lunch Periods",
            "block_bbox": [
                63,
                287,
                193,
                305
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    63.0,
                    287.0
                ],
                [
                    63.0,
                    304.0
                ],
                [
                    192.0,
