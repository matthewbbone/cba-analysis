                ],
                [
                    521.0,
                    522.0
                ],
                [
                    85.0,
                    522.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Q. Planning Time",
            "block_bbox": [
                61,
                520,
                194,
                539
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
