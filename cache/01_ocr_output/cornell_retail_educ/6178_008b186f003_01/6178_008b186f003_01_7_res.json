        {
            "block_label": "paragraph_title",
            "block_content": "C. Informal Action - Step 1",
            "block_bbox": [
                42,
                314,
                241,
                333
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
