                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If a member of the bargaining unit feels he has a grievance, he shall first discuss the matter in good faith with his immediate supervisor in an effort to resolve the problem informally. This informal action shall take place within twenty (20) duty days after the grievant knew, or should have known, of the incident which is the basis of the grievance. In this informal action, the grievant shall verbally advise his supervisor of the particular section of the Contract alleged to have been violated. The immediate supervisor will respond verbally within six (6) duty days after the informal meeting.",
            "block_bbox": [
                47,
                332,
                501,
                496
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
