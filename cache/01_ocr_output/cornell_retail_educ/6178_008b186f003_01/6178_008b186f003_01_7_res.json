        {
            "block_label": "paragraph_title",
            "block_content": "1. Step 2",
            "block_bbox": [
                68,
                517,
                143,
                535
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
