        {
            "block_label": "text",
            "block_content": "A. Except as otherwise provided in this Contract, the teacher duty day shall be seven (7) hours and thirty (30) minutes including a duty free lunch, or 37½ hours per week total. A 30-minute flexible time block may be considered by each worksite supervisor after consultation with the faculty advisory committee. The 30-minute extension shall be compensated within the same work week. There shall be a minimum of a five (5) work day notification when the flexible schedule is to be utilized. The extension shall be used only for required meetings and shall be on a specific day.",
            "block_bbox": [
                63,
                622,
                516,
                781
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
