        {
            "block_label": "text",
            "block_content": "Employees in the Weighers and Wrappers classification will have the opportunity to transfer without loss of seniority or reduction in straight-time hourly wage rate to the Apprentice classification when a vacancy exists, provided they have the skills, abilities, and physical capacity to perform the work. Employees in the Weighers and Wrappers classifications wishing to make application for such openings shall do so in writing with copies to both the Employer's designated official and the Union.",
            "block_bbox": [
                22,
                661,
                557,
                790
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
