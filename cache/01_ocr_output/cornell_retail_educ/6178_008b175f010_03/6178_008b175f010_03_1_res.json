        {
            "block_label": "text",
            "block_content": "A. Each shop shall have a Head meat Cutter and he shall be a Journeyman Meat Cutter and he may perform all the duties of, and shall direct the work, movements and operations of the Meat Department employees.",
            "block_bbox": [
                24,
                99,
                560,
                157
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
