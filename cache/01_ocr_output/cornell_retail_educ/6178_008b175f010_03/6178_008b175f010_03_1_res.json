                [
                    24.0,
                    251.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. Any Apprentice must be eighteen (18) years of age or older, learning all details and developing skills for performing the duties of a Journeyman Meat Cutter. The Employer agrees to assign each Apprentice to various jobs in order to give him the opportunity to qualify as a Journeyman. The apprenticeship training period shall be for a two-year period.",
            "block_bbox": [
                23,
                256,
                560,
                349
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    23.0,
                    256.0
                ],
                [
                    560.0,
                    256.0
                ],
                [
                    560.0,
                    349.0
