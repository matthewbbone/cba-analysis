                    157.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. A Journeyman is one who has qualified as a skilled Meat Cutter. His duties shall include the receiving, cutting, grinding, slicing, preparing, processing, sealing, wrapping, bagging, pricing, fabricating and serving of all items in the Meat Department and the performance of all work incidental thereto.",
            "block_bbox": [
                24,
                161,
                560,
                251
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    24.0,
                    161.0
                ],
