            ]
        },
        {
            "block_label": "text",
            "block_content": "Part-time employees by classification with the most seniority within a store will be given the part-time schedule with the most hours, provided they are qualified to perform the work required and are immediately available.",
            "block_bbox": [
                19,
                1387,
                554,
