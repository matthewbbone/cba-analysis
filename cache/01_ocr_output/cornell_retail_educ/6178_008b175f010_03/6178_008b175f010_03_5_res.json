        {
            "block_label": "text",
            "block_content": "Y. Definition of a full-time employee: All employees on the full-time seniority list as of April 15, 1973, and any employee after that date who works forty (40) hours per week for six (6) weeks during an eight-week period, unless the employee is working full-time (40 hours) due to the absence of another full-time employee.",
            "block_bbox": [
