                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Q. In case of store closing, the Head Meat Cutter in each store shall retain seniority in the Journeyman classification. Service in the Head Meat Cutter classification immediately prior to his most recent appointment as a Head Meat Cutter shall be credited to his Journeyman classification seniority. In case the Employer sees fit to place the Head Meat Cutter of a closed store in another store as Head Meat Cutter, the displaced Head Meat Cutter shall retain seniority as a Journeyman, including his service in his most recent appointment as a Head Meat Cutter.",
            "block_bbox": [
                27,
                267,
                562,
                415
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    27.0,
                    267.0
                ],
                [
                    562.0,
                    267.0
                ],
                [
                    562.0,
