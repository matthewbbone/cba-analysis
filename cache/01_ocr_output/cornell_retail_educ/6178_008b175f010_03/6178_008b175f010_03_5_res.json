        },
        {
            "block_label": "text",
            "block_content": "(2) All part-time employees by classification who are covered by Health and Welfare and Pension (twenty-four (24) hours or more) on the effective date of this Agreement are reduced by seniority to a schedule of twenty-four (24) hours in that store.",
            "block_bbox": [
                17,
