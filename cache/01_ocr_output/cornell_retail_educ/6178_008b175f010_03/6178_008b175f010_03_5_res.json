                    27.0,
                    415.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event the Employer closes or sells a store, employees with two (2) or more years service may displace the least senior employee in their classification (Head Meat Cutter considered Journeyman Meat Cutter) within the jurisdiction of Local No. 408. No employees thus displaced shall have any recourse against the Employer or the Union.",
            "block_bbox": [
                27,
                418,
                562,
                512
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
