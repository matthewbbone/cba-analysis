        {
            "block_label": "text",
            "block_content": "P. When a Journeyman is promoted to Head Meat Cutter, he shall retain seniority in the Journeyman classification.",
            "block_bbox": [
                28,
                220,
                562,
                261
            ],
            "block_id": 2,
