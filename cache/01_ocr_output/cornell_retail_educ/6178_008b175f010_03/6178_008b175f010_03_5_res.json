        {
            "block_label": "text",
            "block_content": "V. Part-time employees shall be given the first opportunity for permanent full-time jobs in their classification based on seniority in their respective stores before new employees are hired for such full-time jobs.",
            "block_bbox": [
                22,
                967,
                558,
                1027
