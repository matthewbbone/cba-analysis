                    27.0,
                    512.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "R. When two (2) or more employees are hired into the same job classification on the same date in the same seniority area, the Employer shall, at such time as it becomes material, advise the Union of their seniority status.",
            "block_bbox": [
                25,
                519,
                560,
                580
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    25.0,
