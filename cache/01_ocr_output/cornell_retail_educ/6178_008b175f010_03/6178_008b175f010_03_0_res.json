        {
            "block_label": "table",
            "block_content": "<table><tr><td>ARTICLE I</td><td>Recognition and Jurisdiction</td></tr><tr><td>ARTICLE II</td><td>Non-Discrimination—Check-Off</td></tr><tr><td>ARTICLE III</td><td>No Strike—No Lockout</td></tr><tr><td>ARTICLE IV</td><td>Meat Department Employees</td></tr><tr><td>ARTICLE V</td><td>Wages</td></tr><tr><td>ARTICLE VI</td><td>Hours of Work</td></tr><tr><td>ARTICLE VII</td><td>Vacations</td></tr><tr><td>ARTICLE VIII</td><td>Holidays</td></tr><tr><td>ARTICLE IX</td><td>Leaves of Absence</td></tr><tr><td>ARTICLE X</td><td>Seniority</td></tr><tr><td>ARTICLE XI</td><td>Working Conditions</td></tr><tr><td>ARTICLE XII</td><td>Grievance and Arbitration</td></tr><tr><td>ARTICLE XIII</td><td>Separation Pay</td></tr><tr><td>ARTICLE XIV</td><td>Health and Welfare</td></tr><tr><td>ARTICLE XV</td><td>Pensions</td></tr><tr><td>ARTICLE XVI</td><td>Management Rights</td></tr><tr><td>ARTICLE XVII</td><td>Favored Nations Clause</td></tr><tr><td>ARTICLE XVIII</td><td>Savings Clause</td></tr><tr><td>ARTICLE XIX</td><td>Store Closing</td></tr><tr><td>ARTICLE XX</td><td>Individual Retirement Account (IRA)</td></tr><tr><td>ARTICLE XXI</td><td>Duration</td></tr><tr><td>APPENDIX “A”</td><td>Wages</td></tr><tr><td>APPENDIX “B”</td><td>Seniority Areas</td></tr><tr><td>TERM</td><td>November 20, 1983 through November 22, 1986</td></tr></table>",
