        {
            "block_label": "paragraph_title",
            "block_content": "NON-DISCRIMINATION—CHECK-OFF",
            "block_bbox": [
                138,
                1686,
                442,
                1703
            ],
            "block_id": 11,
            "block_order": 9,
            "group_id": 11,
