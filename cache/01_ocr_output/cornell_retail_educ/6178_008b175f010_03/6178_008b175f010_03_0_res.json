        {
            "block_label": "paragraph_title",
            "block_content": "RECOGNITION AND JURISDICTION",
            "block_bbox": [
                142,
                684,
                433,
                704
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
