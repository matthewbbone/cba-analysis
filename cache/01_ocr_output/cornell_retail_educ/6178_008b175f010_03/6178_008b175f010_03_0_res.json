        {
            "block_label": "paragraph_title",
            "block_content": "NO STRIKE—NO LOCKOUT",
            "block_bbox": [
                175,
                2258,
                398,
                2279
            ],
            "block_id": 18,
            "block_order": 16,
            "group_id": 18,
