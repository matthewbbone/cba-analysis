                    22.0,
                    2012.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "D. It is agreed that the Company will not attempt in any manner to prevent or discourage any employee from joining the Union or engaging in any lawful activity on behalf of the Union. The Company agrees to tell new employees that they are operating under a Union contract.",
            "block_bbox": [
                21,
                2017,
                556,
                2090
            ],
            "block_id": 16,
            "block_order": 14,
            "group_id": 16,
            "block_polygon_points": [
