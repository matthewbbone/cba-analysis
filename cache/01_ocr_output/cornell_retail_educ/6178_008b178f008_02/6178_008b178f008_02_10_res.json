        },
        {
            "block_label": "text",
            "block_content": "3. Classification seniority in their most recent position only with immediate ability to do the available work shall prevail in laying off employees and in recalling employees from layoff.",
            "block_bbox": [
                198,
                690,
                1129,
                822
