                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. University-wide seniority shall mean an employee's length of service within the bargaining unit covered by this Agreement.",
            "block_bbox": [
                199,
                591,
                1079,
                673
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
