        },
        {
            "block_label": "text",
            "block_content": "4. Any employee displaced from his or her job title shall be permitted to transfer to any vacant position the University is seeking to fill in the same grade and within the same School or administrative unit as defined above, provided he/she has the ability to immediately perform the available work.",
            "block_bbox": [
