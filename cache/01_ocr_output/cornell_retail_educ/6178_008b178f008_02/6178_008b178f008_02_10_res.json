        {
            "block_label": "text",
            "block_content": "1. Seniority by classification shall mean an employee's length of service within a particular job title and grade within a particular School or administrative unit, a list of which is attached as Appendix A.",
            "block_bbox": [
                199,
                444,
                1113,
                574
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
