        {
            "block_label": "text",
            "block_content": "1. In the event of severance of employment by reason of layoff, all permanent full-time and part-time employees shall be paid a severance allowance of one-half  $ \\left(\\frac{1}{2}\\right) $ of a week's pay for each full year of service with the Employer up to a maximum of thirteen (13) weeks.",
            "block_bbox": [
                140,
                505,
                1048,
                686
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
