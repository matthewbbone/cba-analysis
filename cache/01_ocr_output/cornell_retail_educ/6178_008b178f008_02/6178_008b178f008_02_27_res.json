                [
                    172.0,
                    545.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) Credit for vacation or sick leave is not accumulated during an unpaid leave of absence of more than fifteen days.",
            "block_bbox": [
                172,
                561,
                1054,
                642
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    172.0,
                    561.0
                ],
