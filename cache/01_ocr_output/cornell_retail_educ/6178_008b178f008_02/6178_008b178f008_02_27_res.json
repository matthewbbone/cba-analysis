                    1054.0,
                    642.0
                ],
                [
                    172.0,
                    642.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c) No pay is given for holidays which occur during the leave of absence period. If a holiday falls on the first working day after the scheduled expiration date of the employee's leave, the employee is not paid for that holiday.",
            "block_bbox": [
                171,
                659,
                1079,
                841
            ],
            "block_id": 4,
