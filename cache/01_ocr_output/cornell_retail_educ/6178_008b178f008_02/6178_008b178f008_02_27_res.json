            ]
        },
        {
            "block_label": "text",
            "block_content": "a) An employee may be required to take a medical examination prior to return to work from any Illness Leave of Absence.",
            "block_bbox": [
                170,
                906,
                1112,
                988
            ],
            "block_id": 6,
