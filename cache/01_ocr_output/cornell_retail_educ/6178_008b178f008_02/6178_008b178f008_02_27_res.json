                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a) University continues its contributions for health and life insurance coverage during the period of leave. The employee must continue to pay his/her share of such premiums, if applicable.",
            "block_bbox": [
                172,
                413,
                1066,
                545
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
