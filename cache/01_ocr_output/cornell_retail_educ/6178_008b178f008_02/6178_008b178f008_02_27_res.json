        {
            "block_label": "paragraph_title",
            "block_content": "4.  $ \\underline{\\text{Contractual Benefits During Leave}} $",
            "block_bbox": [
                256,
                364,
                724,
                395
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
