        },
        {
            "block_label": "text",
            "block_content": " $ \\underline{\\text{Section 3.}} $ The steps set forth below will be followed in the processing of grievances:",
            "block_bbox": [
                161,
                565,
                1006,
                643
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
