            ]
        },
        {
            "block_label": "text",
            "block_content": "In no event shall a series of temporary employees be used to fill a vacancy in a job of a permanent nature. This shall not preclude the hiring of a temporary employee while a permanent employee is being sought. This provision has no reference or application to student employees.",
