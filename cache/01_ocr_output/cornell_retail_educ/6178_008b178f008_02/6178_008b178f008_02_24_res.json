        },
        {
            "block_label": "text",
            "block_content": "7. Employees who are specifically hired to work for less than the twelve (12) months of the academic year or who are temporarily laid off for the summer months accrue vacation allowance only for the number of completed months actually worked.",
            "block_bbox": [
