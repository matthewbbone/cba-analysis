        },
        {
            "block_label": "text",
            "block_content": "The arbitrator shall have jurisdiction only over disputes arising out of grievances, as defined in Section 1 above, and shall not have the authority to add to, subtract from, modify or amend in any way the provisions of this Agreement.",
