        {
            "block_label": "text",
            "block_content": "D. Procedure for Reduction—When a reduction in staff within a given classification occurs, the determination of those who are to be released will be in the following order:",
            "block_bbox": [
                50,
                59,
                705,
                134
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
