        {
            "block_label": "text",
            "block_content": "2. a) Incremental movement on the Supporting Services Pay Schedule is based on the satisfactory performance of each unit member. The evaluation performance shall be recorded on the proper form. Wage increments are effected on the first day of the pay period in which the anniversary date falls.",
            "block_bbox": [
                76,
                366,
                695,
                487
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
