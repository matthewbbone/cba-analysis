        },
        {
            "block_label": "paragraph_title",
            "block_content": "B. Overtime Assignments",
            "block_bbox": [
                57,
                389,
                289,
                412
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    57.0,
