        {
            "block_label": "text",
            "block_content": "A. 1. Unit members covered by this Agreement who are not in those positions considered as exempted for overtime under the provisions of the Fair Labor Standards Act as executive, administrative, or professional employees, and who are required or authorized to work by an appropriate supervisor in excess of eight (8) hours in a day or forty (40) hours in a regularly scheduled work week shall be paid at one and one-half (1 1/2) times the unit member's regular rate of pay.",
            "block_bbox": [
                53,
                144,
                709,
                316
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    53.0,
                    144.0
                ],
                [
                    709.0,
                    144.0
                ],
                [
                    709.0,
                    316.0
                ],
                [
                    53.0,
                    316.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Paid leave shall be counted as hours worked for purposes of determining hours worked for overtime.",
            "block_bbox": [
                92,
                327,
                708,
                376
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
