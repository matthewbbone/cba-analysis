        {
            "block_label": "paragraph_title",
            "block_content": "Working Hours And Work Load",
            "block_bbox": [
                211,
                378,
                576,
                405
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
