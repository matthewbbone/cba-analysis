                    901.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The transportation division will undertake a review of schedules and assignments for the purpose of reducing the length of the downtime periods.",
            "block_bbox": [
                102,
                913,
                724,
                963
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
