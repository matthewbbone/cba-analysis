        {
            "block_label": "text",
            "block_content": "5. a) The president of MCCSSE will be granted leave during the term of this contract.",
            "block_bbox": [
                107,
                186,
                722,
                235
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
