        {
            "block_label": "text",
            "block_content": "d) Change of Status During Period of Leave—If the unit member on leave for teaching in a college or university cannot complete the program for which leave was granted, it is his/her responsibility to notify the superintendent. The leave may then be rescinded by the Board of Education and the unit member placed on the appropriate leave status, reassigned, or terminated. Salary allowances and benefits shall be adjusted accordingly, and the unit member must make arrangements to reimburse the Board any monies paid to him/her or on his/her behalf.",
            "block_bbox": [
                116,
                195,
                706,
                415
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
