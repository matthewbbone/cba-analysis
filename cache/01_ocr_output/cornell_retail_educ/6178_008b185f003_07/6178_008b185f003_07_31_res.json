                    90.0,
                    775.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Unit members wishing leave in excess of 40 consecutive duty days for a period not to exceed 18 months must use MCPS Form 430-9 for long-term maternity/child care/adoption leave without salary. The unit members' positions will not be held for their return.",
            "block_bbox": [
                91,
                786,
                707,
                885
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
