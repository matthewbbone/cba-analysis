        {
            "block_label": "paragraph_title",
            "block_content": "H. Maternity/Child Care/Adoption Leave",
            "block_bbox": [
                51,
                536,
                421,
                560
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
