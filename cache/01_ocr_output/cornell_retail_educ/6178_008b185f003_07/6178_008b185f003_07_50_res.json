                    142.0,
                    417.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) One employee may choose coverage which would include his/her spouse as a dependent. The other may enroll in a \"life only\" plan.",
            "block_bbox": [
                142,
                427,
                698,
                501
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
