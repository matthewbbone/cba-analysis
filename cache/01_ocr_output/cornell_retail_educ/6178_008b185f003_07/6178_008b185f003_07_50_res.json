                [
                    698.0,
                    305.0
                ],
                [
                    698.0,
                    380.0
                ],
                [
                    110.0,
                    380.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) Each may choose to be covered separately under a single plan.",
            "block_bbox": [
                142,
                391,
                693,
                417
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
