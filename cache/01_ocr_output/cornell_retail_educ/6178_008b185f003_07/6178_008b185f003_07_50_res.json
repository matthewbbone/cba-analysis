                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) If one employee chooses a plan covering other dependents, the other may enroll in a single plan. In no event will any employee be covered by two MCPS plans.",
            "block_bbox": [
                142,
                513,
                698,
                585
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
