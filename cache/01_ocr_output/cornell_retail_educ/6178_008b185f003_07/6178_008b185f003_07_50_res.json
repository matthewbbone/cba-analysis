                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f) Whenever a husband and wife are both employed by MCPS and eligible to participate in the Employee Benefits Plan, one of the following enrollment options will be available:",
            "block_bbox": [
                110,
                305,
                698,
                380
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
