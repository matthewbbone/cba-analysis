        {
            "block_label": "paragraph_title",
            "block_content": "3. Leave for Summer School",
            "block_bbox": [
                88,
                395,
                347,
                418
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
