                    549.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Leave with pay may be granted as follows:",
            "block_bbox": [
                140,
                559,
                496,
                584
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    140.0,
                    559.0
                ],
                [
                    496.0,
                    559.0
                ],
                [
                    496.0,
