                    705.0,
                    596.0
                ],
                [
                    705.0,
                    768.0
                ],
                [
                    139.0,
                    768.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) A unit member who is granted leave must submit grade slips and/or transcripts to the appropriate official at the conclusion of the summer school. The principal will forward them to the Office of Personnel Services.",
            "block_bbox": [
                114,
                779,
                704,
