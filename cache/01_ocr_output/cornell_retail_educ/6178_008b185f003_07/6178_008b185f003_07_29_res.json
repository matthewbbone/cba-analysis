            ]
        },
        {
            "block_label": "text",
            "block_content": "a) A unit member must give evidence in writing that leave is required for summer school attendance prior to the closing of school or at the beginning of the fall semester. Request for leave for summer school shall be made in advance, recommended by the appropriate official and approved by the superintendent.",
            "block_bbox": [
                116,
                426,
                704,
                549
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
