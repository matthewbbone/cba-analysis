            "block_label": "paragraph_title",
            "block_content": "Article 31\nRecrediting Of Former Service Credits",
            "block_bbox": [
                181,
                79,
                629,
                135
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
