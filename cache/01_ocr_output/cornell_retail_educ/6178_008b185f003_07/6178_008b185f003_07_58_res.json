            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Article 32\nEmployee Rights",
            "block_bbox": [
                303,
                347,
                506,
                403
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    303.0,
                    347.0
                ],
                [
                    506.0,
                    347.0
                ],
                [
                    506.0,
                    403.0
                ],
                [
                    303.0,
                    403.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. There will be no reprisals of any kind taken against any employee because of his/her membership or nonmembership in MCCSSE.",
            "block_bbox": [
                79,
                410,
                735,
                458
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    79.0,
                    410.0
                ],
                [
                    735.0,
                    410.0
                ],
                [
                    735.0,
                    458.0
                ],
                [
                    79.0,
                    458.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Nondiscrimination—The Board and the MCCSSE agree that there shall be no discrimination by the Board or MCCSSE against employees because of race, color, creed, religion, national original, sex, age, marital status, or because of physical handicap.",
            "block_bbox": [
                80,
                470,
                736,
                569
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    80.0,
                    470.0
                ],
                [
                    736.0,
                    470.0
                ],
                [
                    736.0,
                    569.0
                ],
                [
                    80.0,
                    569.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. The personal life of a unit member shall be the concern of, and warrant the attention of, the Board only as it may directly prevent the unit member from properly performing his/her assigned functions during duty hours, or violate local, state, or national law, or be prejudicial to his/her effectiveness in his/her position.",
            "block_bbox": [
                80,
                580,
                736,
                702
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    80.0,
                    580.0
                ],
                [
                    736.0,
                    580.0
                ],
                [
                    736.0,
                    702.0
                ],
                [
                    80.0,
                    702.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "D. At the request of either party, Board and Union representatives shall meet to discuss any proposed Board policies or practices regarding testing of employees for use of drugs or alcohol, with the goal of reaching agreement on a program acceptable to both parties. Such discussions shall be without prejudice to the Board's authority to implement testing for drug or alcohol abuse by employees or the Union's right to challenge such practices.",
            "block_bbox": [
                79,
                714,
                736,
                860
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    79.0,
                    714.0
                ],
                [
                    736.0,
                    714.0
                ],
                [
                    736.0,
                    860.0
                ],
                [
                    79.0,
                    860.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "E. In any investigative meeting or interview with an employee which is conducted by the Office of Personnel Services and which may lead to demotion, suspension, or discharge, the employee will be advised that he/she has the right to have a Union representative present.",
