        },
        {
            "block_label": "text",
            "block_content": "A former employee, upon reappointment to a permanent or conditional position in the same classification, shall be granted full credit for years of service with MCPS only to determine salary schedule placement if the following two conditions are met:",
            "block_bbox": [
                73,
                143,
                735,
                239
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    73.0,
                    143.0
                ],
                [
                    735.0,
                    143.0
                ],
                [
                    735.0,
                    239.0
                ],
                [
                    73.0,
                    239.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The individual previously was employed for a minimum of five (5) years.",
            "block_bbox": [
                118,
                251,
                734,
                276
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    118.0,
                    251.0
                ],
                [
                    734.0,
                    251.0
                ],
                [
                    734.0,
                    276.0
                ],
                [
                    118.0,
                    276.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The individual is reemployed within a three-year period.",
            "block_bbox": [
                117,
                288,
                610,
                313
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
