                    116.0,
                    366.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c) The personal leave shall not be cumulative. However, unused personal leave shall be transferred to accumulated sick leave at the end of the school year.",
            "block_bbox": [
                117,
                376,
                707,
                449
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
