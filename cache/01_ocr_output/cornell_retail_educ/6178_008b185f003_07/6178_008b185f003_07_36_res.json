                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Unit members who are eligible for annual leave will be allowed to use any earned leave in their accounts after approval by the principal or appropriate official. The 40-day or 18-month period shall include the period of annual leave if used.",
            "block_bbox": [
                91,
                820,
                708,
                917
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
