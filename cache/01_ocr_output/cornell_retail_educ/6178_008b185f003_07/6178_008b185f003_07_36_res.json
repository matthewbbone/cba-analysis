                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "R. General—Except in those cases where the superintendent has the right to grant the leave, the superintendent shall have the right to recommend to the Board of Education that a leave of absence be granted with loss of substitute pay, without pay, or with pay or to recommend that the leave be denied.",
            "block_bbox": [
                53,
