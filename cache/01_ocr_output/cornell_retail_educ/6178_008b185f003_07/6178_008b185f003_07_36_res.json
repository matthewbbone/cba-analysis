        {
            "block_label": "paragraph_title",
            "block_content": "S. Procedures for Short- and Long-Term Leave",
            "block_bbox": [
                54,
                570,
                478,
                594
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
