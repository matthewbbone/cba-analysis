                    117.0,
                    280.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) Leave immediately before or after a holiday, vacation, or staff development day may be requested for reason from the school principal or appropriate official.",
            "block_bbox": [
                116,
                291,
                707,
                366
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
