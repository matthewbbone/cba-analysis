                    91.0,
                    699.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Unit members wishing leave in excess of forty (40) consecutive duty days for a period not to exceed eighteen (18) months must use MCPS Form 430-9 for long-term leave without salary. The unit member's position will not be held for their return.",
            "block_bbox": [
                90,
                711,
                708,
                809
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
