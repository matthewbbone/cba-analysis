        {
            "block_label": "text",
            "block_content": "2. The rules regarding personal leave shall be as follows:",
            "block_bbox": [
                90,
                218,
                566,
                243
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
