                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a) Requests for personal leave shall be made in writing.",
            "block_bbox": [
                117,
                255,
                580,
                280
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
