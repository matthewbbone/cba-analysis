        {
            "block_label": "text",
            "block_content": "1. When the leave is of short duration, and not longer than forty (40) consecutive duty days, a substitute may be employed and the position held for the return of the unit member. Use MCPS Form 430-1 for short-term leave.",
            "block_bbox": [
                91,
                601,
                708,
                699
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
