        {
            "block_label": "text",
            "block_content": "A. Unit members who are required to use their private automobile within the scope of their assigned duties or while on required official business shall receive the Internal Revenue Service's officially stated mileage allowance. Thereafter during the life of the Agreement the mileage rate will be adjusted as necessary to reflect any changes in mileage allowance regulations issued by the Internal Revenue Service. Such adjustment or adjustments will be made effective on the first of the month following the official change in IRS regulations.",
            "block_bbox": [
                55,
                346,
                709,
                541
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
