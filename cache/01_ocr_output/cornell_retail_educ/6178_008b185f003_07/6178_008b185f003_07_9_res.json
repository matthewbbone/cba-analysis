                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. All decisions rendered at all levels of the grievance procedure will be in writing, setting forth the decision and the reasons therefore, and will be transmitted promptly to both parties.",
            "block_bbox": [
                73,
                567,
                689,
                641
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
