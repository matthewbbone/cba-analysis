        {
            "block_label": "text",
            "block_content": "1. All documents, communications, and records dealing with the processing of a grievance will be filed in a separate grievance file and will not be kept in the official personnel file of any of the participants.",
            "block_bbox": [
                73,
                482,
                688,
                556
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
