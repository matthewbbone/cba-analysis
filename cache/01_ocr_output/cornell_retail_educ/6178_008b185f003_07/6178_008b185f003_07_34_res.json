                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a) Class 1-0, who does not enter the military service but fulfills his/her selective service obligation by working for twenty-four (24) months in an institution approved by the state in which he/she resides, and who is not entitled to veterans' benefits, and",
            "block_bbox": [
                113,
                311,
                703,
                408
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    113.0,
                    311.0
                ],
                [
                    703.0,
                    311.0
                ],
                [
                    703.0,
