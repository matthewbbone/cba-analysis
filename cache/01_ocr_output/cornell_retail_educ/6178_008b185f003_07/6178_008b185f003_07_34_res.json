                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Unit members who are conscientious objectors and who are Class 1-0 shall not be given credit on the salary schedule for this type of service at the time of employment.",
            "block_bbox": [
                86,
                505,
                703,
                579
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
