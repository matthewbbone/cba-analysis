                ],
                [
                    113.0,
                    408.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) Class 1-AO, who enters the armed services but does not bear arms, is subjected to the same hazards as the regular serviceperson, and, upon discharge, is entitled to all veterans' benefits.",
            "block_bbox": [
                112,
                420,
                703,
                493
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
