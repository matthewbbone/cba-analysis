        },
        {
            "block_label": "text",
            "block_content": "1. There are two classes of conscientious objectors:",
            "block_bbox": [
                86,
                281,
                515,
                305
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
