            ]
        },
        {
            "block_label": "text",
            "block_content": "7. Disposition of Accumulated Sick Leave at Termination of Service—At the time of his/her termination after five (5) years of service with the Montgomery County Public Schools, any unit member who has performed his/her duties satisfactorily shall receive termination pay at his/her current salary rate for one-fourth (¼) of his/her accumulated sick leave.",
            "block_bbox": [
                92,
                616,
