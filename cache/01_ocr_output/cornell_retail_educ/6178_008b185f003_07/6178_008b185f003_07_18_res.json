                    119.0,
                    854.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) A unit member on sick leave shall notify the appropriate official as to the progress of his/her illness and the exact date of his/her availability for duty, as soon as it is determined, with at least one (1) day's notice.",
            "block_bbox": [
                118,
                866,
                709,
                939
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
