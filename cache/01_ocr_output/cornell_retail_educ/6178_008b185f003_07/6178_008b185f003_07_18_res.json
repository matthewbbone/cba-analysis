            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Advancement of Sick Leave—At the beginning of each school year, a unit member on permanent status is advanced sick leave that will be earned during the school year. Sick leave in excess of the amount to be earned may be advanced by the superintendent. Unit members are liable for all advanced sick leave.",
            "block_bbox": [
                93,
                190,
                710,
                312
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
