        {
            "block_label": "text",
            "block_content": "a) Eligibility—A unit member who is a member of the National Guard or of the U.S. Armed Forces Reserves and who is required by the laws of the United States or of Maryland to report for a training period, shall be eligible for a grant of military leave for training purposes not to exceed fifteen (15) calendar days per school year.",
            "block_bbox": [
