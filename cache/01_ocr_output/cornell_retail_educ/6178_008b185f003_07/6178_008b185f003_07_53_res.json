                    67.0,
                    261.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees shall receive a set of summer uniforms and a set of winter uniforms within the total number of uniforms agreed upon.",
            "block_bbox": [
                97,
                272,
                721,
                322
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
