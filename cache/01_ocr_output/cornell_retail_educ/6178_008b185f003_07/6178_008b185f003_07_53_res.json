        {
            "block_label": "text",
            "block_content": "A. The Board will furnish five (5) uniforms the first year of this contract or the first year of employment and three (3) replacement uniforms each year thereafter to employees who elect to wear uniforms. Unit members who through this process are furnished uniforms must wear them to work. Failure to do so may result in disciplinary action.",
            "block_bbox": [
                67,
                138,
                722,
                261
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
