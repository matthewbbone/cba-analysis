        {
            "block_label": "text",
            "block_content": "G. The Board agrees that any modifications in the retirement and pension plan benefits will be announced 90 days in advance of the effective date of the implementation of such changes. It agrees further that MCCSSE will be consulted about the proposed changes and will be given an opportunity to provide its views and suggestions.",
            "block_bbox": [
                58,
                240,
                713,
                363
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
