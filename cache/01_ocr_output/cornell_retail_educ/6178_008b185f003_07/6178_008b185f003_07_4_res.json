        },
        {
            "block_label": "text",
            "block_content": "A. All positions within the bargaining unit shall be either permanent or conditional.",
            "block_bbox": [
                78,
                343,
                733,
                392
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    78.0,
