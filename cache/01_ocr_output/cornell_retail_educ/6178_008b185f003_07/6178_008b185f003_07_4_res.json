                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The incumbent of a temporary position being converted shall be assigned to the permanent position upon conversion of the position. The time spent in the temporary position shall be counted in determining seniority.",
            "block_bbox": [
                119,
                975,
                737,
                1049
