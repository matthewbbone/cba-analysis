        {
            "block_label": "paragraph_title",
            "block_content": "Article 3\nEmployee Bargaining Unit Defined",
            "block_bbox": [
                201,
                280,
                604,
                336
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
