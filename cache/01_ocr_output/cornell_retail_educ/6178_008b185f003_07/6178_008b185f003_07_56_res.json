        {
            "block_label": "paragraph_title",
            "block_content": "B. Supervisor Files",
            "block_bbox": [
                55,
                212,
                233,
                236
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
