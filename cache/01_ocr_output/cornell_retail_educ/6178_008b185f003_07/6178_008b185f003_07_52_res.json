        {
            "block_label": "paragraph_title",
            "block_content": "Protection Of Persons And Property",
            "block_bbox": [
                162,
                275,
                585,
                301
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
