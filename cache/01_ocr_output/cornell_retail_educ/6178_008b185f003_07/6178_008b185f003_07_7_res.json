        {
            "block_label": "paragraph_title",
            "block_content": "A. Definitions",
            "block_bbox": [
                48,
                287,
                181,
                310
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    48.0,
                    287.0
                ],
                [
                    180.0,
                    287.0
                ],
                [
                    180.0,
