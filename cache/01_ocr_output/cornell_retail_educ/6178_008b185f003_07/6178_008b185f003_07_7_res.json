                ],
                [
                    48.0,
                    309.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. “Grievance” means a claim by one party that the other party has violated this Agreement.",
            "block_bbox": [
                87,
                317,
                702,
                365
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    87.0,
                    317.0
                ],
                [
                    702.0,
                    317.0
                ],
                [
                    702.0,
                    365.0
                ],
                [
                    87.0,
                    365.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. “Grievant” means the person or persons making the claim.",
            "block_bbox": [
                85,
                377,
                593,
                402
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    85.0,
                    377.0
                ],
                [
                    593.0,
