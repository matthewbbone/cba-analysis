        {
            "block_label": "text",
            "block_content": "Section 1. The Company will pay all regular full time employees straight time for the following holidays if there is no work to be performed: New Year's Day, Easter Monday, Memorial Day, Independence Day, Labor Day, Thanksgiving Day, Christmas Day.",
            "block_bbox": [
                38,
                467,
