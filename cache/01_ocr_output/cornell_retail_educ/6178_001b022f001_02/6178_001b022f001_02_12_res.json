            ]
        },
        {
            "block_label": "text",
            "block_content": "Upon employee's completion of ninety (90) days service with the Company, an additional personal holiday will be granted. Holiday pay will include night shift differential where applicable. The personal holiday is to be mutually agreed upon in advance by the employee and the Employer. Employees must work the scheduled full day before and the schedule full day after each such holiday (Sundays and days off due to death in family excepted) to receive holiday pay.",
            "block_bbox": [
                38,
                556,
                527,
                695
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
