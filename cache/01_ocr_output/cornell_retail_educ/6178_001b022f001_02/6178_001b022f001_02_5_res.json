                    43.0,
                    473.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 2. Employees laid off and subsequently rehired by the Employer within six (6) months of the layoff date shall retain their former seniority. Employees laid off on account of ill health shall retain their seniority for a period of twelve (12) months.",
            "block_bbox": [
                43,
                482,
                531,
                568
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
