        {
            "block_label": "text",
            "block_content": "Section 1. For the life of this Agreement the Company will contribute the sum of five (5c) per hour, in accordance with the provisions of the Trust Agreement, for each hour worked, including paid vacations and paid holidays, by each regular full time employee covered by this Agreement, including those employees referred to in Article VII, Section 4 (a) of the Agreement, up to a maximum of forty (40) hours each week to Amalgamated Local 72 Pension Fund. With respect to all eligible employees hired after February 1, 1962 contributions by the Company will commence with the first full pay week following the completion of thirty (30) days of continuous employment with the Company.",
            "block_bbox": [
                44,
                334,
                532,
                539
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
