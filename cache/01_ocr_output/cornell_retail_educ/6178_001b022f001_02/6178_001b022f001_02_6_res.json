        {
            "block_label": "text",
            "block_content": "Section 5. (a) Any employee returning from the Military Service shall be put back on the regular job he had when leaving for Military Service subject to the provisions of the Universal Military Training and Service Act, provided he/she can reasonably perform the functions of the position, with all across-the-board increases or less any across-the-board deductions that may have become effective during his/her absence. Because on-the-job experience and application are the predominating factors in upgrading within a rate range, Military Service itself will not qualify an employee for automatic promotion within such rate range.",
            "block_bbox": [
                42,
                70,
                530,
                256
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    42.0,
                    70.0
                ],
                [
                    530.0,
                    70.0
                ],
                [
                    530.0,
                    256.0
