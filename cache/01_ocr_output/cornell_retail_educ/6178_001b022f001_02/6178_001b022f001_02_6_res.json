        },
        {
            "block_label": "text",
            "block_content": "Section 6. For the purpose of determining increases within rate ranges, an employee shall be credited for a full week's seniority for any part of a week worked.",
            "block_bbox": [
                42,
                348,
                530,
                402
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
