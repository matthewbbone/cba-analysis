            "block_label": "text",
            "block_content": "Section 9. EMPLOYEES PROMOTED OUT OF BARGAINING UNIT. (a) Employees promoted out of the bargaining unit shall be subject to a probationary period of six (6) calendar months.",
            "block_bbox": [
                47,
                71,
                533,
                144
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
