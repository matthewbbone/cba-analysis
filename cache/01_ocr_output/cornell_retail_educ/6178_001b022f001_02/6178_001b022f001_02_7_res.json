        },
        {
            "block_label": "text",
            "block_content": "(c) Non-union personnel returning to bargaining unit after six (6) calendar months must take up clerk classification for six (6) months prior to qualifying (i.e., being permitted to bid for) following \"key\" positions: Head meat cutter, First grocery clerk, First produce clerk, Night shift head, Head cashier, First meat cutter, Dairy dept. head.",
            "block_bbox": [
                47,
                229,
