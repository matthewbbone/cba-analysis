                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) An employee demoted prior to expiration of six-month trial period may be returned to his former position at which time other employees advanced by reason of the original promotion will be correspondingly demoted.",
            "block_bbox": [
                47,
