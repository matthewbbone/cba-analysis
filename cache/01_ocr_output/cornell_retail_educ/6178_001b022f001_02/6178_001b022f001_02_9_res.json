                    270.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 14. (a) Any employee, member of the Union, who is elected to a full time position with the Union, or who is elected as a delegate or representative of the Union in any Union activity necessitating temporary leave of absence from his employment shall be granted such leave of absence and shall at the end of his term in the first instance, or at the end of his mission in the second instance, be reemployed at his former wage rate, plus any increase or less any reduction that may have become effective during his absence, and shall retain his seniority standing.",
            "block_bbox": [
                45,
                279,
                533,
                449
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    45.0,
                    279.0
                ],
                [
                    533.0,
                    279.0
                ],
                [
                    533.0,
                    449.0
                ],
