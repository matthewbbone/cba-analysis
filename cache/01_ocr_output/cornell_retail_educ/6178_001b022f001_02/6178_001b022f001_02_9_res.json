        {
            "block_label": "text",
            "block_content": "Section 13. There shall be no discrimination against any employee because of Union membership. It is agreed that Union duties and activities shall not be carried on during hours of work or on Company premises. However, this shall not prevent Union officials from entering stores to satisfy themselves that this Agreement is being observed.",
            "block_bbox": [
                45,
                166,
                533,
                270
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
