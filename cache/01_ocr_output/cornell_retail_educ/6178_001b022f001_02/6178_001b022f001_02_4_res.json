                    44.0,
                    359.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3. Full time employees working after 6:00 p.m. on New Year's Eve or Christmas Eve shall be compensated at double time; such employees working from 12:01 a.m. to 12:00 midnight on Sunday shall be compensated at triple time for all time so worked. Triple time will be paid for all work performed on Sundays only when the store is open for business, except in cases of emergency which shall include competitive store opening. In such instances double time will be paid.",
            "block_bbox": [
                44,
                365,
                532,
                502
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
