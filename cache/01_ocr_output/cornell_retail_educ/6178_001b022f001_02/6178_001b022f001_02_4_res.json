        {
            "block_label": "text",
            "block_content": "Section 1. The regular work week shall consist of forty (40) hours. Time worked by full time employees in excess of forty (40) hours per week shall be compensated for at time and one-half the regular straight time hourly rate.",
            "block_bbox": [
                43,
                181,
                531,
                252
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    43.0,
