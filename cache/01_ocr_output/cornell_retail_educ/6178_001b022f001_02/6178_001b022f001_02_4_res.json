        },
        {
            "block_label": "text",
            "block_content": "Section 4. Excepting those working on a regular night shift, all full time employees working prior to 7:00 a.m. shall be compensated at time and one-half the regular straight time hourly rate for all time so worked.",
            "block_bbox": [
                44,
                508,
