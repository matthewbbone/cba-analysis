        },
        {
            "block_label": "text",
            "block_content": "Section 9.11 The parties agree to participate in the NECA-IBEW National Labor-Management Cooperation Fund, under authority of Section 6(b) of the Labor-Management Cooperation Act of 1978, 29 U.S.C. 175(a) and Section 302(c)(9) of the Labor-Management Relations Act, 29 U.S.C. 186(c)(9). The purposes of this Fund include the following:",
            "block_bbox": [
                120,
                837,
                1055,
                1004
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    120.0,
                    837.0
                ],
                [
                    1055.0,
                    837.0
                ],
                [
                    1055.0,
                    1004.0
                ],
                [
                    120.0,
                    1004.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) to improve communication between representatives of labor and management;",
            "block_bbox": [
                122,
                1025,
                1010,
                1085
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    121.5400390625,
                    1033.0042724609375
                ],
                [
                    1009.0,
                    1025.0001220703125
                ],
                [
                    1009.523681640625,
                    1083.0574951171875
                ],
                [
                    122.063720703125,
                    1091.0616455078125
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) to provide workers and employers with opportunities to study and explore new and innovative joint approaches to achieving organizational effectiveness;",
            "block_bbox": [
                122,
                1107,
                1086,
                1194
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
