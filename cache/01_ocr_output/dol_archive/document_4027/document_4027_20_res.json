                    662.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Union will furnish a tool list to be completed by the employee and presented to the Employer prior to commencing work.",
            "block_bbox": [
                122,
                686,
                1084,
                744
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
