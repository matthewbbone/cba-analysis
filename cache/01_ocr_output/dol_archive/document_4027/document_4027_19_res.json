        {
            "block_label": "text",
            "block_content": "Section 5.09 (a) Employees that are assigned to service or maintain trucks or equipment outside of their normal work hours shall receive 40 minutes additional, at their applicable rate of pay, at the rate of time and one-half.",
            "block_bbox": [
                116,
                112,
                1051,
                225
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
