            ]
        },
        {
            "block_label": "text",
            "block_content": "(d) The operation of all other equipment or trucks except those specifically mentioned in sub-section (b) and (c) of this Section will be at the groundman truck driver rate of pay.",
            "block_bbox": [
                118,
                437,
                1069,
