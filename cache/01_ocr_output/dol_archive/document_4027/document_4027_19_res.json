                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) The operation of Fixed Auger/Pressure Digging units shall be at the Journeyman Lineman's rate of pay.",
            "block_bbox": [
                117,
                246,
                1039,
                305
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
