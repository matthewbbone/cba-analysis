        },
        {
            "block_label": "text",
            "block_content": "(c) The operation of all crawler type equipment larger than a D-4, 15 ton cranes and larger shall be at the groundman equipment operator's rate of pay.",
            "block_bbox": [
                118,
                328,
                1009,
                415
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
