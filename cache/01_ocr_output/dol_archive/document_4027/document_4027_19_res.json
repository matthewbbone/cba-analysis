        },
        {
            "block_label": "text",
            "block_content": "(e) Journeyman Linemen and apprentice linemen shall be permitted to drive or operate equipment as required, when qualified groundman truck driver or equipment operator are not available. Journeyman linemen and apprentice linemen shall be paid their applicable rate when engaged in driving or operating equipment.",
            "block_bbox": [
                120,
                544,
                1085,
                714
            ],
            "block_id": 5,
