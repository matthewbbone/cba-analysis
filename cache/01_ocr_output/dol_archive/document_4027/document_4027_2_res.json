        {
            "block_label": "text",
            "block_content": "Section 1.04 There shall be no stoppage of work either by strike or lockout because of any proposed changes in this Agreement or dispute over matters relating to this Agreement. All such matters must be handled as stated herein.",
            "block_bbox": [
