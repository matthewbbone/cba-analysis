        },
        {
            "block_label": "paragraph_title",
            "block_content": "GRIEVANCES - DISPUTES",
            "block_bbox": [
                450,
                603,
                764,
                630
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
