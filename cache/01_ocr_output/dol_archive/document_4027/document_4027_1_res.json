        {
            "block_label": "text",
            "block_content": "Section 1.01 This Agreement shall take effect February 29, 2016 and shall remain in effect until March 1, 2020, unless otherwise specifically provided for herein. It shall continue in effect from year to year thereafter, through the last day of February of each year, unless changed or terminated in the way later provided herein.",
            "block_bbox": [
                119,
                162,
                1068,
                327
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
