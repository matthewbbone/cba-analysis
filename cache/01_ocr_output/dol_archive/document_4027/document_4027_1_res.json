            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Whenever notice is given for changes, the nature of the changes desired must be specified in the notice, or no later than the first negotiating meeting unless mutually agreed otherwise.",
            "block_bbox": [
                121,
