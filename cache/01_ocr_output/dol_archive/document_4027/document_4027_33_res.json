        {
            "block_label": "text",
            "block_content": "3. Failure by any firm to submit completed reports will be automatic cause for the business agent to remove all bargaining employees from all work and not refer any other personnel until all accounts are reported and paid in full.",
            "block_bbox": [
                117,
                194,
                1037,
                307
