        {
            "block_label": "text",
            "block_content": "The intent of this Agreement is to establish uniform conditions of employment of electrical workers for the purpose of performing line construction, reconstruction, maintenance line work, substation, cable work and electrical underground construction or other electrical work coming properly under the jurisdiction of the outside branch of the trade.",
            "block_bbox": [
                119,
                701,
                1079,
                869
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
                [
                    119.0,
                    701.0
                ],
                [
                    1079.0,
                    701.0
                ],
                [
                    1079.0,
                    869.0
                ],
                [
                    119.0,
                    869.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(Electrical underground construction shall include excavations, laying of conduits, ducts, cables and bases for street lights, transmission towers and transformers and excavations for manholes or hand holes.)",
