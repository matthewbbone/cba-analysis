                ],
                [
                    117.0,
                    981.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(6) to engage in research and development programs concerning various aspects of the industry, including, but not limited to, new technologies, occupational safety and health, labor relations, and new methods of improved production;",
            "block_bbox": [
                117,
                1007,
                1025,
                1118
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
