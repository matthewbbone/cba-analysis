                [
                    117.0,
                    1118.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(7) to engage in public education and other programs to expand the economic development of the electrical construction industry;",
            "block_bbox": [
                118,
                1142,
                1070,
                1224
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
