                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(8) to enhance the involvement of workers in making decisions that affect their working lives; and,",
            "block_bbox": [
                116,
                1251,
                1012,
                1308
            ],
            "block_id": 10,
            "block_order": 11,
