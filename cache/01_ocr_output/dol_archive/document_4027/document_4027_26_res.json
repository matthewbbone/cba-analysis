        {
            "block_label": "paragraph_title",
            "block_content": "LOCAL LABOR-MANAGEMENT COOPERATION COMMITTEE (LLMCC)",
            "block_bbox": [
                227,
                280,
                984,
                307
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
