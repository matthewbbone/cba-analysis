                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3.05 The Union shall maintain a register of applicants for employment established on the basis of the Classifications and Groups listed below. Each applicant for employment shall be registered in the highest priority Group in the classification or classifications for which he qualifies.",
            "block_bbox": [
