            "block_label": "text",
            "block_content": "A unit member may submit a file and request an evaluation for award of tenure during any year of service but must be evaluated for tenure in the mandatory year for review. Unit members evaluated for tenure prior to the mandatory year for review shall be evaluated on the basis of performance expectations that would exist at the time of mandatory tenure review.",
            "block_bbox": [
                245,
                145,
                1040,
                285
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
