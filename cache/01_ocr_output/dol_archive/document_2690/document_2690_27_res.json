        },
        {
            "block_label": "paragraph_title",
            "block_content": "a. Initial Appointment to Full or Associate Professor",
            "block_bbox": [
                245,
                360,
                811,
                388
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
