                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An initial appointment to the rank of professor may be made with or without tenure. However, unit members receiving such appointments without tenure shall be reviewed for tenure no later than the second  $ (2^{nd}) $ consecutive year of service. Appointments to full professor may continue beyond the third  $ (3^{rd}) $ year only with tenure.",
            "block_bbox": [
                317,
                410,
                1031,
                552
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    317.0,
                    410.0
                ],
                [
                    1031.0,
                    410.0
                ],
                [
                    1031.0,
                    552.0
                ],
                [
                    317.0,
                    552.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Initial appointment to the rank of associate professor also may be made with or without tenure. Unit members receiving such appointments without tenure shall be reviewed for tenure no later than the fourth  $ (4^{th}) $ consecutive year of service. Appointments to associate professor may continue beyond the fifth  $ (5^{th}) $ year only with tenure.",
            "block_bbox": [
                318,
                572,
                1015,
                714
            ],
            "block_id": 4,
