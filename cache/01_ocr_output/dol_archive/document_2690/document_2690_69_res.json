        {
            "block_label": "paragraph_title",
            "block_content": "17.2 Health and Safety",
            "block_bbox": [
                176,
                433,
                470,
                465
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
