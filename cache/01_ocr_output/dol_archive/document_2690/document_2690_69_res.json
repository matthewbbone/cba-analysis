            ]
        },
        {
            "block_label": "text",
            "block_content": "17.2.4 The University will make available to unit members all information as required by local, state, and federal law dealing with occupational safety and health.",
            "block_bbox": [
                176,
                1057,
                1047,
                1114
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
