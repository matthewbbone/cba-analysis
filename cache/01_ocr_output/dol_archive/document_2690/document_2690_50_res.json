        {
            "block_label": "table",
            "block_content": "<table><tr><td>Rank</td><td>Minimum</td></tr><tr><td>Instructor/Lecturer</td><td>$30,000</td></tr><tr><td>Assistant Professor</td><td>$34,000</td></tr><tr><td>Associate Professor</td><td>$40,000</td></tr><tr><td>Professor</td><td>$46,000</td></tr></table>",
