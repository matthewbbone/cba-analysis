        {
            "block_label": "text",
            "block_content": "3. During periods of sick leave in excess of two (2) biweekly pay periods (4 weeks), the unit member shall provide to his/her dean or director, or designee, statements at predetermined regular intervals from the unit member's or immediate family member's health care provider stating the condition of the unit member's availability for return to work.",
            "block_bbox": [
                317,
                414,
                1044,
                582
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
