        },
        {
            "block_label": "text",
            "block_content": "a. Within the first year, regardless of contract extensions, the unit member shall be notified no later than February 15 for appointments based on the academic year, or three (3) months prior to the end of the base appointment for appointments based on an alternative nine (9) month period.",
            "block_bbox": [
                245,
                280,
                1029,
                420
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
