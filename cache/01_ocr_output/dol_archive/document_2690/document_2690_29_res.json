            "block_label": "text",
            "block_content": "The chancellor or the chancellor's designee shall provide written notification of non-retention to the unit member. The following schedule of notification shall be based upon consecutive years of uninterrupted service as a tenure track unit member within the University of Alaska.",
            "block_bbox": [
                245,
                145,
                1036,
                258
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
