        {
            "block_label": "paragraph_title",
            "block_content": "9.4.2 Non-renewal of Non-tenure Track Unit Members",
            "block_bbox": [
                174,
                654,
                730,
                684
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
