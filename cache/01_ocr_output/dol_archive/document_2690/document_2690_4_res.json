        {
            "block_label": "text",
            "block_content": "4.3 In the event of claims, demands, suits or grievances brought by or on behalf of one or more unit members against the University relating to the application of this Article, United Academics shall indemnify and hold the University harmless against any and all liability that arises by actions taken by either party.",
            "block_bbox": [
                172,
