        },
        {
            "block_label": "paragraph_title",
            "block_content": "e. Failure to Receive Tenure",
            "block_bbox": [
                245,
                576,
                579,
                605
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
