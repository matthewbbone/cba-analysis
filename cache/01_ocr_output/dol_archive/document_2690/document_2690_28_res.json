        },
        {
            "block_label": "text",
            "block_content": "If requested in writing at the time of appointment, a partial year of service that includes at least one (1) semester of full-time unit member service (e.g., as in a mid-year appointment) may be approved by the chancellor or chancellor's designee as a full year of service and counted toward both the time of mandatory tenure review and eligibility for sabbatical leave.",
            "block_bbox": [
                318,
                413,
                1041,
                554
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
