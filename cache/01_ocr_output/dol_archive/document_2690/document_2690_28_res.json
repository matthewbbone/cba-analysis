        {
            "block_label": "text",
            "block_content": "Regardless of inclusion in the computation of total years, leave of absence shall not be deemed an interruption of otherwise consecutive service. Years of service preceding a break in consecutive years of university employment may be counted only upon agreement between the unit member and the chancellor or chancellor's designee at the time of re-employment.",
            "block_bbox": [
                317,
                224,
                1041,
                393
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
