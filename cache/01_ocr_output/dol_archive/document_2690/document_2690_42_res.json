        },
        {
            "block_label": "paragraph_title",
            "block_content": "13.3.4 Workload Determination Procedure:",
            "block_bbox": [
                176,
                497,
                606,
                525
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
