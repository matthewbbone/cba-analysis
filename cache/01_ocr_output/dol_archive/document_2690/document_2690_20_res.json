        {
            "block_label": "paragraph_title",
            "block_content": "9.1.6 Appointments of Distinction",
            "block_bbox": [
                175,
                303,
                530,
                332
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
