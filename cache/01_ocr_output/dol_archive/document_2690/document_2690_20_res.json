                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Written documentation of such evaluation shall be made available to the affected unit member. These evaluations shall play a part in determining if the unit member shall be retained, promoted, or tenured.",
            "block_bbox": [
                247,
                1272,
                1034,
