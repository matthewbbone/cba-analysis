                    1117.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Nothing in this article may be construed as conferring supervisory status on department heads/chairs. Formal or informal evaluations conducted by department heads/chairs may be considered along with other information provided by the faculty member or available to the reviewer.",
            "block_bbox": [
                245,
                1139,
                983,
                1252
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    245.0,
