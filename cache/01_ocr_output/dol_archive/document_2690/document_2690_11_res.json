        },
        {
            "block_label": "paragraph_title",
            "block_content": "c. Pre-Arbitration Communication",
            "block_bbox": [
                246,
                877,
                635,
                905
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
