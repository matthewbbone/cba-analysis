            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "b. Arbitration Issues",
            "block_bbox": [
                246,
                690,
                500,
                718
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
