        {
            "block_label": "paragraph_title",
            "block_content": "a. Arbitrator Selection",
            "block_bbox": [
                246,
                339,
                519,
                366
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
