                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Issues not specifically identified in writing in the Step 4 grievance filing or response shall not be submitted to the arbitrator for decision. The parties may mutually agree to waive this provision, but neither party shall be obligated to do so.",
            "block_bbox": [
                317,
                740,
                1049,
                854
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
