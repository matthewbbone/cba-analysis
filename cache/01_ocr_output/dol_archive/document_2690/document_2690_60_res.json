                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Tenured or tenure track unit members who shall have completed at least five (5) consecutive years of service within the MAU shall be eligible for consideration to take sabbatical leave during the sixth (6 $ ^{th} $) or subsequent year of service. Applicants who shall have completed at least five (5) consecutive years of service within the MAU from the date of return from any previous sabbatical leave shall be eligible to be granted another sabbatical leave to be taken during the sixth (6 $ ^{th} $) or subsequent year.",
            "block_bbox": [
                317,
                604,
                1039,
                801
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    317.0,
