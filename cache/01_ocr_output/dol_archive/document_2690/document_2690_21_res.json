        {
            "block_label": "paragraph_title",
            "block_content": "9.2.1 Evaluation of Tenure Track Unit Members for Retention",
            "block_bbox": [
                173,
                197,
                801,
                225
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
