        {
            "block_label": "text",
            "block_content": "Upon advance written notice to the chair of the board, the chancellor may meet with the board at any time after receiving its recommendation for the sole purpose of seeking clarification concerning the bases and implications of its recommendation.",
            "block_bbox": [
                317,
                277,
                1048,
