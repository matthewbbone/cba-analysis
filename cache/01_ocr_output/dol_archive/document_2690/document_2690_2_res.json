        {
            "block_label": "text",
            "block_content": "3.1 The University recognizes United Academics as the sole and exclusive representative for the members of the bargaining unit described below:",
            "block_bbox": [
                174,
                278,
                937,
                336
            ],
            "block_id": 2,
