                    174.0,
                    336.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "All regular non-adjunct faculty in the following ranks: Instructor, Assistant Professor, Associate Professor, Professor; Research Assistant Professor, Research Associate Professor, Research Professor; Visiting Instructor, Visiting Assistant Professor, Visiting Associate Professor, Visiting Professor; Cooperative Extension Faculty and/or Agents, Post Doctoral Fellows; Librarians, counselors, rehabilitation faculty, advisors, cooperative extension agents, and other academically related personnel and department heads/chairs.",
            "block_bbox": [
                246,
                358,
                1040,
                553
            ],
