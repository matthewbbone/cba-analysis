        {
            "block_label": "paragraph_title",
            "block_content": "e. Leave of Absence (nonmedical)",
            "block_bbox": [
                245,
                386,
                636,
                415
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
