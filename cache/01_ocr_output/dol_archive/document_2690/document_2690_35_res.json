        {
            "block_label": "text",
            "block_content": "11.3.2 Disciplinary action shall proceed according to the process set forth herein in cases of academic incompetence involving demonstrated inability to perform assigned professional responsibilities in an adequate manner.",
            "block_bbox": [
                175,
                306,
                1045,
                393
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
