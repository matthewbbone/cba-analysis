                    246.0,
                    332.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "United Academics and the University may be advised or represented by counsel of their choice during any stage of grievance proceedings. Advice or representation by counsel at any level shall not be the basis for disqualifying such counsel at any other stage. Any conflict of interest which might be raised upon the basis of such advice or representation is expressly waived with respect to all other stages of the process.",
            "block_bbox": [
                317,
                355,
                1046,
                524
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
