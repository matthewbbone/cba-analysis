        {
            "block_label": "paragraph_title",
            "block_content": "7.2.7 Grievances Filed by the University",
            "block_bbox": [
                176,
                674,
                592,
                703
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
