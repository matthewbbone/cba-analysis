        {
            "block_label": "text",
            "block_content": "By mutual agreement, the parties may extend the grievance filing and response timelines set forth in Article 7.2. Such agreements shall be confirmed in writing by the party requesting the extension.",
            "block_bbox": [
                318,
                197,
