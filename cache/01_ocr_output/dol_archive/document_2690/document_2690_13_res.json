        },
        {
            "block_label": "paragraph_title",
            "block_content": "d. Representation and Advice of Counsel",
            "block_bbox": [
                246,
                303,
                699,
                332
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
