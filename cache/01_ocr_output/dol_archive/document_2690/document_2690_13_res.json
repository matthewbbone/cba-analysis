            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "e. Non-Retribution",
            "block_bbox": [
                246,
                545,
                474,
                571
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
