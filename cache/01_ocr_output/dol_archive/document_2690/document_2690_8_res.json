                ],
                [
                    246.0,
                    1052.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. A \"complainant\" is the party alleging a complaint.",
            "block_bbox": [
                246,
                1073,
                808,
                1104
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    246.0,
                    1073.0
                ],
                [
                    808.0,
                    1073.0
                ],
                [
                    808.0,
