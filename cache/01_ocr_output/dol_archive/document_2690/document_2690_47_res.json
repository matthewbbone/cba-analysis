                [
                    782.0,
                    494.0
                ],
                [
                    245.0,
                    494.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. A unit member shall fully and completely disclose to the president, or designee, all inventions which the unit member develops or discovers while a unit member, together with an outline of the project and the conditions under which it was done.",
            "block_bbox": [
                318,
                517,
                1044,
                631
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    318.0,
                    517.0
                ],
                [
                    1044.0,
                    517.0
                ],
                [
                    1044.0,
                    631.0
                ],
                [
                    318.0,
                    631.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The president, or designee, shall conduct an investigation which shall assess the respective equities of the unit member and the University in the invention and determine its importance and the extent to which the University should be involved in its protection, development and promotion.",
            "block_bbox": [
                316,
                650,
                1043,
                793
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    316.0,
                    650.0
                ],
                [
                    1043.0,
                    650.0
                ],
                [
                    1043.0,
                    793.0
                ],
                [
                    316.0,
                    793.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. If the University disclaims to assert its interest or rights in the invention, the president, or designee, shall inform the unit member within one hundred and twenty (120) days of the unit member's disclosure to the president, or designee.",
            "block_bbox": [
                317,
                812,
                1040,
                926
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
