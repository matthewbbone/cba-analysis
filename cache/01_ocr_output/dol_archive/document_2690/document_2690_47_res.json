                ],
                [
                    390.0,
                    445.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "b. Disclosure of all Inventions/University Review",
            "block_bbox": [
                245,
                464,
                782,
                494
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    245.0,
