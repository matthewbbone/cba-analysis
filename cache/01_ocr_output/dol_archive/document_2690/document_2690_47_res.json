        },
        {
            "block_label": "text",
            "block_content": "An invention which is made using University support is the property of the University and the unit member shall share in the net proceeds therefrom according to Article 14.4(d). The unit member shall not commit any act which would tend to defeat the University's interest in the matter and shall take any necessary steps to protect such interest.",
            "block_bbox": [
                390,
                276,
                1025,
                445
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
