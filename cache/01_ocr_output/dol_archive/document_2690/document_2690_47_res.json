                    317.0,
                    926.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. The University and the unit member shall execute a written statement reflecting the distribution of net proceeds set forth in Article 14.4(d).",
            "block_bbox": [
                317,
                947,
                1007,
                1032
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
