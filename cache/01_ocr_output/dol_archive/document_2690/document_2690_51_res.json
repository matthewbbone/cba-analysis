        {
            "block_label": "text",
            "block_content": "In the year of promotion in rank, a unit member shall receive a ten percent (10%) increase in current base salary, in addition to all other base salary adjustments. The increase in base salary shall be effective the first full pay period after July 1, following the unit member's promotion. Any violations of the express provisions of Article 15.4.1 will be subject to the grievance process.",
            "block_bbox": [
                246,
                196,
