                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "11.3 Implementation of Disciplinary Action",
            "block_bbox": [
                176,
                990,
                715,
                1022
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
