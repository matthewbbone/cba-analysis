        {
            "block_label": "paragraph_title",
            "block_content": "11.1 Just Cause",
            "block_bbox": [
                176,
                280,
                387,
                311
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
