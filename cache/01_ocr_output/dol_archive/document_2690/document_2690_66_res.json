            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "d. Military Leave",
            "block_bbox": [
                246,
                947,
                472,
                978
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
