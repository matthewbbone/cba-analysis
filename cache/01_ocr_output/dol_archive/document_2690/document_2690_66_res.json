    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "c. Jury Duty",
            "block_bbox": [
                246,
                146,
                424,
                175
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    246.0,
