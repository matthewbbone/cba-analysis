                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Unit members who shall be employed by the University for the following academic year and who are not employed by the University during the summer shall have graduate and/or undergraduate course credit hour charges (tuition) waived up to twelve (12) credits per summer within the twelve (12) credit per year limitation.",
            "block_bbox": [
                245,
