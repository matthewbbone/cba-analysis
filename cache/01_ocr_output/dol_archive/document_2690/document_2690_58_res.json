        {
            "block_label": "text",
            "block_content": "Unit members shall be provided reimbursement accounts, tax sheltered annuities, and the University pension on the same basis as provided in the University plan in place on the date of this Agreement. All disputes between a unit member and the University regarding eligibility for and ongoing participation in such matters shall be subject solely to the dispute resolution procedures provided in the plan documents.",
            "block_bbox": [
                245,
