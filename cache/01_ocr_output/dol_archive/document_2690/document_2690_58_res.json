        },
        {
            "block_label": "text",
            "block_content": "a. Unit members shall have graduate and/or undergraduate course credit hours charges (tuition) waived up to six (6) credits per semester for a maximum of twelve (12) credits per academic year, beginning with the fall semester and ending with the summer term.",
            "block_bbox": [
                244,
                780,
                1048,
                894
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
