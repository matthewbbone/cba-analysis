        },
        {
            "block_label": "text",
            "block_content": "There shall be three (3) categories of appointment applicable to unit members: appointment with tenure, tenure track appointment, and non-tenure track term appointment. The appointment of unit members to these categories shall be at the sole discretion of the University. The initial appointment of unit members to one of these categories shall not be subject to the dispute resolution processes provided in this Agreement.",
            "block_bbox": [
                244,
                384,
                1042,
                553
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
