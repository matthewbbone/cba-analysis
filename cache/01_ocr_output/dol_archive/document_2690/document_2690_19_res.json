        {
            "block_label": "text",
            "block_content": "A non-tenure track term appointment may be made at less than 100 percent, but no less than 51 percent, of FTE status, for a specific length of time. Performance expectations shall be specified by individual appointment letters.",
            "block_bbox": [
                244,
                277,
                1042,
                362
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
