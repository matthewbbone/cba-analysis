        },
        {
            "block_label": "text",
            "block_content": "The titles of instructor, lecturer, assistant professor, associate professor, and professor may be used to denote rank of non-tenure track unit members. In addition, qualified titles of rank, as specified below, may be used.",
            "block_bbox": [
                245,
                789,
                986,
                876
            ],
            "block_id": 5,
