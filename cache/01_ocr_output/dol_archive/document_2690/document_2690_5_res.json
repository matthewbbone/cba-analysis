            "block_label": "paragraph_title",
            "block_content": "ARTICLE 5\nUnited Academics Representatives and Privileges",
            "block_bbox": [
                282,
                197,
                941,
                285
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
