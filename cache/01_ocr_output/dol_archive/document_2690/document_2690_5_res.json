        },
        {
            "block_label": "text",
            "block_content": "5.1 Representatives of United Academics shall be permitted to conduct Union business in and at University facilities only if such activities do not interfere with the professional responsibilities of unit members or with University operations.",
            "block_bbox": [
                172,
                329,
                1038,
                415
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
