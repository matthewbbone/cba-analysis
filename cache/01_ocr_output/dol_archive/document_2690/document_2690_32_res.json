            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Within the second year, regardless of contract extensions, the unit member shall be notified no later than November 15, for appointments based on the academic year, or six (6) months prior to the end of the base appointment for appointments based on an alternative nine (9) month period.",
            "block_bbox": [
                245,
                1117,
