        {
            "block_label": "text",
            "block_content": "13.1.1 Workload is defined as the activities a unit member shall be required to perform to meet the requirements of a contract.",
            "block_bbox": [
                176,
                334,
                1025,
                392
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
