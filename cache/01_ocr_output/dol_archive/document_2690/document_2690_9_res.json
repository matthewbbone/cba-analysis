        {
            "block_label": "text",
            "block_content": "The grievant or United Academics must notify the responsible administrator of the grievance and must attempt an informal resolution with the administrator. Notification that there is a grievance must be given in writing to the administrator within 30 days after the event giving rise to the grievance, or within 30 days after the grievant became aware, or reasonably should have been aware of the event giving rise to the grievance, whichever is later.",
            "block_bbox": [
                245,
                920,
                1040,
                1091
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
