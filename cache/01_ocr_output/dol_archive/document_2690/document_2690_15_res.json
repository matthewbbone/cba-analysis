        },
        {
            "block_label": "paragraph_title",
            "block_content": "d. Recommendation of the Appeals Board",
            "block_bbox": [
                246,
                1220,
                708,
                1249
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
