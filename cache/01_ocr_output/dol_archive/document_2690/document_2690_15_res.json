                ],
                [
                    317.0,
                    1069.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "c. Procedures of the Appeals Board",
            "block_bbox": [
                246,
                1090,
                646,
                1118
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
