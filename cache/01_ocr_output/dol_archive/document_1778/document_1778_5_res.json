        {
            "block_label": "text",
            "block_content": "14.01 The Employer hereby agrees not to discharge any employee after the expiration of said sixty (60) day trial period except for just cause. A ninety (90) day trial period in the case of a Department Heads.",
            "block_bbox": [
                28,
                340,
                523,
                390
            ],
