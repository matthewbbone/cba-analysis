                    543.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "15.02 In no event shall the closing of any store or stores covered or operated by the Employer result in the loss in seniority rights of any of the employees affected thereby.",
            "block_bbox": [
                28,
                544,
                524,
                593
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
