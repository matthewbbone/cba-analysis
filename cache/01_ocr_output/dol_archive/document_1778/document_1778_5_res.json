        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 13 TRIAL PERIOD",
            "block_bbox": [
                158,
                133,
                397,
                152
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
