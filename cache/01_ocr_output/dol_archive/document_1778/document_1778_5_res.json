        {
            "block_label": "text",
            "block_content": "16.01 There shall be no cessation of work, no strikes, no picketing, no slowdowns, no sit-downs or other interference with the operation of the Employer's business sanctioned by the Union, nor shall the Employer lockout for any cause whatsoever during the term of this Agreement.",
            "block_bbox": [
                28,
                693,
                524,
                760
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
            "block_polygon_points": [
