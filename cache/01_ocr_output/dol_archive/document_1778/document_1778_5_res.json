        {
            "block_label": "text",
            "block_content": "15.01 Seniority rights of employees for purposes of layoff shall prevail on a company wide departmental basis.",
            "block_bbox": [
                28,
                509,
                523,
                543
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
