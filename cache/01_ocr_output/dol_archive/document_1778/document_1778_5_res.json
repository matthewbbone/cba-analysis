                [
                    28.0,
                    593.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "15.03 Employees who are laid off for lack of work, shall have recall rights with prior seniority in the reverse order of their layoff, for a period not to exceed twelve (12) months or the length of their employment, whichever is less.",
            "block_bbox": [
                28,
                593,
                524,
                660
            ],
            "block_id": 12,
            "block_order": 13,
