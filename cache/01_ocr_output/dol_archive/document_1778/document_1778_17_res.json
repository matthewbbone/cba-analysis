        },
        {
            "block_label": "text",
            "block_content": "31.06 Regular part time employees hired on or before June 18, 1994 shall receive twenty (20) hours paid sick leave in each sick leave year.",
            "block_bbox": [
                28,
                418,
                522,
                452
            ],
            "block_id": 4,
