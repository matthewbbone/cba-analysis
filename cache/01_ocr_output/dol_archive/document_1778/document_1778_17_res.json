                    336.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "31.05 At the end of each sick leave year, full time employees shall be paid for any sick days which were earned and not taken, provided they are in the employ of the Employer in a full time capacity on the last day of each sick leave year. Such unused sick leave must be paid within thirty (30) days after the completion of the sick leave year.",
            "block_bbox": [
                28,
                337,
                522,
                418
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
