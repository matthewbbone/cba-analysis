                    25.0,
                    216.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- All current employees who volunteer will have the opportunity with two weeks written notice to the Company to switch back to a five day, eight hour schedule.",
            "block_bbox": [
                45,
                217,
                512,
                266
            ],
            "block_id": 4,
            "block_order": 5,
