                    521.0,
                    133.0
                ],
                [
                    26.0,
                    133.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Only volunteers from the current employee complement will be selected.",
            "block_bbox": [
                45,
                134,
                494,
                165
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
