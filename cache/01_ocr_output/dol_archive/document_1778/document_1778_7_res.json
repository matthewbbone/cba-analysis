        {
            "block_label": "text",
            "block_content": "19.14 Effective June 23, 2002, all Full-time employees will be offered the opportunity of working four days a week, at ten hours of paid straight-time per day. This provision is subject to the following conditions;",
            "block_bbox": [
                26,
                83,
                521,
                133
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
