                [
                    45.0,
                    165.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The need will be determined by the Company on a store-wide basis and if all volunteers cannot be accommodated, seniority among the volunteers will be the company's basis of selection.",
            "block_bbox": [
                25,
                166,
                521,
                216
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
