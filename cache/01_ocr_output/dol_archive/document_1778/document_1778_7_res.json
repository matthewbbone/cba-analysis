        },
        {
            "block_label": "text",
            "block_content": "For Full-time employees hired after June 23, 2002 they will be informed that the four day, ten hour straight-time shift will be permanent unless changed by the Company, at which time they will be offered a five day, eight hour shift.",
            "block_bbox": [
                24,
                266,
