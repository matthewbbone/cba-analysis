            ]
        },
        {
            "block_label": "text",
            "block_content": "After One (1) year employment One (1) personal holiday, (Does not apply to a reclassified employee who was hired on or before June 18, 1994 who is receiving President's Day or a personal day in lieu of President's Day.)",
