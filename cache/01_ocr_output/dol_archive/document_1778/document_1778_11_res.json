        {
            "block_label": "text",
            "block_content": "23.22 To qualify for such holiday pay, regular part time employees shall work their regularly scheduled day before and their regularly scheduled day following the holiday and shall also work all their scheduled hours during the week in which the holiday occurs, unless such absence is excused by the Employer, which excuse shall not be unreasonably denied.",
            "block_bbox": [
                21,
                616,
                518,
                698
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
