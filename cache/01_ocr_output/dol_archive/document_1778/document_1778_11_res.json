        },
        {
            "block_label": "text",
            "block_content": "23.21 Part time employees who work on any of the above named legal holidays (as described in Article 23.17 or 23.19 above) shall receive in addition to the holiday pay to which they are entitled, time and one-half their regular hourly rate for all hours worked on said holidays.",
            "block_bbox": [
                21,
                550,
                517,
                616
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
