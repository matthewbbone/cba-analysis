        },
        {
            "block_label": "text",
            "block_content": "19.10 Full time employees hired after June 22, 1985, scheduled to work four (4) or more days per week on any shift starting between 12:00 P.M. and 3:00 P.M., shall receive premium pay of One ($1.00) Dollar per day.",
            "block_bbox": [
