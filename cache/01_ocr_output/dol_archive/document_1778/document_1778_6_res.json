            ]
        },
        {
            "block_label": "text",
            "block_content": "19.09 An additional seventy five (75¢) cents per hour shall be paid to all department heads and regular clerks working after regular store closing hours of 6:00 P.M., 6:30 P.M. or 7:00 P.M. except when such hours are overtime hours as herein before defined.",
            "block_bbox": [
                37,
                826,
                535,
                892
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
