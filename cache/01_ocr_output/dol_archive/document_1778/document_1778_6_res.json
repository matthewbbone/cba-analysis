                [
                    37.0,
                    326.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 19 HOURS AND LENGTH OF WORK WEEK",
            "block_bbox": [
                39,
                334,
                505,
                353
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    39.0,
                    334.0
                ],
                [
                    504.0,
                    334.0
                ],
                [
                    504.0,
                    352.0
                ],
                [
                    39.0,
                    352.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.01 Except for regular part time employees covered by the terms of this Agreement, forty (40) hours shall constitute the regular work week for all employees covered therein, and it shall consist of five (5) eight (8) hour days.",
            "block_bbox": [
                37,
                359,
                535,
                425
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    37.0,
                    359.0
                ],
                [
                    535.0,
                    359.0
                ],
                [
                    535.0,
                    425.0
                ],
                [
                    37.0,
                    425.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.02 In a week in which a full day holiday occurs, thirty two (32) hours in four (4) eight (8) hour days shall constitute the regular work week for all such employees.",
            "block_bbox": [
                38,
                425,
                533,
                475
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    38.0,
                    425.0
                ],
                [
                    533.0,
                    425.0
                ],
                [
                    533.0,
                    475.0
                ],
                [
                    38.0,
                    475.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.03 If a store is open for business on New Year's Day, Easter Sunday, Thanksgiving Day or Christmas Day, the store shall be staffed on a voluntary basis and then by inverse order of seniority.",
            "block_bbox": [
                38,
                476,
                534,
                526
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    38.0,
                    476.0
                ],
                [
                    534.0,
                    476.0
                ],
                [
                    534.0,
                    526.0
                ],
                [
                    38.0,
                    526.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.04 When stores are closed on holidays, the entire night crew shall be given the option of working on the holiday at straight time as part of the work week. In that event the night crew shall not be scheduled to work on the night of the holiday.",
            "block_bbox": [
                38,
                526,
                535,
                591
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    38.0,
                    526.0
                ],
                [
                    535.0,
                    526.0
                ],
                [
                    535.0,
                    591.0
                ],
                [
                    38.0,
                    591.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.05 Working hours shall be consecutive except for a meal period of sixty (60) minutes which shall be provided during such hours as the Employer may designate and which shall not count in computing the number of hours worked.",
            "block_bbox": [
                38,
                592,
                535,
                658
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    38.0,
                    592.0
                ],
                [
                    535.0,
                    592.0
                ],
                [
                    535.0,
                    658.0
                ],
                [
                    38.0,
                    658.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.06 All employees shall receive a fifteen (15) minute rest period for each four (4) hours worked which shall be included in computing the number of hours worked.",
            "block_bbox": [
                38,
                659,
                534,
                708
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    38.0,
                    659.0
                ],
                [
                    534.0,
                    659.0
                ],
                [
                    534.0,
                    708.0
                ],
                [
                    38.0,
                    708.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.07 All employees regularly working more than thirty two (32) hours per week shall be considered full time employees and all employees regularly working thirty (32) two hours or less per week shall be considered part time employees.",
            "block_bbox": [
                37,
                710,
                534,
                775
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    37.0,
                    710.0
                ],
                [
                    534.0,
                    710.0
                ],
                [
                    534.0,
                    775.0
                ],
                [
                    37.0,
                    775.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.08 All part time employees working thirty two (32) hours or less per week shall be included in the bargaining unit and covered by the terms and conditions therein.",
            "block_bbox": [
                37,
                776,
                534,
                825
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
