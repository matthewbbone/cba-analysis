            "block_label": "text",
            "block_content": "(B) In the event that the matter is not adjusted in the above step, a representative of the Employer charged with the responsibility for labor relations and a duly designated representative of the Union shall attempt to adjust the same.",
            "block_bbox": [
                38,
                33,
                536,
                98
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
