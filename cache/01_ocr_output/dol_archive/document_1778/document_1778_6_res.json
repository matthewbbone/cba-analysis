        {
            "block_label": "text",
            "block_content": "19.11 Part time employees appointed to full time, after June 22, 1985, scheduled to work four (4) or more days per week on any shift starting between 12:00 P.M. and 3:00 P.M., and shall receive premium pay of One ($1.00) Dollar per day.",
            "block_bbox": [
