        {
            "block_label": "text",
            "block_content": "Employer will be responsible for all hospital, medical, surgical and other benefits that would have been paid for by the Fund had the Employer's delinquency in making contributions not resulted in the cancellation of any rights on the part of the Employer's covered employees to receive any such benefits.",
            "block_bbox": [
