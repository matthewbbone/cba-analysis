        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 35 DEATH IN FAMILY",
            "block_bbox": [
                147,
                33,
                414,
                51
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
