                    32.0,
                    418.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "36.03 The Union will provide the Employer with a list of the names of its authorized business representatives and shop stewards and will keep said list current.",
            "block_bbox": [
                32,
                419,
                527,
                468
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
