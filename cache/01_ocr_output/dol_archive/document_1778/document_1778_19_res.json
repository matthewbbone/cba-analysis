            ]
        },
        {
            "block_label": "text",
            "block_content": "36.04 The Employer will, with adequate notice, arrange for one (1) full time shop steward from each store to have the same scheduled day off once each year, with eight (8) hours pay, for the purpose of attending the Union's shop steward seminar.",
            "block_bbox": [
                32,
                469,
