                ],
                [
                    32.0,
                    317.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 36 SHOP STEWARDS",
            "block_bbox": [
                149,
                326,
                411,
                344
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
