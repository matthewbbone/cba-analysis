                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "36.01 The Employer recognizes the right of the Union to have one (1) full time shop steward and one (1) part time shop steward in each store.",
            "block_bbox": [
                33,
                350,
                525,
                384
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    33.0,
                    350.0
                ],
                [
                    525.0,
                    350.0
                ],
                [
                    525.0,
                    384.0
                ],
                [
                    33.0,
                    384.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "36.02 The full time shop steward in each store shall not be transferred without prior notice to and discussion with the Union.",
            "block_bbox": [
                32,
                385,
                526,
                418
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
