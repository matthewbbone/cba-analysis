        {
            "block_label": "text",
            "block_content": "Effective December 29, 2013, a store doing a volume of $275,000 per week or less the Company will not be required to appoint an Assistant Manager or a Department Head. However, any clerk assigned to be in charge of the department, will receive a twenty ($20.00) Dollar per week premium.",
            "block_bbox": [
                30,
                657,
                525,
                740
            ],
            "block_id": 11,
            "block_order": 4,
            "group_id": 11,
            "block_polygon_points": [
                [
