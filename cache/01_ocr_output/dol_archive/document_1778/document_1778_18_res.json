        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 32 LEAVE OF ABSENCE",
            "block_bbox": [
                132,
                94,
                417,
                112
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    132.0,
                    94.0
                ],
                [
                    416.0,
                    94.0
                ],
                [
                    416.0,
                    111.0
                ],
                [
                    132.0,
                    111.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "32.01 Full time and part time employees with more than one (1) years' service, requesting a leave of absence for reasons other than the employee's illness or injury, shall be given said leave of absence by the Employer at its sole discretion, provided, however, that granting of such leave of absence shall not be unreasonably withheld.",
            "block_bbox": [
                26,
                118,
                524,
                201
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    26.0,
                    118.0
                ],
                [
                    524.0,
                    118.0
                ],
                [
                    524.0,
                    201.0
                ],
                [
                    26.0,
                    201.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "32.02 All requests for leave of absence shall be in writing and must be submitted to the Employer at least two (2) weeks in advance of the date of the commencement of the requested leave of absence. The employee shall be notified in writing with a copy to the Union if the requested leave is approved or denied. The notice shall specify the time limit placed on an approved leave of absence. Advance written request for leave of absence is not necessary in case of family emergency. However, subsequent written notice and request shall be given as soon as is reasonably possible.",
            "block_bbox": [
                26,
                201,
                525,
                330
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    26.0,
                    201.0
                ],
                [
                    525.0,
                    201.0
                ],
                [
                    525.0,
                    330.0
                ],
                [
                    26.0,
                    330.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "32.03 A leave of absence granted by the Employer shall not constitute a break in seniority, but if the leave of absence exceeds three (3) months in duration, then service for purposes of progression increases, vacations and all other benefits required to be paid under this Agreement shall not be earned during said leaves.",
            "block_bbox": [
                26,
                331,
                525,
                412
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    26.0,
                    331.0
                ],
                [
                    525.0,
                    331.0
                ],
                [
                    525.0,
                    412.0
                ],
                [
                    26.0,
                    412.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "32.04 The Employer shall make all contributions to all funds required by this Agreement for any month in which the employee performs any work for which monthly contributions are required before taking the leave and after returning, but not for the months when no covered work is performed. However, in the case of an employee's illness or injury, contributions for Health and Welfare and Pension shall be made for a period not to exceed three (3) months while the employee is absent from work. An employee on an approved leave of absence will be automatically terminated if:",
            "block_bbox": [
                25,
                412,
                525,
                559
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    25.0,
                    412.0
                ],
                [
                    525.0,
                    412.0
                ],
                [
                    525.0,
                    559.0
                ],
                [
                    25.0,
                    559.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(A) The employee does not return to work when the leave of absence expires, unless the Employer has agreed to an extension.",
            "block_bbox": [
                26,
                559,
                524,
                594
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    26.0,
                    559.0
                ],
                [
                    524.0,
                    559.0
                ],
                [
                    524.0,
                    594.0
                ],
                [
                    26.0,
                    594.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(B) The employee works elsewhere while on leave without express permission in writing from the Employer to be so employed.",
            "block_bbox": [
                26,
                595,
                524,
                628
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    26.0,
                    595.0
                ],
                [
                    524.0,
                    595.0
                ],
                [
                    524.0,
                    628.0
                ],
                [
                    26.0,
                    628.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "32.05 An employee absent from work due to illness or injury shall retain his seniority for a period not to exceed twelve (12) months.",
            "block_bbox": [
                26,
                628,
                523,
                663
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
