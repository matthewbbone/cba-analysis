        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 34 JURY DUTY",
            "block_bbox": [
                168,
                857,
                380,
                875
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
