        {
            "block_label": "text",
            "block_content": "In a court case known as N.L.R.B. Vs. Weingarten, the U.S. Supreme Court ruled you have the right to have your Union Representative present when you are interviewed by your employer, if you reasonably believe the interview may lead to disciplinary action.",
            "block_bbox": [
                31,
                342,
                528,
                464
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    31.0,
                    342.0
                ],
                [
                    528.0,
                    342.0
                ],
                [
                    528.0,
                    464.0
                ],
                [
                    31.0,
                    464.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "YOUR RIGHTS UNDER WEINGARTEN ARE:",
            "block_bbox": [
                31,
                485,
                528,
                511
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    31.0,
                    485.0
                ],
                [
                    528.0,
                    485.0
                ],
                [
                    528.0,
                    511.0
                ],
                [
                    31.0,
                    511.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. You have the right to request the presence of a Union Representative during any investigatory interview you reasonably believe might result in disciplinary action.",
            "block_bbox": [
                32,
                523,
                528,
                620
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    32.0,
                    523.0
                ],
                [
                    528.0,
                    523.0
                ],
                [
                    528.0,
                    620.0
                ],
                [
                    32.0,
                    620.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. You have the right not to be interviewed until your Union Representative is present.",
            "block_bbox": [
                32,
                630,
                527,
                680
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    32.0,
                    630.0
                ],
                [
                    527.0,
                    630.0
                ],
                [
                    527.0,
                    680.0
                ],
                [
                    32.0,
                    680.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Your Union Representative may assist you during the interview to organize and explain your facts.",
            "block_bbox": [
                32,
                690,
                527,
                740
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
