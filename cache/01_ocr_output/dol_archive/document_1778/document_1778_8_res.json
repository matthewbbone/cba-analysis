                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.20 Effective September 26, 2010 Part time employees, who work for eight (8) consecutive weeks in excess of thirty two (32) regular hours, shall be reclassified to full-time. This shall not apply from May 1st to September 30th.",
            "block_bbox": [
                42,
                242,
                539,
                308
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    42.0,
                    242.0
                ],
                [
                    539.0,
                    242.0
                ],
                [
                    539.0,
                    308.0
                ],
                [
                    42.0,
                    308.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "19.21 A part time employee who works on the sixth (6th) day in a work week, excluding Sunday, will be paid time and one half for work on that day, provided the employee has worked all of their scheduled hours on the other five (5) days of such week.",
            "block_bbox": [
                42,
                309,
                538,
                374
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    42.0,
                    309.0
                ],
