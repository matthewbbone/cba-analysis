            ]
        },
        {
            "block_label": "text",
            "block_content": "19.23 A part time bookkeeper where designated by the Employer, shall receive fifteen (15¢) cents per hour above their regular clerk's rate of pay. No more than one part time bookkeeper shall be designated in a store.",
            "block_bbox": [
                41,
