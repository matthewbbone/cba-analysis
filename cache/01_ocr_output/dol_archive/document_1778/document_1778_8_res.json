                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "21.02 A full time employee who is reclassified to part time shall receive payment for earned and unused full time vacation. The employee shall receive, after one (1) year, part time vacation benefits based upon the employee's total length of service.",
            "block_bbox": [
                40,
                951,
                537,
                1017
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
