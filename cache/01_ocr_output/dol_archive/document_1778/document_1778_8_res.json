        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 20 INDUSTRY EXPERIENCE",
            "block_bbox": [
                128,
                646,
                449,
                664
            ],
            "block_id": 6,
            "block_order": 7,
