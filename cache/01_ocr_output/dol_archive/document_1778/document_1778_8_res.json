        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 21 RECLASSIFICATION",
            "block_bbox": [
                147,
                763,
                432,
                781
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
