                    166.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) All employees hired in March, April, May, June, July, and August shall receive their increases in December.",
            "block_bbox": [
                33,
                166,
                526,
                199
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
