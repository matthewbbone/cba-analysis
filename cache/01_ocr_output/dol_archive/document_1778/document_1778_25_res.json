        {
            "block_label": "text",
            "block_content": "(2) An employee, newly assigned to the night crew on or after June 19, 1988, shall receive a night shift premium of Ten Percent (10%) of the employee's straight time rate of pay to a maximum of fifty ($50.00) Dollars per week which shall be in addition to the employee's straight time rate of pay.",
            "block_bbox": [
