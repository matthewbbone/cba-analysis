        },
        {
            "block_label": "text",
            "block_content": "(J) A full time Dairy and Frozen Food Department Head Clerk in stores which consistently have a gross volume of $275,000 and over per week, when designated by the Employer, shall receive twenty ($20) dollars per week in addition to the base weekly wage.",
            "block_bbox": [
                32,
                282,
                526,
                348
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
