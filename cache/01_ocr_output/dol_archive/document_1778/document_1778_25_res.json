        {
            "block_label": "text",
            "block_content": "(H) Employees hired on or after December 29, 2013 shall receive their Increases on a semi-annual basis in accordance with the following schedule:",
            "block_bbox": [
                35,
                80,
                526,
                132
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
