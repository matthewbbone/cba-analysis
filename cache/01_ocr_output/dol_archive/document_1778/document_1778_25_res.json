                    35.0,
                    132.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) All employees hired in September, October, November, December, January, and February shall receive their increases in May.",
            "block_bbox": [
                34,
                132,
                526,
                166
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
