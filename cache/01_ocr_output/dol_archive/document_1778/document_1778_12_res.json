        {
            "block_label": "text",
            "block_content": "24.04 Full time employees shall be given a reasonable opportunity to work on Sundays and Holidays on a rotating basis when the store is open for business.",
            "block_bbox": [
                40,
                35,
                537,
                84
            ],
            "block_id": 0,
