                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "25.05 Part-time Employees hired prior to 9-26-10 shall receive time and one half (1½) times their regular rate for all hours worked on Sunday.",
            "block_bbox": [
                39,
                738,
                534,
                771
