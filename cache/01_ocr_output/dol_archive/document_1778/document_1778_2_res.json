                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 2 UNION SHOP",
            "block_bbox": [
                178,
                463,
                395,
                482
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    178.0,
