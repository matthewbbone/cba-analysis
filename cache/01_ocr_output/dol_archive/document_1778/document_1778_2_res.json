        {
            "block_label": "text",
            "block_content": "AGREEMENT, made this 30th day of April, 2014, by and between UNITED FOOD AND COMMERCIAL WORKERS UNION, LOCAL 1500 chartered by the UNITED FOOD AND COMMERCIAL WORKERS INTERNATIONAL UNION, AFL-CIO, CLC, having its principal place of business at 425 Merrick Avenue, Westbury, New York 11590, hereinafter referred to as the \"UNION\" and DAN'S SUPREME SUPERMARKETS INC., and any new or acquired corporation operating retail food stores, having its principal place of business at 474 Fulton Avenue, Hempstead, New York 11550, hereinafter collectively referred to as the \"EMPLOYER\".",
            "block_bbox": [
                40,
                31,
                537,
                192
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
