        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 1 UNION RECOGNITION",
            "block_bbox": [
                140,
                251,
                435,
                269
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
