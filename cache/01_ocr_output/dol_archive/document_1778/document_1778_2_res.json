            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 3 CHECK OFF",
            "block_bbox": [
                184,
                776,
                388,
                795
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
