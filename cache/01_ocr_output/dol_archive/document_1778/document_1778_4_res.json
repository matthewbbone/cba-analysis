                    536.0,
                    710.0
                ],
                [
                    38.0,
                    710.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9.03 In no event shall such military service performed in any form whatsoever be construed against the employee, or deprive them of any of their rights and prerogatives as an employee or member of the Union.",
