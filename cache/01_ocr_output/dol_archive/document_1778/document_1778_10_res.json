                [
                    39.0,
                    442.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "23.11 Full time employees who work on any of the above named legal holidays (as described in Article 23.01 or 23.02 above 23.06) shall receive in addition to the holiday pay to which they are entitled, time and one-half their regular hourly rate for all hours worked on said holidays.",
            "block_bbox": [
                39,
                442,
                536,
                508
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    39.0,
                    442.0
