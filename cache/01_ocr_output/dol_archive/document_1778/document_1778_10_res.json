                [
                    39.0,
                    559.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "23.13 In order to qualify for holiday pay, full time employees shall work their regularly scheduled day before and their regularly scheduled day following the holiday and shall also work all their scheduled hours during the week in which the holiday occurs unless such absence is excused by the Employer, which excuse shall not be unreasonably denied.",
            "block_bbox": [
                39,
                560,
                536,
                641
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
