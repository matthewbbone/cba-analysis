                    39.0,
                    508.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "23.12 Personal holidays for all employees are to be assigned and taken, otherwise they shall be paid for at the end of each contract year, providing that the employee is in the employ of the Employer at such time.",
            "block_bbox": [
                39,
                509,
                536,
                559
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    39.0,
                    509.0
                ],
