    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "After completing three (3) years of employment, three (3) additional personal holidays. (Employees hired on or before June 15, 1991 who are reclassified will continue to have President's Day as a holiday and those Employees hired on or after June 16, 1991 who are reclassified will continue to receive a personal holiday in lieu of President's Day.) Upon the completion of three (3) years employment these employees shall be entitled to only two (2) additional personal holidays.",
            "block_bbox": [
                40,
                31,
                536,
                144
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    40.0,
                    31.0
                ],
                [
                    536.0,
                    31.0
                ],
                [
                    536.0,
                    144.0
