            ]
        },
        {
            "block_label": "text",
            "block_content": "Effective 03/01/14, the weekly pre-tax contribution to the Fund for any such associate who has not opted out of the Special Part-Time plan is fifteen ($15.00) dollars. Such employee contributions shall be deducted by the Employer and transmitted to the Fund with the Employer contribution in accordance with the procedures established by the Welfare Fund Board of Trustees. There shall be no new entrants into the Special Part-Time Plan after 02/28/14.",
            "block_bbox": [
                36,
                663,
                536,
                777
            ],
            "block_id": 8,
