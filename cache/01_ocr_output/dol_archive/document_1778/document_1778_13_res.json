    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "26.06 When an employee is entitled to more than two (2) weeks' vacation, the Employer reserves the right to grant or assign such additional week or weeks at a time or times, different from the first two (2) weeks.",
            "block_bbox": [
                20,
                29,
                515,
                79
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    20.0,
                    29.0
                ],
                [
                    515.0,
                    29.0
                ],
                [
                    515.0,
                    79.0
                ],
                [
                    20.0,
                    79.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "26.07 All full time employees laid off by the Employer before the completion of their six (6) month qualifying period, shall receive pro rata vacation for each month of continuous service rendered, except those employees who have been discharged for good cause and/or have voluntarily left their employment.",
            "block_bbox": [
                20,
                79,
                516,
                161
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    20.0,
                    79.0
                ],
                [
                    516.0,
                    79.0
                ],
                [
                    516.0,
                    161.0
                ],
                [
                    20.0,
                    161.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "26.08 Full time employees resigning in good standing and who have given proper notice, who have earned vacation weeks which have not been taken, will be paid for where six month intervals have passed when entitled to up to two (2) weeks' vacation by virtue of length of service; four month intervals have passed when entitled to up to three (3) weeks' vacation by virtue of length of service; and three month intervals have passed when entitled to up to four (4) weeks' vacation by virtue of length of service. Payment will include only those full weeks that have thus been earned.",
            "block_bbox": [
                20,
                161,
                517,
                306
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    20.0,
                    161.0
                ],
                [
                    517.0,
                    161.0
                ],
                [
                    517.0,
                    306.0
                ],
                [
                    20.0,
                    306.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "26.09 Regular part time employees who have been continuously employed by the employer for twelve (12) consecutive months or more and who have worked 800 hours or more during the year, shall be entitled to vacation as follows:",
            "block_bbox": [
                20,
                306,
                515,
                372
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    20.0,
                    306.0
                ],
                [
                    515.0,
                    306.0
                ],
                [
                    515.0,
                    372.0
                ],
                [
                    20.0,
                    372.0
                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Length of</td><td>Hired Before</td><td>Hired on or</td><td>Hired on or</td></tr><tr><td>Service</td><td>6/19/94</td><td>After 6/19/94</td><td>After 9/24/06</td></tr><tr><td>One (1) year:</td><td>25 hours</td><td>20 hours</td><td>20 hours</td></tr><tr><td>Two (2) years:</td><td>50 hours</td><td>40 hours</td><td>20 hours</td></tr><tr><td>Three (3) years:</td><td>50 hours</td><td>40 hours</td><td>40 hours</td></tr><tr><td>Seven (7) years:</td><td>75 hours</td><td>75 hours</td><td>75 hours</td></tr><tr><td>Ten (10) years:</td><td>100 hours</td><td>100 hours</td><td>100 hours</td></tr><tr><td>Twenty-five years:</td><td>125 hours</td><td>125 hours</td><td>125 hours</td></tr></table>",
            "block_bbox": [
                21,
                372,
                511,
                517
            ],
            "block_id": 4,
            "block_order": null,
            "group_id": 4,
            "block_polygon_points": [
