        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 4 CONTINUANCE OF EMPLOYMENT",
            "block_bbox": [
                76,
                319,
                473,
                338
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
