                    27.0,
                    986.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5.07 Temporary transfers shall be limited to a period not to exceed thirty (30) days.",
            "block_bbox": [
                28,
                987,
                524,
                1020
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
