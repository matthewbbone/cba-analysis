        },
        {
            "block_label": "text",
            "block_content": "4.01 All employees are to be continued in their present employment during the term of this Agreement subject to the terms and conditions of employment in this Agreement and the Schedule attached hereto and made part hereof.",
            "block_bbox": [
                27,
                344,
                522,
                411
            ],
            "block_id": 4,
            "block_order": 5,
