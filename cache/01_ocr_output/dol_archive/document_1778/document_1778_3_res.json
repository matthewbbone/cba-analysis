        {
            "block_label": "text",
            "block_content": "3.05 The Employer agrees to deduct weekly from the wages of those employees who have given proper authorization, such amounts due the Teachers Federal Credit Union and remit same to said Credit Union on a weekly basis. The Employer's obligation to remit to the Teachers Federal Credit Union shall be limited to the amounts, which it actually deducts from the employees' wage.",
            "block_bbox": [
                26,
                147,
                524,
                244
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
