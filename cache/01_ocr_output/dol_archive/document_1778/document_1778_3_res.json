                    26.0,
                    920.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5.06 Those full time employees who are transferred more than fifteen (15) miles from their assigned stores, in cases of temporary transfers, shall receive three ($3.00) dollars per day travel pay. Tolls paid in the case of temporary transfers shall be reimbursed regardless of mileage.",
            "block_bbox": [
                27,
                921,
                524,
                986
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
