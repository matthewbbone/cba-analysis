        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 5 EMPLOYER'S PREROGATIVES",
            "block_bbox": [
                95,
                420,
                456,
                438
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    95.0,
                    420.0
                ],
                [
                    453.0,
                    420.0
                ],
                [
                    453.0,
