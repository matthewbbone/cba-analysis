                    32.0,
                    452.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Time lost by sickness, accident or pregnancy up to six months shall not be deducted in determining the eligibility of an employee's vacation time, seniority and wages.",
            "block_bbox": [
                102,
                469,
                504,
                560
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
