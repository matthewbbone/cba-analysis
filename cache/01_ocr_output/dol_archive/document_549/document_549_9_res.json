        {
            "block_label": "text",
            "block_content": "Part time employees may be granted a leave of absence if they have completed one (1) year or more of continuous service.",
            "block_bbox": [
                34,
                114,
                506,
                180
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    34.0,
                    114.0
                ],
                [
                    506.0,
                    114.0
                ],
                [
                    506.0,
                    180.0
                ],
                [
                    34.0,
                    180.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This leave of absence shall be without pay or benefits, shall not exceed three (3) months duration, and shall be subject to the same prerequisites, except for C-2-b, as described herein, applicable to leaves of absence for full time employees.",
            "block_bbox": [
                33,
                193,
                506,
                305
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
