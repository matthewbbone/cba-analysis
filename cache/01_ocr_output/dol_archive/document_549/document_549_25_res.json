        {
            "block_label": "text",
            "block_content": "Failure to report a work-related injury promptly is the primary reason for a workers' compensation claim to be denied. Report all work injuries immediately, and make sure a First Report of Injury is filled out.",
            "block_bbox": [
                563,
                162,
                789,
                235
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
