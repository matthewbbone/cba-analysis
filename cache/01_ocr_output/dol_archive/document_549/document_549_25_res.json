        {
            "block_label": "paragraph_title",
            "block_content": "Billing for Medical Treatment",
            "block_bbox": [
                798,
                341,
                967,
                358
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
            "block_polygon_points": [
