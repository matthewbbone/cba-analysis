        {
            "block_label": "text",
            "block_content": "Even if you have your own attending physician, the employer or their insurer can require you to submit for examination by another physician. They cannot make you accept treatment from another doctor against your wishes.",
            "block_bbox": [
                796,
                245,
                1024,
