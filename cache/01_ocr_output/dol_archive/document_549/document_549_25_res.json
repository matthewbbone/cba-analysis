        },
        {
            "block_label": "paragraph_title",
            "block_content": "Medical Treatment/Therapy",
            "block_bbox": [
                798,
                481,
                958,
                497
            ],
            "block_id": 16,
            "block_order": 17,
            "group_id": 16,
