                    137.0,
                    554.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. For purposes of this Agreement, the word \"grievance\" shall be deemed to mean only a dispute between the Company and the Union and the Employees it represents concerning the meaning or application of this Agreement.\nB. An effort shall be made to dispose of all grievances as soon as reasonably possible pursuant to the following provisions:",
            "block_bbox": [
                18,
                571,
                495,
                724
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    18.0,
                    571.0
                ],
                [
                    495.0,
                    571.0
                ],
                [
                    495.0,
                    724.0
                ],
                [
                    18.0,
                    724.0
                ]
            ]
        },
        {
            "block_label": "number",
            "block_content": "32",
            "block_bbox": [
                244,
                761,
                272,
                779
            ],
            "block_id": 8,
            "block_order": null,
            "group_id": 8,
            "block_polygon_points": [
                [
                    244.0,
