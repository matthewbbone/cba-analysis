        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 28\nGRIEVANCE-ARBITRATION",
            "block_bbox": [
                137,
                511,
                378,
                554
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    137.0,
