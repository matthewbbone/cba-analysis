        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 27\nDISCHARGE/SUSPENSION",
            "block_bbox": [
                139,
                284,
                378,
                326
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
