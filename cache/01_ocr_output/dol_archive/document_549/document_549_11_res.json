        },
        {
            "block_label": "text",
            "block_content": "Effective March 7, 2004, the pension contribution for part-time employees is $20.00 per month. Effective April 1, 2005, the pension contribution for part-time employees is $21.51 per month. Effective April 1, 2006, the pension contribution for part-time employees is $23.02 per month.",
            "block_bbox": [
