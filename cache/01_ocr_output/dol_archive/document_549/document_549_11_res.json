        {
            "block_label": "text",
            "block_content": "A. The Company will provide a pension plan for service prior to June 1, 2001. Eligible full-time employees will be entitled to a maximum of 40 years of credited service under the plan. The basic benefit will be $32.00 per month.",
            "block_bbox": [
                28,
                74,
                501,
                188
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
