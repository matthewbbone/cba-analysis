                    35.0,
                    599.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company shall send to the Local a copy of the employee's authorization card within fourteen (14) days of the date of hire or rehire.",
            "block_bbox": [
                36,
                618,
                508,
