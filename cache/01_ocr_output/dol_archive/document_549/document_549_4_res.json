        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 5\nNO STRIKES, NO LOCKOUTS, PICKET LINE",
            "block_bbox": [
                608,
                293,
                991,
                337
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    608.0,
                    293.0
                ],
                [
                    991.0,
                    293.0
                ],
                [
                    991.0,
                    337.0
                ],
                [
                    608.0,
                    337.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "It is mutually agreed by the parties to this Agreement that there shall be no strike, stoppage of work, slowdown, walk-out, boycott, handbilling, picketing, refusal to handle any product or other interruptions or interference with the Company's operations (whether primary, sympathetic or otherwise) by the Union, nor shall there be any lockout by the Company during the life of this Agreement.",
            "block_bbox": [
                564,
                356,
                1034,
                512
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    564.0,
                    356.0
                ],
                [
                    1034.0,
                    356.0
                ],
                [
                    1034.0,
                    512.0
                ],
                [
                    564.0,
                    512.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event of a threat of, preparation for, or the actuality of any unauthorized strike, stoppage of work, slowdown, walk-out, boycott, handbilling, picketing, refusal to handle any product or other interruptions or interference with the Company's operations, the Union and all of its officials will take every reasonable action to prevent and to stop such proceedings by any of its members.",
            "block_bbox": [
                564,
                529,
                1034,
                685
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
