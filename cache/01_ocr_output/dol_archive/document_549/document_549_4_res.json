    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Laws of the Local Union. In the event that any employee fails to comply with Items (a) and (b) provided for in this Article, or fails to tender the initiation fee and periodic dues uniformly required as a condition for membership, the Union may notify the Company in writing, requesting the dismissal of such employee. Said employee shall be discharged by the Company within seven (7) days of receipt of said notice, provided that such discharge shall be permitted by law.",
            "block_bbox": [
                37,
                35,
                510,
                232
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
