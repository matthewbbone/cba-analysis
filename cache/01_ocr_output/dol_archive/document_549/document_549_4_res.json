            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 4\nCHECK-OFF",
            "block_bbox": [
                219,
                251,
                329,
                295
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    219.0,
                    251.0
                ],
                [
                    329.0,
                    251.0
                ],
                [
                    329.0,
                    295.0
                ],
                [
                    219.0,
                    295.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company agrees to deduct Union dues (weekly), including arrears, from the wages of employees covered by this Agreement who are members of the Union and who, individually and voluntarily, sign an authorization card for such deduction. It is further agreed that such deduction shall include the deduction of initiation fees.",
            "block_bbox": [
                36,
                316,
                510,
                448
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    36.0,
                    316.0
                ],
                [
                    510.0,
                    316.0
                ],
                [
                    510.0,
                    448.0
                ],
                [
                    36.0,
                    448.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Current weekly dues remittance will be remitted with the check-off list to the Local Union.",
            "block_bbox": [
                36,
                466,
                509,
                513
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    36.0,
                    466.0
                ],
                [
                    509.0,
                    466.0
                ],
                [
                    509.0,
                    513.0
                ],
                [
                    36.0,
                    513.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Dues in arrears will be deducted following the receipt by the Company of a list of arrears from the respective Union Local.",
            "block_bbox": [
                35,
                531,
                509,
                599
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
