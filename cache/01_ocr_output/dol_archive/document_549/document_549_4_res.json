        {
            "block_label": "text",
            "block_content": "The Company agrees to payroll deduction of uniform Assessments requested by the Union when proper authorization is provided. There shall be no more than two (2) such assessments per calendar year.",
            "block_bbox": [
                564,
                32,
                1033,
                123
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
