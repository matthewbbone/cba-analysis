        },
        {
            "block_label": "text",
            "block_content": "For purposes of this Agreement, a part-time employee is defined as one who is normally scheduled to work less than thirty-five (35) hours weekly. If a part-time employee works more than 36 hours in a week, he/she shall be paid a premium of 30% for all hours worked in excess of 36 hours.",
            "block_bbox": [
                48,
                331,
                521,
                463
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    48.0,
                    331.0
                ],
                [
                    521.0,
                    331.0
                ],
                [
                    521.0,
                    463.0
                ],
                [
                    48.0,
                    463.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Part-timers shall work no less than fifteen (15) hours a week, Monday through Saturday, except during a holiday week. Part-timers shall work no less than ten (10) hours a week during holiday weeks, except during weeks with Saturday holidays, when there shall be no minimum hours.",
            "block_bbox": [
                47,
                478,
                519,
                611
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
