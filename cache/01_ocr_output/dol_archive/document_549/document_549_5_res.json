        {
            "block_label": "table",
            "block_content": "<table><tr><td>Completed Service as of Jan 1st</td><td>Vacation Time</td></tr><tr><td>Less than 1 year</td><td>None</td></tr><tr><td>1 Year</td><td>1 Week</td></tr><tr><td>2 Years</td><td>2 Weeks</td></tr><tr><td>5 Years</td><td>3 Weeks</td></tr><tr><td>12 Years</td><td>4 Weeks</td></tr><tr><td>20 Years</td><td>5 Weeks</td></tr></table>",
