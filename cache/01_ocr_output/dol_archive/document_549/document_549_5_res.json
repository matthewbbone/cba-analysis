        {
            "block_label": "text",
            "block_content": "(a) The Union and such officers or officials take every reasonable, prompt, and positive measure, within their power, to prevent and stop such unauthorized strike, stoppages of work, slowdowns, walk-outs, boycotts, hand-billing, picketing, refusal to handle any product or other interruptions or interferences with the Company's operations.",
            "block_bbox": [
