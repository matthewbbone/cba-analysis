            "block_label": "text",
            "block_content": "B. Part-time Employee Eligibility. A part-time employee with less than five (5) years service as of the anniversary date of employment must have accumulated at least 250 hours (including vacation, holidays, and illness) during the year prior to his/her anniversary to be eligible.",
            "block_bbox": [
                33,
                33,
                506,
                165
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
