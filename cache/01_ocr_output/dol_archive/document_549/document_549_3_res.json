        {
            "block_label": "text",
            "block_content": "The Company may secure new employees from any source. When new employees are to be hired in the Company's stores, the Union shall have equal opportunity with all other sources to refer and recommend applicants for employment. Persons referred by the Union shall be given equal opportunity for employment with all other applicants.",
            "block_bbox": [
                559,
