            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) All present employees who are members of the Union on the execution date of this Agreement shall remain members of the Union in good standing as a condition of employment.",
            "block_bbox": [
                632,
                269,
                1028,
                381
