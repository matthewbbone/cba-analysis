        {
            "block_label": "text",
            "block_content": "B. Regular full time employees with six (6) months service or over who leave the Company's employ to join the Armed Forces of the United States for a period of not less than two (2) years and as defined in the Selective",
            "block_bbox": [
                562,
                121,
                1032,
                212
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
                [
                    562.0,
