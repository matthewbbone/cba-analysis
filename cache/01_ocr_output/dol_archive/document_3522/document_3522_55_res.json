                    1083.0,
                    653.0
                ],
                [
                    1083.0,
                    794.0
                ],
                [
                    130.0,
                    794.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Requests to be excused to attend Union sponsored training will be submitted, with justification to the Supervisor and HRO-Labor Relations, as soon as possible but no later than fourteen (14) days prior to the training session.",
            "block_bbox": [
                129,
                820,
                1045,
                905
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
