        {
            "block_label": "paragraph_title",
            "block_content": "Section 22.1 – Joint Employer-Union Sponsored Training Sessions",
            "block_bbox": [
                134,
                230,
                908,
                259
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
