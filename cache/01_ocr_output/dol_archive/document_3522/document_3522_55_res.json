        {
            "block_label": "paragraph_title",
            "block_content": "Section 22.2 - Labor/Management Relations (LMR) Training",
            "block_bbox": [
                131,
                597,
                817,
                628
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    131.0,
