                [
                    132.0,
                    508.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Training conducted will be on Official Time.",
            "block_bbox": [
                132,
                534,
                626,
                563
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
