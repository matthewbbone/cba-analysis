        {
            "block_label": "text",
            "block_content": "2. The Employer may place an Employee in an administrative leave status when he or she is prevented from reporting to duty, or is dismissed by the Employer prior to the end of the duty day, because hazardous weather or other emergency conditions make it unsafe or impractical for the employee to either travel from their home to the worksite, remain at the worksite, or travel from the worksite to their home.",
            "block_bbox": [
                132,
                188,
                1080,
                329
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
