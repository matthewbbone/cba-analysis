            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 9.8 – Funeral Leave (Title 5 U.S.C. Section 6326)",
            "block_bbox": [
                133,
                576,
                782,
                605
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
