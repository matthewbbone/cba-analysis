                    133.0,
                    605.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. An Employee is entitled up to three (3) administrative leave days (consecutive or non-consecutive workdays) to make arrangements for, or to attend, the funeral or memorial service for a qualifying family member who died as a result of wounds, disease, or injury incurred while serving in a combat zone (IAW 26 USC § 112) as a member of the Armed Forces of the United States. The Employee shall furnish justification for scheduling nonconsecutive days.",
            "block_bbox": [
                130,
                629,
                1037,
                798
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
