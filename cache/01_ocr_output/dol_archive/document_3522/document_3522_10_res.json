                [
                    1078.0,
                    432.0
                ],
                [
                    1078.0,
                    490.0
                ],
                [
                    134.0,
                    490.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Negotiations for a new agreement will commence no earlier than one calendar year (365 days) nor later than ninety (90) days prior to the termination of the current agreement.",
            "block_bbox": [
                133,
                515,
                1055,
                601
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
