        },
        {
            "block_label": "text",
            "block_content": "Should either party wish to change the agreement prior to automatic renewal provisions in Section 3.5 of this Article, the following shall apply:",
            "block_bbox": [
                134,
                432,
                1078,
                490
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
