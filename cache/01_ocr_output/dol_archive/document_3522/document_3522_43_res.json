        {
            "block_label": "text",
            "block_content": "2. Within 10 days after receipt of the Arbitrator's decision, the Parties to the arbitration will notify one another in writing of whether or not they are filing for an exception with the Federal Labor Relations Authority (FLRA) in accordance with council procedures. An exception to the Arbitrator's decision must be filed within thirty (30) days from the date the award is served on the parties.",
            "block_bbox": [
                132,
                631,
                1065,
                773
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
