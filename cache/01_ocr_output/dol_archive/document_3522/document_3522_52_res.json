            "block_label": "paragraph_title",
            "block_content": "Section 19.1 - General",
            "block_bbox": [
                136,
                260,
                397,
                288
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
