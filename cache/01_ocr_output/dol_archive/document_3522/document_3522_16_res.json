        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 6 - UNION RIGHTS",
            "block_bbox": [
                136,
                224,
                466,
                254
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
