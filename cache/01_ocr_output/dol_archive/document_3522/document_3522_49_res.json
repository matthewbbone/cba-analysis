                    133.0,
                    463.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The Employer shall provide the best possible work environment for the safety and well-being of the Employee.",
            "block_bbox": [
                132,
                489,
                1049,
                547
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
