        {
            "block_label": "text",
            "block_content": "1. The Agency has as its objective the elimination or reduction to the lowest level possible of all hazards, physical hardships, and working conditions of an unusually severe nature.",
            "block_bbox": [
                133,
                378,
                1022,
                463
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
