            ]
        },
        {
            "block_label": "text",
            "block_content": "3. When an Agency’s action does not overcome the unusually severe nature of the hazards, physical hardships, or working conditions, an environmental differential determination may be authorized.",
            "block_bbox": [
                132,
                573,
                1031,
                658
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
