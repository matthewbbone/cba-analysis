                    770.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. In order to deal with situations occurring after regular duty hours, Employees may be placed on either a stand-by or on-call duty status.",
            "block_bbox": [
                131,
                796,
                1079,
                854
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    131.0,
                    796.0
                ],
                [
                    1079.0,
                    796.0
                ],
                [
                    1079.0,
                    854.0
                ],
                [
                    131.0,
                    854.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The Agency may establish routine prohibitions regarding alcohol consumption, and may restrict the use of specific prescription or over the counter drugs, in order to ensure Employees maintain the ability to perform work.",
            "block_bbox": [
                130,
                879,
                1080,
                966
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
