            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.5 – Call Back",
            "block_bbox": [
                134,
                379,
                407,
                408
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    134.0,
                    379.0
                ],
                [
                    407.0,
                    379.0
                ],
                [
                    407.0,
                    408.0
                ],
                [
                    134.0,
                    408.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Call Back is the act or an instance of requesting that an off-duty Employee report to work and perform his duties on a day when work was not scheduled, or after their regular work day is over.",
            "block_bbox": [
                133,
                435,
                1066,
                521
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    133.0,
                    435.0
                ],
                [
                    1066.0,
                    435.0
                ],
                [
                    1066.0,
                    521.0
                ],
                [
                    133.0,
                    521.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Unscheduled call back work entitles an Employee to at least two (2) hours of compensatory time.",
            "block_bbox": [
                132,
                545,
                995,
                603
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    132.0,
