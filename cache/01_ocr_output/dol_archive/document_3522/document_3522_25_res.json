        {
            "block_label": "text",
            "block_content": "8. It is agreed that when overtime follows a regular work shift, the Employee will be given an optional fifteen (15) minute paid break at the beginning of the overtime period and, at the Employees request, a thirty (30) minute non-paid meal break to begin no later than two (2) hours after the overtime period begins if the overtime period is expected to last greater than four (4) hours.",
            "block_bbox": [
                133,
                213,
                1066,
                355
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
