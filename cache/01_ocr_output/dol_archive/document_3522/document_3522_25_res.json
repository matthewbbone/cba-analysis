            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The Agency shall make every reasonable effort to provide an Employee advance notice specifying the beginning and ending period that he or she is on standby status.",
            "block_bbox": [
                129,
                1185,
                1069,
