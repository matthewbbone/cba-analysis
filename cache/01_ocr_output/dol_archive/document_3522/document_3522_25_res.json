        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.6 - Stand-By and On-Call Duty Compensation",
            "block_bbox": [
                131,
                740,
                774,
                770
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
