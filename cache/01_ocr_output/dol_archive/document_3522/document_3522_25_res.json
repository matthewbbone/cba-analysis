            "block_label": "text",
            "block_content": "7. Employees scheduled to work overtime will be notified of any cancellation of the overtime requirement as soon as possible.",
            "block_bbox": [
                134,
                130,
                1030,
                188
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
