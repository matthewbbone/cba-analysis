        {
            "block_label": "text",
            "block_content": "1. The MIARNG performance appraisal system will incorporate all the requirements of NGB Regulatory Guidance TPR 430 and local TPLs as promulgated.",
            "block_bbox": [
                132,
                300,
                1067,
                359
            ],
