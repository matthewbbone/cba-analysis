        {
            "block_label": "paragraph_title",
            "block_content": "Section 13.1 - General",
            "block_bbox": [
                136,
                206,
                395,
                233
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    136.0,
                    206.0
                ],
                [
                    395.0,
                    206.0
                ],
                [
                    395.0,
