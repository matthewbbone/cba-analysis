                [
                    133.0,
                    216.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. As an exception to the normally scheduled lunch period, and pursuant to the Supervisor's right to assign work, if a Supervisor assigns an Employee work during the normally scheduled lunch period, and it is not possible for the lunch period to be rescheduled during that duty day, the Employee shall be entitled to compensation for the missed period of lunch IAW applicable law or regulation.",
            "block_bbox": [
                132,
                241,
                1067,
                383
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    132.0,
                    241.0
                ],
                [
                    1067.0,
                    241.0
                ],
                [
                    1067.0,
                    383.0
                ],
                [
                    132.0,
                    383.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Fifteen (15) minute paid rest periods or breaks, during the first half and the second half of an Employee's shift, will be granted. Rest breaks will not be taken in conjunction with the lunch period, or at the beginning or end of the work day. The fifteen (15) minute rest period is considered off-duty for purposes of internal Union business.",
            "block_bbox": [
                132,
                407,
                1070,
                521
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
