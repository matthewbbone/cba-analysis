    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "2. When Employer mission requirements do not allow an Employee time off for lunch, the Employee will be compensated for his/her missed lunch period with an alternate lunch period equal to the time missed.",
            "block_bbox": [
                133,
                129,
                1059,
                216
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    133.0,
