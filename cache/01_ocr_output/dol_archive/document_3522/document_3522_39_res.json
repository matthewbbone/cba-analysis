                [
                    131.0,
                    1131.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 12.2 – Exclusions",
            "block_bbox": [
                132,
                1164,
                436,
                1192
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
