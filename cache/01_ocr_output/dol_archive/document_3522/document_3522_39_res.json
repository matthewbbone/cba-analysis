                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Exclusions will be in accordance with 5 USC §7121 and actions covered by statutory appeals procedure in 32 USC §709(f). Matters not expressly excluded under this section may be grieved under this procedure.",
            "block_bbox": [
                131,
                1219,
                1078,
                1306
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
