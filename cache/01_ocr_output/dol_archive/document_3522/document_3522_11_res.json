                ],
                [
                    133.0,
                    518.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. to determine the mission, budget, organization, number of Employees, and internal security practices of the agency",
            "block_bbox": [
                132,
                544,
                1004,
                602
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
