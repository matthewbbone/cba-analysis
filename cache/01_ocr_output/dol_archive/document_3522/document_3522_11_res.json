                ],
                [
                    132.0,
                    602.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. to hire, assign, direct, layoff, and retain Employees in the agency, or to suspend, remove, reduce in grade or pay, or take other disciplinary action against such Employees;",
            "block_bbox": [
                131,
                627,
                1063,
                713
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
