        {
            "block_label": "text",
            "block_content": "1. It is agreed that internal Union business such as, soliciting membership, collecting dues, campaigning for office, electing officers, attending Union meetings, and posting or distributing Union literature, will be conducted during the non-duty hours of the Employee involved.",
            "block_bbox": [
                129,
                1016,
                1081,
                1131
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
