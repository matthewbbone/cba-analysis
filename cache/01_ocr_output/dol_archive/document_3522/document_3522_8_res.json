                    170.0,
                    494.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. To promote programs designated to assist the Employer and Employees in achieving their acknowledged and recognized objectives.",
            "block_bbox": [
                134,
                519,
                1016,
                577
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
