                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. It is intended that this agreement will meet the following purposes:",
            "block_bbox": [
                134,
                407,
                873,
                438
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
