                ],
                [
                    134.0,
                    438.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. To promote fair, equitable and reasonable working conditions.",
            "block_bbox": [
                170,
                464,
                874,
                494
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
