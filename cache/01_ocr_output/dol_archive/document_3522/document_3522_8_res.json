                    577.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. To promote the highest degree of efficiency, morale, and responsibility to the MIARNG.",
            "block_bbox": [
                133,
                603,
                1035,
                659
            ],
            "block_id": 6,
            "block_order": 7,
