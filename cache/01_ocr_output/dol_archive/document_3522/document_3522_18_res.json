        {
            "block_label": "paragraph_title",
            "block_content": "Section 6.3 - Negotiation Procedures",
            "block_bbox": [
                135,
                130,
                563,
                159
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    135.0,
                    130.0
                ],
                [
                    563.0,
                    130.0
                ],
                [
                    563.0,
                    159.0
