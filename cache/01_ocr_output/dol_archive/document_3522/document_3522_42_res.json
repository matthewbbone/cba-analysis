                ],
                [
                    127.0,
                    1302.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Union representatives involved shall attend on official time.",
            "block_bbox": [
                127,
                1326,
                800,
                1356
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
