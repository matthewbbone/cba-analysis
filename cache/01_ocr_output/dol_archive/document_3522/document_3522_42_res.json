            "block_label": "paragraph_title",
            "block_content": "Section 12.7 – Right to Information",
            "block_bbox": [
                135,
                134,
                541,
                162
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
