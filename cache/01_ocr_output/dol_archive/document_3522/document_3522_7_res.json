        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 1.2 – Excluded Positions",
            "block_bbox": [
                135,
                377,
                530,
                406
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
