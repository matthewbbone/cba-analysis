        {
            "block_label": "text",
            "block_content": "LIUNA is the exclusive representative for all dual status (DS) and non-dual status (NDS) General Schedule (GS) and Federal Wage Survey (WG/WL) Technicians of the MIARNG bargaining unit.",
            "block_bbox": [
                134,
                266,
