                    907.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. At any time, by mutual consent, for the purpose of amending or providing supplements to this agreement.",
            "block_bbox": [
                131,
                932,
                996,
                991
            ],
            "block_id": 10,
