        {
            "block_label": "text",
            "block_content": "1. This agreement may be subject to amendments or supplements during the agreement duration under one of the following procedures:",
            "block_bbox": [
                132,
                765,
                968,
                824
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
