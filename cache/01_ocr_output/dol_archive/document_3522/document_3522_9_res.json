                    132.0,
                    824.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Either party may initiate negotiations at the midpoint of this agreement, after service of notice, no later than sixty (60) days prior to the midpoint of this agreement.",
            "block_bbox": [
                132,
                849,
                1049,
                907
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
