        {
            "block_label": "paragraph_title",
            "block_content": "Section 15.2 - Priority Placement",
            "block_bbox": [
                134,
                366,
                517,
                394
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
