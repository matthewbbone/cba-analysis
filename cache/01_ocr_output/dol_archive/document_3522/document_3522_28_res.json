                ],
                [
                    131.0,
                    852.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Remoteness of the medical facility.",
            "block_bbox": [
                167,
                878,
                585,
                909
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
