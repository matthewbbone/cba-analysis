        },
        {
            "block_label": "text",
            "block_content": "1. The Employer and the Union will ensure:",
            "block_bbox": [
                136,
                295,
                611,
                324
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    136.0,
                    295.0
                ],
                [
                    611.0,
                    295.0
                ],
                [
                    611.0,
                    324.0
                ],
                [
                    136.0,
                    324.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Employees are fully aware of the provisions of this agreement.",
            "block_bbox": [
                170,
                351,
                878,
                381
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    170.0,
                    351.0
                ],
                [
                    878.0,
                    351.0
