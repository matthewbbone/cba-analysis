                [
                    170.0,
                    436.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Employees will receive educational sessions regarding the contents and applicability of the contract.",
            "block_bbox": [
                134,
                463,
                983,
                520
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
