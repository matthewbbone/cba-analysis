                    130.0,
                    1019.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. The Agency shall inform all Employees of their right to Union representation (Weingarten Right) IAW 5 USC § 7114(a)(2)(B):",
            "block_bbox": [
                129,
                1045,
                976,
                1104
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
