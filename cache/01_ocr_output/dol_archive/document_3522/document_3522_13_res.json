                [
                    878.0,
                    381.0
                ],
                [
                    170.0,
                    381.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. This agreement receives the widest possible dissemination.",
            "block_bbox": [
                170,
                406,
                848,
                436
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    170.0,
                    406.0
                ],
                [
                    848.0,
