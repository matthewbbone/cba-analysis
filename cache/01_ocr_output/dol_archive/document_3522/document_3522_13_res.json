            ]
        },
        {
            "block_label": "text",
            "block_content": "a. On an annual basis IAW 5 USC 7114(a)(3) electronically to the Employee's official email address.",
            "block_bbox": [
                130,
                1130,
                1082,
                1186
            ],
            "block_id": 12,
