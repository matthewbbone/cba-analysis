        {
            "block_label": "paragraph_title",
            "block_content": "Section 11.9 - Occupational Health and Safety Training",
            "block_bbox": [
                134,
                570,
                768,
                600
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
