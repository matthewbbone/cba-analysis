                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. A Supervisor will approve or disapprove properly submitted request for annual leave as soon as possible. If the request is disapproved, the reason will be entered on Block 8b of the OPM 71 and the Employee will be notified. The Supervisor will work with the affected Employee to reschedule the disapproved leave as necessary.",
            "block_bbox": [
                132,
                795,
                1075,
                910
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    132.0,
                    795.0
                ],
                [
                    1075.0,
                    795.0
                ],
