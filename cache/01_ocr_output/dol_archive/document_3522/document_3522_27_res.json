                    132.0,
                    910.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Annual leave requests for emergency reasons will be considered on an individual basis. Employee's will notify their Supervisor as soon as possible of the emergency situation stating the reason for the request and the approximate time they desire to be absent from work.",
            "block_bbox": [
                132,
                935,
                1061,
                1047
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
