        {
            "block_label": "text",
            "block_content": "1. Employee’s shall earn annual leave in accordance with applicable law, rule, and regulation.",
            "block_bbox": [
                134,
                712,
                1030,
                770
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
