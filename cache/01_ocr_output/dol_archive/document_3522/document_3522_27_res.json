        },
        {
            "block_label": "text",
            "block_content": "1. An Employee's request to take earned leave will normally be granted as requested, unless the Supervisor determines that the Employee's presence is required to meet mission requirements.",
            "block_bbox": [
                136,
                288,
                1064,
                374
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
