        },
        {
            "block_label": "text",
            "block_content": "3. No disciplinary or adverse action will be taken as a result of using EAP or Military One Source. This extends to an Employee who self-discloses a personal medical/behavioral condition to his Supervisor.",
            "block_bbox": [
