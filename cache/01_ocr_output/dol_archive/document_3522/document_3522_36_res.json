                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Subject to availability of funding, an Occupational Health Services and Preventive Medicine Program shall be established and maintained by the Employer, as provided for in 5 USC Chapter 79 and other applicable laws, rules and regulations.",
            "block_bbox": [
                134,
                322,
                1084,
                409
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
