                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The Parties agree that performing duties as a dual status (DS) technician requires wear of the uniform appropriate for the member's grade. Technicians will adhere to appropriate appearance standards, customs, and courtesies of the US Army.",
            "block_bbox": [
                135,
                338,
                1051,
                425
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    135.0,
