                    561.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. When on Official Time acting as a Union Representative.",
            "block_bbox": [
                170,
                588,
                820,
                616
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
