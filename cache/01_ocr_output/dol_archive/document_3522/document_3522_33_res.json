                    979.0,
                    449.0
                ],
                [
                    979.0,
                    505.0
                ],
                [
                    134.0,
                    505.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. During non-duty hours",
            "block_bbox": [
                171,
                533,
                454,
                561
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
