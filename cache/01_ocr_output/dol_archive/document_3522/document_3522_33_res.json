                    170.0,
                    616.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. While appearing as an aggrieved Employee or Union witness before a third party proceeding.",
            "block_bbox": [
                134,
                644,
                1079,
                701
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    134.0,
