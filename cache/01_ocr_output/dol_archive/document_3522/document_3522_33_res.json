                ],
                [
                    1051.0,
                    338.0
                ],
                [
                    1051.0,
                    425.0
                ],
                [
                    135.0,
                    425.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Employees are not required to wear the military uniform under the following situations:",
            "block_bbox": [
                134,
                449,
                979,
                505
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
