        {
            "block_label": "paragraph_title",
            "block_content": "Section 10.1 - Uniform Appearance, Customs and Courtesies",
            "block_bbox": [
                135,
                282,
                839,
                311
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
