        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 11.5 - Employees Free From Reprisals",
            "block_bbox": [
                134,
                402,
                672,
                432
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    134.0,
                    402.0
                ],
                [
                    672.0,
                    402.0
                ],
                [
                    672.0,
                    432.0
