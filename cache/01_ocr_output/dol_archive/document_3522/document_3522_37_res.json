                [
                    134.0,
                    432.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees who file a safety complaint or who request OSHA or MIOSHA to inspect a facility shall be free from reprisals, disciplinary action, or harassment.",
            "block_bbox": [
                134,
                462,
                1054,
                520
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
