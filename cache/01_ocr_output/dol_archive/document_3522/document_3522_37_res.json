            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 11.7 - Workers' Compensation Entitlements",
            "block_bbox": [
                133,
                843,
                733,
                872
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
