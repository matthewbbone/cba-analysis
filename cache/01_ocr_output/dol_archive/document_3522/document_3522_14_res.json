        },
        {
            "block_label": "text",
            "block_content": "2. The Parties recognize the Employee's right to voluntarily invest their money, donate to charity, or participate in activities, meetings or undertakings related to their employment.",
            "block_bbox": [
                133,
                213,
                1070,
                299
