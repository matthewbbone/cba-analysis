        {
            "block_label": "paragraph_title",
            "block_content": "Section 5.4 - Right to Organize and Discuss Matters of Concern",
            "block_bbox": [
                134,
                328,
                869,
                358
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    134.0,
                    328.0
                ],
                [
                    869.0,
