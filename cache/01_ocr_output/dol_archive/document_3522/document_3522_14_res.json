                    133.0,
                    636.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The Employee shall not be disciplined nor otherwise discriminated against based on having filed a formal grievance, complaint, or for giving testimony under Title VII Civil Service Reform Act 1978.",
            "block_bbox": [
                133,
                660,
                1076,
                747
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    133.0,
