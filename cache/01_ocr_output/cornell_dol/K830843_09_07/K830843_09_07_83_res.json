        {
            "block_label": "paragraph_title",
            "block_content": "F. ATTENDANCE STANDARDS",
            "block_bbox": [
                111,
                97,
                514,
                126
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
