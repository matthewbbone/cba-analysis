                ],
                [
                    180.0,
                    377.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. At least thirty (30) calendar days prior to the implementation of new or changed attendance standards, the University shall inform AFSCME.",
            "block_bbox": [
                181,
                400,
                1120,
                458
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
