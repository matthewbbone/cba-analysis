        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 37\nSTAFFING COMMITTEE",
            "block_bbox": [
                476,
                512,
                754,
                568
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    476.0,
