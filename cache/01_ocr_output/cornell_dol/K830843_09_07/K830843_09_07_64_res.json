        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 19\nMOVING EXPENSES",
            "block_bbox": [
                495,
                925,
                738,
                982
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
