        {
            "block_label": "text",
            "block_content": "A. Employees with multiple appointments will be covered by the provisions of this Agreement only for the time in which the employee is working in any appointment(s) which would place him/her in the unit, except that the time worked in per diem appointments is covered only by the provisions listed in Article 29 - Position Appointments, Section D.",
            "block_bbox": [
