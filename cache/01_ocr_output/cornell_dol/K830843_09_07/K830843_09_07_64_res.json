        {
            "block_label": "paragraph_title",
            "block_content": "E. PERQUISITES",
            "block_bbox": [
                112,
                675,
                353,
                706
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
