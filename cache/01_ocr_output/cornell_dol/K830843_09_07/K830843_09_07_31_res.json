        {
            "block_label": "paragraph_title",
            "block_content": "B. ASSIGNMENT",
            "block_bbox": [
                112,
                97,
                352,
                126
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
