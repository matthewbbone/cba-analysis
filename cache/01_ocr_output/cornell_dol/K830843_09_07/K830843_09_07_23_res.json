        },
        {
            "block_label": "text",
            "block_content": "Grievances of two (2) or more employees, as well as multiple grievances by or related to the same employee or which relate to the same incident, issue or course of conduct, may be consolidated for purposes of the Grievance Procedure by mutual agreement of the University and the Union.",
            "block_bbox": [
                181,
                153,
                1121,
                265
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
