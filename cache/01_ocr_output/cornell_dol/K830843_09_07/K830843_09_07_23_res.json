            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "D. INFORMAL REVIEW AND RESOLUTION",
            "block_bbox": [
                111,
                1118,
                643,
                1147
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    111.0,
                    1118.0
                ],
                [
                    643.0,
                    1118.0
                ],
                [
                    643.0,
                    1147.0
                ],
                [
                    111.0,
                    1147.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Before commencing the formal grievance procedure, an individual employee, or group of employees, with or without their representative, may first attempt to resolve the alleged grievance informally. When an employee or representative requests such a meeting, an Informal Review meeting shall be held with the immediate supervisor within 15 calendar days of the request. Informal resolution of grievances at the lowest possible level is an objective shared by the University and AFSCME. Informal attempts of settlement to resolve the grievance shall not extend time limits including the initial 30-day filing deadline.",
            "block_bbox": [
                180,
                1175,
                1122,
                1397
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
