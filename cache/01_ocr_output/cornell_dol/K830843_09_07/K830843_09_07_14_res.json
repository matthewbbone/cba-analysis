                    1120.0,
                    322.0
                ],
                [
                    253.0,
                    322.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Any period of time between the date a hearing was originally scheduled to be held and, due to a request from AFSCME to postpone or change the scheduled hearing, the rescheduled date of the hearing; and",
            "block_bbox": [
                253,
                346,
                1121,
                433
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
