                ],
                [
                    1121.0,
                    433.0
                ],
                [
                    253.0,
                    433.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Any period of time earlier than 30 days prior to the date of filing of the Step 1 written grievance.",
            "block_bbox": [
                253,
                484,
                1119,
                541
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
