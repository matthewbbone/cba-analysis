            "block_label": "text",
            "block_content": "14. With regard to a grievance appealed to arbitration for which in whole or in part the remedy sought involves back wages or other monetary reimbursement, the University shall not, in providing such remedy as a result of an arbitrator's award or a settlement, be required to make any payment of wages or any other monetary reimbursement for:",
            "block_bbox": [
                184,
                97,
                1122,
                239
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
