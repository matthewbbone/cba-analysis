                    239.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Any period of time during which an extension of time limits has been granted at the request of AFSCME;",
            "block_bbox": [
                253,
                263,
                1120,
                322
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
