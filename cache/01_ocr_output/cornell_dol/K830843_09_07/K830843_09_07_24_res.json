                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. The adjustment/resolution of grievances presented absent AFSCME representation shall be consistent with the terms of this Agreement.",
            "block_bbox": [
                252,
                594,
                1118,
                652
            ],
            "block_id": 4,
