            ]
        },
        {
            "block_label": "text",
            "block_content": "1. A non-probationary career employee who is indefinitely laid off shall be recalled in order of seniority to an active, vacant career position, provided:",
            "block_bbox": [
                183,
                595,
                1120,
                652
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    183.0,
                    595.0
                ],
                [
                    1120.0,
                    595.0
                ],
                [
                    1120.0,
                    652.0
                ],
                [
                    183.0,
                    652.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The active, vacant career position is in the same bargaining unit and same department/division as the position from which the employee was laid off; and",
            "block_bbox": [
                252,
                677,
                1121,
                761
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    252.0,
                    677.0
                ],
                [
                    1121.0,
                    677.0
                ],
                [
                    1121.0,
                    761.0
                ],
                [
                    252.0,
                    761.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The active, vacant career position is in the same class at the same or lesser percentage of time as the position from which the employee was laid off; or",
            "block_bbox": [
                253,
                787,
                1121,
                872
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    253.0,
                    787.0
                ],
                [
                    1121.0,
                    787.0
                ],
                [
                    1121.0,
                    872.0
                ],
                [
                    253.0,
                    872.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. The active, vacant career position is in a lower class at the same or lesser percentage of time than the position from which the employee was laid off, provided the employee previously held a career position in such lower class in the same department/division and bargaining unit.",
            "block_bbox": [
                252,
                898,
                1121,
                1012
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
