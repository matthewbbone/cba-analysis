                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Employees who are eligible for recall shall retain recall eligibility for three years from the effective date of layoff. An employee may exercise his/her rights to recall immediately after the employee receives written notification of layoff.",
            "block_bbox": [
                181,
                1146,
                1121,
                1233
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
