                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Employees recalled from layoff status to a new position who fail to perform satisfactorily may, at any time during the six (6) months following such return, be returned to layoff status with restoration of full recall rights. Previous time on layoff status prior to recall shall be deducted from an employee's period of eligibility.",
            "block_bbox": [
                179,
                1256,
                1123,
                1397
            ],
            "block_id": 10,
