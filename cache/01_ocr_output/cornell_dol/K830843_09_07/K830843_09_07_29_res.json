                ],
                [
                    1122.0,
                    511.0
                ],
                [
                    182.0,
                    511.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "N. PROOF OF SERVICE",
            "block_bbox": [
                111,
                533,
                430,
                563
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
