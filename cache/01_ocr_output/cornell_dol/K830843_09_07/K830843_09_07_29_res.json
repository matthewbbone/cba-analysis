                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Wherever Proof of Service is required in this Agreement, it shall be accomplished as follows:",
            "block_bbox": [
                182,
                585,
                1119,
                641
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    182.0,
                    585.0
                ],
                [
                    1119.0,
                    585.0
                ],
                [
                    1119.0,
                    641.0
                ],
                [
                    182.0,
                    641.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. When delivery is by U.S. mail, the person mailing shall complete and sign the prescribed and appropriate Proof of Service form which shall indicate that they have personally deposited with or presented to the U.S. Postal Service the document(s) being mailed.",
            "block_bbox": [
                183,
                668,
                1120,
                781
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
