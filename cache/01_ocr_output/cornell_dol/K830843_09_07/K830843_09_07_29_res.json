                [
                    182.0,
                    862.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The person presenting the document(s) completing and signing the prescribed and appropriate Proof of Service form which shall indicate they have delivered the document(s) by hand and to whom the document(s) were delivered; or",
            "block_bbox": [
                253,
                889,
                1120,
                1001
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
