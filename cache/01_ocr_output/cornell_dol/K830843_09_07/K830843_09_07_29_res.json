                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The person delivering the document(s) and the person accepting delivery of the document(s) shall mutually acknowledge the delivery/receipt by signing and dating the document(s) and a copy of the document(s) and each of them retaining one of the signed and dated document(s).",
