                ],
                [
                    183.0,
                    781.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. When delivery is through a personal presentation of a document(s), Proof of Service is accomplished and recorded by:",
            "block_bbox": [
                182,
                806,
                1120,
                862
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
