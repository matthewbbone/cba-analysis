        {
            "block_label": "paragraph_title",
            "block_content": "M. EXCLUSIVE PROCEDURE",
            "block_bbox": [
                112,
                290,
                489,
                319
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    112.0,
                    290.0
                ],
                [
                    489.0,
