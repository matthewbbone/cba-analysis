        {
            "block_label": "text",
            "block_content": "1. A non-probationary career employee may be granted a personal leave of absence without pay at the sole, non-grievable discretion of the University. Such leave shall not exceed six (6) calendar months.",
            "block_bbox": [
                182,
                1064,
                1119,
