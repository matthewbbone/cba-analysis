                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. An employee who has exhausted his/her original leave entitlement and who has been granted additional leave under another section of this Article, shall be reinstated in accordance with the provisions of the section under which the additional leave was granted.",
            "block_bbox": [
                252,
                786,
                1121,
