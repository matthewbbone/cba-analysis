        },
        {
            "block_label": "text",
            "block_content": "2. If an employee's request for a personal leave of absence without pay is denied, such denial may, upon the employee's written request, be reviewed by the Department/Division Head. The results of such a review shall not be subject to Article 9 - Grievance Procedure or Article 3 - Arbitration Procedure of this Agreement.",
            "block_bbox": [
                179,
