        {
            "block_label": "text",
            "block_content": "Protective work clothing and safety equipment, where required to be worn by the University, will be provided by the University.",
            "block_bbox": [
                255,
                208,
                1119,
                265
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
