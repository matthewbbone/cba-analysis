        {
            "block_label": "text",
            "block_content": "1. There shall be no duplication, pyramiding, or compounding of any premium wage payments.",
            "block_bbox": [
                185,
                1230,
                1118,
                1287
            ],
            "block_id": 9,
            "block_order": 10,
