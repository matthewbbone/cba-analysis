                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. Compensatory time off is scheduled by the University. The University may require employees to take compensatory time off. Employees may also request use of compensatory time; such requests shall be granted subject to the operational needs of the University. Use of compensatory time off requires prior approval in accordance with departmental policy.",
            "block_bbox": [
                181,
                235,
                1122,
                377
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    181.0,
                    235.0
                ],
