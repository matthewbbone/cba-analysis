        },
        {
            "block_label": "text",
            "block_content": "2. Nothing in this Article shall infringe upon, interfere with or diminish in any way the University's right to ensure adequate staffing and coverage to meet operational requirements and necessities in an efficient and orderly manner.",
            "block_bbox": [
                182,
