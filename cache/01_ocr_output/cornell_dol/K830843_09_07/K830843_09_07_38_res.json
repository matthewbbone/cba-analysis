                    377.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "K. CALL-BACK",
            "block_bbox": [
                112,
                401,
                335,
                430
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    112.0,
                    401.0
                ],
                [
                    335.0,
                    401.0
                ],
                [
                    335.0,
                    430.0
                ],
                [
                    112.0,
                    430.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When an employee is called back to work after completing a shift and leaving the premises, the employee shall be paid for the time actually worked upon return or a minimum of three (3) hours, whichever is greater. Call-back time, whether worked or not, is considered time worked for the purpose of calculating hours of overtime.",
            "block_bbox": [
                181,
                456,
                1121,
                570
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    181.0,
                    456.0
                ],
                [
                    1121.0,
                    456.0
                ],
                [
                    1121.0,
                    570.0
                ],
                [
                    181.0,
                    570.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "L. ON-CALL",
            "block_bbox": [
                111,
                593,
                300,
                624
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    111.0,
                    593.0
                ],
                [
                    300.0,
                    593.0
                ],
                [
                    300.0,
                    624.0
                ],
                [
                    111.0,
                    624.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "On-call is time during which an employee is required to be available for immediate return to work. An employee is not considered to be in on-call status unless he or she has previously been informed by the University of the assignment. The University retains the right to determine the need for and the assignment of on-call time. Eligibility for on-call pay and the on-call rates shall be as listed in Appendix A. Time spent in on-call status but not actually worked is not considered as time worked or time on pay status. Payment for on-call time shall be included as part of compensation when calculating the time and one-half overtime rate. An employee in on-call status is not eligible for minimum call-back payments.",
            "block_bbox": [
                181,
                650,
                1122,
                902
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    181.0,
                    650.0
                ],
                [
                    1122.0,
                    650.0
                ],
