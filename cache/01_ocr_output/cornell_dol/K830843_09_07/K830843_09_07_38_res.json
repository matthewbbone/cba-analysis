                    181.0,
                    902.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "M. TRAVEL TIME",
            "block_bbox": [
                112,
                924,
                352,
                955
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
