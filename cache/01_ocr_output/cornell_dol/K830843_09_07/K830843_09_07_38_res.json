        {
            "block_label": "text",
            "block_content": "4. Upon separation from employment, employees shall be paid for all accumulated overtime; accumulated overtime earned at the time and one-half rate shall be paid at the employee's current rate of pay or at the employee's average rate of pay for the last three years of employment, whichever is higher.",
            "block_bbox": [
                182,
                97,
                1121,
                212
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    182.0,
