        {
            "block_label": "paragraph_title",
            "block_content": "A. GENERAL PROVISIONS",
            "block_bbox": [
                111,
                180,
                465,
                209
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    111.0,
