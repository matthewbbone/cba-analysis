            ]
        },
        {
            "block_label": "text",
            "block_content": "b. In the event a non-probationary career employee does not receive the written evaluation, he/she may take the following action:",
            "block_bbox": [
                254,
                236,
                1120,
                293
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    254.0,
