            ]
        },
        {
            "block_label": "text",
            "block_content": "1) Within fifteen (15) calendar days of the date the written evaluation was due but not received, the employee shall make a written request for the evaluation to his/her immediate supervisor. The employee shall provide a copy of such request to the Department Head and to the campus Labor Relations Manager.",
            "block_bbox": [
                328,
                318,
                1121,
                460
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
