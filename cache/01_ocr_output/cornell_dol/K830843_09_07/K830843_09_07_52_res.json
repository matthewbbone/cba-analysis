        {
            "block_label": "paragraph_title",
            "block_content": "e. Parental Leave",
            "block_bbox": [
                255,
                485,
                506,
                513
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
