        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Grievances That Allege Sexual Harassment",
            "block_bbox": [
                183,
                1202,
                759,
                1231
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
