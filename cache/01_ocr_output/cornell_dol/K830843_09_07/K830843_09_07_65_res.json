        },
        {
            "block_label": "paragraph_title",
            "block_content": "B. GRIEVABILITY/ARBITRABILITY",
            "block_bbox": [
                111,
                786,
                552,
                816
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
