                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. During the paid reimbursed leave, the employee shall not be eligible for Workers Compensation benefits arising out of an injury occurring during the leave from the University. While on Union leave, University employees shall be covered by AFSCME's Workers Compensation carrier.",
            "block_bbox": [
                253,
                456,
                1121,
                596
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
