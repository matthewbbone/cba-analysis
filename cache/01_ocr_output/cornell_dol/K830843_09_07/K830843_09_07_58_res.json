                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) The maximum duration of a paid leave with Union reimbursement is three (3) years.",
            "block_bbox": [
                327,
                1422,
                1120,
                1479
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
