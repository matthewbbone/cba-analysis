                    1119.0,
                    348.0
                ],
                [
                    254.0,
                    348.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Any leave granted in accordance with this section shall not constitute a break in service.",
            "block_bbox": [
                254,
                374,
                1120,
                430
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    254.0,
                    374.0
                ],
                [
                    1120.0,
