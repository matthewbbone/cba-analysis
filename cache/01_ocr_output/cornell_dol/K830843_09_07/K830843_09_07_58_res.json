                    266.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. During the paid reimbursed leave the employee shall be eligible for increases in accordance with campus practices.",
            "block_bbox": [
                254,
                291,
                1119,
                348
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    254.0,
                    291.0
                ],
