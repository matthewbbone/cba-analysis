        {
            "block_label": "paragraph_title",
            "block_content": "1. Long Term Leave (30 days to 3 years)",
            "block_bbox": [
                184,
                926,
                693,
                957
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    184.0,
