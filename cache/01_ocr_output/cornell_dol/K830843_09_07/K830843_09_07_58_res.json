            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "3. Union Reimbursement",
            "block_bbox": [
                184,
                621,
                521,
                651
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
