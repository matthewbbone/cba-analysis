            ]
        },
        {
            "block_label": "text",
            "block_content": "The Union shall reimburse the University for all costs of employee compensation, including but not limited to, salary plus all benefits paid to the employee for the time the employee is on leave without loss of compensation (36%). The Union shall submit payment to the University within thirty (30) days of receipt of confirmation of payment to the employee. The University has the right to terminate the leave if the Union fails to provide timely payment.",
            "block_bbox": [
                253,
                677,
                1121,
                846
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
