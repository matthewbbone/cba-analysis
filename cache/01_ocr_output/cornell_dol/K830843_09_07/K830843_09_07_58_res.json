        {
            "block_label": "text",
            "block_content": "During the paid reimbursed leave, the employee shall be paid by the University, and shall continue to accrue service credit; and shall retain all benefits to which the employee was entitled prior to the start of the leave. Employee benefit contributions will continue to be deducted during the leave.",
            "block_bbox": [
                254,
                153,
                1120,
                266
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
