        },
        {
            "block_label": "paragraph_title",
            "block_content": "N. USE OF UNIVERSITY FACILITIES",
            "block_bbox": [
                111,
                758,
                569,
                788
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
