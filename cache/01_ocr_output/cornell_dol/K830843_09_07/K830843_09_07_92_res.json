        {
            "block_label": "paragraph_title",
            "block_content": "1. Grievability and Arbitrability",
            "block_bbox": [
                188,
                152,
                615,
                183
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
