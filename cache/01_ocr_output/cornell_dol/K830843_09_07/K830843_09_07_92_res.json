        {
            "block_label": "text",
            "block_content": "1. Shift differential rates are found in Appendix A. It is the intent of the parties that employees who are assigned to the second or third shift will receive a shift differential, unless such a shift differential is built into their base salary.",
            "block_bbox": [
                188,
                787,
                1122,
                872
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
