                    188.0,
                    569.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Affected employees and/or AFSCME may file a grievance regarding a pay equity concern in accordance with Section C.2, above. Pay rate adjustments shall, if any, be effective on the first day of the first pay period following receipt of the grievance.",
            "block_bbox": [
                252,
                595,
                1123,
                706
            ],
