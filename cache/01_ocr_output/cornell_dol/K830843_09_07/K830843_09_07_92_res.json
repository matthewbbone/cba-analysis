                    188.0,
                    872.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Shift differential rates will be included in wage negotiations.",
            "block_bbox": [
                187,
                898,
                845,
                927
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
