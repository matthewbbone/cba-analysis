    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "2. Short Term Paid Leave (2-29 Days)",
            "block_bbox": [
                182,
                97,
                665,
                128
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
