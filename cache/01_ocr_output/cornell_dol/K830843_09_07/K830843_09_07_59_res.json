        {
            "block_label": "paragraph_title",
            "block_content": "C. ONE-DAY LEAVES",
            "block_bbox": [
                111,
                538,
                406,
                568
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
