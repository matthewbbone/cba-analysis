        {
            "block_label": "text",
            "block_content": "4. An employee must be on pay status for at least one-half (1/2) of the working hours of a month or quadri-weekly cycle to earn sick leave credit for that month or quadri-weekly cycle. Time on pay status in excess of a full-time employee's work schedule does not earn sick leave credit. For the purposes of this Agreement, a quadri-weekly cycle is defined as two bi-weekly pay periods designated by the University to be considered as one unit for the purpose of leave accrual.",
            "block_bbox": [
                181,
                125,
                1122,
                320
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
