        {
            "block_label": "text",
            "block_content": "1. When the University temporarily assigns an employee to perform fully the functions of a position in a higher classification for at least 15 working days or more:",
            "block_bbox": [
                184,
                1560,
                1120,
                1645
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
