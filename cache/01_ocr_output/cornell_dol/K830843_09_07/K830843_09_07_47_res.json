                    1451.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. Family Illness Leave is leave to care for the employee's child, parent or same- or opposite-sex domestic partner with a serious health condition.",
            "block_bbox": [
                255,
                1478,
                1120,
                1536
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    255.0,
                    1478.0
                ],
                [
                    1120.0,
                    1478.0
                ],
                [
                    1120.0,
                    1536.0
                ],
                [
                    255.0,
                    1536.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f. Child means a biological, adopted, or foster child, a stepchild, a legal ward, or a child of a person standing in loco parentis who is either under 18 years of age or an adult dependent child.",
            "block_bbox": [
                253,
                1560,
                1121,
                1646
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
