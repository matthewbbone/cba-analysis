        {
            "block_label": "paragraph_title",
            "block_content": "1. Definitions",
            "block_bbox": [
                190,
                731,
                388,
                760
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
