        },
        {
            "block_label": "paragraph_title",
            "block_content": "I. ARBITRATION PROCEDURE",
            "block_bbox": [
                110,
                1449,
                517,
                1478
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
