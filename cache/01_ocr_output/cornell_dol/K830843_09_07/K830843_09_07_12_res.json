                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "H. SCHEDULING THE ARBITRATION HEARING",
            "block_bbox": [
                110,
                1008,
                695,
                1037
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    110.0,
