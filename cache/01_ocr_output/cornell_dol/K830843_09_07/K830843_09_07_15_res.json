        },
        {
            "block_label": "paragraph_title",
            "block_content": "N. PANEL OF ARBITRATORS",
            "block_bbox": [
                111,
                400,
                494,
                430
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
