        {
            "block_label": "text",
            "block_content": "M. AFSCME shall have full authority to settle, withdraw, or otherwise dispose of any grievance brought on behalf of the Union and/or on the behalf of employees. An agreement to settle, withdraw, or otherwise dispose of a grievance appealed to arbitration reached by and between the University and AFSCME shall be binding upon employees represented by AFSCME.",
            "block_bbox": [
                112,
                234,
                1122,
                376
