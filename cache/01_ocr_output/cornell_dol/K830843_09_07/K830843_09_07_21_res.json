                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Inform the employee that he or she has a right to respond either orally or in writing, to whom to respond, and that the response must be received within ten (10) calendar days of the date of the issuance of the notice of intent in accordance with Section E below;",
            "block_bbox": [
                252,
                429,
                1122,
                542
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
