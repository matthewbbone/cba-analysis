        },
        {
            "block_label": "text",
            "block_content": "a. Inform the employee of the disciplinary action which the University intends to take, the reason for the disciplinary action, and the effective date of the disciplinary action;",
            "block_bbox": [
                254,
                318,
                1120,
                403
            ],
            "block_id": 2,
