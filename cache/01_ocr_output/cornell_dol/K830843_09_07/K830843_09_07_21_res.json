            ]
        },
        {
            "block_label": "text",
            "block_content": "After review of the employee's timely response, if any, the University shall notify the employee of any action to be taken. Such action may not include discipline more severe than that described in the notice of intent; however, the University may reduce such discipline without the issuance of a further notice of intent. If the employee chooses to respond orally, the employee may request and, if such request is made, have present a Union representative.",
            "block_bbox": [
