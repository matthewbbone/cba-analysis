        {
            "block_label": "text",
            "block_content": "The employee shall be entitled to respond, orally or in writing, to the notice of intent described above. Such response must be received within ten (10) calendar days from the date of issuance of such notice of intent in accordance with instructions given by the University in the written notice of intent sent to the employee.",
            "block_bbox": [
                181,
                760,
                1120,
                874
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
