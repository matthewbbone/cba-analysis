                ],
                [
                    1118.0,
                    1065.0
                ],
                [
                    255.0,
                    1065.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The need to obtain special expertise or efficiencies that are better provided through an outside contractor than by the University; and",
            "block_bbox": [
                253,
                1091,
                1119,
                1151
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    253.0,
