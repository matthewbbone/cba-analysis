                ],
                [
                    1120.0,
                    901.0
                ],
                [
                    184.0,
                    901.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Examples of instances in which a contract for such services may be appropriate include:",
            "block_bbox": [
                182,
                925,
                1119,
                981
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
