                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Nothing in this Article shall be interpreted as prohibiting action which must be taken to establish or maintain eligibility for any federal program, contract or grant - including the contract requirements contained in the agreement between the University and the Department of Energy- where ineligibility would result in a loss of federal funds to the University of California.",
            "block_bbox": [
                181,
                622,
                1121,
                763
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
