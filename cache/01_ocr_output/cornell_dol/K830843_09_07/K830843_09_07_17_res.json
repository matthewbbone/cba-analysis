                    111.0,
                    816.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Except as provided below, the University of California will not contract out services that result in the layoff of bargaining unit employees.",
            "block_bbox": [
                184,
                842,
                1120,
                901
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    184.0,
