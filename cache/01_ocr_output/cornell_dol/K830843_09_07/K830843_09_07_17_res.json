        {
            "block_label": "paragraph_title",
            "block_content": "A. GENERAL PROVISIONS",
            "block_bbox": [
                111,
                566,
                466,
                595
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
