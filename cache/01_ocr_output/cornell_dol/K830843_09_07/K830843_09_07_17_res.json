                ],
                [
                    253.0,
                    1151.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Financial necessity.",
            "block_bbox": [
                256,
                1174,
                543,
                1204
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    256.0,
                    1174.0
