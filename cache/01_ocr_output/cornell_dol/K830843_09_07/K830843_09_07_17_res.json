                    1119.0,
                    981.0
                ],
                [
                    182.0,
                    981.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The need to obtain special services and equipment that are not available internally;",
            "block_bbox": [
                255,
                1009,
                1118,
                1065
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    255.0,
                    1009.0
                ],
                [
                    1118.0,
