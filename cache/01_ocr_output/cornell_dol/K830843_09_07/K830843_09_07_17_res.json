                    182.0,
                    1342.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. When the University has determined to contract for services it will provide AFSCME's Local 3299 Director or Designee with a copy of any RFP as soon as feasible after it is issued. Such notice shall demonstrate the appropriateness for the contract, in accordance with Section B above.",
            "block_bbox": [
                182,
                1366,
                1121,
                1480
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    182.0,
                    1366.0
                ],
                [
                    1121.0,
                    1366.0
                ],
