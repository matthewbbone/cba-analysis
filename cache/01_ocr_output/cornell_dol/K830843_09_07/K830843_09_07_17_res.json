                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "B. DISPLACEMENT OF EMPLOYEES",
            "block_bbox": [
                111,
                785,
                577,
                816
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
