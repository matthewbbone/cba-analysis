                ],
                [
                    182.0,
                    1480.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. If AFSCME asks to meet with the University about the proposed contract for services, such a meeting will occur as soon as practicable following the University’s receipt of the request. The meeting will not delay the commencement of the contract.",
            "block_bbox": [
                254,
                1505,
                1121,
                1618
            ],
            "block_id": 13,
