                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Where financial necessity is the reason for the exception, before contracting for work which is fully or partially supported from state funds, including those at the teaching hospitals, the University shall first seek funding from the Legislature to address the financial necessity.",
            "block_bbox": [
                182,
                1228,
                1121,
                1342
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
