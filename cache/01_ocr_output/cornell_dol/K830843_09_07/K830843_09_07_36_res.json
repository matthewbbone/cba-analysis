        },
        {
            "block_label": "paragraph_title",
            "block_content": "H. OVERTIME DEFINITION",
            "block_bbox": [
                111,
                1256,
                460,
                1285
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
