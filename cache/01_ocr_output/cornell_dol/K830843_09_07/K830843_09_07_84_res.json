                    184.0,
                    866.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The University shall negotiate over the effects identified by the union, insofar as they are the mandatory subjects of bargaining: wages, hours, and terms & conditions of employment.",
            "block_bbox": [
                180,
                911,
                1120,
                996
            ],
            "block_id": 4,
            "block_order": 5,
