                    1119.0,
                    735.0
                ],
                [
                    110.0,
                    735.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The union agrees to identify the known effects of the staffing change it wishes to bargain at the time it makes the bargaining request. During the course of negotiations, the union can raise additional effects issues as they become known.",
            "block_bbox": [
                184,
                755,
                1121,
                866
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    184.0,
