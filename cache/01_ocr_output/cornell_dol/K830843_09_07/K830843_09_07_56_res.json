        {
            "block_label": "text",
            "block_content": "1. Leave shall be granted to an employee who as a member of the National Guard is called to active duty by proclamation of the Governor during a state of emergency. An employee who as a member of the National Guard is called to active federal military duty at the request of the President of the United States is not eligible for emergency National Guard leave, but shall be granted extended military leave as set forth in Section K.",
            "block_bbox": [
                188,
                1041,
                1122,
                1208
            ],
            "block_id": 9,
