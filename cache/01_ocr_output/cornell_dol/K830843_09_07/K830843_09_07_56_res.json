        {
            "block_label": "text",
            "block_content": "An employee who was serving a probationary period at the time extended military leave became effective shall be required to complete the probationary period upon reinstatement.",
            "block_bbox": [
                253,
                336,
                1120,
                423
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    253.0,
