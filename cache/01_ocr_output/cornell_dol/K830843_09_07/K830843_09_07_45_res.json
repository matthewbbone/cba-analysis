    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "1.) Is medically incapable of performing essential assigned functions of his/her job due to a non-work related illness or injury; and",
            "block_bbox": [
                329,
                96,
                1119,
                156
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
