                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Medical leaves of absence are granted for the period of verified disability and are not granted for non-disability purposes. When the use of accrued sick leave and a medical leave of absence without pay are combined, a medical leave of absence from work for non-work related disability purposes may be granted by the University for a total period of verified disability not to exceed six (6) months.",
            "block_bbox": [
                253,
                1367,
                1122,
                1508
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    253.0,
                    1367.0
                ],
                [
                    1122.0,
