                    1119.0,
                    320.0
                ],
                [
                    326.0,
                    320.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4.) Has either exhausted his/her twelve (12) workweek entitlement under Section D Family Care and Medical Leave, or is not otherwise eligible for medical leave under Section D Family Care and Medical Leave or Pregnancy Disability Leave under Section C.6.",
            "block_bbox": [
                324,
                345,
                1121,
                484
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
