                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "5. Duration",
            "block_bbox": [
                189,
                1310,
                362,
                1341
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
