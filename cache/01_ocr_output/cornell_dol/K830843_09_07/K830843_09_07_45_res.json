                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "3. Notification",
            "block_bbox": [
                188,
                511,
                396,
                541
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    188.0,
                    511.0
                ],
                [
                    396.0,
                    511.0
                ],
                [
                    396.0,
                    541.0
                ],
                [
                    188.0,
                    541.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Requests for medical leave without pay shall be in writing as provided in Section A.3, and the employee shall furnish evidence of disability satisfactory to the University as provided in Section C.4, Documentation and Verification, below. Additionally, an employee must notify the University of a need to extend his/her medical absence from work prior to the anticipated date of return.",
            "block_bbox": [
                253,
                566,
                1120,
                708
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    253.0,
                    566.0
                ],
                [
                    1120.0,
                    566.0
                ],
                [
                    1120.0,
                    708.0
                ],
                [
                    253.0,
                    708.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4. Documentation and Verification",
            "block_bbox": [
                188,
                731,
                624,
                761
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    188.0,
                    731.0
                ],
                [
                    624.0,
                    731.0
                ],
                [
                    624.0,
                    761.0
                ],
                [
                    188.0,
                    761.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Documentation of the employee's disability and/or ability to return to work is required and is subject to verification by the University. Such documentation shall include, but is not limited to, a health practitioner's (as defined in Article 36 - Sick Leave, Section D.4.) statement of the anticipated duration of disability, and a statement that the employee is incapable of performing the essential assigned functions of his/her job, or is able to return and perform the essential assigned functions of his/her job.",
            "block_bbox": [
                252,
                787,
                1121,
                1012
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    252.0,
                    787.0
                ],
                [
                    1121.0,
                    787.0
                ],
                [
                    1121.0,
                    1012.0
                ],
                [
                    252.0,
                    1012.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The University may have an employee claiming disability examined by a physician or physicians of its choosing. The University shall pay the reasonable costs of any such medical examination required by the University.",
            "block_bbox": [
                253,
                1035,
                1121,
                1149
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    253.0,
                    1035.0
                ],
                [
                    1121.0,
                    1035.0
                ],
                [
                    1121.0,
                    1149.0
                ],
                [
                    253.0,
                    1149.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Verification of medical disability for pregnancy-related purposes additionally includes a physician's statement regarding the estimated date of delivery and the anticipated date of the employee's ability to perform the essential assigned functions of her job.",
            "block_bbox": [
                253,
                1174,
                1120,
                1288
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
