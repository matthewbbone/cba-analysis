                [
                    326.0,
                    237.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3.) Has exhausted her four (4) month entitlement under Pregnancy Disability leave; or",
            "block_bbox": [
                326,
                262,
                1119,
                320
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
