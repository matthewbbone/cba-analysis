                ],
                [
                    329.0,
                    156.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2.) Has furnished evidence of disability satisfactory to the University; or",
            "block_bbox": [
                326,
                179,
                1118,
                237
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
