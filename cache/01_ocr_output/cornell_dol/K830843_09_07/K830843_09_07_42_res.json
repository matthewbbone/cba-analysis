                [
                    325.0,
                    1259.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Repayment - An employee who has received severance pay under this provision and who returns to work in a career position with the University at the same or higher salary and same percentage of time as the position held at the time of layoff shall repay to the University the portion of severance pay received that exceeds the time the employee was laid off. Before returning to work, the employee must make repayment in full or sign a repayment agreement.",
            "block_bbox": [
