        {
            "block_label": "paragraph_title",
            "block_content": "G. SEVERANCE- EFFECTIVE 30 DAYS FOLLOWING RATIFICATION THROUGH THE DURATION OF THE AGREEMENT. THIS PROVISION EXPIRES AT THE END OF THIS AGREEMENT.",
            "block_bbox": [
                110,
                372,
                1120,
                458
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
