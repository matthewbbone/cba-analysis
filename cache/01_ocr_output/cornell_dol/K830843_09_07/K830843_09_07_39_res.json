        {
            "block_label": "text",
            "block_content": "1. When the University determines that a layoff is imminent within the unit, it shall give AFSCME such advance notice as is reasonable under the circumstances. The notice shall describe the general areas which may be affected.",
            "block_bbox": [
                183,
                1257,
                1119,
                1342
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
