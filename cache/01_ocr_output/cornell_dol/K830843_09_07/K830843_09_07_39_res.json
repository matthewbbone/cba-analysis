            ]
        },
        {
            "block_label": "text",
            "block_content": "a. For temporary layoff expected to last 120 calendar days or less, the University shall give, if feasible, 15 calendar days notice of the expected beginning and ending dates of the layoff.",
            "block_bbox": [
                254,
                1505,
                1120,
                1591
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
