            ]
        },
        {
            "block_label": "text",
            "block_content": "2. When the University selects particular members of the unit for layoff, it shall give individual notice to each employee of the effective date of the layoff and whether the layoff is temporary or indefinite. Advance notice will be provided as follows:",
            "block_bbox": [
                182,
                1366,
                1121,
                1452
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
