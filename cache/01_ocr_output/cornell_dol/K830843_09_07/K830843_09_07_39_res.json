        {
            "block_label": "paragraph_title",
            "block_content": "C. SELECTION FOR LAYOFF",
            "block_bbox": [
                110,
                372,
                491,
                403
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
