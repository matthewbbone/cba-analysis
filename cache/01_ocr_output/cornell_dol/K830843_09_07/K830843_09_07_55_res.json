        },
        {
            "block_label": "text",
            "block_content": "An employee shall be granted extended military leave for the initial period of enlistment, service, or tour of duty for a period not to exceed five (5) years. In addition to the initial period of the leave and any extensions thereof in accordance with Section L, leave shall be granted for a period up to six (6) months from the date of release from duty.",
            "block_bbox": [
                251,
