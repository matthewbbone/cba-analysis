        },
        {
            "block_label": "text",
            "block_content": "An employee granted extended military leave is entitled to receive regular University pay for the first thirty (30) calendar days of leave provided:",
            "block_bbox": [
                252,
                921,
                1120,
                980
            ],
            "block_id": 7,
