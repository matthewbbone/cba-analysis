        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Period of Leave",
            "block_bbox": [
                182,
                644,
                443,
                674
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
