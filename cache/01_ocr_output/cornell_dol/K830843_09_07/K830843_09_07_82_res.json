            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee who is transferred, promoted, or demoted into a position not covered by this Agreement shall have the accumulation, use, and transfer of sick leave governed by the policies and/or contract covering employees in that unit or personnel program.",
