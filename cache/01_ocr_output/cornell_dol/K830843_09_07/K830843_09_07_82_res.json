        },
        {
            "block_label": "paragraph_title",
            "block_content": "E. TRANSFER AND REINSTatement OF SICK LEAVE",
            "block_bbox": [
                110,
                897,
                783,
                927
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
