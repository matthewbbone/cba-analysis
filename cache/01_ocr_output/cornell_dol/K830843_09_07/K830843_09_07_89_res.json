        },
        {
            "block_label": "paragraph_title",
            "block_content": "E. VACATION PAY",
            "block_bbox": [
                111,
                1007,
                373,
                1037
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
