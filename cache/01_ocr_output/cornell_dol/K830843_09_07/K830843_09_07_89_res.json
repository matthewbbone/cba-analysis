                    184.0,
                    1149.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. An employee who separates from employment or who is granted extended military leave shall be paid for any vacation earned through the employee's last day of work, except that an employee who is retiring may use vacation up to the effective date of retirement.",
            "block_bbox": [
                181,
                1174,
                1121,
