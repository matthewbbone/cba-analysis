        {
            "block_label": "paragraph_title",
            "block_content": "K. TEMPORARY MILITARY LEAVE FOR ACTIVE-DUTY TRAINING",
            "block_bbox": [
                110,
                501,
                900,
                531
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
