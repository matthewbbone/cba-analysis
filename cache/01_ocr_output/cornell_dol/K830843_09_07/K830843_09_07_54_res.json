        },
        {
            "block_label": "text",
            "block_content": "An employee granted temporary military leave for active duty training is entitled to receive regular University pay for up to thirty (30) calendar days, but not to exceed the actual period of active duty for training, provided:",
            "block_bbox": [
                252,
                884,
                1120,
                969
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    252.0,
                    884.0
                ],
                [
                    1120.0,
                    884.0
                ],
                [
                    1120.0,
                    969.0
                ],
                [
                    252.0,
                    969.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The employee has at least twelve (12) months of continuous University service immediately prior to granting of the leave (any prior full-time military service shall be included in calculating this University service requirement); and",
            "block_bbox": [
                252,
                994,
                1121,
                1107
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    252.0,
                    994.0
                ],
                [
                    1121.0,
                    994.0
                ],
                [
                    1121.0,
