        {
            "block_label": "text",
            "block_content": "In the event of natural or man-made emergencies, an employee may be granted leave with straight-time pay during regularly scheduled hours of work for the period of time authorized by the University. The granting of such leave and the period of time shall be at the sole, non-grievable discretion of the University.",
            "block_bbox": [
