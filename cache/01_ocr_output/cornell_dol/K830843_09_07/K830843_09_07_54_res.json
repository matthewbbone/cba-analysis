                ],
                [
                    252.0,
                    1107.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Such payment, in addition to University payment for extended military leave and for military leave for physical examinations, does not exceed thirty (30) calendar days pay in any one fiscal year.",
            "block_bbox": [
