                [
                    110.0,
                    857.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The University and AFSCME agree that the Associate Vice President, Human Resources and Benefits will review individual situations on a case by case basis referred by the union that allegedly violate current terms and conditions of employment.",
