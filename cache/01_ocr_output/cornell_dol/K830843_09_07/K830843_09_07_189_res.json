        {
            "block_label": "paragraph_title",
            "block_content": "SIDE LETTER AGREEMENT\nBETWEEN THE UNIVERSITY OF CALIFORNIA AND THE\nAMERICAN FEDERATION OF STATE, COUNTY, AND MUNICIPAL EMPLOYEES (AFSCME) WITH\nREGARDS TO AGRICULTURAL WORKERS",
            "block_bbox": [
                112,
                546,
                1118,
                648
            ],
            "block_id": 7,
            "block_order": 5,
            "group_id": 7,
            "block_polygon_points": [
