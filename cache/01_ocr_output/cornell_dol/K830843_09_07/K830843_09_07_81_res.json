                [
                    110.0,
                    789.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Sick leave is paid at the employee's straight time rate of pay including any shift differential, provided that the employee would have been expected to work that shift or shifts if not on sick leave.",
            "block_bbox": [
                183,
                810,
                1120,
                895
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    183.0,
