                    810.0
                ],
                [
                    1120.0,
                    895.0
                ],
                [
                    183.0,
                    895.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. No sick leave shall be payable to an employee unless the employee has complied fully with the terms of Section D, Sick Leave Notification and Verification.",
            "block_bbox": [
                179,
                920,
                1121,
