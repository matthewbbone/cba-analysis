        },
        {
            "block_label": "paragraph_title",
            "block_content": "d. Bereavement Leave",
            "block_bbox": [
                254,
                290,
                562,
                319
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
