            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "C. SICK LEAVE PAY",
            "block_bbox": [
                110,
                758,
                393,
                789
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
