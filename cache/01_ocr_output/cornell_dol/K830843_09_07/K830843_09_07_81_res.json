        {
            "block_label": "paragraph_title",
            "block_content": "1. Notice",
            "block_bbox": [
                185,
                1086,
                339,
                1116
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
