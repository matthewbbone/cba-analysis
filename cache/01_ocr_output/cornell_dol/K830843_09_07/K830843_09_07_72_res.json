                    1701.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Qualifying service includes all time on pay status in one or more limited appointments at the campus/laboratory/hospital. Pay status shall not include any on-call, premium, or overtime hours.",
            "block_bbox": [
                253,
                1726,
                1121,
