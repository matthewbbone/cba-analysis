                    1424.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The termination of a limited appointment because the position lacks funding, or for other work-related reasons, does not constitute a termination designed to deny a limited appointment career status.",
            "block_bbox": [
                182,
                1450,
                1121,
                1535
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
