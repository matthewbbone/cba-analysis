        {
            "block_label": "paragraph_title",
            "block_content": "B. LIMITED APPOINTMENTS",
            "block_bbox": [
                111,
                1172,
                485,
                1203
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
