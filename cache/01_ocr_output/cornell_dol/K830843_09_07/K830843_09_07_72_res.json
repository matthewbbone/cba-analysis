                ],
                [
                    184.0,
                    1315.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Employees in limited appointments are at will, except that the University will not terminate limited appointment employees for the sole purpose of denying them career status.",
            "block_bbox": [
                182,
                1338,
                1120,
                1424
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    182.0,
                    1338.0
                ],
