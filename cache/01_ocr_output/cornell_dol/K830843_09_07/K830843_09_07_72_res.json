        },
        {
            "block_label": "text",
            "block_content": "1. Career appointments are established for a fixed or variable percentage of time at fifty percent (50%) or more of full-time and are expected to continue for one (1) year or longer.",
            "block_bbox": [
                183,
                980,
                1120,
                1067
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
