            ]
        },
        {
            "block_label": "text",
            "block_content": "G. A scheduled bargaining session is defined as the prior agreement of the parties to meet face to face for the purpose of negotiating terms and conditions of an Agreement and that such meeting actually takes place for a reasonable period of time or, if no meeting actually takes place, it is the result of the employer's unavailability to appear at the bargaining table.",
            "block_bbox": [
