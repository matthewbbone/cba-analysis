                ],
                [
                    1120.0,
                    1177.0
                ],
                [
                    110.0,
                    1177.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "F. Reasonable travel time means actual travel to and from scheduled bargaining sessions for the designated employees. At the employer's discretion, the designated employees may be required to report to work prior to and subsequent to scheduled bargaining sessions.",
            "block_bbox": [
                111,
                1201,
                1120,
                1314
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
