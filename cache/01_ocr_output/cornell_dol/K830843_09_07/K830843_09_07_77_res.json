                    111.0,
                    1094.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "E. AFSCME shall provide and certify to the employer an attendance roster at the end of each bargaining session.",
            "block_bbox": [
                110,
                1118,
                1120,
                1177
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
