        {
            "block_label": "text",
            "block_content": "b. All current member contributions to the University of California Retirement Plan (UCRP) are redirected to the Pretax Account. Although payroll reductions default to the Savings Fund, participants may invest in any of the other UC-Managed Funds: Money Market, Insurance Company Contract, Equity, Bond and Multi-Asset Funds or in Fidelity Investments mutual funds. Redirection is subject to annual Regental review.",
            "block_bbox": [
                253,
                1367,
                1121,
                1537
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
