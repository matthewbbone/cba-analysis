        {
            "block_label": "text",
            "block_content": "1. When an employee is attending administrative or legal proceedings on behalf of the University or is subpoenaed by the University to appear as a witness on its behalf in an administrative or legal proceeding, leave without loss of straight-time pay will be granted for actual time spent in the proceedings and in related travel not to exceed the number of hours in the employee's normal work day and workweek.",
            "block_bbox": [
                178,
                1321,
                1122,
                1489
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    178.0,
                    1321.0
                ],
                [
                    1122.0,
                    1321.0
                ],
                [
                    1122.0,
                    1489.0
                ],
                [
                    178.0,
                    1489.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Leave with pay shall not be granted when an employee is the plaintiff or defendant in a proceeding, is called or subpoenaed as a paid expert witness not on behalf of the University, or is called or subpoenaed because of duties for another employer.",
            "block_bbox": [
                176,
                1514,
                1121,
                1627
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    176.0,
