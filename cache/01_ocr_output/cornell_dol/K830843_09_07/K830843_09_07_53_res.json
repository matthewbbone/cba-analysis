                    403.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee granted Family Care and/or Medical Leave shall be returned to the same or an equivalent position upon return from the leave. If the position has been abolished or otherwise affected by layoff and an equivalent position is not available, the employee shall be afforded the same considerations which would have been afforded had the employee been on pay status when the position was abolished or affected by layoff. An employee granted a Family Care and/or Medical Leave is not entitled to reinstatement to his/her position if the employee's appointment ending date or predetermined date of separation occurs before the scheduled return date.",
            "block_bbox": [
                325,
                430,
                1121,
                707
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
