                    176.0,
                    1627.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. When served with a subpoena which compels the employee's appearance as a witness, in the prosecution of a person for an offense which the employee, by virtue of being on University premises during scheduled work hours, witnessed, the employee shall be granted leave without loss of straight-time pay for actual time spent in the proceedings and in related travel time not to exceed the employee's normal work day and workweek.",
            "block_bbox": [
                174,
                1653,
                1122,
                1820
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
