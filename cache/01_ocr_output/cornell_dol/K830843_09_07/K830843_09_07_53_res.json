        {
            "block_label": "text",
            "block_content": "If an employee's request for Family Care and/or Medical Leave is denied, deferred or otherwise provided for short of the employee's initial request, such University action may, upon the employee's written request, be reviewed by the Department/Division Head. Neither the University's action in granting or not granting a Family Care and/or Medical Leave nor the results of such review shall be subject to Article 9 - Grievance Procedure or Article 3 - Arbitration Procedure of this Agreement.",
            "block_bbox": [
                325,
                153,
                1121,
                349
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
