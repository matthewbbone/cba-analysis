            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "h. Return to Work",
            "block_bbox": [
                255,
                373,
                511,
                403
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
