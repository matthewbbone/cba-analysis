        {
            "block_label": "paragraph_title",
            "block_content": "F. CORRECTION OF ERRORS",
            "block_bbox": [
                111,
                234,
                499,
                264
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
