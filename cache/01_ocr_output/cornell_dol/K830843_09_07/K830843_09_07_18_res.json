    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "C. EFFECT OF CONTRACT ON EMPLOYEES",
            "block_bbox": [
                111,
                97,
                657,
                126
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
