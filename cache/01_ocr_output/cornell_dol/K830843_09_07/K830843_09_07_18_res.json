        {
            "block_label": "paragraph_title",
            "block_content": "D. NEW FUNDING TO BRING CONTRACTED WORK BACK TO THE UNIVERSITY OF CALIFORNIA",
            "block_bbox": [
                111,
                841,
                1119,
                898
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
