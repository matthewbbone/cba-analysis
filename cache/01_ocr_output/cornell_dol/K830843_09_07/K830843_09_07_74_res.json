                    1341.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. The University shall provide qualifying Per Diem employees who meet the criteria in Sections D.7.a and D.7.b, above, career appointment as follows:",
            "block_bbox": [
                254,
                1366,
                1120,
                1451
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    254.0,
                    1366.0
                ],
                [
                    1120.0,
                    1366.0
                ],
                [
                    1120.0,
                    1451.0
                ],
                [
                    254.0,
                    1451.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) The appointment shall be made no later than nine (9) months from the date on which the employee meets the criteria set forth in Sections D.7.a and D.7.b, above.",
            "block_bbox": [
                327,
                1477,
                1120,
                1563
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    327.0,
                    1477.0
                ],
                [
                    1120.0,
                    1477.0
                ],
                [
                    1120.0,
                    1563.0
                ],
                [
                    327.0,
                    1563.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) The appointment shall be a variable career appointment of at least 50%, provided the University first complies with the recall and preferential rehire procedures in Article 13 - Layoff and Reduction in Time.",
            "block_bbox": [
                325,
                1587,
                1121,
                1700
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
                [
                    325.0,
                    1587.0
                ],
                [
                    1121.0,
                    1587.0
                ],
                [
                    1121.0,
                    1700.0
                ],
                [
                    325.0,
                    1700.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3) The appointment shall be in the same or substantially similar job at the same classification at the same campus/hospital, provided the employee is qualified for that appointment.",
            "block_bbox": [
                326,
                1725,
                1121,
                1812
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
