            ]
        },
        {
            "block_label": "text",
            "block_content": "5. Employees who are in per diem appointments are covered by per diem salary rates (by agreement rates), the overtime provisions in Article 12 - Hours of Work, and Article 45 - Work Rules. Per Diem employees may be released or have their time reduced at the sole discretion of the University and without recourse to the Layoff procedures of this Agreement.",
            "block_bbox": [
                181,
                429,
                1123,
                570
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    181.0,
                    429.0
                ],
                [
                    1123.0,
