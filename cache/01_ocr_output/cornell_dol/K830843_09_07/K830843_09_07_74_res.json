            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Use of Article 9 - Grievance Procedure and Article 3 - Arbitration Procedure of this Agreement by employees in per diem appointments is limited to alleged violations of the Wages, overtime and Work Rules provisions of this Agreement except as set forth in Sections D.7-8 of this article.",
            "block_bbox": [
                180,
                594,
                1123,
                708
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
