        {
            "block_label": "text",
            "block_content": "4. Employees in per diem appointments may be scheduled or not scheduled, called off from a pre-established schedule, or have their eligibility for scheduling discontinued at the sole discretion of the University and without recourse to Article 9 - Grievance Procedure or Article 3 - Arbitration Procedure of this Agreement, except as provided in §D.7 and D.8, of this Article.",
            "block_bbox": [
                181,
                263,
                1121,
                405
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    181.0,
