                ],
                [
                    326.0,
                    1260.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4) Have provided the University with an annual written statement of interest in a career appointment.",
            "block_bbox": [
                325,
                1284,
                1120,
                1341
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    325.0,
                    1284.0
                ],
                [
                    1120.0,
                    1284.0
                ],
