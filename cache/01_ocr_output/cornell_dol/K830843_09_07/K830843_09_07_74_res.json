        },
        {
            "block_label": "paragraph_title",
            "block_content": "7. Consideration for Career Appointment",
            "block_bbox": [
                182,
                731,
                703,
                762
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    182.0,
                    731.0
                ],
                [
                    703.0,
                    731.0
                ],
                [
                    703.0,
                    762.0
                ],
                [
                    182.0,
                    762.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Annually, in the month of May, each campus and hospital will review the total hours worked, pursuant to 7.b below, by Per Diem employees who have provided the University with a written statement of interest in becoming a career employee. This review will determine if such a Per Diem employee meets the criteria for consideration for career appointment pursuant to 6.b, below.",
            "block_bbox": [
                252,
                787,
                1122,
                957
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    252.0,
                    787.0
                ],
                [
                    1122.0,
                    787.0
                ],
                [
                    1122.0,
                    957.0
                ],
                [
                    252.0,
                    957.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "b. Qualifying Per Diem employees are those who:",
            "block_bbox": [
                254,
                980,
                859,
                1012
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    254.0,
                    980.0
                ],
                [
                    859.0,
                    980.0
                ],
                [
                    859.0,
                    1012.0
                ],
                [
                    254.0,
                    1012.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) Have been employed at least twelve (12) months at the campus or hospital;",
            "block_bbox": [
                326,
                1036,
                1119,
                1093
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    326.0,
                    1036.0
                ],
                [
                    1119.0,
                    1036.0
                ],
                [
                    1119.0,
                    1093.0
                ],
                [
                    326.0,
                    1093.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) Have worked 80% of full time, with no less than 50% time worked in any given month or quadri-weekly period, including overtime, during the preceding contract year;",
            "block_bbox": [
                325,
                1118,
                1119,
                1205
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    325.0,
                    1118.0
                ],
                [
                    1119.0,
                    1118.0
                ],
                [
                    1119.0,
                    1205.0
                ],
                [
                    325.0,
                    1205.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3) Have satisfactory work performance;",
            "block_bbox": [
                326,
                1228,
                798,
                1260
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    326.0,
                    1228.0
                ],
                [
                    798.0,
                    1228.0
                ],
                [
                    798.0,
