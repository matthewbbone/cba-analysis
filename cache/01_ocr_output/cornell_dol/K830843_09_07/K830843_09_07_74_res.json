    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "In addition, by no later than July 2002, the University will provide AFSCME with information about the ratio of Per Diem to Career employees, including the total number of Per Diem and career employees, between July 2001 and July 2002. The University agrees that the ratio of Per Diem to career employees will not grow by more than 12% over three (3) years.",
            "block_bbox": [
                252,
                97,
                1122,
                240
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
