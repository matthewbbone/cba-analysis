            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Costs that exceed current University contributions, and employee costs for plans to which the University does not contribute, are to be paid by unit employees, normally through payroll deduction.",
            "block_bbox": [
                180,
                484,
