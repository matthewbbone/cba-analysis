            ]
        },
        {
            "block_label": "text",
            "block_content": "An eligible employee on military leave with pay for emergency National Guard duty or Military Reserve Training Leave shall receive those benefits related to employment that are granted in the University's Military Leave policy and its related documents.",
            "block_bbox": [
                252,
                981,
                1121,
