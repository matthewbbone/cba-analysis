        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Military Leave",
            "block_bbox": [
                183,
                925,
                424,
                955
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
