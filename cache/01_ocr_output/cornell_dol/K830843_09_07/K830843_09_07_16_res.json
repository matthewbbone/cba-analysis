        {
            "block_label": "paragraph_title",
            "block_content": "3. Leaves Of Absence Without Pay",
            "block_bbox": [
                183,
                1119,
                631,
                1148
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
