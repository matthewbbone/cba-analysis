        {
            "block_label": "paragraph_title",
            "block_content": "1. Temporary Layoff/Temporary Reduction In Time/Furlough",
            "block_bbox": [
                184,
                649,
                923,
                680
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
