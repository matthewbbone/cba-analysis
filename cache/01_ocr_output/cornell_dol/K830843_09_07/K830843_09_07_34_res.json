        {
            "block_label": "text",
            "block_content": "Major holidays are defined as Thanksgiving Day, Christmas Day, and New Year's Day. The University will guarantee each member of the unit one (1) of the named major holidays off regardless of the date(s) on which the University celebrates those holidays. Holiday pay eligibility shall be determined by the official University holiday schedule.",
            "block_bbox": [
                182,
                152,
                1120,
                268
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    182.0,
                    152.0
                ],
                [
                    1120.0,
                    152.0
                ],
                [
                    1120.0,
                    268.0
                ],
                [
                    182.0,
                    268.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event the University fails to provide an employee with one of the named major holidays off during a contract year, the University shall pay the employee at the rate of time and one-half (1-1/2x) for the third major holiday worked. This provision shall not apply if an employee volunteers to work a third named holiday within a contract year.",
            "block_bbox": [
                182,
                290,
                1123,
                406
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
