        {
            "block_label": "text",
            "block_content": "Employees in classes designated in Appendix A of this Agreement as eligible for overtime at one and one-half (1-1/2) times the straight time rate (OTP code N) shall be compensated at the straight time rate for hours of overtime not exceeding forty (40) hours of actual work in a workweek and shall be compensated at one and one-half (1-1/2) times the straight time rate only for those overtime hours which exceed forty (40) hours of actual work in a workweek.",
            "block_bbox": [
