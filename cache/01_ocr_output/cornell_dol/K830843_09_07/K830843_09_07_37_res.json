        {
            "block_label": "paragraph_title",
            "block_content": "3. 8/80 Option",
            "block_bbox": [
                183,
                373,
                396,
                404
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
