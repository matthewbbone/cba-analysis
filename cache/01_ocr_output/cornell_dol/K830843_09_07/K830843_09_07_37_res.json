            ]
        },
        {
            "block_label": "text",
            "block_content": "2. No more than two hundred forty (240) hours of compensatory time off (one hundred sixty (160) hours of overtime which require compensation at the time and one-half rate) may be accumulated. An employee shall be paid for hours of overtime which exceed this limit.",
            "block_bbox": [
                183,
                1533,
                1121,
                1646
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
