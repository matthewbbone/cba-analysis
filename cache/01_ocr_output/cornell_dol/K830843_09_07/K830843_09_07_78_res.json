                ],
                [
                    111.0,
                    985.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Initiate discipline of the employee, which may include terminating the employee for position abandonment; or",
            "block_bbox": [
                184,
                1008,
                1119,
                1066
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
