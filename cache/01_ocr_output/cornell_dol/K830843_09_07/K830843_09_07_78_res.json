        {
            "block_label": "text",
            "block_content": "A. Eligible employees assigned to an evening or night shift shall be paid a shift differential for all hours including overtime which are worked. Classes eligible for a shift differential and shift differential rates by location are listed in Appendix A. Work which is scheduled during the evening or night hours on the basis of convenience to the employee shall not be considered an assigned evening or night shift for the purpose of this provision.",
            "block_bbox": [
                110,
                1643,
                1121,
                1811
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
