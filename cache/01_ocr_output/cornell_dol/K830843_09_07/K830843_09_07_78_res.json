        {
            "block_label": "text",
            "block_content": "c. An employee has given at least seventy-two (72) hours notice of intention to quit",
            "block_bbox": [
                253,
                153,
                1119,
                208
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
