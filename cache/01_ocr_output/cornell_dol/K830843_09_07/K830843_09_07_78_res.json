                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Consider and treat the employee as having resigned, effective as of the end of the last day worked.",
            "block_bbox": [
                181,
                1091,
                1121,
                1148
            ],
            "block_id": 8,
            "block_order": 9,
