                    254.0,
                    570.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Employees with accrued compensatory time may elect to use it to cover the scheduled time off or to offset the use of vacation time.",
            "block_bbox": [
                255,
                595,
                1119,
