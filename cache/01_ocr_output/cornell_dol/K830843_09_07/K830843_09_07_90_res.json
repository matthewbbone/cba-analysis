        {
            "block_label": "text",
            "block_content": "a. Employees may use accumulated vacation leave during the period. Newly employed unit members would be allowed to use accrued vacation even if the required six (6) continuous months on pay status has not been completed. Employees without sufficient accumulated vacation would be allowed to use up to three (3) days vacation leave prior to actual accrual.",
            "block_bbox": [
                254,
                430,
                1120,
                570
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
