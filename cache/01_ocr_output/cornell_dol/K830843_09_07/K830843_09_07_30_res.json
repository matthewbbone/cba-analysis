                    904.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The Union must request a meeting and the parties must agree to the meeting date.",
            "block_bbox": [
                254,
                954,
                1119,
                1011
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
