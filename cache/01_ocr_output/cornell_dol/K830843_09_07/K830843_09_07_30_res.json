                    1011.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The Union must submit a written agenda identifying health and safety concerns it wishes to discuss. Such agenda must be submitted to the designated campus representative at least ten (10) workdays before the proposed meeting date.",
            "block_bbox": [
                253,
                1036,
                1121,
                1151
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
