                    1151.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. In the event the University has agenda items regarding health and safety, the University shall present its agenda to the Union at least ten (10) workdays before the scheduled meeting.",
            "block_bbox": [
                253,
                1174,
                1119,
                1260
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
