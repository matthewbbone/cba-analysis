                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. In the event neither party submits an agenda ten (10) workdays before the scheduled meeting, the meeting will not be convened.",
            "block_bbox": [
                254,
                1284,
                1119,
                1343
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
