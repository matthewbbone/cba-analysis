                ],
                [
                    185.0,
                    706.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The procedure described herein shall be the sole, exclusive procedure for resolving disputes arising under Sections D and E above.",
            "block_bbox": [
                253,
                732,
                1119,
                790
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
