        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Selection of Arbitrator and Scheduling of Hearing",
            "block_bbox": [
                182,
                815,
                829,
                845
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    182.0,
                    815.0
                ],
                [
                    829.0,
                    815.0
                ],
                [
                    829.0,
