        },
        {
            "block_label": "paragraph_title",
            "block_content": "E. RECLASSIFICATION FROM UNIT TO NON-UNIT POSITIONS",
            "block_bbox": [
                110,
                290,
                869,
                319
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    110.0,
                    290.0
                ],
                [
                    869.0,
                    290.0
                ],
                [
                    869.0,
                    319.0
                ],
                [
                    110.0,
                    319.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event the University determines that a position should be reclassified or designated for exclusion with the result that the position would be removed from the unit, it shall notify the Union in writing. If the Union believes that the reclassification or designation violates this Agreement, it shall notify the University within 30 calendar days of receipt of the University's notice that it wishes to challenge the matter through expedited arbitration. Subsequent to the Union's notice but prior to selection of an arbitrator, the University shall arrange a meeting to include the employee whose job is in question, a Union representative, and a University representative to review the contents of the employee's job.",
            "block_bbox": [
                181,
                347,
                1123,
                598
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    181.0,
                    347.0
                ],
                [
                    1123.0,
