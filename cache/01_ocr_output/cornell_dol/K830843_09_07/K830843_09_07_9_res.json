                    182.0,
                    845.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Within five working days of the Union's notice to the University, the arbitrator shall be selected by mutual agreement or by the alternate striking of names.",
            "block_bbox": [
                252,
                870,
                1119,
                956
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    252.0,
                    870.0
                ],
                [
                    1119.0,
                    870.0
                ],
                [
                    1119.0,
                    956.0
                ],
                [
                    252.0,
                    956.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The hearing shall be held within two weeks of the arbitrator's selection or, if that is not possible, on the arbitrator's first available date thereafter; provided that if the arbitrator has no available date within four weeks, another arbitrator shall be selected.",
            "block_bbox": [
                253,
                981,
                1119,
                1093
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    253.0,
                    981.0
                ],
                [
                    1119.0,
                    981.0
                ],
