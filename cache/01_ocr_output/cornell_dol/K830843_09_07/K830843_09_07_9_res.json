        },
        {
            "block_label": "paragraph_title",
            "block_content": "1. Exclusive Process",
            "block_bbox": [
                185,
                677,
                475,
                706
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    185.0,
                    677.0
