                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "F. EXPEDITED ARBITRATION",
            "block_bbox": [
                110,
                621,
                501,
                650
            ],
            "block_id": 3,
            "block_order": 4,
