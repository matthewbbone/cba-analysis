                    253.0,
                    348.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) The Per Diem employee has worked 1000 hours in Per Diem status, exclusive of overtime and on-call hours, in a rolling 12 month period; and",
            "block_bbox": [
                328,
                372,
                1120,
                458
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    328.0,
                    372.0
                ],
                [
                    1120.0,
