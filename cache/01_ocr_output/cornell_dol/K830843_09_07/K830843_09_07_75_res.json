        {
            "block_label": "text",
            "block_content": "a. Articles 7 - Discipline and Dismissal, 9 - Grievance Procedure, and 3 - Arbitration Procedure shall apply to any Per Diem employee as long as the following conditions are satisfied.",
            "block_bbox": [
                253,
                262,
                1119,
                348
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    253.0,
