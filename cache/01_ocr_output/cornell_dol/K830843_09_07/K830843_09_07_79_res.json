                    109.0,
                    377.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "E. The shift differential shall be included in payments for all types of paid leave, provided that the employee would have been expected to work that shift or shifts if the employee were not on paid leave.",
            "block_bbox": [
                110,
                400,
                1121,
                486
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
