        {
            "block_label": "paragraph_title",
            "block_content": "F. PREFERENTIAL REHIRE",
            "block_bbox": [
                110,
                262,
                474,
                292
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
