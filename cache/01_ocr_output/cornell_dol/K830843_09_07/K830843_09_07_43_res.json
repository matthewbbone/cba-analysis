        {
            "block_label": "paragraph_title",
            "block_content": "1. Benefit Eligibility",
            "block_bbox": [
                189,
                676,
                458,
                707
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
