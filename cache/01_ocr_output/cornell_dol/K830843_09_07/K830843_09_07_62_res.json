        {
            "block_label": "paragraph_title",
            "block_content": "A. JURISDICTIONAL AREAS",
            "block_bbox": [
                110,
                290,
                485,
                319
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
