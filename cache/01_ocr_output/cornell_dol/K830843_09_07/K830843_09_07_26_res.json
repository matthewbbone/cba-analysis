                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The designated campus official must receive the written appeal within fifteen (15) calendar days of the date on which the written response to Step 1 was given or due.",
            "block_bbox": [
                254,
                1611,
                1121,
                1696
