        {
            "block_label": "paragraph_title",
            "block_content": "1. Step 1",
            "block_bbox": [
                185,
                428,
                336,
                459
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
