            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The employee or the employee’s representative shall submit the written appeal to the designated campus official. The campus official to whom Step 2 appeals must be presented shall be a designee of the Chancellor of the campus.",
            "block_bbox": [
                254,
                1473,
                1121,
                1586
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
