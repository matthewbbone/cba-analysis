    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "The parties understand that such requests for discussion will occur on a very limited basis and will not be made with respect to actions including but not limited to those resulting from the expiration of appointment, programs or grant funds, or the decision not to continue, rehire or extend the employment of a casual employee The parties further understand that the opportunity for such discussion in very limited circumstances does not in any way confer upon a limited employee any property or process right and does not in any way obligate or commit a designated campus official to any specific course of action or procedure.",
            "block_bbox": [
