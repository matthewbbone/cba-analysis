        },
        {
            "block_label": "text",
            "block_content": "If the grievance is not satisfactorily resolved at Step 1, the employee or the Union may proceed to Step 2 by filing an appeal as follows:",
            "block_bbox": [
                254,
                1391,
                1119,
                1448
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
