        },
        {
            "block_label": "paragraph_title",
            "block_content": "7. Extensions of Leaves",
            "block_bbox": [
                182,
                1146,
                510,
                1176
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
