        {
            "block_label": "text",
            "block_content": "A. 1. The University shall have the authority to discharge or to take other appropriate disciplinary action against a non-probationary career employee for just cause. For purposes of illustration but not limitation, such actions may be taken for misconduct or failure to perform satisfactorily.",
            "block_bbox": [
                109,
                925,
                1120,
                1039
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    109.0,
