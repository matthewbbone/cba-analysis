        {
            "block_label": "text",
            "block_content": "1. Non-probationary employees in career positions who are residents of the State of California and who are admitted to the University are eligible for a two-thirds (2/3) reduction of both the University registration fee and the University educational fee per quarter or semester, for up to nine (9) units or three (3) regular session University courses, per quarter (or six (6) units or two (2) regular session University courses per semester), whichever is greater.",
            "block_bbox": [
                177,
                152,
                1121,
                321
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    177.0,
                    152.0
                ],
                [
                    1121.0,
                    152.0
                ],
                [
                    1121.0,
                    321.0
                ],
                [
                    177.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. An employee so registered shall not be eligible for the services or facilities of counseling centers, gymnasia, or student health services incidental to such reduced-fee registration.",
            "block_bbox": [
                175,
                345,
                1121,
                431
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
