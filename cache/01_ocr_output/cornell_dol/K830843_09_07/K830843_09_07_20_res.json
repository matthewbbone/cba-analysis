                    1120.0,
                    1039.0
                ],
                [
                    109.0,
                    1039.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Such non-probationary career employee who alleges that such action is not based on just cause may appeal such action pursuant to the provisions of Article 9 - Grievance Procedure.",
            "block_bbox": [
                179,
                1063,
                1121,
                1149
            ],
            "block_id": 8,
