        {
            "block_label": "text",
            "block_content": "The University shall provide each employee with a base-building salary adjustment of four percent (4%) effective September 1, 2006 or the closest start of the pay period for the individual's bi-weekly or semi-monthly paycheck.",
            "block_bbox": [
