                    189.0,
                    543.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. At least thirty (30) calendar days prior to implementing the increases referenced in Section B.1, above, the University shall inform AFSCME.",
            "block_bbox": [
                186,
                566,
