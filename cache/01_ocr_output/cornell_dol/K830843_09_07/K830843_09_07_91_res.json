        },
        {
            "block_label": "text",
            "block_content": "1. The provisions of this section will take place effective January 28, 2002.",
            "block_bbox": [
                188,
                704,
                1014,
                735
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    188.0,
                    704.0
