        {
            "block_label": "text",
            "block_content": "1. The University may increase, during the term of this agreement, individual salary rates, or salary ranges for selected classes at selected locations. The University may also increase, for selected classes at selected locations, during the term of the agreement, shift differentials, on-call rates and/or extend the coverage of such rates. Likewise, nothing shall preclude the University from providing equity adjustments in addition to those provided in Section C, below.",
            "block_bbox": [
                189,
                346,
                1123,
                543
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
