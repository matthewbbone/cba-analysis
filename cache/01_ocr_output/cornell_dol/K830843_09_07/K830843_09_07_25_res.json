                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) The initial hand-delivered filing of a grievance and the retrieval of University documents provided pursuant to a written request for information related to a grievance;",
            "block_bbox": [
                327,
                484,
                1121,
                568
            ],
            "block_id": 4,
