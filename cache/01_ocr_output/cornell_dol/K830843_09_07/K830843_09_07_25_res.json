            ]
        },
        {
            "block_label": "text",
            "block_content": "2) One-on-one meetings with a grievant concerning a filed grievance, or an alleged violation of this Agreement which is at the Informal Review stage of Article 9 - Grievance Procedure;",
            "block_bbox": [
                325,
                595,
                1120,
                679
            ],
