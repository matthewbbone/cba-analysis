            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The use of the maximum of 10 hours shall be for grievance-related activity such as:",
            "block_bbox": [
                255,
                401,
                1120,
                458
            ],
            "block_id": 3,
            "block_order": 4,
