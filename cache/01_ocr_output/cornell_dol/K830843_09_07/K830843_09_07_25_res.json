        {
            "block_label": "text",
            "block_content": "c. A request for release time will be made to the AFSCME designated employee representative's supervisor prior to the activity. Such approval shall be granted solely on the basis of operational need and shall not be denied unreasonably.",
            "block_bbox": [
                254,
