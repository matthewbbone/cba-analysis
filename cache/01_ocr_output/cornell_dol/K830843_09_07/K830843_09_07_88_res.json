            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Earned vacation for each month or quadri-weekly cycle is credited on the first day of the following month or quadri-weekly cycle, except that proportionate vacation credit for an eligible employee who is separating from employment shall be credited at the completion of the last day on pay status. A full-time employee on the Factor Accrual System may earn vacation credit to a maximum stated in Section A.1. above. A full-time employee on the Table Accrual System may earn vacation credit to a maximum of two (2) times the employee's annual accumulation rate. A part-time employee may earn vacation credit to the same maximum number of hours as a full-time employee with comparable years of service.",
            "block_bbox": [
                180,
                814,
                1122,
                1094
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
