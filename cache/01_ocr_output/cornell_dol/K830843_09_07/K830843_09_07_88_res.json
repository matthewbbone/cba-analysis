            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "C. VACATION SCHEDULING",
            "block_bbox": [
                110,
                1338,
                483,
                1368
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
