        {
            "block_label": "text",
            "block_content": "Vacation leave is scheduled at the convenience of the University. An employee appointed at fifty percent (50%) or more of full-time for a period of six (6) months or more is eligible to earn vacation credit from the date of hire; however, an employee may not use vacation credit until after six (6) continuous months on pay status. No vacation shall be used prior to the time it is credited.",
            "block_bbox": [
                180,
                1174,
                1121,
                1315
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
