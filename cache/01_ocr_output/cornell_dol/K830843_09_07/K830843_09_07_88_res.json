        {
            "block_label": "text",
            "block_content": "5. An employee must be on pay status for a least one-half (1/2) of the working hours of a month or quadri-weekly cycle to earn vacation credit for that month or quadri-weekly cycle. Vacation credit is earned proportionately for hours on pay status over one-half (1/2) of the full-time working hours of the month or quadri-weekly cycle but less than full-time. Time on pay status in excess of a full-time employee's work schedule does not earn vacation credit.",
            "block_bbox": [
                180,
                621,
                1121,
                791
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
