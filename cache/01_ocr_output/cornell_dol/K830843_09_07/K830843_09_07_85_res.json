        },
        {
            "block_label": "text",
            "block_content": "e. Among equally qualified non-probationary career applicants for promotion or transfer, seniority will be considered as a tie-breaker. The use of seniority as a tie-breaker determination is non-grievable and non-arbitrable.",
            "block_bbox": [
                253,
                1092,
                1122,
                1204
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
