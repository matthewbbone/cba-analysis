    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "When such leaves are exhausted and when the employee is still unable to work because of such illness or injury, the employee may be granted a leave without pay for the remainder of the period in which he/she is medically authorized for Workers' Compensation temporary disability, but not to exceed a total absence from work of twelve (12) months or a predetermined date of separation, whichever is earlier.",
            "block_bbox": [
                253,
                98,
                1121,
                265
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
