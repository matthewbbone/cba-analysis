            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Military leave with pay shall be granted to an employee in accordance with K.2.b and L.3.b, regardless of length of service, when the employee is required to take a pre-induction or pre-enlistment physical examination to fulfill a commitment under a Selective Service or comparable law, or during a period of war or comparable national emergency. The University may require verification of an employee's military orders to report for a physical examination.",
            "block_bbox": [
                182,
                429,
                1121,
                598
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    182.0,
                    429.0
                ],
                [
                    1121.0,
                    429.0
                ],
