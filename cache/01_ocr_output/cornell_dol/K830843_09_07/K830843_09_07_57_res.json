                    182.0,
                    598.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The University may grant leave without pay for further physical examinations required for military service or the employee may charge such time off to accrued sick leave, accrued vacation or accrued compensatory time off.",
            "block_bbox": [
                186,
                622,
                1120,
                707
