        {
            "block_label": "paragraph_title",
            "block_content": "N. PHYSICAL EXAMINATION",
            "block_bbox": [
                111,
                372,
                493,
                402
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
