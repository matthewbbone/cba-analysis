        {
            "block_label": "text",
            "block_content": "a. Following release from active duty, an employee granted leave for emergency National Guard duty shall have such right to return, and only such right, as may be required by state and federal law in effect at the time the employee applies for reinstatement.",
            "block_bbox": [
                254,
                153,
                1121,
                266
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
