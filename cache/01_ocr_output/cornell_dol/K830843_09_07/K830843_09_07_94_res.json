                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The University shall inform the employee that a medical release to return is required as soon as practicable after the need for such documentation is determined; and",
            "block_bbox": [
                253,
                1313,
                1120,
                1396
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
