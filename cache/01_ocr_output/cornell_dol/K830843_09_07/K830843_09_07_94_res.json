                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The employee shall provide the University with the required medical release as soon as possible after the medical release is available to the employee. When possible, the employee shall provide such documentation thirty (30) calendar days prior to the anticipated date of return; and",
            "block_bbox": [
                253,
                1422,
