        {
            "block_label": "text",
            "block_content": "An employee who is receiving temporary disability payments and extended sick leave benefits as described in Section C above is considered to be on regular pay status for purposes of application of provisions of this Agreement, except completion of the probationary period. However, sick leave and vacation earned during this period is credited to the employee only upon return to work. If an employee separates without returning to work, the employee shall be paid for vacation earned during the period the employee received extended sick leave payment.",
            "block_bbox": [
                253,
                430,
                1122,
                653
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
