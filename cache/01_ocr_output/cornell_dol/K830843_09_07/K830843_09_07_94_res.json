        {
            "block_label": "paragraph_title",
            "block_content": "3. Leave Without Pay",
            "block_bbox": [
                183,
                677,
                478,
                706
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
