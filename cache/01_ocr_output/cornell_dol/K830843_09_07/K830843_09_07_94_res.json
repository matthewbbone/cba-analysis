        },
        {
            "block_label": "text",
            "block_content": "2. When a medical release to return is required by the University:",
            "block_bbox": [
                182,
                1257,
                927,
                1287
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
