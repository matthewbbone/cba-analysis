        {
            "block_label": "text",
            "block_content": "1. An employee who has been granted a leave of absence due to a work-incurred injury or illness shall be reinstated as soon as possible to the same or a similar position held at the time the leave was granted when the following conditions are met:",
            "block_bbox": [
                183,
                953,
                1120,
                1065
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    183.0,
                    953.0
                ],
                [
                    1120.0,
                    953.0
                ],
                [
                    1120.0,
                    1065.0
                ],
                [
                    183.0,
                    1065.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The employee has notified the University of his/her anticipated date of return; and",
            "block_bbox": [
                253,
                1091,
                1120,
                1148
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    253.0,
