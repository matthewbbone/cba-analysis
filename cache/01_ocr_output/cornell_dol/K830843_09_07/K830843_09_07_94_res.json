                    253.0,
                    1148.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. If required by the University, the employee has provided medical documentation that he/she has been medically released to perform the normal duties of his/her job.",
            "block_bbox": [
                253,
                1174,
                1120,
                1256
            ],
            "block_id": 10,
