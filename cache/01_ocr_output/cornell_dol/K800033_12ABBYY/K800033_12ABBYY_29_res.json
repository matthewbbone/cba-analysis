        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.10 Authorized Leave of Absence Without Pay",
            "block_bbox": [
                138,
                684,
                775,
                713
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
