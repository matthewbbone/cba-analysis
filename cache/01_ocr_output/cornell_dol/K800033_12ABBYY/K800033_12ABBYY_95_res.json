                    169.0,
                    401.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. An employee in a Unit 9 title as of December 27, 1986; which is reclassified to a lower job grade effective December 28, 1986, shall continue to be paid at the job grade he/she held as of December 27, 1986, for whatever period he/she serves in the title reclassified lower, unless subsequent to promotion to a higher title he/she is returned for disciplinary reasons to the title reclassified lower.",
            "block_bbox": [
                166,
                423,
                1047,
                589
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    166.0,
                    431.0
