        {
            "block_label": "text",
            "block_content": "The parties understand that the following contract provisions remain in effect for any employee in a Unit 9 job title as of December 27, 1986, affected by implementation of the Classification Study effective December 28, 1986:",
            "block_bbox": [
                169,
                313,
                1047,
                401
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
