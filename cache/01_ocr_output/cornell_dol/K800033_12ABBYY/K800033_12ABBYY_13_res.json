                    352.994140625
                ],
                [
                    137.68701171875,
                    360.994140625
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 6.2",
            "block_bbox": [
                140,
                392,
                272,
                420
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
