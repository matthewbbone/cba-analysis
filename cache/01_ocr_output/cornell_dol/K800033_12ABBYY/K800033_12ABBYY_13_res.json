        {
            "block_label": "text",
            "block_content": "I’ve Employer and MOSES agree not to discriminate in any way against employees covered by this Agreement on account of race, religion, creed, color, national origin, sex, sexual orientation, age, mental or physical handicap, or veteran status.",
            "block_bbox": [
                137,
                272,
                1081,
                361
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
