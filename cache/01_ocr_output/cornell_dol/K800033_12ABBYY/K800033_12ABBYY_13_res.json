                ],
                [
                    1085.0,
                    695.0
                ],
                [
                    137.0,
                    695.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 6.3",
            "block_bbox": [
                139,
                726,
                271,
                754
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    139.0,
