        {
            "block_label": "text",
            "block_content": "I. A regular part-time employee shall not accrue sick leave credit for any month in which he/she was on leave without pay or absent without pay in the same proportion that his/her service bears to one day of service of a full-time employee;",
            "block_bbox": [
                136,
                444,
