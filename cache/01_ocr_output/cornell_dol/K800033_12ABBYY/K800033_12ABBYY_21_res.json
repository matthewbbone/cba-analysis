                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "K. Where the Appointing Authority has reason to believe that sick leave is being abused, the Appointing Authority may require satisfactory medical evidence from the employee. This request shall be reduced to writing and shall cite specific reasons for the request. When medical evidence is requested, such request shall be made as promptly as possible. To the extent possible, the employee shall receive prior notice that the Appointing Authority believes s/he is abusing sick leave and that s/he may be required to produce medical evidence for future use of sick leave.",
            "block_bbox": [
                137,
                881,
                1083,
                1083
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    137.0,
                    881.0
                ],
