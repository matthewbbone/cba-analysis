        {
            "block_label": "text",
            "block_content": "Employees whose conduct does not conform to the rules and guidelines contained in this Code may be subject to disciplinary action, up to and including termination. Any disciplinary action taken will conform to civil service law and/or the provisions of the collective bargaining agreement.",
            "block_bbox": [
                353,
                847,
                1060,
                962
            ],
            "block_id": 7,
            "block_order": 8,
