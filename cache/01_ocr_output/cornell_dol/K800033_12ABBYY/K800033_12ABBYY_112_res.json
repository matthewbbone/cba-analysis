        },
        {
            "block_label": "text",
            "block_content": "Each employee is required to know the Code of Conduct and rules contained herein, to seek information from his/her appointing authority, the appointing authority’s designee or personnel office in case of doubt or misunderstanding as to their application.",
            "block_bbox": [
                353,
                535,
                1081,
                651
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
