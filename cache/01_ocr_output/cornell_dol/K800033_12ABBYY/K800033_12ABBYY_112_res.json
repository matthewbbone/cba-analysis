                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Decisions in personnel matters involving disciplinary action will be based on the presumption that each employee has familiarized himself/herself with this Code and that he or she is aware of the obligation to abide by it.",
            "block_bbox": [
                353,
