                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Upon evidence satisfactory to the Appointing Authority of the death of a spouse, child, parent, brother, sister, grandparent, grandchild, or parent of spouse, or person living in household an employee shall be entitled to leave without loss of pay for a maximum of four consecutive calendar days commencing with the date of death or ending after the date of the funeral, at the option of the employee.",
            "block_bbox": [
                136,
                201,
                1084,
                354
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    136.0001678466797,
                    209.0
                ],
                [
                    1081.76708984375,
                    200.95947265625
                ],
                [
                    1083.0001220703125,
                    346.0
                ],
                [
                    137.2332000732422,
                    354.04052734375
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.4 Voting Leave",
            "block_bbox": [
                140,
                386,
                509,
                415
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    140.0,
                    386.0
                ],
                [
                    509.0,
                    386.0
                ],
                [
                    509.0,
                    415.0
                ],
                [
                    140.0,
                    415.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee whose hours of work preclude him/her from voting in a town, city, state, or national election shall upon application be granted a voting leave with pay, not to exceed two hours, for the sole purpose of voting in the election.",
            "block_bbox": [
                137,
                449,
                1083,
                540
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    449.0
                ],
                [
                    1083.0,
                    449.0
                ],
                [
                    1083.0,
                    540.0
                ],
                [
                    137.0,
                    540.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.5 Civic Duty Leave",
            "block_bbox": [
                139,
                572,
                549,
                601
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    139.0,
                    572.0
                ],
                [
                    549.0,
                    572.0
                ],
                [
                    549.0,
                    601.0
                ],
                [
                    139.0,
                    601.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. Employees summoned for jury duty will be granted a leave of absence with pay for time lost from their regular work schedule while on said jury duty upon presentation of appropriate summons to the department head by the employee.",
            "block_bbox": [
                137,
                635,
                1082,
                728
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    635.0
                ],
                [
                    1082.0,
                    635.0
                ],
                [
                    1082.0,
                    728.0
                ],
                [
                    137.0,
                    728.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. An employee who receives jury fees for jury service upon presentation of the appropriate court certificate of service, shall either:",
            "block_bbox": [
                138,
                758,
                1082,
                821
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    138.0,
                    758.0
                ],
                [
                    1082.0,
                    758.0
                ],
                [
                    1082.0,
                    821.0
                ],
                [
                    138.0,
                    821.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) retain such jury fees in lieu of pay for the period of jury service if the jury fees exceed his/her regular rate of compensation for the period involved; or",
            "block_bbox": [
                210,
                851,
                1082,
                912
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    210.0,
                    851.0
                ],
                [
                    1082.0,
                    851.0
                ],
                [
                    1082.0,
                    912.0
                ],
                [
                    210.0,
                    912.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) remit to the appointing authority the jury fees if less than his/her regular rate of compensation for the period involved.",
            "block_bbox": [
                211,
                944,
                1080,
                1003
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    211.0,
                    944.0
                ],
                [
                    1080.0,
                    944.0
                ],
                [
                    1080.0,
                    1003.0
                ],
                [
                    211.0,
                    1003.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. Jury fees for the purpose of this Article shall be the per diem rate paid for jury duty by the court not including the expenses reimbursed for travel, meals, rooms, or incidentals.",
            "block_bbox": [
                137,
                1036,
                1084,
                1127
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    137.0,
                    1036.0
                ],
                [
                    1084.0,
                    1036.0
                ],
                [
                    1084.0,
                    1127.0
                ],
                [
                    137.0,
                    1127.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "D. An employee summoned as a witness in court on behalf of the Commonwealth or any town, city or county of the Commonwealth or on behalf of the federal government shall be granted court leave with pay upon filing of the appropriate notice of service with his/her department head except that this Section shall not apply to an employee who is also in the employ of any town, city, or county of the Commonwealth or in the employ of the federal government or any private employer and who is summoned on a matter arising from that employment.",
            "block_bbox": [
