        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 7.2 Overtime",
            "block_bbox": [
                139,
                907,
                469,
                935
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    139.0,
                    907.0
                ],
                [
                    469.0,
                    907.0
                ],
                [
                    469.0,
                    935.0
                ],
