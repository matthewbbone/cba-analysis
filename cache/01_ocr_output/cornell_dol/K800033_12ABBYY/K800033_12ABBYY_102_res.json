                ],
                [
                    1078.0,
                    460.0
                ],
                [
                    1078.0,
                    576.0
                ],
                [
                    137.0,
                    576.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The Commonwealth recognizes that under M.G.L. c. 149, section 148, employees are entitled to receive a suitable paycheck or pay slip and will conform to such statute until or unless amended. The Union reserves its right to oppose an amendment or alteration of said law;",
            "block_bbox": [
                140,
                601,
                1085,
                718
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    140.0,
                    601.0
                ],
                [
                    1085.0,
                    601.0
                ],
                [
                    1085.0,
                    718.0
                ],
                [
                    140.0,
                    718.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The Commonwealth will make every effort to ensure that no cost impact will occur to employees through the implementation of the HR/CMS Project.",
            "block_bbox": [
                137,
                743,
                1077,
                802
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
