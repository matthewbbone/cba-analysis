        {
            "block_label": "text",
            "block_content": "The Commonwealth of Massachusetts (“Employer”) and the Massachusetts Organization of State Engineers and Scientists, (“MOSES”), representing employees in Bargaining Unit 9, agree to the following understandings reached during negotiations for a successor Collective Bargaining Agreement. It shall be agreed to by the parties that:",
            "block_bbox": [
                137,
                460,
                1078,
                576
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
