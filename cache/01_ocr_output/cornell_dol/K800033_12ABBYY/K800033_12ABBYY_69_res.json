        },
        {
            "block_label": "text",
            "block_content": "A. MOSES or any employee may challenge the accuracy or propriety of such material and personnel evaluation by filing a written statement of the challenge in the personnel file.",
            "block_bbox": [
                136,
                479,
                1072,
                571
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    136.0,
