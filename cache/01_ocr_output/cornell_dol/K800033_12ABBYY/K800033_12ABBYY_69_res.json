                [
                    136.0,
                    571.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. An employee may file a grievance based on a personnel evaluation or on any material either of which results in a negative action. Upon a determination at any step of the grievance procedure that such personnel evaluation, any other material, or portion thereof, is either inaccurate or improperly placed in such employee's personnel records, such inaccurate evaluation, material, or portion thereof, shall be removed from the file, together with any of the employee's statement or statements thereto.",
            "block_bbox": [
                136,
                603,
                1070,
                789
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    136.0,
                    603.0
                ],
