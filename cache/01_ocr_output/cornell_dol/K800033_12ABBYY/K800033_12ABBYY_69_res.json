        {
            "block_label": "text",
            "block_content": "Whenever any material, including evaluations, is to be inserted into the personnel file or record of an employee, such employee shall I be promptly notified and given a copy of such material upon its insertion. Such material shall be date stamped before its insertion.",
            "block_bbox": [
