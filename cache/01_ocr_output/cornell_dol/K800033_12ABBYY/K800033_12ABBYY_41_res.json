                [
                    209.0,
                    994.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Compare the resultant amount to the rates for the higher job group into which the employee is being promoted;",
            "block_bbox": [
                211,
                1020,
                1082,
                1078
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
