                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. Whenever an employee paid in accordance with the salary schedules provided in Appendices B-1 through B-7 of this Agreement receives a promotion to a higher job group, the employee's new salary rate shall be calculated as follows:",
            "block_bbox": [
                137,
                736,
                1083,
                825
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    736.0
                ],
                [
                    1083.0,
                    736.0
                ],
                [
                    1083.0,
                    825.0
                ],
                [
                    137.0,
                    825.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Determine the employee's salary rate at his/her current job group;",
            "block_bbox": [
                211,
                850,
                955,
                880
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    211.0,
                    850.0
                ],
                [
                    955.0,
                    850.0
                ],
                [
                    955.0,
                    880.0
                ],
                [
                    211.0,
                    880.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Find the next higher step within the employee's current job group, or, for employees at the maximum rate within their current job group, multiply the employee's current salary rate by one plus two one-hundredths (1.02);",
            "block_bbox": [
                209,
                908,
                1083,
                994
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
