        {
            "block_label": "text",
            "block_content": "The following shall apply to full time employees:",
            "block_bbox": [
                210,
                325,
                730,
                354
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
