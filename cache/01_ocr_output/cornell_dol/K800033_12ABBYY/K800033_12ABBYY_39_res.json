                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Effective January 7, 2001 employees who meet the eligibility criteria provided in Section 12.2 of this article shall receive a three percent (3%) increase in salary rate.",
            "block_bbox": [
                281,
                777,
                1081,
                863
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
