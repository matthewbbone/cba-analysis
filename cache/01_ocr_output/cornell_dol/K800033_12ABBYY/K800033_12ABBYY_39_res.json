                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. Effective January 2, 2000 employees who meet the eligibility criteria provided in Section 12.2 of this article shall receive a three percent (3%) increase in salary rate.",
            "block_bbox": [
                208,
                380,
                1080,
                467
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    208.0,
                    380.0
                ],
                [
                    1080.0,
                    380.0
                ],
                [
                    1080.0,
                    467.0
                ],
                [
                    208.0,
                    467.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Effective January 1, 2001 a step 12 is established at 2% above the existing step 11 for each job group. For the purposes outlined in section 4 of this Article, employees who have occupied step 11 of their job group for 52 or more weeks of creditable service as of January 1, 2001 shall be provided with a date of next step increase in calendar year 2001 which corresponds to the month and day on which the employee received his/her most recent step increase. Employees who have occupied Step 11 of their job group for less than 52 weeks as of January 1, 2001 shall advance to Step 12 after fifty-two (52) weeks of creditable service in Step 11.",
            "block_bbox": [
                210,
                494,
                1083,
                752
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    210.0,
                    494.0
                ],
