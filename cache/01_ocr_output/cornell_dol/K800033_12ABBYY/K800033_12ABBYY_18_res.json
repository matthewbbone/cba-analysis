    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "B. The stand-by period shall be fifteen hours in duration for any night stand-by duty including Saturdays, Sundays, and holidays, and shall be nine hours in duration for any daytime stand-by duty including Saturday, Sunday or holiday.",
            "block_bbox": [
                136,
                169,
                1084,
                261
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    136.0,
