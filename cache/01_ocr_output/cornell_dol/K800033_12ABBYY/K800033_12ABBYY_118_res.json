                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) The nature of the employment or business activity or the hours to be devoted to such activity would not impair the employee's availability, capacity or efficiency for the performance of his/her official duties as an employee of the Commonwealth.",
            "block_bbox": [
                282,
                478,
                1062,
                592
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
