        },
        {
            "block_label": "text",
            "block_content": "(2) The outside activity would not result in use, dissemination or disclosure to others of confidential information obtained in connection with the employee's departmental duties or position.",
            "block_bbox": [
                282,
                365,
                1071,
                453
            ],
            "block_id": 1,
