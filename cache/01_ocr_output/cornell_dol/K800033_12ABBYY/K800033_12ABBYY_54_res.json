        },
        {
            "block_label": "text",
            "block_content": "B.  $ \\underline{\\text{Actual Layoff}} $ - In the event the department/agency shall lay off a non-civil service employee because of a reduction in force, the least senior employee in the title in the department/agency or appointing authority, where applicable, shall be laid off. Seniority is based on service within the department/agency except that all provisional employees in a title must be laid off before any employee with temporary-from-certification status in the same title.",
            "block_bbox": [
                136,
                693,
                1081,
                879
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    136.0,
                    693.0
                ],
                [
                    1081.0,
                    693.0
                ],
                [
                    1081.0,
                    879.0
