        {
            "block_label": "text",
            "block_content": "A. Impending Layoff - In the event management becomes aware of an impending reduction in work force, which includes a civil service displacement, it will make every effort to notify MOSES at least twenty (20) calendar days prior to the layoff.",
            "block_bbox": [
                137,
                138,
                1078,
                232
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
