                    137.0,
                    446.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Prior to notifying employees of the reduction in force the Appointing Authority will first solicit volunteers for layoff within the Department/Agency. However, nothing contained in this article shall preclude the Appointing Authority from rejecting a volunteer based on the operational needs of the Department/Agency. During the reduction in force process, the Appointing Authority may also consider the termination of consultant contracts.",
            "block_bbox": [
                136,
                476,
                1070,
                662
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
