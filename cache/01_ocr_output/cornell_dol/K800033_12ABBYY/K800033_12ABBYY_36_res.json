        },
        {
            "block_label": "text",
            "block_content": "The above procedure may be waived by the employer if an employee is tardy due to severe weather conditions or if an employee is tardy for not more than two (2) hours due to events beyond the control of the employee. Denial of said waiver by the Employer may be appealed up to Step III of the grievance procedure if MOSES feels that such denial was arbitrary or capricious.",
            "block_bbox": [
