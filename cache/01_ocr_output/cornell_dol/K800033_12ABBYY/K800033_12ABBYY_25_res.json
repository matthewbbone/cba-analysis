        {
            "block_label": "text",
            "block_content": "F. An employee on court leave who has been excused by the proper court authority shall report to his/her official duty station if such interruption in court service will permit four or more consecutive hours of employment. Court leave shall not affect any employment rights of the individual.",
            "block_bbox": [
                136,
                293,
                1084,
                417
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    136.0,
                    293.0
                ],
                [
                    1084.0,
                    293.0
                ],
                [
                    1084.0,
                    417.0
                ],
                [
                    136.0,
                    417.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "G. No court leave shall be granted when the employee is the defendant or is engaged in personal litigation.",
            "block_bbox": [
                137,
                448,
                1083,
                509
            ],
