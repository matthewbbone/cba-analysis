        {
            "block_label": "text",
            "block_content": "E. All fees for court service except jury fees paid for service rendered during office hours must be paid to the Commonwealth. Any fees paid to an employee for court service performed during a vacation period may be retained by the employee. The employee shall retain expenses paid for travel, meals, rooms, etc.",
            "block_bbox": [
                137,
                139,
                1084,
                263
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
