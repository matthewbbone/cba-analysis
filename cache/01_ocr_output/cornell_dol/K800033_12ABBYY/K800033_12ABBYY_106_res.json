            ]
        },
        {
            "block_label": "text",
            "block_content": "MOSES and the Commonwealth agree and understand that the essential functions study of classification titles and specifications in the Commonwealth is critical to the Commonwealth's compliance with the Americans with Disabilities Act. The parties further agree and understand that the results of said study will have impacts upon the classification system statewide. The parties further agree and understand that the results of said study may likely necessitate alterations in the clas sification structure of Bargaining Unit 9, which may include the expansion of career ladders, the constriction of others, the creation of new job titles and the elimination of others.",
            "block_bbox": [
                137,
                521,
                1063,
                749
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    521.0
                ],
                [
                    1063.0,
                    521.0
                ],
                [
                    1063.0,
                    749.0
                ],
                [
                    137.0,
                    749.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties agree and understand that:",
            "block_bbox": [
                176,
                775,
                593,
                804
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    176.0,
                    775.0
                ],
                [
                    593.0,
                    775.0
                ],
                [
                    593.0,
                    804.0
                ],
                [
                    176.0,
                    804.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. HRD shall confer with MOSES regarding Unit 9 job specifications developed pursuant to the essential functions study, in accordance with Article 17.1, on or before June 30, 2001. Pursuant to Article 17.1, HRD shall determine job titles, the relationship of one classification to the other rs, and job specifications on or before December 31, 2001;",
            "block_bbox": [
                177,
                832,
                1050,
                973
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    177.0,
                    832.0
                ],
                [
                    1050.0,
                    832.0
                ],
                [
                    1050.0,
                    973.0
                ],
                [
                    177.0,
                    973.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The job grade placement for Unit 9 positions resulting from the essential functions study shall commence on or before January 1, 2002 and shall be completed, to the extent possible, up to a maximum expenditure of $500,000.00 on or before December 31, 2002. Said $500,000.00 shall continue to be available to address said Unit 9 job grade placement issues until completely depleted;",
            "block_bbox": [
                173,
                1002,
                1070,
                1173
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    173.0,
                    1002.0
                ],
                [
                    1070.0,
                    1002.0
                ],
                [
                    1070.0,
                    1173.0
                ],
                [
                    173.0,
                    1173.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3 Should the parties agree that job grade placement for Unit 9 positi ons resulting from the essential functions study requires funding greater than that allocated pursuant to paragraph 2, above, such funding will be discussed as part of negotiations for a successor collective bargaining agreement;",
            "block_bbox": [
                175,
                1200,
                1061,
                1315
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
