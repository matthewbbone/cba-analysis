        },
        {
            "block_label": "text",
            "block_content": "M. No employee shall be entitled to a leave under the provisions of this Article in excess of the accumulated sick leave credits due such employee.",
            "block_bbox": [
                137,
                705,
                1082,
                766
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
