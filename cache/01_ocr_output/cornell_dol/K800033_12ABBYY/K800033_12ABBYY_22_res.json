                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The employee shall be required to undergo a medical examination to determine his/her fitness for work. The employee, if he/she so desires, may be represented by a physician of his/her own choice, in which case such verification and cost shall be the responsibility of the employee. However, the Appointing Authority shall reserve the right to obtain a second opinion from a Commonwealth designated physician to determine fitness for work. Such cost shall be borne by the Appointing Authority.",
            "block_bbox": [
                137,
                489,
                1084,
                674
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
