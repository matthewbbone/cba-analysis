        {
            "block_label": "text",
            "block_content": "While an employee is performing the duties of a position classified in a grade lower than that in which the employee performs his/her duties, he/she shall be compensated at his/her regular rate of pay as if performing his/her regular duties.",
            "block_bbox": [
                137,
                845,
                1075,
                937
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
