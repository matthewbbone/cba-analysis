        },
        {
            "block_label": "text",
            "block_content": "The Commonwealth seeks to give employees the maximum freedom possible to engage in outside employment or business activities consistent with the Commonwealth’s responsibilities. However, the extremely sensitive mission of the Commonwealth and its employees necessitates certain restrictions. Employees may engage in outside employment or business activity provided such activity is not prohibited by this Code or by any statute, regulation or departmental order.",
            "block_bbox": [
                209,
                1016,
                1082,
                1189
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
