        },
        {
            "block_label": "text",
            "block_content": "B. An employee who travels from his/her home to a temporary assignment rather than to his/her regularly assigned office shall be allowed transportation expenses for the distance between his/her home and his/her temporary assignment or between his/her regularly assigned office and his/her temporary assignment whichever is less.",
            "block_bbox": [
                136,
                891,
                1083,
                1044
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
