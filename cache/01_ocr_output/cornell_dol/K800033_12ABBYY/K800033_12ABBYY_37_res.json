        {
            "block_label": "text",
            "block_content": "A. Effective 1/1/97, when an employee is authorized to use his/her personal automobile for travel related to his/her employment he/she shall be reimbursed at the rate of twenty-five cents per mile.",
            "block_bbox": [
                137,
                552,
                1082,
                645
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
