                    137.0,
                    645.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Effective 7/1/97, when an employee is authorized to use his/her personal automobile for travel related to his/her employment he/she shall be reimbursed at the rate of twenty-seven cents per mile.",
            "block_bbox": [
                137,
                675,
                1083,
                768
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
