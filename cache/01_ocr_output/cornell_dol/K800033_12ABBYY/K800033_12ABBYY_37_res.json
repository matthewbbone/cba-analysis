            ]
        },
        {
            "block_label": "text",
            "block_content": "This rate of reimbursement is intended to cover the costs of garages, parking, tolls, and other charges.",
            "block_bbox": [
                137,
                798,
                1080,
                860
            ],
            "block_id": 5,
