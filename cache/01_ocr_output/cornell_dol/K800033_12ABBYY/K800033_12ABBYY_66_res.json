        {
            "block_label": "text",
            "block_content": "The term \"grievance\" shall mean any dispute concerning the application or interpretation of the terms of this collective bargaining Agreement.",
            "block_bbox": [
                138,
                201,
                1074,
                262
            ],
            "block_id": 1,
