                ],
                [
                    137.49107360839844,
                    486.995849609375
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 12.7",
            "block_bbox": [
                139,
                506,
                291,
                536
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
