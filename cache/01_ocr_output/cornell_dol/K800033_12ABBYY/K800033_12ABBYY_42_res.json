                    137.0,
                    1106.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Should such employees return to their old job grade, they will be placed in the step rate in which they were employed at the time of separation consistent with past time in service.",
            "block_bbox": [
                137,
                1133,
                1084,
                1219
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
