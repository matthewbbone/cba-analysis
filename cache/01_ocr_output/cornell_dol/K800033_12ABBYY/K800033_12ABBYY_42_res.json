    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "An employee from within and without Unit 9 lowered in job group shall be placed in a step in grade in his/her new job group based upon the highest salary received through the following calculation:",
            "block_bbox": [
                137,
                138,
                1083,
                225
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    137.0,
                    138.0
                ],
                [
                    1083.0,
                    138.0
                ],
                [
                    1083.0,
                    225.0
                ],
                [
                    137.0,
                    225.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. credit for the step previously held in the job group plus years of service in higher job groups, or",
            "block_bbox": [
                211,
                251,
                1083,
                310
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    211.0,
                    251.0
                ],
                [
                    1083.0,
                    251.0
                ],
                [
                    1083.0,
                    310.0
                ],
                [
                    211.0,
                    310.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. credit for the step previously held in the next lower job group plus years of service in higher job groups plus the promotion factor of the new job group.",
            "block_bbox": [
                209,
                336,
                1084,
                395
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    209.0,
                    336.0
                ],
                [
                    1084.0,
                    336.0
                ],
                [
                    1084.0,
                    395.0
                ],
                [
                    209.0,
                    395.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "However, under no circumstances shall an employee receive a salary higher than that received in the position held prior to being lowered in job group.",
            "block_bbox": [
                137,
                421,
                1083,
                480
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
