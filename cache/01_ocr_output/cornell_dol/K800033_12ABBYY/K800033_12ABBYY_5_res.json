                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) all employees employed in short term jobs established by special federal or state programs such as summer jobs for underprivileged youths; and",
            "block_bbox": [
                283,
                1032,
                1082,
                1126
            ],
