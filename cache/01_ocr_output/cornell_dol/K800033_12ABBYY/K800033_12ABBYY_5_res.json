                ],
                [
                    136.0,
                    881.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. exclusion:",
            "block_bbox": [
                211,
                910,
                395,
                940
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
