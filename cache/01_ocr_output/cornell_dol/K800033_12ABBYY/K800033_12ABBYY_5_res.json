        },
        {
            "block_label": "text",
            "block_content": "As used in this contract the term \"employee\" or \"employees\" shall",
            "block_bbox": [
                209,
                695,
                888,
                726
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    209.0,
                    695.0
                ],
                [
                    888.0,
                    695.0
                ],
                [
                    888.0,
                    726.0
                ],
                [
                    209.0,
                    726.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. include full-time and regular part-time persons employed by the Commonwealth in job titles in the bargaining unit included in Section 1.1 above, including federally funded employees and seasonal employees whose employment is for a period of ninety consecutive days or more.",
            "block_bbox": [
                136,
                757,
                1083,
                881
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
