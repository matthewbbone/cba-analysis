        },
        {
            "block_label": "text",
            "block_content": "C. A full-time employee is defined as an employee who normally works a full workweek and whose employment is expected to continue for twelve months or more, or an employee who normally works a full workweek and has been employed for twelve consecutive months or more.",
            "block_bbox": [
                136,
                1218,
                1084,
                1340
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
