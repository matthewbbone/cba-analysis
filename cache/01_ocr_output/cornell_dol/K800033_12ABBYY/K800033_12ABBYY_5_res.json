                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) all managerial and confidential employees;",
            "block_bbox": [
                283,
                971,
                801,
                1004
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
