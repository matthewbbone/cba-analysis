        {
            "block_label": "text",
            "block_content": "This Memorandum of Understanding is entered into b between the Commonwealth of Massachusetts, through the Human Resources Division, and MOSES, Unit 9. The intent of this Memorandum of Understanding is to clarify the understanding reached by the parties concerning Article 8, Section 8.2., \"Paid Personal Lea ve\".",
            "block_bbox": [
                137,
                460,
                1081,
                575
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    460.0
                ],
                [
                    1081.0,
                    460.0
                ],
                [
                    1081.0,
                    575.0
                ],
                [
                    137.0,
                    575.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "MOSES employees are encouraged to utilize any current unused personal leave balances before December 31, 1999. It is understood that the employees will receive three new personal days upon implementation of the HR/CMS payroll system, and that those three personal days will be available for use between the advent of HR/CMS and December 31, 2000. However, no employee will be allowed to carry more than three personal days at any given time. If an employee has exhausted his/her personal leave by January 1, 2000, and said employee requires the use of personal leave before said implementation of HR/CMS, the Employer agrees to allow an employee to “draw” against their personal leave balance in advance of said implementation.",
            "block_bbox": [
                137,
                601,
                1069,
                859
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    601.0
                ],
                [
                    1069.0,
                    601.0
                ],
                [
                    1069.0,
                    859.0
                ],
                [
                    137.0,
                    859.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee’s unused but forfeable vacation time as of June 30, 2000 will not be forfeited as required by Article 9; rather said forfeiture shall not occur until December 31, 2000.",
            "block_bbox": [
                137,
                884,
                1060,
                969
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    884.0
                ],
                [
                    1060.0,
                    884.0
                ],
                [
                    1060.0,
                    969.0
                ],
                [
                    137.0,
                    969.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The provisions contained herein shall expire on December 31, 2000.",
            "block_bbox": [
                210,
                998,
                941,
                1027
