        },
        {
            "block_label": "paragraph_title",
            "block_content": "(a) General Prohibitions",
            "block_bbox": [
                356,
                650,
                631,
                677
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
