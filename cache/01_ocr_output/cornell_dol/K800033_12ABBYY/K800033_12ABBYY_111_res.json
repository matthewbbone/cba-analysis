            ]
        },
        {
            "block_label": "text",
            "block_content": "Please read these rules carefully and abide by their spirit as well as their letter. Each of us can take pride in belonging to an organization which contributes so much to the growth, strength and quality of life of the Commonwealth.",
            "block_bbox": [
                137,
                252,
                1082,
                338
            ],
            "block_id": 1,
