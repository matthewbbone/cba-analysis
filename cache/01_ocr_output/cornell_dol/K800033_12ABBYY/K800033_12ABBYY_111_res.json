                    392.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "As used in this Code, unless the context requires otherwise:",
            "block_bbox": [
                210,
                422,
                786,
                450
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    210.0,
                    422.0
                ],
                [
                    786.0,
