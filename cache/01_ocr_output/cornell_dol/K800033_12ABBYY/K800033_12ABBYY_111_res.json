                    213.0,
                    875.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. “nominal value” - means monetary worth not exceeding twenty-five dollars ($25.00).",
            "block_bbox": [
                211,
                904,
                1068,
                932
            ],
            "block_id": 8,
            "block_order": 9,
