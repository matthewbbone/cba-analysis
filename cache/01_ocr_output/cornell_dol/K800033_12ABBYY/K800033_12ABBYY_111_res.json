    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Guidance--both on what we are expected to do and on what we are prohibited from doing-- should help all of us understand generally what is expected of us. It should also help resolve particular situations we are faced with in our daily work.",
            "block_bbox": [
                138,
                139,
                1029,
                226
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
