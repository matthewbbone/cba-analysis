        {
            "block_label": "paragraph_title",
            "block_content": "Section 23A.12 Alternative Dispute Resolution (ADR) Committee",
            "block_bbox": [
                139,
                467,
                893,
                496
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    139.0,
