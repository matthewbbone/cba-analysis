        {
            "block_label": "paragraph_title",
            "block_content": "B. Medical Leave",
            "block_bbox": [
                211,
                337,
                455,
                365
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    211.0,
