                    775.0
                ],
                [
                    139.0,
                    775.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Attendance at Statewide, departmental, facility and local Labor -Management committee meetings, including reasonable travel and preparation time;",
