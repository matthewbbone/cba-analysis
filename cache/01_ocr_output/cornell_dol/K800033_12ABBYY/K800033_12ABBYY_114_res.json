                    210.0,
                    1217.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. No employee may request or receive, in any manner whatsoever, compensation or anything else of value, except from the Commonwealth: (a) for performance of his/her duties; or (b) for influencing or appearing to influence such performance.",
            "block_bbox": [
                211,
                1245,
                1073,
                1330
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
