                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Necessity For The Fair And Impartial Administration Of State Government And The Enforcement Of Its Laws Makes The Avoidance Of Any Conflict Of Interest Of Primary Importance. A Conflict Of Interest Is A Situation In Which An Employee's Private Interest, Usually Financial, Conflicts Or Raises A Reasonable Question Of Conflict With His/Her Official Duties And Responsibilities.",
            "block_bbox": [
                209,
                932,
                1055,
                1076
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    209.0,
                    932.0
                ],
                [
                    1055.0,
                    932.0
                ],
                [
                    1055.0,
                    1076.0
                ],
                [
                    209.0,
                    1076.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Chapter 268a Of The General Laws Provides Criminal And Civil Penalties For Conflict Of Interest Violations. The Following Three General Categories Of Prohibitions Are To Be Used As Guidelines For Your Information. (Chapter 268a Of The General Laws Offers Specific Details).",
            "block_bbox": [
                210,
                1102,
                1077,
                1217
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    210.0,
