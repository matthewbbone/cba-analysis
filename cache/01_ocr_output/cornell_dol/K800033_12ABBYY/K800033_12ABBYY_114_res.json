        {
            "block_label": "paragraph_title",
            "block_content": "5. CONFLICT OF INTEREST",
            "block_bbox": [
                140,
                876,
                466,
                903
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
