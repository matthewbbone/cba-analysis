    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Agency/departmental identification cards or badges may be used for personal identification purposes when cashing checks or as proof of employment, such as when applying for a loan, for credit or when renting an apartment.",
            "block_bbox": [
                210,
                138,
                1083,
                226
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    210.0,
                    137.99996948242188
                ],
                [
                    1081.9998779296875,
                    137.99996948242188
                ],
                [
                    1081.9998779296875,
                    217.99996948242188
                ],
                [
                    210.0,
                    217.99996948242188
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees are responsible for the safeguarding and proper use of agency/departmental identification cards, badges and access cards, for promptly reporting their loss and for surrendering them on termination of employment or demand by proper agency/departmental authorities.",
            "block_bbox": [
                210,
                251,
                1046,
                368
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    210.0,
                    251.0
                ],
                [
                    1046.0,
                    251.0
                ],
                [
                    1046.0,
                    368.0
                ],
                [
                    210.0,
                    368.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Cards, badges or documents, or an employee’s official position or status, are not to be used to exert influence or obtain, either directly or indirectly, personal privileges, favors or rewards for themselves or others. Photo identification badges must be worn while at work in any agency which requires them to be worn.",
            "block_bbox": [
                210,
                394,
                1084,
                509
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    210.0,
                    394.0
                ],
                [
                    1084.0,
                    394.0
                ],
                [
                    1084.0,
                    509.0
                ],
                [
                    210.0,
                    509.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "F. Political Activities",
            "block_bbox": [
                212,
                536,
                477,
                563
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    212.0,
                    536.0
                ],
                [
                    477.0,
                    536.0
                ],
                [
                    477.0,
                    563.0
                ],
                [
                    212.0,
                    563.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees are prohibited from using their offices or official duties to interfere with, affect or influence the results of a nomination or election for public office. No employee shall use his/her official authority directly or indirectly to coerce, attempt to coerce, command, advise or prevent any person or body to pay, lend or contribute anything of value to any party candidate or political committee.",
            "block_bbox": [
                210,
                592,
                1076,
                736
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    210.0,
                    592.0
                ],
                [
                    1076.0,
                    592.0
                ],
                [
                    1076.0,
                    736.0
                ],
                [
                    210.0,
                    736.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "No employee shall solicit or accept funds or anything of value for any party, political committee, agency, person or organization for political purposes.",
            "block_bbox": [
                210,
                762,
                1025,
                821
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    210.0,
                    762.0
                ],
                [
                    1025.0,
                    762.0
                ],
                [
                    1025.0,
                    821.0
                ],
                [
                    210.0,
                    821.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees are not prohibited from contributing to the campaign committee or organization for nomination or election of any individual running for public office or to any committee, agency, or organization for political purposes.",
            "block_bbox": [
                210,
                848,
                1047,
                935
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    210.0,
                    848.0
                ],
                [
                    1047.0,
                    848.0
                ],
                [
                    1047.0,
                    935.0
                ],
                [
                    210.0,
                    935.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees are prohibited from campaigning for political office for themselves or others during normal working hours. Employees are prohibited from being a candidate for federal, state or full-time municipal office while on active duty. Such employees must obtain a leave of absence to run for such offices.",
            "block_bbox": [
                210,
                960,
                1054,
                1075
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    210.0,
                    960.0
                ],
                [
                    1054.0,
                    960.0
                ],
                [
                    1054.0,
                    1075.0
                ],
                [
                    210.0,
                    1075.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees are prohibited from wearing a political or campaign button while on official agency/departmental business.",
            "block_bbox": [
                210,
                1101,
                1047,
                1161
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
