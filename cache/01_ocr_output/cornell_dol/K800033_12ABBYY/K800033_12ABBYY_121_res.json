                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees shall abide by the provisions of the following paragraph from M.G.L. Ch. 268A, Section 11 which provides:",
            "block_bbox": [
                210,
                1186,
                1026,
                1244
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
