        {
            "block_label": "text",
            "block_content": "Bribery and attempted bribery are claims which strike at the core of state government. Employees should be constantly alert to solicitations to accept money, consideration, or anything of value in return for acts or omissions involving their official functions. Such solicitations may be indirect and subtle. Any attempt to bribe a departmental employee shall be reported immediately to the proper agency authority.",
            "block_bbox": [
                210,
                225,
                1085,
                367
            ],
            "block_id": 1,
