            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "B. Recommending Professional Assistance",
            "block_bbox": [
                211,
                678,
                700,
                706
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
