            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees may not recommend or suggest, specifically or by implication, to anyone that he/she obtain the services of any particular accountant, attorney or firm of accountants or attorneys, or any other person or professional or business organization in connection with any official business which involves or may involve the agency/department.",
