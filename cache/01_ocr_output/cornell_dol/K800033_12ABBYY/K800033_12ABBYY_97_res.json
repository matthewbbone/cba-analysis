        },
        {
            "block_label": "text",
            "block_content": "7. Job duties and performance criteria shall be observed and measured to the extent practicable.",
            "block_bbox": [
                139,
                337,
                1078,
                394
            ],
            "block_id": 2,
            "block_order": 3,
