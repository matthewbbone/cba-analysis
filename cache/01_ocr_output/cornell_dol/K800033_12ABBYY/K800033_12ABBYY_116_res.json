            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "6. GIFTS AND GRATUITIES FROM OUTSIDE SOURCES",
            "block_bbox": [
                140,
                422,
                818,
                449
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
