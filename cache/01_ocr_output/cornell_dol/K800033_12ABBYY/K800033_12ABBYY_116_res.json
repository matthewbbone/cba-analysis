    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "These rules with respect to conflicts of interest are in addition to, and supplement, state policies and agency/departmental rules, regulations and operating procedures that may otherwise apply to the official actions of employees.",
            "block_bbox": [
                138,
                139,
                1075,
                225
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    138.0,
