                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "A. General Limitations",
            "block_bbox": [
                212,
                479,
                498,
                506
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    212.0,
                    479.0
                ],
                [
                    498.0,
                    479.0
                ],
                [
                    498.0,
                    506.0
                ],
                [
                    212.0,
                    506.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees shall not solicit or accept, directly or indirectly, any gift, gratuity, favor, entertainment, loan, or any other thing of monetary value, from a person who or entity which, the employee knows or has reason to know:",
            "block_bbox": [
                210,
                535,
                1043,
                622
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    210.0,
                    535.0
                ],
                [
                    1043.0,
                    535.0
                ],
                [
                    1043.0,
                    622.0
                ],
                [
                    210.0,
                    622.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) Has, or is seeking to obtain, contractual or other business or financial relations with his/her agency/department;",
            "block_bbox": [
                231,
                648,
                1060,
                706
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    231.0,
                    648.0
                ],
                [
                    1060.0,
                    648.0
                ],
                [
                    1060.0,
                    706.0
                ],
                [
                    231.0,
                    706.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) Conducts business or other activities which are regulated or monitored by the agency/department, except as permitted by this section or by agency/departmental directives; or",
            "block_bbox": [
                231,
                733,
                1050,
                819
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    231.0,
                    733.0
                ],
                [
                    1050.0,
                    733.0
                ],
                [
                    1050.0,
                    819.0
                ],
                [
                    231.0,
                    819.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) Has interests that may be or give the reasonable impression of being substantially affected by the performance or non-performance of the employee’s official duties.",
            "block_bbox": [
                231,
                847,
                1082,
                905
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    231.0,
                    847.0
                ],
                [
                    1082.0,
                    847.0
                ],
                [
                    1082.0,
                    905.0
                ],
                [
                    231.0,
                    905.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "B. Exceptions",
            "block_bbox": [
                211,
                961,
                400,
                989
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    211.0,
                    961.0
                ],
                [
                    400.0,
                    961.0
                ],
                [
