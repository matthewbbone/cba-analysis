        {
            "block_label": "text",
            "block_content": "The parties agree that All Unit 9 employees are covered by the provisions of Paragraphs A and B below:",
            "block_bbox": [
                181,
                278,
                1056,
                334
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
