        {
            "block_label": "paragraph_title",
            "block_content": "A. Family Leave",
            "block_bbox": [
                211,
                167,
                444,
                196
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
