                ],
                [
                    137.0,
                    676.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 19A.2",
            "block_bbox": [
                139,
                705,
                306,
                733
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
