        {
            "block_label": "text",
            "block_content": "Where operations such as hazardous waste spill cleanup, medical emergency, safety control, bituminous concrete placement, cement concrete placement, steel erection or other critical operations that require continuous monitoring requiring an employee to work through his/her lunch period, he/she shall be granted compensatory time at the rate of one and one-half his/her regular hourly rate of pay for the lunch period work.",
            "block_bbox": [
