            "block_content": "<table><tr><td>Company Service</td><td>Annual Vacation</td></tr><tr><td>1 thru 4 years</td><td>80 hours</td></tr><tr><td>5 thru 9 years</td><td>96 hours</td></tr><tr><td>10 and 11 years</td><td>120 hours</td></tr><tr><td>12 and 13 years</td><td>128 hours</td></tr><tr><td>14 and 15 years</td><td>136 hours</td></tr><tr><td>16 and 17 years</td><td>144 hours</td></tr><tr><td>18 years or more</td><td>160 hours</td></tr></table>",
