        {
            "block_label": "text",
            "block_content": "Company service date will be used to determine the credits to be awarded. Vacation credits may accumulate to a maximum of two years of credit (as determined from above schedule). No additional vacation credits will be accrued until the number of credits in the account drops below the two-year maximum.",
            "block_bbox": [
                100,
