        {
            "block_label": "text",
            "block_content": "8.3(d)(3) Employees on travel status may not be laid off while on such status. Such employees shall not be counted among or reduce the number of exceptions permitted by the provisions of 8.3 nor shall their retention prevent the layoff or downgrade of employees with a higher retention index who are otherwise subject to such action.",
            "block_bbox": [
                124,
                497,
                699,
                579
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
