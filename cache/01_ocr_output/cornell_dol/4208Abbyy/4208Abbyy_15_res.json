        },
        {
            "block_label": "text",
            "block_content": "8.3(d)(5) Employees laid off after refusing less than equivalent job offers made as a result of re-deployment activities will be considered involuntary layoffs and will be eligible for layoff benefits as defined in Article 21.",
            "block_bbox": [
                124,
                883,
                699,
                944
