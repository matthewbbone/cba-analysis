        {
            "block_label": "text",
            "block_content": "The parties hereby agree that SPEEA shall have access to the Boeing internal Web page. To that effect, the parties agree as follows:",
            "block_bbox": [
                76,
                395,
                710,
                437
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    76.0,
                    395.0
                ],
                [
                    710.0,
                    395.0
                ],
                [
                    710.0,
                    437.0
                ],
                [
                    76.0,
                    437.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) SPEEA shall maintain the confidentiality of all information, data and computer programs ('Information Assets') to which SPEEA has access, along with any passwords or access procedures given to facilitate access to 'authorized SPEEA users'.",
            "block_bbox": [
                102,
                453,
                710,
                513
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    102.0,
                    453.0
                ],
                [
                    710.0,
                    453.0
                ],
                [
                    710.0,
                    513.0
                ],
                [
                    102.0,
                    513.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) SPEEA shall only access the Information Assets specified by the Boeing Computing Access Focal Point, and then only in accordance with the access procedures.",
            "block_bbox": [
                103,
                528,
                709,
                570
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    103.0,
                    528.0
                ],
                [
                    709.0,
                    528.0
                ],
                [
                    709.0,
                    570.0
                ],
                [
                    103.0,
                    570.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) SPEEA shall not access any other Information Assets not approved by the Boeing Computing Access Focal Point.",
            "block_bbox": [
                102,
                586,
                710,
                627
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    102.0,
                    586.0
                ],
                [
                    710.0,
                    586.0
                ],
                [
                    710.0,
                    627.0
                ],
                [
                    102.0,
                    627.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(4) SPEEA shall not remove any Information Assets from Boeing computing systems, or delete, change or otherwise modify any Information Assets.",
            "block_bbox": [
                102,
                643,
                708,
                684
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    102.0,
                    643.0
                ],
                [
                    708.0,
                    643.0
                ],
                [
                    708.0,
                    684.0
                ],
                [
                    102.0,
                    684.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(5) Access to Information Assessments marked 'Boeing Limited' or bearing Government classified markings is strictly prohibited.",
            "block_bbox": [
                101,
                700,
                708,
                742
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
                [
                    101.0,
                    700.0
                ],
                [
                    708.0,
                    700.0
                ],
                [
                    708.0,
