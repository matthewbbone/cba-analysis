                    323.0
                ],
                [
                    128.0,
                    323.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "To work together to further the mutual success of both parties; so that the Company will continue to have a productive, flexible, competitive business with a highly-motivated, skilled and involved workforce while enabling SPEEA to best represent and serve its members.",
            "block_bbox": [
                128,
                338,
                732,
                401
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
