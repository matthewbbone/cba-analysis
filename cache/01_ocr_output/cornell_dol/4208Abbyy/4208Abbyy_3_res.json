            ]
        },
        {
            "block_label": "text",
            "block_content": "• To maintain a respectful, cooperative relationship; recognizing that the employees are the most valued resource The Boeing Company (the Company' or 'Boeing') has.",
            "block_bbox": [
                128,
                281,
                731,
                323
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
