        {
            "block_label": "text",
            "block_content": "Section 1.1 Recognition. For the purposes of collective bargaining with respect to rates of pay and other conditions of employment, the Company recognizes the Union as the exclusive bargaining agent for the collective bargaining unit described as follows:",
            "block_bbox": [
                101,
                550,
                732,
                612
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
