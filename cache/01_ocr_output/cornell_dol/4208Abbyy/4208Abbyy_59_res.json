                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The Company provides coverage under the Scheduled Dental Plan, Preferred Dental Plan, or Prepaid Dental Plan for employees who live in a service area of the Preferred Dental Plan or Prepaid Dental Plan.",
            "block_bbox": [
                98,
                508,
                701,
                567
            ],
