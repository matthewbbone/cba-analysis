                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Under the Prepaid Dental Plan, employees must select a participating provider from the prepaid provider network. No dental benefits are payable until the employee selects a participating provider.",
            "block_bbox": [
                124,
                583,
                700,
                643
            ],
            "block_id": 8,
