        {
            "block_label": "text",
            "block_content": "The Company agrees to pay employees covered by this agreement and on the active payroll or on leave of absence for ninety (90) days or less on both February 19, 2004, and on the date of the ratification of this agreement, a lump sum payment of eighteen hundred dollars ($1,800) less applicable withholding if this agreement is ratified on or before July 12, 2004.",
            "block_bbox": [
                63,
                148,
                697,
                229
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    63.0,
                    148.0
                ],
                [
                    697.0,
                    148.0
                ],
                [
                    697.0,
                    229.0
                ],
                [
                    63.0,
                    229.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The payment will be made two (2) weeks after ratification of this agreement.",
            "block_bbox": [
                63,
                243,
                527,
                266
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    63.0,
                    243.0
                ],
