        {
            "block_label": "text",
            "block_content": "Employees on inter-continental travel assignments for which time enroute exceeds twelve (12) continuous hours will not be required to work their regular shift on the date of departure and will receive a minimum of eight (8) hours pay for that day. When travel time enroute to a customer work location exceeds twelve (12) continuous hours, a minimum of twelve (12) hours rest will be provided prior to beginning work whenever possible within customer required schedules.",
            "block_bbox": [
