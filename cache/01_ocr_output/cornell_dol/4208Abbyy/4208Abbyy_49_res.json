                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) An employee will be authorized to telephone his home at Company expense in accordance with applicable Company policy. When necessary to use conventional long-distance service, the employee will be reimbursed for the cost of the call, provided the call is of reasonable duration.",
            "block_bbox": [
                94,
                543,
                698,
                621
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
