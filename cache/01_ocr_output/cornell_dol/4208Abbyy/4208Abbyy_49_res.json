            ]
        },
        {
            "block_label": "text",
            "block_content": "(5) For Company holidays which occur during a travel assignment employees shall receive eight (8) hours' holiday pay and, in addition, for time worked on a holiday, the employee shall be paid at his or her regular rate for twice the hours worked.",
            "block_bbox": [
                95,
