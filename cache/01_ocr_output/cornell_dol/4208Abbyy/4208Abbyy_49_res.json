        {
            "block_label": "text",
            "block_content": "Wage payment basis will be as follows:",
            "block_bbox": [
                71,
                126,
                306,
                148
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
