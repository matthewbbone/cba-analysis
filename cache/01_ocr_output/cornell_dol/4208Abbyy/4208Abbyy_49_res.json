                [
                    71.0,
                    148.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The employee shall receive at least eight hours pay for each regular workday on which the employee works or is available for work.",
            "block_bbox": [
                96,
                163,
                699,
                206
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    96.0,
                    163.0
                ],
                [
                    699.0,
                    163.0
                ],
                [
                    699.0,
                    206.0
                ],
                [
                    96.0,
                    206.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) The employee's regular rate shall include his or her base rate plus a weekend premium rate of $2.00 per hour.",
            "block_bbox": [
                96,
                220,
                700,
                261
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    96.0,
                    220.0
                ],
                [
                    700.0,
                    220.0
                ],
                [
                    700.0,
                    261.0
                ],
                [
                    96.0,
                    261.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) For time worked in excess of forty (40) through fifty-two (52) compensated hours in a work week on other than a second day of rest, the employee shall be paid one and one-half (1-1/2) times his or her base rate. For time worked in excess of fifty-two (52) compensated hours in a work week, the employee shall be paid at double his or her base rate.",
            "block_bbox": [
                96,
                277,
                699,
                356
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    96.0,
                    277.0
                ],
                [
                    699.0,
                    277.0
                ],
                [
                    699.0,
                    356.0
                ],
                [
                    96.0,
                    356.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(4) For time worked on the second day of rest and in excess of forty (40) compensated hours in a work week, the employee shall be paid at double his or her base rate.",
            "block_bbox": [
                95,
                372,
                697,
                413
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
