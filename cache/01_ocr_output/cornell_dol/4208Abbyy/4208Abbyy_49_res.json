        },
        {
            "block_label": "text",
            "block_content": "The following telephone and laundry allowance will be authorized:",
            "block_bbox": [
                68,
                505,
                471,
                526
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
