                    621.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) An employee on a travel assignment will be reimbursed for the cost of any laundry service which is reasonable and necessary in accordance with applicable Company policy.",
            "block_bbox": [
                94,
                637,
                696,
                678
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
