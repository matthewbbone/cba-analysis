            ]
        },
        {
            "block_label": "text",
            "block_content": "3.3(c) No matter shall be considered as a grievance under 3.3 unless it is presented to the designated persons within ten (10) workdays after occurrence of the last event on which the grievance is based.",
            "block_bbox": [
                137,
