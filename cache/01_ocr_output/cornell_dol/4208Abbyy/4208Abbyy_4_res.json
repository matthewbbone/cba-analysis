                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3.6(d) Each party to the proceedings may call such witnesses as may be necessary in the order in which their testimony is to be heard. Such testimony shall be limited to the matters set forth in the written statement of the grievance. The arguments of the parties may be supported by oral comment and rebuttal. Either or both parties may submit written briefs within a time period mutually agreed upon. Such arguments of the parties, whether oral or written, shall be confined to and directed at the matters set forth in the grievance.",
            "block_bbox": [
