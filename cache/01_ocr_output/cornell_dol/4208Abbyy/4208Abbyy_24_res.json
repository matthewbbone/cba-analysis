        {
            "block_label": "text",
            "block_content": "Section 11.4 Part-Time Employees. Any employee whose work schedule consists of a seven (7) -day cycle with fixed days and hours of work that are less than forty (40) hours over a regular work week, or a fourteen (14) -day cycle with fixed days and hours of work that are less than eighty (80) hours over two regular work weeks, and is not on a Category 2 Schedule, shall be considered as a part-time employee and shall be subject to all provisions of this Agreement except as otherwise provided in 11.4(a) through 11.4(f).",
            "block_bbox": [
                74,
                149,
                707,
                246
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
