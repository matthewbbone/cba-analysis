        },
        {
            "block_label": "text",
            "block_content": "11.4(c) Holidays. Employees are eligible for holiday pay if they are scheduled to work twenty (20) or more hours in a seven (7)-day cycle or forty (40) or more hours in a fourteen (14)-day cycle. Payment will be four (4) hours of holiday pay for each Company holiday, regardless of the calendar day or hours scheduled on the respective holiday.",
            "block_bbox": [
                99,
                395,
                705,
                474
            ],
            "block_id": 5,
