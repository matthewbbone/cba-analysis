        {
            "block_label": "text",
            "block_content": "11.4(b) Work Schedule Incentives. Employees assigned to second or third shift may receive a shift rate and a schedule factor incentive. Employees are not eligible to receive the weekend rate incentive.",
            "block_bbox": [
                99,
                338,
                705,
                379
            ],
            "block_id": 4,
