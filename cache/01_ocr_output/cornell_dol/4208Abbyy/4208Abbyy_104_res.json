                [
                    151.0,
                    320.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3) The plan of the parent without custody pays third.",
            "block_bbox": [
                150,
                334,
                482,
                358
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
