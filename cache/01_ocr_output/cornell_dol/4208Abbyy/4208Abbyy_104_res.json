        {
            "block_label": "paragraph_title",
            "block_content": "B. Traditional Medical Plan",
            "block_bbox": [
                71,
                832,
                258,
                853
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
