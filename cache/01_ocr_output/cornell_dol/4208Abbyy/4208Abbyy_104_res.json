                    698.0,
                    163.0
                ],
                [
                    698.0,
                    243.0
                ],
                [
                    123.0,
                    243.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) The plan of the parent with custody pays benefits first.",
            "block_bbox": [
                151,
                258,
                506,
                282
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
