        },
        {
            "block_label": "text",
            "block_content": "d. If a dependent child's parents are divorced or separated and a court decree establishes financial responsibility for the health care coverage of the child, the plan of the parent with such financial responsibility is the primary plan of coverage. If the divorce decree is silent on the issue of coverage, the following guidelines are used:",
            "block_bbox": [
                123,
                163,
                698,
                243
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
