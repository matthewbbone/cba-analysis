                ],
                [
                    506.0,
                    282.0
                ],
                [
                    151.0,
                    282.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) The plan of the spouse of the parent with custody pays second.",
            "block_bbox": [
                151,
                296,
                556,
                320
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
