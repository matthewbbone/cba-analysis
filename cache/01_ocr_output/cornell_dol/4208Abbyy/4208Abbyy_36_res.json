        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 18\nNON-DISCRIMINATION",
            "block_bbox": [
                307,
                70,
                482,
                108
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
