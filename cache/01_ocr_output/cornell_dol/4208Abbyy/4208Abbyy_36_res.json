        {
            "block_label": "text",
            "block_content": "Section 21.1 Establishment of Plan. The Company will establish a Layoff Benefit Plan to provide for lump sum or income continuation benefits as set forth in this Article. Such Plan will apply to employees who are laid off with an effective date on or after the effective date of this agreement.",
            "block_bbox": [
                71,
                770,
                703,
                830
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
