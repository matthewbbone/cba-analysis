        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8.5 Designated Employees.",
            "block_bbox": [
                74,
                337,
                304,
                358
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
