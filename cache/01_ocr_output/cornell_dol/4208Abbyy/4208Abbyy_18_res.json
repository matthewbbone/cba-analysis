            ]
        },
        {
            "block_label": "text",
            "block_content": "8.5(a)(3) Designated employees will be identified by skill teams.",
            "block_bbox": [
                126,
                602,
                521,
                623
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
