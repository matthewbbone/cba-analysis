                ],
                [
                    126.0,
                    548.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8.5(a)(2) Designated employees must have an assigned R3 retention index rating.",
            "block_bbox": [
                127,
                564,
                622,
                586
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
