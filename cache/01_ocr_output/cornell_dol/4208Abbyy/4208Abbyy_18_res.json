            ]
        },
        {
            "block_label": "text",
            "block_content": "8.5(a)(4) Designated employees who have one (1) full year of service and who elect to receive income continuation benefits under 21.3(b) will nevertheless be ineligible for first consideration recall rights.",
            "block_bbox": [
                126,
                640,
                702,
                681
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
