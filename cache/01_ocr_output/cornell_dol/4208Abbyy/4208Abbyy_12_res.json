                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8.3(b)(4) Distribution. Each employee will be assigned a retention rating such that, as nearly as is mathematically practicable, and except as provided in 8.3(b)(8), the retention index distribution for retention groupings within each retention index group is R1 - 38 to 42%, R2 - 38 to 42%, and R3 - 18 to 22%.",
            "block_bbox": [
                127,
                716,
                705,
                794
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
