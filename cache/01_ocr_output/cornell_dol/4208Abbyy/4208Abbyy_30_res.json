        },
        {
            "block_label": "text",
            "block_content": "12.2(c) The Company shall supply identification badges so that each Union Staff Representative can have access during working hours to the areas in which Bargaining Unit employees are assigned. Staff Representatives may retain their badges affording such access during the period they are assigned such duties by the Union, subject to 12.2(a), 12.2(b), and 12.2(d) of this Agreement.",
            "block_bbox": [
                102,
