        {
            "block_label": "text",
            "block_content": "If a retired employee is not enrolled in the Company-sponsored Retiree Medical Plan and has a new dependent as a result of an event such as marriage, birth, adoption, or placement for adoption, the retired employee may enroll himself or herself, his or her spouse, and any dependent children during the year as long as enrollment is requested within sixty (60) days after the event by contacting the Boeing Service Center.",
            "block_bbox": [
                100,
                161,
                704,
                260
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
