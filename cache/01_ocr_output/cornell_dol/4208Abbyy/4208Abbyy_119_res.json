        },
        {
            "block_label": "text",
            "block_content": "If a retired employee is enrolled in the Retiree Medical Plan and has a new dependent as a result of marriage, birth, adoption, or placement for adoption, the retired employee may enroll the new dependent during the year as long as enrollment is requested within one hundred twenty (120) days after the qualified event. See \"Change of Dependent Status,\" Section 3.E., for more information.",
            "block_bbox": [
                98,
                275,
