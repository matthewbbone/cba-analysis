        },
        {
            "block_label": "paragraph_title",
            "block_content": "12.1(d) Grievance and Contract Administration.",
            "block_bbox": [
                100,
                303,
                415,
                322
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
