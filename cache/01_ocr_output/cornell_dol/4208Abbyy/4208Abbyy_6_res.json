        {
            "block_label": "text",
            "block_content": "4.2(a) The Performance Evaluation Process consists of three activities: define, incrimin review and final review. Additional reviews may be conducted as requested.",
            "block_bbox": [
                100,
                679,
                703,
                720
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
