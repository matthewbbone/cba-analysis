        },
        {
            "block_label": "text",
            "block_content": "Pregnancy includes normal delivery, cesarean section, spontaneous abortion (miscarriage), legal abortion, and complications of pregnancy.",
            "block_bbox": [
                124,
                302,
                700,
                343
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
