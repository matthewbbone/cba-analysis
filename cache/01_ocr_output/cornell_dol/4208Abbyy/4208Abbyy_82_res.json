        },
        {
            "block_label": "paragraph_title",
            "block_content": "6. Oral surgery.",
            "block_bbox": [
                103,
                343,
                212,
                365
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
