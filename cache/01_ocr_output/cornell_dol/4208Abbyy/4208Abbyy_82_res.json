                ],
                [
                    708.0,
                    498.0
                ],
                [
                    159.0,
                    498.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) If crowns (caps), dentures (false teeth), bridgework (fixed or removable), or in-mouth appliances are installed due to such injury, only charges for the first denture or bridgework to replace lost teeth, the first crown needed to repair each damaged tooth, and an in-mouth appliance used in the first course of orthodontic therapy after the injury are included.",
            "block_bbox": [
                158,
                513,
                709,
                613
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
