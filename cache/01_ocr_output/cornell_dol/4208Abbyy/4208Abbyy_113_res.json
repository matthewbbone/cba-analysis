        {
            "block_label": "paragraph_title",
            "block_content": "A. Approved Medical Leaves of Absence",
            "block_bbox": [
                75,
                72,
                340,
                93
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
