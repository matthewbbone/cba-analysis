                    127.0,
                    463.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8.2(b) Re-assignments and transfers of the following kinds may be made by the Company without regard to the provisions of 8.2(e). Positions so filled shall not be regarded as open positions.",
            "block_bbox": [
                127,
