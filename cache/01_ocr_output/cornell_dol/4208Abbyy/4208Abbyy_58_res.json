        {
            "block_label": "text",
            "block_content": "In accordance with federal law, the Company also provides medical and dental coverage to certain dependent children (called alternate recipients) if the Company is directed to do so by a qualified medical child support order (QMCSO) issued by a court or state agency of competent jurisdiction.",
            "block_bbox": [
                73,
                75,
                705,
                137
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
