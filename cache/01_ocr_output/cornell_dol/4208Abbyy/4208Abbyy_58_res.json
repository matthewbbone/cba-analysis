                    75.0
                ],
                [
                    705.0,
                    137.0
                ],
                [
                    73.0,
                    137.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Documentation is required to request coverage for a child named in a QMCSO, for a child for whom the employee has been given legal custody or guardianship or for a same-gender domestic partner or his or her children.",
            "block_bbox": [
                73,
                151,
                705,
                213
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
