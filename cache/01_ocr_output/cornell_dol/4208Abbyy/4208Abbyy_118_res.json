        {
            "block_label": "text",
            "block_content": "A retired employee who has been enrolled in a health maintenance organization (HMO) or coordinated care plan may elect to change to the Traditional Medical Plan by calling the Boeing Service Center within thirty-one (31) days of the date the employee retires. The Company will supply enrollment instructions at the time of retirement.",
            "block_bbox": [
                102,
