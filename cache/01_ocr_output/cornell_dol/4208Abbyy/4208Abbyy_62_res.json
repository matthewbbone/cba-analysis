                    71.0,
                    189.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The disability must have existed continuously for six (6) months and be expected to keep the employee, for life, from performing any work for compensation or profit.",
            "block_bbox": [
                72,
