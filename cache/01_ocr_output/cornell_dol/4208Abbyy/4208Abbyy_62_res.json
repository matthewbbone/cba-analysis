        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Loss of</td><td>Percentage of Principal Sum</td><td>28</td></tr><tr><td>Life</td><td>100%</td><td>31</td></tr><tr><td>Quadriplegia</td><td>100%</td><td>32</td></tr><tr><td>Both Hands or Both Fees</td><td>100%</td><td>33</td></tr><tr><td>Sight of Both Eyes</td><td>100%</td><td>34</td></tr><tr><td>One Hand and One Foot</td><td>100%</td><td>35</td></tr><tr><td>One Hand and the Sight of One Eye</td><td>100%</td><td>36</td></tr><tr><td>One Foot and the Sight of One Eye</td><td>100%</td><td>37</td></tr><tr><td>Speech and Hearing in Both Ears</td><td>100%</td><td>38</td></tr><tr><td>Paraplegia</td><td>75%</td><td>39</td></tr><tr><td>Hemiplegia</td><td>50%</td><td>40</td></tr><tr><td>One Hand or One Foot</td><td>50%</td><td>41</td></tr><tr><td>Sight of One Eye</td><td>50%</td><td>42</td></tr><tr><td>Speech or Hearing in Both Ears</td><td>50%</td><td>43</td></tr><tr><td>Hearing in One Ear</td><td>25%</td><td>44</td></tr><tr><td>Thumb and Index Finger of Same Hand</td><td>25%</td><td>45</td></tr></table>",
            "block_bbox": [
