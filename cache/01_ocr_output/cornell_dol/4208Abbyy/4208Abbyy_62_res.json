        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 7\nACCIDENTAL DEATH AND DISMEMBERMENT PLAN",
            "block_bbox": [
                197,
                336,
                575,
                377
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
