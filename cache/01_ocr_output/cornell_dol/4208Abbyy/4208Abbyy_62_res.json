    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "If the employee becomes permanently and totally disabled while covered and before age 60 from any cause, the life insurance benefit will remain in force, without cost to the employee, as long as the employee remains disabled. If an employee becomes permanently and totally disabled between ages 60 and 65, the life insurance benefit will be continued without premium payment until the earlier of the employee's recovery or attainment of age 65. Proof of disability must be furnished within twelve (12) months of the date active work ends.",
            "block_bbox": [
                71,
                70,
                702,
                189
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    71.0,
                    70.0
                ],
                [
                    702.0,
                    70.0
