                [
                    124.0,
                    1005.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6.3(b) Sick leave payments will be at the employee's base rate in effect at the time of his or her absence plus; if applicable, any supplement to the base rate approved by the Company for inclusion in sick leave pay.",
            "block_bbox": [
