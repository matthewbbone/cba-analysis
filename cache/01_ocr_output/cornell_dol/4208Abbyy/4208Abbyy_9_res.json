                    123.0,
                    660.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6.2(c) No sick leave credit will be accumulated during periods on layoff or for absence in excess of the first pinery (90) calendar days on a leave of absence. Such absence from the active payroll will reduce the monthly sick leave award, if applicable, in the proportion of 1/30th of eight hours for each calendar day of absence during the month, or a comparable proportionate reduction if a part-time employee, rounded to the nearest tenth of an hour.",
            "block_bbox": [
                123,
                674,
                731,
                776
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
