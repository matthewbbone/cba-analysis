        {
            "block_label": "text",
            "block_content": "6.1(a) Employees classified on a salaried payroll become eligible for sick leave upon completion of one (1) month continuous active service with the Company.",
            "block_bbox": [
                124,
                272,
                731,
                314
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    124.0,
                    272.0
                ],
                [
                    731.0,
                    272.0
                ],
                [
                    731.0,
                    314.0
                ],
                [
                    124.0,
                    314.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6.1(b) When the continuity of employment is broken other than by layoff or termination to enter military service, an employee must begin with the date of reemployment to accumulate one (1) month continuous active service with the Company before being eligible for sick leave.",
            "block_bbox": [
                124,
                329,
                731,
                408
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
