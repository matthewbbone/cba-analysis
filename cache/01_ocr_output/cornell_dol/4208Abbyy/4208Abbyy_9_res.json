        {
            "block_label": "text",
            "block_content": "6.3(a) Sick leave credits are to be used only in the event of absence due to the following causes: (a) illness of employee, including physical incapacity of a female employee due to her pregnancy; (b) illness or death in the family (requiring the employee's presence); and (c) medical or dental appointment which can be scheduled only during the working hours. Non-exempt employees may use sick leave in any increments, but exempt employees shall use NONIND for usage of less than a full day.",
            "block_bbox": [
                124,
                886,
                728,
                1005
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    124.0,
                    886.0
                ],
                [
                    728.0,
                    886.0
                ],
                [
                    728.0,
                    1005.0
