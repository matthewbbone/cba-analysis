        {
            "block_label": "paragraph_title",
            "block_content": "LETTER OF UNDERSTANDING\nRELATING TO DRUG AND ALCOHOL FREE WORKPLACE PROGRAM",
            "block_bbox": [
                149,
                665,
                641,
                706
            ],
            "block_id": 18,
            "block_order": 17,
            "group_id": 18,
            "block_polygon_points": [
                [
                    149.0,
