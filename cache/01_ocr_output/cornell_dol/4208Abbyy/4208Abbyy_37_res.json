                ],
                [
                    712.0,
                    73.0
                ],
                [
                    712.0,
                    172.0
                ],
                [
                    77.0,
                    172.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "21.3(a) Benefits will be paid as a lump sum following the effective date of layoff. Employees who elect this option will have first consideration recall rights under Article 8 canceled.",
            "block_bbox": [
                104,
                187,
                710,
                229
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
