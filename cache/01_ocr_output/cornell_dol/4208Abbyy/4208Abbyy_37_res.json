        {
            "block_label": "text",
            "block_content": "21.3(b)(1) Subject to continuation of the Plan, no employee shall be paid income continuation benefits more than once during any three (3)-year period; provided, however, if an employee is re-employed by the Company before payment of the employee's total income continuation benefit and is subsequently laid off in such three (3)-year period under conditions which make the employee eligible for a benefit, any unused benefit will be payable to the employee under the procedures established by this Article.",
            "block_bbox": [
                131,
                456,
                711,
                576
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
