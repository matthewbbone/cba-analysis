        {
            "block_label": "text",
            "block_content": "8.3(e)(1) The Company may lay off employees without regard to the provisions of the layoff procedures set forth in 8.3, provided the number of such layoffs per month does not exceed 0.25% (one quarter of one percent) of the total number of employees employed in the bargaining unit on the first day of that month.",
            "block_bbox": [
                129,
                112,
                707,
                192
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
