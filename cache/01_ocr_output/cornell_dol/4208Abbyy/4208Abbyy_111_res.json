        },
        {
            "block_label": "text",
            "block_content": "Life insurance coverage stops on the date employment terminates.",
            "block_bbox": [
                104,
                245,
                499,
                265
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
