                [
                    102.0,
                    474.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the employee dies within the thirty-one (31)-day conversion period, the conversion amount is payable.",
            "block_bbox": [
                102,
                490,
                703,
                530
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
