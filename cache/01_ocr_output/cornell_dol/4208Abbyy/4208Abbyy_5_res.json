        {
            "block_label": "text",
            "block_content": "Section 3.7 Binding Effect of Award. All decisions arrived at under the provisions of this Article by the representatives of the Company and the Union, or by the arbiter, shall be final and binding upon both parties, provided that in arriving at such decisions neither of the parties nor the arbiter shall have the authority to alter this Agreement in whole or in part.",
            "block_bbox": [
                63,
                203,
                692,
                284
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
