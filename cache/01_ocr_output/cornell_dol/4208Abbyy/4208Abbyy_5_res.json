                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3.9 Extension of Time Limits by Agreement. The time limits set forth in this Article are recognized by the parties as being necessary for prompt resolution of grievances. Reasonable extensions of these time limits may be arranged by mutual written agreement. If a decision is not rendered by the Company within the time limits established for Steps 1 and 2, Section 3.2, the Union may thereupon advance the grievance to the next step. Grievances not presented, or presented and not pursued, within the specified or mutually extended time limits will be considered waived.",
            "block_bbox": [
                63,
                394,
                693,
                512
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
