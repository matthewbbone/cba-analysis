            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3.8 Time Limitation as to Back Pay, Grievance claims regarding retroactive compensation shall be limited to thirty (30) calendar days prior to the written submission of the grievance to Company Representatives, provided; however, that this thirty (30) day limitation may be waived by mutual consent of the parties.",
            "block_bbox": [
                63,
                299,
                692,
                378
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
