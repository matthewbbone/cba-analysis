                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "A. Order of Payment",
            "block_bbox": [
                74,
                642,
                221,
                663
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    74.0,
