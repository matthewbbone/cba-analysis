                ],
                [
                    128.0,
                    834.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. It has benefit determination rules that differ from coordination of benefit rules under state regulations or, if not insured, that differ from these rules.",
            "block_bbox": [
                128,
                852,
                706,
                893
            ],
            "block_id": 14,
            "block_order": 14,
            "group_id": 14,
            "block_polygon_points": [
                [
                    128.0,
                    852.0
                ],
                [
                    706.0,
                    852.0
                ],
                [
                    706.0,
                    893.0
                ],
                [
                    128.0,
                    893.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. All plans that cover an individual use the same coordination of benefit rules, and under those rules, the plan is primary.",
            "block_bbox": [
                127,
                910,
                705,
                950
            ],
            "block_id": 15,
            "block_order": 15,
            "group_id": 15,
            "block_polygon_points": [
                [
                    127.0,
                    910.0
                ],
