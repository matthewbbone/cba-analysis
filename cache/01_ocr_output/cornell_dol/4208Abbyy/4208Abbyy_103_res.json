                ],
                [
                    127.0,
                    950.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. If the aforementioned rules do not determine which group plan is considered primary, this plan applies the following coordination of benefit rules:",
            "block_bbox": [
                98,
                967,
                705,
                1008
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
