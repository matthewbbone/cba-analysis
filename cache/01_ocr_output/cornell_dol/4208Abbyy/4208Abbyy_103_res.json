                ],
                [
                    102.0,
                    798.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. It has no order of benefit determination rules.",
            "block_bbox": [
                128,
                815,
                434,
                835
            ],
            "block_id": 13,
            "block_order": 13,
            "group_id": 13,
            "block_polygon_points": [
                [
                    128.0,
                    815.0
                ],
                [
                    433.0,
                    815.0
                ],
                [
                    433.0,
