                [
                    98.0,
                    1008.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. A plan that covers a person as an employee, retiree, member, or subscriber pays before a plan that covers the person as a dependent.",
            "block_bbox": [
                127,
                1024,
                704,
                1064
            ],
            "block_id": 17,
            "block_order": 17,
            "group_id": 17,
            "block_polygon_points": [
