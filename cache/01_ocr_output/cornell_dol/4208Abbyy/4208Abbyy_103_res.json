        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 16\nCOORDINATION OF BENEFITS",
            "block_bbox": [
                279,
                356,
                508,
                396
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
