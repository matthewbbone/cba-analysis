                    74.0,
                    662.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The primary plan pays its benefits first and pays its benefits without regard to benefits that may be payable under other plans. When another plan is the primary plan for health care coverage, the secondary plan pays the difference between the benefits paid by the primary plan and what would have been paid had the secondary plan been primary.",
            "block_bbox": [
                100,
                680,
                708,
                760
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    100.0,
                    680.0
                ],
                [
                    708.0,
                    680.0
                ],
                [
                    708.0,
                    760.0
                ],
                [
                    100.0,
                    760.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. A plan is considered primary if:",
            "block_bbox": [
                102,
                776,
                321,
                798
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    102.0,
                    776.0
                ],
                [
                    321.0,
