        {
            "block_label": "paragraph_title",
            "block_content": "LETTER OF UNDERSTANDING\nRELATING TO WORK ENVIRONMENT AND HEALTH AND SAFETY",
            "block_bbox": [
                147,
                417,
                620,
                459
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
