        {
            "block_label": "text",
            "block_content": "8.6(d) The Company will determine which employees will be offered Temporary Recall assignments. Temporary Recall will be strictly voluntary on the part of the employee. Refusing to consider an employee for Temporary Recall or an employee's rejection of an offer of Temporary Recall will not affect the employee's active layoff status.",
            "block_bbox": [
                108,
                148,
                712,
                228
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    108.0,
                    148.0
                ],
                [
                    712.0,
                    148.0
                ],
                [
                    712.0,
                    228.0
                ],
                [
                    108.0,
                    228.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8.6(e) Temporarily-recalled employees will receive the same salary they were receiving prior to layoff, adjusted for any general wage increases implemented between the date of their original layoff and temporary recall.",
            "block_bbox": [
                108,
                244,
                711,
                305
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
