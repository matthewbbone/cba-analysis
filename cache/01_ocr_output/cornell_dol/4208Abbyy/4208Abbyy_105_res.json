        {
            "block_label": "text",
            "block_content": "Benefits payable under the Scheduled Dental Plan, Preferred Dental Plan, and Prepaid Dental Plan take into account any coverage (including orthodontic coverage) the employee or family members have under another plan.",
            "block_bbox": [
                107,
