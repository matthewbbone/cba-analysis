            ]
        },
        {
            "block_label": "text",
            "block_content": "Plan means any plan providing medical, dental, vision care, hearing aid benefits, or treatment under group insurance or any other coverage for individuals in a group, whether on an insured or uninsured basis. However, plan excludes any medical plan sponsored by the Company. This means the dental plans pay first when dental expenses performed by a dentist also are covered by any medical plan sponsored by the Company.",
            "block_bbox": [
                106,
                258,
                711,
                356
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
