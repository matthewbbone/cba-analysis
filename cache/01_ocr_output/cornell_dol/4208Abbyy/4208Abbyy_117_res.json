        },
        {
            "block_label": "text",
            "block_content": "An employee who is at least age fifty-five (55) and has ten (10) or more years of vesting service at retirement is eligible for the Retiree Medical Plan if he or she retires under The Boeing Company Employee Retirement Plan within the following time limits:",
            "block_bbox": [
                68,
                278,
                697,
                339
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
