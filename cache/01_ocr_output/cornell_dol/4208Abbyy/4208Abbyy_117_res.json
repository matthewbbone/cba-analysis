        {
            "block_label": "text",
            "block_content": "To be eligible for the Retiree Medical Plan, the employee must retire from the service of the Company under The Boeing Company Employee Retirement Plan at age 55 or older with ten (10) or more years of vesting service under a Company-sponsored retirement plan.",
            "block_bbox": [
                67,
                125,
                698,
                188
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
