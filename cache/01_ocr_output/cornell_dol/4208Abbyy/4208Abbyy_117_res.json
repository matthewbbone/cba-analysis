                [
                    67.0,
                    188.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If an employee becomes eligible for disability benefits under The Boeing Company Employee Retirement Plan, the employee also is eligible for the Retiree Medical Plan if he or she is at least age fifty (50) and has ten (10) or more years of vesting service at retirement.",
            "block_bbox": [
                68,
                201,
                697,
                264
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
