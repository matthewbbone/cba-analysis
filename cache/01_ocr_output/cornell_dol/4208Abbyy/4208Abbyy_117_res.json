                [
                    68.0,
                    339.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Two (2) years following the start of an approved pre-retirement leave of absence, provided the approved leave of absence has not ended prior to the employee's retirement.",
            "block_bbox": [
                69,
                354,
                696,
                397
            ],
            "block_id": 4,
            "block_order": 5,
