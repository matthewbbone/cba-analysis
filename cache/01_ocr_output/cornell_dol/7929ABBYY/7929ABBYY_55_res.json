                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) For each year before 1964, 203% of 1-1/4% times monthly compensation in 1963;",
            "block_bbox": [
                386,
                860,
                1088,
                921
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
