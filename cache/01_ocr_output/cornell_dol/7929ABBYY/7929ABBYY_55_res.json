                    1094.0,
                    364.0
                ],
                [
                    1094.0,
                    645.0
                ],
                [
                    237.0,
                    645.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "259. 2. For years of Credited Service before 1979, the larger of:",
            "block_bbox": [
                151,
                668,
                922,
                700
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
