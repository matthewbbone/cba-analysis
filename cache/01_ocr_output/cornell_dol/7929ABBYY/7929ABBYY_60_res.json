        {
            "block_label": "text",
            "block_content": "283. The Employer and the Union realize that the Employer's facilities are different in their operations from industries because of services rendered to the community and for humanitarian reasons, and agree that there shall be no lockouts on the part of the Employer, nor suspension of work on the part of the employees, it being one of the purposes of this Agreement to guarantee that there will be no strikes, lockouts or work stoppages.",
            "block_bbox": [
                149,
                269,
                1091,
                440
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
