        {
            "block_label": "paragraph_title",
            "block_content": "Section 1 - Intent of Article",
            "block_bbox": [
                240,
                337,
                534,
                367
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
