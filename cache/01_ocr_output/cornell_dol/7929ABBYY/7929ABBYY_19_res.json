                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "81. This Article is intended to provide the basis for calculation of and payment for overtime and allowed time and shall not be construed as a guarantee of hours of work per day or per week or days of work per week.",
            "block_bbox": [
                148,
                392,
                1086,
                480
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
