                ],
                [
                    1086.0,
                    480.0
                ],
                [
                    148.0,
                    480.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 2 - Definition of Terms",
            "block_bbox": [
                239,
                502,
                576,
                534
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    239.0,
                    502.0
                ],
                [
                    576.0,
                    502.0
                ],
                [
                    576.0,
                    534.0
                ],
                [
                    239.0,
                    534.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "82. \"Payroll Week\" as used in this Article shall mean and consist of the seven (7) day period beginning at 12:01 a.m., Sunday, or at the shift changing hour nearest that time.",
            "block_bbox": [
                239,
                557,
                1087,
                644
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    239.0,
                    557.0
                ],
                [
                    1087.0,
                    557.0
                ],
                [
                    1087.0,
                    644.0
                ],
                [
                    239.0,
                    644.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "83. \"Payroll Day\" as used in this Article shall mean and consist of a twenty-four (24) hour period, beginning at the same time each Payroll Day as the Payroll Week begins.",
            "block_bbox": [
                149,
                667,
                1087,
                753
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    149.0,
                    667.0
                ],
                [
                    1087.0,
                    667.0
                ],
                [
                    1087.0,
                    753.0
                ],
                [
                    149.0,
                    753.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3 - Overtime Rates",
            "block_bbox": [
                241,
                777,
                540,
                809
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    241.0,
                    777.0
                ],
                [
                    540.0,
                    777.0
                ],
                [
                    540.0,
                    809.0
                ],
                [
                    241.0,
                    809.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "84. Employees shall be paid at the rate of time and one-half (1-1/2) the straight-time hourly rate, including shift differential and split shift differential, for all hours of work performed in excess of eight (8) hours in any one work day and/or for all hours worked in excess of forty (40) hours within the work week. Employees shall be paid at the rate of double the straight-time hourly rate including shift differential and split shift differential for all hours worked in excess of twelve (12) consecutive hours in any one workday.",
            "block_bbox": [
                148,
                833,
                1088,
                1031
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    148.0,
                    833.0
                ],
                [
                    1088.0,
                    833.0
                ],
                [
                    1088.0,
                    1031.0
                ],
                [
                    148.0,
                    1031.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "85. Employees assigned to a scheduled work week of twenty (20) hours or more in a period of more than five (5) work days shall be paid at the rate of time and one-half (1-1/2) for all hours of work performed on the sixth (6th) day of work; whether or not such hours of work are in excess of forty (40) hours within the work week.",
            "block_bbox": [
                150,
                1052,
                1088,
                1194
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    150.0,
                    1052.0
                ],
                [
                    1088.0,
                    1052.0
                ],
                [
                    1088.0,
                    1194.0
                ],
                [
                    150.0,
                    1194.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "86. Employees shall be paid at the rate of double the straight-time hourly rate, including shift differential and split shift differential, for all hours of work performed on the seventh (7th) consecutive Payroll Day worked within the Payroll Week.",
