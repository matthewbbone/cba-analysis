        {
            "block_label": "paragraph_title",
            "block_content": "Section 3 - Applicability",
            "block_bbox": [
                241,
                361,
                500,
                391
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
