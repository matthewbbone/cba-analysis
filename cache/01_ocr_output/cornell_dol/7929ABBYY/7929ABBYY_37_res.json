        {
            "block_label": "paragraph_title",
            "block_content": "Section 1 - Room and Personal Laundry",
            "block_bbox": [
                243,
                391,
                685,
                421
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
