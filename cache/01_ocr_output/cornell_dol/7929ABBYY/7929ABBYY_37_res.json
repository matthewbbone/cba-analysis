        {
            "block_label": "paragraph_title",
            "block_content": "Section 2 - Uniforms",
            "block_bbox": [
                196,
                640,
                473,
                671
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
