        },
        {
            "block_label": "text",
            "block_content": "Up to Three (3) Hours' Work One (1) Meal\nThree (3) Hours to Six (6) Hours' Work Two (2) Meals\nSix (6) Hours' Work or More Three (3) Meals\nThese meals shall be furnished to such employees without deduction in compensation.",
            "block_bbox": [
                240,
                1138,
                1089,
                1281
