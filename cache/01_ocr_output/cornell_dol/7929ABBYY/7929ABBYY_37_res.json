                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "176. When the Employer offers any employee the option of room and/or personal laundry service in partial satisfaction of the employee's wages, the amount to be deducted from the wages of the employee shall be a matter of individual arrangement between the Employer and the employee. Nothing herein contained shall be construed to require the Employer to make or continue to make available room or personal laundry service.",
            "block_bbox": [
                155,
                446,
                1095,
                618
            ],
            "block_id": 4,
