        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 6 - Return from Leave",
            "block_bbox": [
                234,
                717,
                568,
                748
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    234.0,
                    717.0
                ],
                [
                    568.0,
                    717.0
                ],
                [
                    568.0,
                    748.0
