            ]
        },
        {
            "block_label": "text",
            "block_content": "281. Union Field Representatives shall be allowed access to appropriate materials in personnel files which are directly related to an alleged contract violation if the employee's written consent is presented to Personnel. The Employer will not use any materials from personnel files for the purpose of discipline, or in the grievance procedure, which have been specifically denied the Union in a request for access.",
            "block_bbox": [
