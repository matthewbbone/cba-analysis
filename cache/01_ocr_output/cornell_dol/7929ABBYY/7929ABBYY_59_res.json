                    150.0,
                    668.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "280. Employees have the right to have a Union Steward or Union representative present at meetings with supervisors or management representatives when such meetings are accusatory or disciplinary in nature. Furthermore, the Employer shall advise the employee in advance if a requested meeting may result in suspension, discharge or other discipline of the employee.",
            "block_bbox": [
                149,
                692,
                1088,
                835
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
