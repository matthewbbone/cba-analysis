    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "The Employer agrees to provide Kaiser Foundation Health Plan benefits currently described as “SS” coverage, the Psychiatric Plan, pre-paid maternity, durable medical equipment coverage and the Optical Plan for Regular employees, spouse/domestic partner and eligible dependents or to pay the premium required to provide the alternate medical plan coverage as described in the plan document. Effective August 1, 1996, the Employer agrees to provide the drug benefit currently described as Kaiser Foundation Health Plan Drug Program Benefit “N” ($5.00 co-pay) or the Drug Program Benefit ($5.00 co-pay) included under the alternate medical plan to all Regular employees/retirees, their spouses/domestic partners and their dependents. The $5.00 drug co-pay shall apply to eligible employees who retire on or after January 1, 1998.",
            "block_bbox": [
