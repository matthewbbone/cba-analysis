                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "77. A split shift is defined as eight (8) hours completed within a spread in excess of nine (9) consecutive hours without more than one break.",
            "block_bbox": [
                143,
                964,
                1087,
                1023
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
