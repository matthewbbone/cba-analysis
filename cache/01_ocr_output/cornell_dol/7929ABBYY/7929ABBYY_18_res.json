        {
            "block_label": "text",
            "block_content": "76. A. straight. shift is defined as a regular day's work of eight (8) hours completed within nine (9) consecutive hours with no more than one (1) hour for lunch.",
            "block_bbox": [
                145,
                882,
                1085,
                942
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
