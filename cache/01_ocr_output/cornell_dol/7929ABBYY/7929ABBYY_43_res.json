        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE XVII - BEREAVEMENT LEAVE",
            "block_bbox": [
                150,
                251,
                616,
                282
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
