                    148.0,
                    513.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. All course programs must be approved prior to starting course, including the actual time required for the course.",
            "block_bbox": [
                236,
                536,
                1084,
                597
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
