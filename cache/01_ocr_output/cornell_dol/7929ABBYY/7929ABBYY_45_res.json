        {
            "block_label": "text",
            "block_content": "217. An employee who is entitled to education leave may elect to utilize up to (16) sixteen hours per year of their educational leave pay, on a day or days when the employee is not normally scheduled to work, including home based courses. The educational course must meet the following and all other criteria established above for paid educational leave:",
            "block_bbox": [
                148,
                367,
                1087,
                513
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
