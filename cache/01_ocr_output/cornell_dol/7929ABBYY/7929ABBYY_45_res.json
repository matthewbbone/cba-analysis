                    236.0,
                    597.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. The course announcement must accompany the request for approval.",
            "block_bbox": [
                237,
                621,
                1085,
                681
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
