                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. The employee must show proof of successful completion of the course prior to being paid education leave pay for the time.",
            "block_bbox": [
                236,
                706,
                1084,
                766
            ],
            "block_id": 6,
            "block_order": 7,
