    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "c. The overtime provisions of the Industrial Welfare Commission Orders 4 and 5, Sections 3 (A), (1), in accordance with Section 3 (k) are waived for all full-time employees working a 4x10 Schedule.",
            "block_bbox": [
                184,
                160,
                1035,
                247
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
