                    811.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "g. Employees will receive one (1) unpaid thirty (30) minute lunch period and two (2) rest periods per ten (10) hour shift. Such rest periods shall be taken in the middle of each five (5) hour segment.",
            "block_bbox": [
                180,
                837,
                1075,
                924
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
