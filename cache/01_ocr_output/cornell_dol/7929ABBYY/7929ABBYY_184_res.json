        },
        {
            "block_label": "text",
            "block_content": "h. The Employer shall continue its policy of establishing scheduled days of work and days off, subject to operational needs. This agreement allows the affected file clerks to work either a 4 x 10 Schedule or a 5 x 8 Schedule.",
            "block_bbox": [
                180,
