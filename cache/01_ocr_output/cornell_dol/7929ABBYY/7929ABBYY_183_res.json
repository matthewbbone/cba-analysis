        {
            "block_label": "text",
            "block_content": "This Agreement, effective ___, modifies the Collective Bargaining Agreement between the KAISER FOUNDATION HOSPITALS, THE PERMANENTE MEDICAL GROUP, INC., AND KAISER FOUNDATION HEALTH PLAN (hereinafter referred to as the \"Employer\") and the HOSPITAL AND HEALTH CARE WORKERS' UNION, LOCAL 250, S.E.I.U. (hereinafter referred to as the \"Union\"). The agreement has been initiated at the request of the affected employees to implement a flexible work arrangement for all Regular Full-Time within the ___. Department.",
            "block_bbox": [
                112,
                338,
                1079,
                538
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    112.0,
                    338.0
                ],
                [
                    1079.0,
                    338.0
                ],
                [
                    1079.0,
                    538.0
                ],
                [
                    112.0,
                    538.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Nothing herein shall obligate the Employer to establish a flexible work arrangement.",
            "block_bbox": [
                112,
                563,
                931,
                594
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    112.0,
