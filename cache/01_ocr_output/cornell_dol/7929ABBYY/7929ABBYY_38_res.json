                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "183. Regular employee working less than forty (40) hours per week shall accumulate sick leave on the basis of the ratio of his/her regularly scheduled hours of work per week to forty (40) hours per week.",
            "block_bbox": [
                148,
