        {
            "block_label": "text",
            "block_content": "127. Any employee working in a Maintenance, Service and Technical classification who, as a part of his/her regular predetermined work schedule, performs work in a higher classification (except for rest period and meal relief) shall be paid at the higher rate of pay for all hours worked in the higher classification (that step in the higher classification which provides a minimum increase of $0.15 per hour).",
            "block_bbox": [
                143,
                1069,
                1081,
                1238
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
