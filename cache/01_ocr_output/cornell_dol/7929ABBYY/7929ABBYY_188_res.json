        {
            "block_label": "text",
            "block_content": "I, ___ voluntarily agree to a schedule of work effective",
            "block_bbox": [
                107,
                249,
                938,
                278
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
