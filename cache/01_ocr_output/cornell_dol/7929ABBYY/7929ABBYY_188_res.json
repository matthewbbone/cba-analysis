                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "whereby I may be scheduled up to ten (10) hours per each work day for not more than four (4) working days, within five (5) consecutive work days in a regularly scheduled week of work with the following provisions for overtime (Reference IWC Order 4-80, Part 3(B) copy attached):",
            "block_bbox": [
                107,
                278,
                1083,
                394
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    106.17613983154297,
                    278.2284851074219
                ],
                [
                    1081.951416015625,
                    271.2229309082031
                ],
                [
                    1082.775390625,
                    385.9944763183594
                ],
                [
                    107.00011444091797,
                    393.0000305175781
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1) The Employer is not required to pay the premium wage rate prescribed in Section (A) for the ninth and tenth hours worked during such work days.",
            "block_bbox": [
                180,
                418,
                1087,
                478
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    180.0,
                    418.0
                ],
                [
                    1087.0,
                    418.0
                ],
                [
                    1087.0,
                    478.0
                ],
                [
                    180.0,
                    478.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) If an employee on such a four day work schedule is required or permitted to work more than ten (10) hours in any work day, the premium wage rate provisions in sub-section (A) shall apply to such employee for those hours worked in excess of the tenth hour of that work day.",
            "block_bbox": [
                178,
                503,
                1073,
                619
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    178.0,
                    503.0
                ],
                [
                    1073.0,
                    503.0
                ],
                [
                    1073.0,
                    619.0
                ],
                [
                    178.0,
                    619.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3) Any employee on such a schedule who is required or permitted to work on more than four (4) work days in a workweek shall be compensated at the rate of not less than one and one half (1½) times the employee's regular rate of pay for the first eight (8) hours on such additional work days, and double the employee's regular rate of pay for work in excess of eight (8) hours on those work days.",
            "block_bbox": [
                176,
                645,
                1082,
                790
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    176.0,
                    645.0
                ],
                [
                    1082.0,
                    645.0
                ],
                [
                    1082.0,
                    790.0
                ],
                [
                    176.0,
                    790.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(Sub Section A, as cited above, refers to the requirements to compensate employees one and one half (1½) times their regular rate for all hours worked in excess of eight (8) hours up to and including twelve (12) hours in any one work day.)",
