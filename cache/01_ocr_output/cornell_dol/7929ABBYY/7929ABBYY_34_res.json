        {
            "block_label": "text",
            "block_content": "Section 11 - Holiday Scheduling",
            "block_bbox": [
                239,
                273,
                590,
                303
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
