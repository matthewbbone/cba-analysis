        {
            "block_label": "paragraph_title",
            "block_content": "Section 1 – Compelling or Personal Situations",
            "block_bbox": [
                241,
                196,
                761,
                225
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
