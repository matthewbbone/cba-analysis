        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE XXVIII - CONSCIENTIOUS OBJECTION",
            "block_bbox": [
                142,
                768,
                708,
                798
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    142.0,
                    768.0
                ],
                [
                    708.0,
                    768.0
                ],
                [
                    708.0,
