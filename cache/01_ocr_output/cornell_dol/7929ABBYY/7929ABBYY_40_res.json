            ]
        },
        {
            "block_label": "text",
            "block_content": "192. If an employee is eligible for basic UCD benefits, Employer-paid sick leave shall be reduced by the amount of the UCD benefit the employee is eligible to receive. Payments received in the form of basic UCD benefits shall not be charged against the employee's accumulated sick leave.",
            "block_bbox": [
                146,
                411,
                1085,
                525
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    146.0,
                    411.0
                ],
                [
                    1085.0,
                    411.0
                ],
                [
                    1085.0,
