        {
            "block_label": "paragraph_title",
            "block_content": "Section 5 - Integration With Disability and Workers' Compensation",
            "block_bbox": [
                234,
                356,
                953,
                387
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
