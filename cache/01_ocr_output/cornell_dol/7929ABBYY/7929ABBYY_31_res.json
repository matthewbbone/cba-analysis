        {
            "block_label": "text",
            "block_content": "143. It is the 'Employer's intent to abide by any changes in Federal legislation related to the holidays listed in Section 1.",
            "block_bbox": [
                152,
                553,
                1085,
                613
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
