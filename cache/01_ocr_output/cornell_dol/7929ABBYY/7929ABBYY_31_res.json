            ]
        },
        {
            "block_label": "text",
            "block_content": "144. Employees with more than thirty (30) days of continuous service as a Regular employee are entitled to their personal birthday as a recognized holiday. If such employee's personal birthday falls on any of the other recognized holidays, the employee's next regularly scheduled work day following said recognized holiday shall be considered as the employee's birthday.",
            "block_bbox": [
                149,
                691,
                1088,
                835
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    149.0,
                    691.0
                ],
