        },
        {
            "block_label": "text",
            "block_content": "It is the intent of the parties to utilize a proactive approach to resolving issues before they become grievances.",
            "block_bbox": [
                178,
                553,
                1085,
                611
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
