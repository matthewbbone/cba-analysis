        {
            "block_label": "paragraph_title",
            "block_content": "6. DISPUTE RESOLUTION PROCESS:",
            "block_bbox": [
                109,
                502,
                590,
                532
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
