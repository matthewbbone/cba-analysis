                [
                    104.0,
                    950.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Accruals for sick leave, vacations, educational leave, etc. shall be based on forty (40) hours of work per week. For the purposes of this Agreement, one \"day\" as referred to in the Master Agreement is equivalent to ten (10) hours. For example, if an employee takes one vacation day, he/she will receive ten (10) hours of vacation pay.",
            "block_bbox": [
                104,
                980,
                1065,
                1093
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    104.0,
