                    839.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The overtime provisions of Article ___, Paragraph _____ are waived, while the overtime provisions of Section 3 B of the California State Industrial Welfare Commission Order 5-89 remain in effect.",
            "block_bbox": [
                104,
                868,
                1041,
                950
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    104.0,
                    868.0
                ],
                [
                    1041.0,
