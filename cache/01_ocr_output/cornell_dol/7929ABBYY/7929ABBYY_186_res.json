        {
            "block_label": "text",
            "block_content": "This Agreement effective ___ , modifies the Collective Bargaining Agreement between the KAISER PERMANENTE MEDICAL CARE PROGRAM (hereinafter referred to as the Employer) and ___ (hereinafter referred to as the Union) for the purposes of establishing a ten hour, four day workweek (4/40 workweek) for employees within the ___ Department.",
            "block_bbox": [
                110,
                362,
                1082,
                503
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    110.0,
                    362.0
                ],
                [
                    1082.0,
                    362.0
                ],
                [
                    1082.0,
                    503.0
                ],
                [
                    110.0,
                    503.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties acknowledge that at least two-thirds of the affected employees have voluntarily agreed in writing to work four ten-hour shifts. (Affected employees include all employees in a readily identifiable work unit, such as a division, a department, a job classification, a shift, a separate physical location, or a recognized subdivision of any such work unit). Additionally, a secret ballot vote was conducted in accordance with Section 3B of the Industrial Welfare Commission Order 5-89. At the end of one (1) year if 1/3 of the affected employees petition for a vote to terminate this agreement, the Employer will conduct a secret ballot vote. Provided that at least 2/3 of the affected employee's vote in support of the Agreement, this Agreement may be extended.",
            "block_bbox": [
                107,
                530,
                1072,
                758
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    107.0,
                    530.0
                ],
                [
                    1072.0,
                    530.0
                ],
                [
                    1072.0,
                    758.0
                ],
                [
                    107.0,
                    758.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Unless otherwise provided below, all other provisions of the Collective Bargaining Agreement shall remain in force.",
            "block_bbox": [
                106,
                783,
                1077,
                839
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    106.0,
                    783.0
                ],
