                ],
                [
                    1087.0,
                    687.0
                ],
                [
                    111.0,
                    687.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "1. NOTICE OF IMPLEMENTATION:",
            "block_bbox": [
                113,
                705,
                551,
                735
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    113.0,
                    705.0
                ],
                [
                    551.0,
                    705.0
                ],
                [
                    551.0,
