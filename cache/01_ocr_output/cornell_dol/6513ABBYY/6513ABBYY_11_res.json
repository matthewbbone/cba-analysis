        {
            "block_label": "text",
            "block_content": "L. Other than the provisions of this section, no designation of any type of employee in the Agreement shall be understood to guarantee any fixed amount of employment.",
            "block_bbox": [
                345,
                146,
                1456,
                206
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
