        {
            "block_label": "text",
            "block_content": "Your eligibility and whether the leave is paid are determined by several factors. These include the reason for the leave, your length of service, and your hours worked. Different kinds of leaves of absence may run concurrent with each other and/or with paid time off.",
            "block_bbox": [
                348,
                289,
                1488,
                378
            ],
            "block_id": 6,
            "block_order": 4,
            "group_id": 6,
            "block_polygon_points": [
                [
