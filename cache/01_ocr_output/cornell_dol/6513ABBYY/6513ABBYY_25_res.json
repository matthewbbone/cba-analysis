        },
        {
            "block_label": "text",
            "block_content": "D. Where an Employee is entitled to recall to work from a layoff and cannot be contacted by telephone, the Employer will notify the Employee of availability of work by written communication to his/her last home address on file with the Employer.",
            "block_bbox": [
                349,
