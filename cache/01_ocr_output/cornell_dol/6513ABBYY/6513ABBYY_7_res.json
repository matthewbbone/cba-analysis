            ]
        },
        {
            "block_label": "text",
            "block_content": "4. The Employer agrees prior to hiring Seasonal Employees to request the availability of Regular Employees and to schedule those Regular Employees into Seasonal Employee schedules where the Regular Employee can assume the complete seasonal schedule. Employees may switch their regular schedule for one of the seasonal schedules within the department when the seasonal schedule provides for more hours or a more favorable schedule in a week for the duration of the Christmas season.",
            "block_bbox": [
                347,
                570,
                1476,
                716
            ],
            "block_id": 6,
