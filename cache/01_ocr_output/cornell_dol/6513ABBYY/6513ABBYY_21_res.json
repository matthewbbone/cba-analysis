                    831.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. For Eligible Employees with six (6) months continuous service but less than one (1) year a maximum of two (2) weeks unpaid leave;",
            "block_bbox": [
                349,
                854,
                1466,
                916
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
