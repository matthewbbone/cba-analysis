                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Reported absences: Those in which the employee is not reporting to work but has contacted Human Resources in accordance with the above procedures. If an employee reports an anticipated return date, they do not have to call in each day, unless the return date goes beyond original anticipated return date.",
            "block_bbox": [
                342,
                917,
                1469,
                1031
            ],
            "block_id": 12,
            "block_order": 10,
            "group_id": 12,
            "block_polygon_points": [
