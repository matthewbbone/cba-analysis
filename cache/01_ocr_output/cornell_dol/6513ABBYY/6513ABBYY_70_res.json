        {
            "block_label": "paragraph_title",
            "block_content": "II. STANDARD",
            "block_bbox": [
                342,
                376,
                501,
                407
            ],
            "block_id": 7,
            "block_order": 5,
            "group_id": 7,
            "block_polygon_points": [
