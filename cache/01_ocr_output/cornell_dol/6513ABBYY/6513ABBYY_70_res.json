                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "C. Absences shall be recorded into three (3) categories:",
            "block_bbox": [
                342,
                859,
                951,
                891
            ],
            "block_id": 11,
            "block_order": 9,
            "group_id": 11,
            "block_polygon_points": [
