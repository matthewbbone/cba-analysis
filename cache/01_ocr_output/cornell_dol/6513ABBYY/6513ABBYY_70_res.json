        {
            "block_label": "text",
            "block_content": "Macy's California believes it is the obligation of every employee to report to work on time as scheduled each day and to work their entire schedule.",
            "block_bbox": [
                339,
                291,
                1462,
                353
            ],
            "block_id": 6,
            "block_order": 4,
            "group_id": 6,
            "block_polygon_points": [
