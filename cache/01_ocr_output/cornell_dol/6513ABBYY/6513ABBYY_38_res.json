        {
            "block_label": "text",
            "block_content": "1. For any illness or injury which begins on or after August 1, 1996, the sickness pay benefits shall be paid at sixty-six and two thirds (66 2/3's) of average pay for the days eligible for sick pay. Average pay shall be computed as per Section 11 less benefits received from California Disability Insurance (not including hospital benefits) or less Workers' Compensation Benefits received by the employee.",
            "block_bbox": [
                340,
                290,
                1459,
                408
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
