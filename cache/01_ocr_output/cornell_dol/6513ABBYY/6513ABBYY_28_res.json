                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Sales associates may be assigned to perform non-sell work that may be performed on the selling floor as long as it does not inhibit their ability to sell to the customers that come in the department.",
            "block_bbox": [
                339,
