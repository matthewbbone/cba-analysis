                [
                    1448.0,
                    770.0
                ],
                [
                    339.0,
                    770.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Sales associates will not be scheduled to work in stockrooms or in support areas (including Fitting rooms).",
            "block_bbox": [
                339,
                795,
                1426,
                855
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
