        {
            "block_label": "text",
            "block_content": "1. The Employer agrees to lay-off by seniority prior to reducing any base hours of all Employees except those Merchandise Handlers covered by Burns List seniority per Section 8, P-6.",
            "block_bbox": [
                406,
                62,
                1410,
                149
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
