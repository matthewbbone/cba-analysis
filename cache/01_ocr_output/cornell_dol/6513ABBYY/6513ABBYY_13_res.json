        },
        {
            "block_label": "text",
            "block_content": "2. Except during the Christmas Period, no less than fifty-percent (50%) of the number of Sales Employees on roll shall be classified as full-time. The remedy for a violation of this section shall be to hire as soon as practical to the level necessary to maintain the fifty-percent (50%) full-time head requirement.",
            "block_bbox": [
                406,
                174,
                1429,
                291
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
