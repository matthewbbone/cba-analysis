        {
            "block_label": "text",
            "block_content": "Rates of pay under the progression schedules shall be as follows:",
            "block_bbox": [
                347,
                119,
                1056,
                151
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
                [
