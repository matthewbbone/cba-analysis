                    633.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. All progression steps will be adjusted according to their % of the thereafter rate consistent with the wage increases.",
            "block_bbox": [
                348,
                655,
                1468,
                717
