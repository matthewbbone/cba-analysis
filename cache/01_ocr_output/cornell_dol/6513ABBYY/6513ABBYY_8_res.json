        {
            "block_label": "text",
            "block_content": "Any person entering the employment of the Employer shall be required to complete a six (6) calendar month orientation period prior to achieving regular status. Such employees, after 3 months of employment, will be afforded the same rights as other employees under Section 31 of this Collective Bargaining Agreement. The termination of Employees with less than three (3) months of employment shall not be subject to Section 31, except for terminations for Union membership or activity.",
            "block_bbox": [
                340,
                319,
                1448,
                465
            ],
            "block_id": 5,
