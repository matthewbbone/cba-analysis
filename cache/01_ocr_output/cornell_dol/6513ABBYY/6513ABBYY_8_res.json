        },
        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 8 - WORK SCHEDULES",
            "block_bbox": [
                738,
                488,
                1090,
                518
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
