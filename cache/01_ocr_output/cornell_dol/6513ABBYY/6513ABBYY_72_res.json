                    550.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "E. The Department and Group Managers are responsible for keeping track of daily attendance with the Human Resource Manager in tracking attendance.",
            "block_bbox": [
                342,
                572,
                1461,
                633
