        {
            "block_label": "text",
            "block_content": "F. The parties recognize that it is in their mutual interest to assure that the Employer's customers receive the highest level of customer service possible. Questions and issues arising from this Subsection shall be handled in an expedited manner.",
            "block_bbox": [
                345,
                120,
                1474,
                207
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
