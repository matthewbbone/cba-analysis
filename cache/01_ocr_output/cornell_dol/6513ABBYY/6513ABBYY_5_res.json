                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. It is understood that all steward activities should be executed so as not to interfere with the conduct of the Employer's Business or to interrupt or interfere unreasonably with the performance of work.",
            "block_bbox": [
                349,
                910,
                1484,
                972
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
