        {
            "block_label": "text",
            "block_content": "A. Regular employees who are required to serve on court mandated jury duty shall be granted leave with pay for their lost earnings as a result of such required jury service. Lost earnings will be calculated by paying, at the individuals average hourly rate as computed in Section 11 (E), for those hours they are actually scheduled to be present for jury duty, up to the employee's maximum scheduled work hours in a given day or week.",
            "block_bbox": [
                341,
                659,
                1486,
                805
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    341.0,
                    659.0
                ],
                [
                    1486.0,
                    659.0
                ],
                [
                    1486.0,
                    805.0
                ],
                [
                    341.0,
                    805.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Employees must notify their Human Resource Manager as soon as practicable concerning their being called to jury duty. No compensation is owed by the Employer without prior notification by the employee.",
            "block_bbox": [
                342,
                829,
                1461,
                917
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
                [
