            ]
        },
        {
            "block_label": "text",
            "block_content": "C. It is understood that an employee is required to contact the Human Resource Department and if requested to report to work for any part of his/her scheduled work day, provided two (2) hours of scheduled work remains, when s/he is not required to be present for said jury duty.",
            "block_bbox": [
