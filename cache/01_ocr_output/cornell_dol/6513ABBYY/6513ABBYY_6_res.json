                    210.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. REGULAR FULL-TIME - an employee who has completed their orientation period and who is regularly scheduled to work five (5) days per week and thirty-seven and one-half (37.5) hours or more per week between Sunday and Saturday, consistent with the terms of the agreement. Regular Full-time associates must be available to work at least two (2) nights per week consistent with the terms of the agreement.",
            "block_bbox": [
                336,
                234,
                1472,
                352
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
                [
                    336.0,
                    234.0
                ],
                [
                    1472.0,
                    234.0
                ],
                [
                    1472.0,
                    352.0
                ],
                [
                    336.0,
                    352.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Or an employee who has completed their orientation period and who is available and is regularly scheduled to work five (5) days per week and/or thirty (30) hours or more per week between Sunday and Saturday. Full time associates must be available to work at least two (2) nights per week consistent with the terms of this agreement.",
            "block_bbox": [
                338,
                375,
                1478,
                492
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
                [
