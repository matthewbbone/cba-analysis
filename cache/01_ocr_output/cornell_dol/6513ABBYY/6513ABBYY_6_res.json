        {
            "block_label": "text",
            "block_content": "For the purpose of this Agreement, employees are designated as follows:",
            "block_bbox": [
                337,
                178,
                1132,
                210
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
