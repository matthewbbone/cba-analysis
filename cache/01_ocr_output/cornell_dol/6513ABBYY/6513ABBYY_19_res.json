                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees retiring under the terms of the Macy's California Pension Plan shall receive any remaining vacation due to be taken in the benefit year, as cash at the time of retirement.",
            "block_bbox": [
                347,
                483,
                1445,
                544
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
