                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When a holiday, as provided in Section 11 (Holidays), falls during an employee's paid vacation s/he shall receive an additional day's vacation for such holiday.",
            "block_bbox": [
                347,
                568,
