            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 26\nEXECUTIVE SELLING ACTIVITIES AND WORK ACTIVITIES",
            "block_bbox": [
                612,
                315,
                1226,
                372
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
                    612.0,
