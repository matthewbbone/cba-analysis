        {
            "block_label": "text",
            "block_content": "A. All employees covered under the terms of this agreement shall receive an employee discount on purchases in accordance with the Employee Discount Policy affecting a majority of the employer's employees under the employee discount plan.",
            "block_bbox": [
                344,
                61,
                1425,
                150
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
                [
                    344.0,
                    61.0
                ],
                [
                    1425.0,
                    61.0
                ],
                [
                    1425.0,
                    150.0
                ],
                [
                    344.0,
                    150.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. The Employer does agree to provide the Union with a copy of the discount program in its present form and provide in a prompt manner copies of any changes that may be implemented to the discount program in the future. Additionally, the Employer will provide to the Union a copy of the rules and policies regarding use of the discount by eligible employees.",
            "block_bbox": [
                344,
                173,
                1461,
                292
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
                [
                    343.9998779296875,
