        },
        {
            "block_label": "paragraph_title",
            "block_content": "REASON FOR LEAVE",
            "block_bbox": [
                343,
                232,
                574,
                263
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
