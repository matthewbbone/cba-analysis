                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "NOTICE OF LEAVE",
            "block_bbox": [
                343,
                544,
                553,
                576
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
