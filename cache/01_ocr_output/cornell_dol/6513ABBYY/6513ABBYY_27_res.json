                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the Union makes a written request within fourteen (14) days of receipt of said notice of Implementation, then the Employer will meet with the Union to discuss the rule and/or regulation. The Employer will give good faith consideration to the comments of the Union. The effective date of the rule and/or regulation shall be the 15th day after the receipt by the Union of the notice or the 31st day if the Union has filed a request to meet, or another mutually agreeable date.",
            "block_bbox": [
                346,
                314,
                1493,
                460
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
