                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Thereafter the Union may, within seven (7) days (from the date of the meeting or response from the Company), request mediation over whether such rule or regulation is arbitrary or capricious or a violation of an express term of the Agreement.",
            "block_bbox": [
                345,
                483,
                1445,
                573
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
