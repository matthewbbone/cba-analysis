        {
            "block_label": "paragraph_title",
            "block_content": "10. Extended Leave for Serious Health Condition",
            "block_bbox": [
                343,
                260,
                899,
                291
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
