        {
            "block_label": "text",
            "block_content": "5. For all Regular Employees work in excess of four (4) days in a holiday week, except where it is mutually agreed between the Union, Employer and the employee that the employee will work the 5th day at straight-time. Any paid time off in a holiday week shall constitute time worked.",
            "block_bbox": [
                338,
                175,
                1446,
                265
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
