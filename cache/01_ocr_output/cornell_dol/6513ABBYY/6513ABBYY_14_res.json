        {
            "block_label": "text",
            "block_content": "4. Work performed on a holiday, as specified in Section 11 (Holidays) shall be paid pursuant to the 1990-1993 Collective Bargaining Agreement. Such premium shall begin upon completion of the first anniversary date of employment.",
            "block_bbox": [
                338,
                63,
                1469,
                151
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
