                    1480.0,
                    374.0
                ],
                [
                    345.0,
                    374.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "H. Said weekly and monthly meetings shall not be cancelled except for unusual circumstances.",
            "block_bbox": [
                348,
                398,
                1382,
                430
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
