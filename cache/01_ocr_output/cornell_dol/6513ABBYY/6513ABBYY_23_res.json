                [
                    349.0,
                    884.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Any Employee feeling s/he has been unjustly discharged shall have the right to appeal such discharge through the Union within ten (10) calendar days from the date the Union receives notice of the discharge pursuant to Section 31 - Processing of Complaints and Disputes.",
            "block_bbox": [
                350,
                907,
                1458,
                999
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
                [
                    350.0,
