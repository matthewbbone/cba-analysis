        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 15 DISCIPLINE OF EMPLOYEES",
            "block_bbox": [
                702,
                510,
                1144,
                541
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
