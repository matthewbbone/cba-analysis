        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 11 - HOLIDAYS",
            "block_bbox": [
                781,
                146,
                1055,
                176
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
