        },
        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 36 - LABOR MANAGEMENT COMMITTEE",
            "block_bbox": [
                648,
                513,
                1189,
                544
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
                    648.0,
                    513.0
                ],
                [
                    1189.0,
                    513.0
                ],
                [
                    1189.0,
