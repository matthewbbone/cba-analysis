        {
            "block_label": "paragraph_title",
            "block_content": "SECTION 16 - SENIORITY",
            "block_bbox": [
                775,
                770,
                1054,
                801
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
