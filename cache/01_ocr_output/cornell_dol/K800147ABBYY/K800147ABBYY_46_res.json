        {
            "block_label": "text",
            "block_content": "Section 11. Sections 1 through 10, and 12 of this Article shall not be applicable to employees whose injuries are within the scope of either Act 193 of 1935, P.L. 477, as amended, or Act 632 of 1959, P.L. 1718, as amended.",
            "block_bbox": [
                138,
                227,
                1082,
                310
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
