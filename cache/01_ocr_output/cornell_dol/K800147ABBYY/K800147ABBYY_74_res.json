                    204.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The amount of money reimbursed for lunch expenses will be charged against aggregate amount of money extended to each employee for out-service training.",
            "block_bbox": [
                138,
                228,
                1084,
                285
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
