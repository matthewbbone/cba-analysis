    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Employees who attend out-service training where lunch is not provided as a part of the registration fee will be reimbursed for out-of-pocket lunch expenses not to exceed $10.00, including sales tax upon presentation of a receipt.",
            "block_bbox": [
                138,
                121,
                1082,
                204
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
