        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 18\nSHIFT DIFFERENTIAL",
            "block_bbox": [
                491,
                553,
                732,
                606
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    491.0,
                    553.0
                ],
                [
                    732.0,
                    553.0
                ],
                [
                    732.0,
