                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 13. Permanent employees who have attained one or more of the certifications listed in Appendix G in an appropriate specialization by July 1, 2003; July 1, 2004; July 1, 2005; July 1, 2006, as appropriate, will receive a $200.00 certification payment in each contract year that the employee meets the criteria. To receive the certification payment employees must be in active pay status on July 1, of the appropriate contract year and must be in an active pay status from 50% to 100% of the time for six months during the 12 months preceding July 1, of the appropriate contract year. The area of certification must be related to the employees' duties and responsibilities with the Commonwealth.",
            "block_bbox": [
                138,
                201,
                1084,
                394
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    138.0,
                    201.0
                ],
                [
                    1084.0,
                    201.0
                ],
                [
                    1084.0,
                    394.0
                ],
                [
                    138.0,
                    394.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee in an inactive pay status on July 1, upon return to active pay status, shall be entitled to the certification payment, subject to the same entitlement criteria.",
            "block_bbox": [
                139,
                417,
                1082,
                474
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
