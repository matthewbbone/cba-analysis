            "block_label": "text",
            "block_content": "Section 12. The policies regarding pay range revisions contained in the Commonwealth of Pennsylvania's Personnel Rules shall continue.",
            "block_bbox": [
                138,
                120,
                1086,
                177
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
