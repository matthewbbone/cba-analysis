                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 1. It is understood that there shall be no strike, as that term is defined under the Public Employee Relations Act, during the life of this Agreement, nor shall any officer, representative or official of the Union authorize, assist or encourage any such strike during the life of this Agreement.",
            "block_bbox": [
                137,
                767,
                1081,
                853
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    137.0,
                    767.0
                ],
                [
                    1081.0,
                    767.0
                ],
                [
                    1081.0,
                    853.0
                ],
                [
                    137.0,
                    853.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 2. Should a strike occur not authorized by the Union, the Union within 24 hours following the request of the Commonwealth shall:",
            "block_bbox": [
                137,
                875,
                1083,
                933
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    137.0,
                    875.0
                ],
                [
                    1083.0,
                    875.0
                ],
                [
                    1083.0,
                    933.0
                ],
                [
                    137.0,
                    933.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Publicly disavow such action by the employees.",
            "block_bbox": [
                210,
                956,
                719,
                984
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    210.0,
                    956.0
                ],
                [
                    719.0,
