                ],
                [
                    719.0,
                    984.0
                ],
                [
                    210.0,
                    984.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Advise the Commonwealth in writing that such employee action has not been authorized or sanctioned by the Union.",
            "block_bbox": [
                209,
                984,
                1082,
                1037
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
