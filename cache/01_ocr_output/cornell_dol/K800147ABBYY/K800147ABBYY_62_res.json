                    209.0,
                    1037.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Post notices on all bulletin boards advising employees that it disapproves of such action and instruct them to return to work immediately.",
            "block_bbox": [
                209,
                1038,
                1082,
