        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 29\nSPECIAL AND PART-TIME EMPLOYEES",
            "block_bbox": [
                392,
                337,
                831,
                390
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
