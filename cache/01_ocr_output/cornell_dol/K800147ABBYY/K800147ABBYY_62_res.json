                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 1. Present practices relating to part-time and irregularly scheduled employees shall remain as is, except as modified in this Agreement and subject to the provisions of Article 37, Section 6.",
            "block_bbox": [
                139,
                416,
                1082,
                474
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    139.0,
                    416.0
                ],
                [
                    1082.0,
                    416.0
                ],
                [
                    1082.0,
                    474.0
                ],
                [
                    139.0,
                    474.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 2. Employees referred to in Section 1 shall only be entitled to those fringe benefits presently received subject to any modifications to those specific fringe benefits provided for in the Agreement. If prior fringe benefits were prorated, the modifications to those fringe benefits shall likewise be prorated. No additional fringe benefits shall accrue by virtue of the provisions of this Agreement except as provided herein.",
            "block_bbox": [
                137,
                497,
                1083,
                637
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
