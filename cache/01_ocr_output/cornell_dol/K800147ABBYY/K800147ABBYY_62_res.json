            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 30\nPEACE AND STABILITY",
            "block_bbox": [
                480,
                686,
                743,
                741
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
