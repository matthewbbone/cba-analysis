        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 8. Loss of Benefits",
            "block_bbox": [
                139,
                579,
                438,
                607
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    139.0,
                    579.0
