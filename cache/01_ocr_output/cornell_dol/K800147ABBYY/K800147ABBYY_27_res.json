        {
            "block_label": "text",
            "block_content": "Employees who are granted military leaves may, under conditions provided in the Military Code (51 Pa.C.S. 7306) and Chapter 43, Part III of Title 38 United States Code and in accordance with procedures prescribed by the State Employees' Retirement Board and the Public School Employees' Retirement Board, choose either to continue or discontinue making regular payments into their retirement accounts.",
            "block_bbox": [
                137,
                416,
                1084,
                554
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
