            "block_label": "paragraph_title",
            "block_content": "ARTICLE 35\nMANAGEMENT RIGHTS",
            "block_bbox": [
                479,
                147,
                745,
                202
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
