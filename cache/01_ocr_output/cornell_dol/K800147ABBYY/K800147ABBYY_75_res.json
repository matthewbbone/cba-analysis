        },
        {
            "block_label": "text",
            "block_content": "Section 10. Requests for out-service training which have been denied for failure to meet the criterion established in Section 2b of this Article shall, at the request of the Union, be reviewed by a joint committee. The committee shall consist of one member to be appointed by the Union, one member to be appointed by the Office of Administration (the Chief Negotiator or designee) and the Agency Labor Relations Coordinator or designee.",
            "block_bbox": [
                138,
                552,
                1085,
                689
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    138.0,
                    552.0
                ],
                [
                    1085.0,
                    552.0
                ],
