        {
            "block_label": "text",
            "block_content": "Section 1. The Employer recognizes the responsibility of its employees to fulfill their civic duties as jurors and witnesses in court proceedings. The Employer agrees therefore to grant civil leave with pay to permanent employees:",
            "block_bbox": [
                137,
                876,
                1083,
                960
            ],
