        },
        {
            "block_label": "text",
            "block_content": "Disabled employees receiving Workers' Compensation will be notified 90 days prior to the expiration of the three year period. The notification will include information concerning the employee's right to apply for disability retirement, if eligible. If the employee does not receive 90 days notice, the employee's right to return will not be extended. However, the leave without pay will be extended for 90 days from the date of notification to enable the employee if eligible to apply for disability retirement.",
            "block_bbox": [
