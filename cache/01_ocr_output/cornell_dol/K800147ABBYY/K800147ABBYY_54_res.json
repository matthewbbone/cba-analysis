        },
        {
            "block_label": "text",
            "block_content": "Section 7. Recall: The Employer shall establish a recall list by classification by seniority unit for those employees furloughed under Section 5 of this Article in the inverse order of seniority.",
            "block_bbox": [
                137,
                821,
                1083,
