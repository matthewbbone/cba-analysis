                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. If an employee refuses to exercise rights under this Section, the employee shall forfeit all further bumping rights under this Section, recall rights under Section 7 of this Article to positions in all classifications except the one from which the employee was furloughed, and placement rights under Section 11 of this Article.",
            "block_bbox": [
                136,
                336,
                1083,
                446
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
