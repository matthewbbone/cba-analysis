            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Employees on such recall lists shall have rights to a position in a classification within the seniority unit from which they were furloughed provided they have the requisite seniority and skill and ability.",
            "block_bbox": [
                136,
                904,
                1085,
