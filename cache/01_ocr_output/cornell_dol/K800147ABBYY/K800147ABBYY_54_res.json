                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. Where practicable, the Employer will notify the Union one month in advance of any impending furlough.",
            "block_bbox": [
                137,
                471,
                1079,
                528
            ],
            "block_id": 3,
