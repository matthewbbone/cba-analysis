        },
        {
            "block_label": "text",
            "block_content": "c. If the affected employee is unable to bump into any position as provided in subsections a. and b. above, the employee shall be furloughed.",
            "block_bbox": [
                137,
                255,
                1084,
                312
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
