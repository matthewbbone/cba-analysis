        {
            "block_label": "table",
            "block_content": "<table><tr><td>Days Available</td><td>Percentage</td><td>Maximum</td></tr><tr><td>at Retirement</td><td>Buy-Out</td><td>Days</td></tr><tr><td>0 - 100</td><td>30%</td><td>30</td></tr><tr><td>101 - 200</td><td>40%</td><td>80</td></tr><tr><td>201 - 300</td><td>50%</td><td>150</td></tr><tr><td>over 300 (in last year of employment)</td><td>100% of days over 300</td><td>13</td></tr></table>",
