        },
        {
            "block_label": "text",
            "block_content": "Section 14. For the purpose of this Article, the calendar year shall be defined as beginning with the employee's first full pay period commencing on or after January 1 and continuing through the end of the employee's pay period that includes December 31.",
            "block_bbox": [
