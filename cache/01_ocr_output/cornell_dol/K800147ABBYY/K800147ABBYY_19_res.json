    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Section 12. An employee who is furloughed and is not employed in another position within 14 calendar days of the effective date of furlough will receive a lump sum payment for all earned, unused annual leave unless the employee requests in writing before the end of the 14 calendar days to freeze all earned unused annual leave.",
            "block_bbox": [
                138,
                120,
                1082,
                230
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    138.0,
                    120.0
                ],
                [
                    1082.0,
                    120.0
                ],
                [
                    1082.0,
                    230.0
                ],
                [
                    138.0,
                    230.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee may subsequently change a decision to freeze the earned, unused annual leave by submitting a written request for a lump sum payment for the annual leave. Payment will be made within 35 days of the date on which the request is received by the Employer, and will be at the rate of pay in effect on the last day of employment prior to the date of furlough.",
            "block_bbox": [
                138,
                255,
                1083,
                367
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    138.0,
                    255.0
                ],
                [
                    1083.0,
                    255.0
                ],
                [
                    1083.0,
                    367.0
                ],
                [
                    138.0,
                    367.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the employee is reemployed during the furlough recall period, the annual leave which was frozen will be reinstated. If the employee is not reemployed prior to the expiration of the furlough recall period, the employee shall be paid off in lump sum for all frozen earned unused annual leave at the rate of pay in effect on the last date of employment prior to the date of furlough.",
            "block_bbox": [
                137,
                390,
                1084,
                502
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
