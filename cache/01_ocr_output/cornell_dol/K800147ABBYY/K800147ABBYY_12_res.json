        },
        {
            "block_label": "text",
            "block_content": "Section 7. Permanent part-time employees will be compensated at one and one-half times their regular rate of pay for all hours worked on all holidays set forth in Section 1. No compensatory time will be granted for such hours. Monday shall be recognized as a holiday for all holidays occurring on a Sunday and Friday for all holidays occurring on a Saturday for permanent part-time employees of the Community Health Service. For other than these employees the holiday will be deemed to fall on the day on which it actually occurs.",
            "block_bbox": [
                137,
                498,
                1084,
                664
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    498.0
                ],
                [
                    1084.0,
                    498.0
                ],
                [
                    1084.0,
                    664.0
                ],
                [
                    137.0,
                    664.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Permanent part-time employees shall receive holidays on a pro rata basis. This additional paid leave is to be scheduled and granted in the same manner as personal leave.",
            "block_bbox": [
                137,
                687,
                1083,
                744
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    687.0
                ],
