        {
            "block_label": "text",
            "block_content": "Section 6. After mutual agreement between the Employer and the employee, the employee may be compensated at the employee's regular rate of pay in lieu of such paid time off as provided for in Section 5 or in lieu of paid time off for a holiday that occurs on an employee's scheduled day off.",
            "block_bbox": [
                138,
                390,
                1084,
                474
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
