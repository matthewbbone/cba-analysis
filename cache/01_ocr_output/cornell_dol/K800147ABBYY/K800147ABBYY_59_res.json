                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f. Employees placed in vacancies in the same classification from which they were furloughed will lose recall rights as outlined by Article 25, Section 7. Those employees placed in a lower classification will retain their recall rights under Article 25, Section 7.",
            "block_bbox": [
