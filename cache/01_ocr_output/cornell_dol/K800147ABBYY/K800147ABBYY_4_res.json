                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 2\nUNION SECURITY",
            "block_bbox": [
                508,
                661,
                715,
                714
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    508.0,
                    661.0
                ],
                [
                    715.0,
                    661.0
                ],
                [
                    715.0,
