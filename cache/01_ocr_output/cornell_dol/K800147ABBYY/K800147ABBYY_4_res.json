                    313.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 1\nRECOGNITION",
            "block_bbox": [
                525,
                337,
                699,
                391
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
