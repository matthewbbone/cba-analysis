        {
            "block_label": "text",
            "block_content": "Only employees who are required to be on standby are entitled to the compensation hereafter set forth. Such employees on standby time shall, at the Employer's discretion, either be paid 25% of their regular base pay for such standby time or receive compensatory time equivalent to 25% of such standby time. Standby time shall not be considered hours worked for the purpose of computing overtime. An employee is not considered to be on standby time during the period the employee is being paid for call time. If the Employer is unable to reach an employee who is on standby, the employee shall not receive pay or compensatory time for any of the hours which the employee was supposed to be on standby.",
            "block_bbox": [
                136,
                228,
                1085,
                447
            ],
            "block_id": 1,
            "block_order": 2,
