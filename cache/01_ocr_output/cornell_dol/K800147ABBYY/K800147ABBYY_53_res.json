                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A furloughed employee who applies for and receives retirement benefits from the State Employees' Retirement Board shall forfeit all recall rights as of the date of approval of benefits by the State Employees' Retirement Board.",
