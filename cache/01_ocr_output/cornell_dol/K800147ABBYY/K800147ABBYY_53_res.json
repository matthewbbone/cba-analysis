        },
        {
            "block_label": "text",
            "block_content": "Employees who are furloughed and who file applications for retirement benefits which are subsequently approved, will be considered to have a break in service as of the date of the approval of benefits by the State Employees' Retirement Board.",
            "block_bbox": [
                137,
                498,
                1084,
                583
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
