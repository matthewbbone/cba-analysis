                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) Where feasible, ten calendar days before realignment of staff occurs, the local union will be notified of the reason for and the scope of the realignment.",
            "block_bbox": [
                137,
                375,
                1082,
                432
            ],
