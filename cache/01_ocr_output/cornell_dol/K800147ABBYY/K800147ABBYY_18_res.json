        {
            "block_label": "text",
            "block_content": "Section 5. Employees who become ill during their vacation will not be charged annual leave for the period of illness provided they furnish satisfactory proof of such illness to the Employer upon their return to work.",
            "block_bbox": [
                138,
                120,
                1086,
                202
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
