            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 10. Employees on leave without pay to attend official Union conventions or conferences in accordance with Article 14, Section 3 shall have that time included in regular hours paid for purposes of earning annual leave entitlement and credited service under Section 1 above.",
