                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 9. The provisions of Section 1 of this Article shall not apply to temporary employees unless such employees have worked 750 regular hours by the end of the last full pay period in each calendar year. It is understood that this section does not apply to furloughed employees who, during their recall period, return to the Employer's payroll in a temporary capacity.",
            "block_bbox": [
                137,
                930,
                1086,
                1042
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
