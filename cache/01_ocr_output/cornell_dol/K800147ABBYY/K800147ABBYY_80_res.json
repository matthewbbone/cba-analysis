        },
        {
            "block_label": "text",
            "block_content": "For the purpose of this Article, son or daughter shall be defined as a the employee’s biological, adopted, or foster child, a step-child, a legal ward, or a child of a person standing in loco parentis or a biological or adopted child of the employee’s domestic partner who is",
            "block_bbox": [
