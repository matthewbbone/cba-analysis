                    419.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee shall have the right to return to the same position in the same classification held before going on parental leave, or to an equivalent position with regard to pay and skill.",
            "block_bbox": [
                137,
                444,
