        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 5. Annual, Personal, and Sick Leave",
            "block_bbox": [
                138,
                660,
                599,
                689
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
