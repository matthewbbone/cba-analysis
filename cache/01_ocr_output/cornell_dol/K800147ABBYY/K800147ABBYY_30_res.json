        {
            "block_label": "paragraph_title",
            "block_content": "Section 4. Seniority Rights",
            "block_bbox": [
                139,
                525,
                434,
                554
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
