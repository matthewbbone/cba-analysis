        },
        {
            "block_label": "text",
            "block_content": "Upon return from parental leave, an employee shall retain all seniority and pension rights that had accrued up to the time of leave. Seniority shall continue to accrue during parental leave.",
            "block_bbox": [
                138,
                579,
                1082,
                636
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
