        {
            "block_label": "paragraph_title",
            "block_content": "Section 3. Re-employment",
            "block_bbox": [
                139,
                390,
                437,
                419
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
