            "block_label": "paragraph_title",
            "block_content": "Section 1. - Filing of Grievances",
            "block_bbox": [
                139,
                227,
                456,
                255
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
