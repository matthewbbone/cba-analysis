        {
            "block_label": "text",
            "block_content": "The grievance shall be reduced to writing by the Union on a form approved by the Joint State Committee. Copies of same shall be submitted to the Office of Administration (Bureau of Labor Relations), District 1199P, Service Employees International Union, AFL-CIO, CLC, and the affected Employer (Division of Labor Relations).",
            "block_bbox": [
                137,
                282,
                1087,
                395
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
