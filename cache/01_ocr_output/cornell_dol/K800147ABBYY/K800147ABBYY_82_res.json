        },
        {
            "block_label": "text",
            "block_content": "f. Up to 12 weeks of donated leave per leave calendar year may be received for all conditions of the employee and family members cumulatively, but donations may not be received in more than two consecutive leave calendar years. Donated leave is added to the recipient's sick leave balance on a biweekly basis. Recipients do not repay the donor for donated leave. Leave usage is monitored closely to ensure that donated leave is used only for absences related to the catastrophic illness or injury.",
            "block_bbox": [
                137,
                605,
                1084,
                770
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
