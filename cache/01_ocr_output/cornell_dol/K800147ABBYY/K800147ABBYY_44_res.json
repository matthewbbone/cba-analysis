        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 22\nWORK-RELATED INJURIES",
            "block_bbox": [
                462,
                365,
                762,
                417
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
