            ]
        },
        {
            "block_label": "text",
            "block_content": "6) Employees who have a verified positive test result for controlled substances and/or alcohol during the initial hire, 6 or 12 month probationary period shall be terminated.",
            "block_bbox": [
                281,
                558,
                1084,
                642
            ],
            "block_id": 3,
