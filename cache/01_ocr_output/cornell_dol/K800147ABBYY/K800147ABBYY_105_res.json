        },
        {
            "block_label": "text",
            "block_content": "5) Employees who have a verified positive test result for controlled substances and/or alcohol during the 12 months following the date of the employee's return to duty shall be terminated.",
            "block_bbox": [
                282,
                447,
                1084,
                533
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
