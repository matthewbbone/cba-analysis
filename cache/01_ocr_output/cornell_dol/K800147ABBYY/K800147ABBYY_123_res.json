                ],
                [
                    335.0,
                    596.0
                ],
                [
                    147.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties have met and discussed over a procedure to be followed when a determination is made to terminate the reassignment of a Registered Nurse to a Forensic Registered Nurse during the trial period described in Article 25, Section 8 of the collective bargaining agreement. The parties have agreed as follows:",
            "block_bbox": [
                144,
                620,
                1087,
                739
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    144.0,
                    620.0
                ],
                [
                    1087.0,
                    620.0
                ],
                [
                    1087.0,
                    739.0
                ],
                [
                    144.0,
                    739.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The assessment that a return is indicated and the actual return may be made at any point during the six month period when a determination is made that it is warranted based on the employee's performance. The decision to return an employee will not be made for arbitrary or capricious reasons.",
            "block_bbox": [
                145,
                759,
                1088,
                878
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    145.0,
                    759.0
                ],
                [
                    1088.0,
                    759.0
                ],
                [
                    1088.0,
                    878.0
                ],
                [
                    145.0,
                    878.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The employee will be given notice of the assessment and when signing to denote the receipt, will indicate on the assessment document in writing a request for Bureau of Hospital Operations review.",
            "block_bbox": [
                145,
                898,
                1088,
                990
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    144.37582397460938,
                    905.004638671875
                ],
                [
                    1087.0,
                    898.0
                ],
                [
                    1087.6241455078125,
                    981.995361328125
                ],
                [
                    144.99996948242188,
                    989.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The employee and /or the union will then, upon request, be afforded access to information upon which the assessment is based.",
            "block_bbox": [
                148,
                1010,
                1088,
                1073
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    148.0,
                    1010.0
                ],
                [
                    1088.0,
                    1010.0
                ],
                [
                    1088.0,
                    1073.0
                ],
                [
                    148.0,
                    1073.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Within 10 days of the receipt of the information, the employee and/or the union can request in writing to the Director of the Bureau of Hospital Operations or designee a review of the information on which the assessment to reassign the employee was made. The union and/or the employee shall state the reason they believe the reassignment was improper and can attach any documentation they have to support their claim.",
            "block_bbox": [
                147,
                1092,
                1091,
                1241
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    147.0,
                    1092.0
                ],
                [
                    1091.0,
                    1092.0
                ],
                [
                    1091.0,
                    1241.0
                ],
                [
                    147.0,
                    1241.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. The employee and/or the union may request a meeting to discuss the issue with the Director of the Bureau of Hospital Operations or designee.",
            "block_bbox": [
                149,
                1260,
                1091,
                1324
            ],
