            ]
        },
        {
            "block_label": "text",
            "block_content": "Dear Mr. DeBruin:",
            "block_bbox": [
                147,
                569,
                335,
                596
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    147.0,
                    569.0
                ],
                [
                    335.0,
