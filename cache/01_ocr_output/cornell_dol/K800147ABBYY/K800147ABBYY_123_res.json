        {
            "block_label": "text",
            "block_content": "RE: Procedures to be followed if removing an employee from a FRN trial period",
            "block_bbox": [
                576,
                481,
                1052,
                543
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
