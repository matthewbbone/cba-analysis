                    136.0,
                    852.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Time Limits",
            "block_bbox": [
                139,
                876,
                255,
                905
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
