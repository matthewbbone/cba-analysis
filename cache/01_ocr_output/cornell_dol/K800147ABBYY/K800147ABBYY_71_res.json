        },
        {
            "block_label": "text",
            "block_content": "Section 1. It shall be the duty of the Employer to remedy all unsafe or unhealthy conditions within a reasonable time after notification by the Union of the existence of such condition.",
            "block_bbox": [
                137,
                768,
                1084,
                825
            ],
