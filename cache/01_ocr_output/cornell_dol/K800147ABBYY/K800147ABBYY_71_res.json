                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties agree in the interest of achieving drug and alcohol free Department of Corrections institutions/boot camps/corrections community centers, that the Department of Corrections may modify the above referenced programs and policies including but not limited to random drug and alcohol testing in the same manner as the program and policies are modified for the employee organization which represents the majority of state employees after meeting and discussing with the Union.",
            "block_bbox": [
                137,
                308,
                1083,
                448
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    308.0
                ],
                [
                    1083.0,
                    308.0
                ],
                [
                    1083.0,
                    448.0
                ],
                [
                    137.0,
                    448.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Commonwealth and the Union agree that the coverage of employees by the above referenced programs and policies and the agreement to meet and discuss prior to modifying the above referenced programs and policies represents the result of negotiations conducted under and in accordance with the Public Employee Relations Act and constitutes a term and condition of employment for employees in this bargaining unit.",
            "block_bbox": [
                137,
                471,
                1086,
                610
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
