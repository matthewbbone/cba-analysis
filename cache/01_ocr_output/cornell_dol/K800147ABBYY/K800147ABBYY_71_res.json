        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 39\nSAFETY AND HEALTH",
            "block_bbox": [
                487,
                876,
                737,
                932
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
