        },
        {
            "block_label": "text",
            "block_content": "Searches of employees due to a positive reaction to drug interdiction equipment or a K-9 will be conducted in accordance with the existing Institution Security Policy, 6.3.22.",
            "block_bbox": [
                136,
                227,
                1082,
                285
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
