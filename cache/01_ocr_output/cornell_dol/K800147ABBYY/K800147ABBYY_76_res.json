        {
            "block_label": "text",
            "block_content": "Section 1. In order to enhance the Commonwealth's ability to attract registered nurses who may not be available for full-time or regular part-time employment, the parties have established a separate and distinct classification which is known as \"PRN Nurse\". When staff level bargaining unit work is assigned from a pool of PRN Nurses on a day to day basis, such nurses shall be, for the period of their employment, bargaining unit employees, and subject to the terms of this Agreement excepting those Articles specified in Section 3 of this Article. It is understood that this classification may be used at all locations throughout the Commonwealth and that no use will be permitted through the reclassification of existing positions.",
            "block_bbox": [
                137,
                336,
                1084,
                555
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    336.0
                ],
                [
                    1084.0,
                    336.0
