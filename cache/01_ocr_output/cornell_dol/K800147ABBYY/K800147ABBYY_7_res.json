    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "When work schedules are to be adopted for new programs, the Employer will meet and discuss with the Union prior to the implementation of such schedules.",
            "block_bbox": [
                138,
                121,
                1084,
                177
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
