        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 24\nDISCHARGE, DEMOTION, SUSPENSION AND DISCIPLINE",
            "block_bbox": [
                297,
                121,
                924,
                174
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
