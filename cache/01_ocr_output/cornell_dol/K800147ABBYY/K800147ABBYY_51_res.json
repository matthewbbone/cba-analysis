                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 7. After a period of two years, a written reprimand or reference to an oral reprimand shall be removed from the employee's official personnel folder if no intervening incidents of the same or a similar nature have occurred.",
            "block_bbox": [
