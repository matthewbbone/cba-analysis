                [
                    137.0,
                    825.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Authorization from non-dues paying members to deduct fair share fees shall not be required. The amounts to be deducted shall be certified to the Employer by the Union, and the aggregate deductions of all employees shall be remitted together with an itemized statement thereof, to the Union by the last day of the succeeding month after such deductions are made.",
            "block_bbox": [
                137,
                849,
                1082,
                961
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
