                    744.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3. The Employer further agrees to deduct a fair share fee from the bi-weekly pay of all employees in the bargaining unit who are not dues paying members of the Union.",
            "block_bbox": [
                137,
                767,
                1081,
                825
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
