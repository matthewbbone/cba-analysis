        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 3\nDUES DEDUCTION",
            "block_bbox": [
                506,
                255,
                718,
                309
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
