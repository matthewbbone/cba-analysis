                    506.0,
                    309.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 1. The Employer agrees to deduct the Union bi-weekly membership dues, initiation fees and assessments, if any, only from the bi-weekly pay of those employees who individually authorize in writing that such deductions be made. The amounts to be deducted shall be certified to the Employer by the Union, and the aggregate deductions of all employees shall be remitted together with an itemized statement thereof, to the Union by the last day of the succeeding month after such deductions are made.",
            "block_bbox": [
                137,
                336,
                1081,
                473
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    137.0,
                    336.0
                ],
                [
                    1081.0,
                    336.0
                ],
                [
                    1081.0,
                    473.0
                ],
                [
                    137.0,
                    473.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This authorization shall be irrevocable by the employee during the term of this Agreement except as provided for in Article 2.",
            "block_bbox": [
                138,
                472,
                1083,
                527
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    138.0,
                    472.0
                ],
                [
                    1083.0,
                    472.0
                ],
                [
                    1083.0,
                    527.0
                ],
                [
                    138.0,
                    527.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When an authorization to deduct dues is revoked by the employee in accordance with Article 2, the Agency shall halt the check-off of dues effective the first full pay period following the expiration of this Agreement.",
            "block_bbox": [
                137,
                551,
                1084,
                635
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    551.0
