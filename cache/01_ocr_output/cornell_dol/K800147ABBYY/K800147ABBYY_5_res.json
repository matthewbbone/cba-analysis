                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 2. The employee's written authorization for dues payroll deductions submitted hereafter shall contain the employee's name, social security number, agency in which employed, work location (institution, district, bureau, etc.), Union name and local number.",
            "block_bbox": [
                137,
                660,
                1085,
                744
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
