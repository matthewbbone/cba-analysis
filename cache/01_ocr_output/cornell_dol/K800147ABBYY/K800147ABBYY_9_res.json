                    1083.0,
                    1015.0
                ],
                [
                    136.0,
                    1015.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "At the request of either party, the Employer shall meet and discuss at the agency or local level concerning the length and scheduled time of the meal period.",
            "block_bbox": [
                138,
                1038,
                1082,
                1095
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
