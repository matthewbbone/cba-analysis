            ]
        },
        {
            "block_label": "text",
            "block_content": "Section I. Employees shall be granted meal periods. The hours of work during a work day shall be exclusive of the meal period except at Scotland School for Veterans' Children, Department of Military and Veterans' Affairs, where the hours of work during the work day shall be inclusive of the meal period.",
            "block_bbox": [
                136,
                902,
                1083,
                1015
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    136.0,
                    902.0
                ],
                [
                    1083.0,
                    902.0
                ],
