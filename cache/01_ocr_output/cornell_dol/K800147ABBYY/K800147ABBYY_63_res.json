        {
            "block_label": "text",
            "block_content": "Section 1. Travel expenses shall be paid in accordance with the Commonwealth's existing Travel Expense Regulations. The mileage allowance shall be the General Services Administration rate. If the General Services Administration of the Federal Government increases or decreases the mileage allowance for employees under its jurisdiction, the mileage allowance for employees under this Agreement will be increased or decreased on the effective date of the General Services Administration change.",
            "block_bbox": [
                138,
                227,
                1084,
                394
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
