            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 2. - Composition",
            "block_bbox": [
                139,
                503,
                384,
                532
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    139.0,
                    503.0
                ],
                [
                    384.0,
