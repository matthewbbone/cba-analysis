        {
            "block_label": "text",
            "block_content": "It shall be the sole purpose of the Joint Pennsylvania State Committee to hear unresolved grievances from Step 1. The Joint State Committee shall have the authority to render final and binding decisions on all grievances properly brought before them.",
            "block_bbox": [
                137,
                393,
                1083,
                478
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
