        {
            "block_label": "paragraph_title",
            "block_content": "Section 1. Pennsylvania Employees Benefit Trust Fund",
            "block_bbox": [
                139,
                364,
                688,
                391
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
