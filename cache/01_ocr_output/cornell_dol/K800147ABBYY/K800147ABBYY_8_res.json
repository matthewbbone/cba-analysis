                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. If no agreement is reached at the local level a \"meet and discuss\" session will be scheduled at the agency level.",
            "block_bbox": [
                138,
                228,
                1080,
                285
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
