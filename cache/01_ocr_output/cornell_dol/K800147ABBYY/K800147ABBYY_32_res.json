                    1083.0,
                    445.0
                ],
                [
                    1083.0,
                    526.0
                ],
                [
                    138.0,
                    526.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. When an employee covered by this Agreement is demoted (including demotions occurring as a result of furlough bump or furlough recall) to another classification in a lower pay range, the employee shall receive a decrease of four steps for each pay range the employee is demoted or to the maximum of the new pay range, whichever is lesser.",
            "block_bbox": [
                137,
                526,
                1084,
                636
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
