        {
            "block_label": "text",
            "block_content": "d. Employees covered by this Agreement who terminate with at least one year of continuous service since their most recent appointment and who are reemployed within six months from the date of termination or furlough will be eligible to receive the one step service increments outlined in Subsections a., b., and c., if they are in an active pay status on the effective date of the increments.",
            "block_bbox": [
                137,
                175,
                1084,
                285
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
