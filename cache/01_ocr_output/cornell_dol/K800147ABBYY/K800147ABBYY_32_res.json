        },
        {
            "block_label": "text",
            "block_content": "Section 7. a. When an employee covered by this Agreement is promoted to another classification in a higher pay range, the employee shall receive an increase of four steps for each pay range the employee is promoted or to the minimum of the new pay range, whichever is greater.",
            "block_bbox": [
                138,
                445,
                1083,
                526
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    138.0,
                    445.0
                ],
