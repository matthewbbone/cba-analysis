        },
        {
            "block_label": "text",
            "block_content": "e. During the term of this Agreement, employees who are at or above the maximum step of their pay range at the time they would become eligible for a service increment as outlined in Subsections a., b., and c., shall receive the annual amount of a two and one-quarter percent (2.25%) increase in the form of a one-time cash payment rounded to the nearest dollar.",
            "block_bbox": [
                137,
                311,
                1086,
                420
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
