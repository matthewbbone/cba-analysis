            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 4. Personal leave days shall be noncumulative from calendar year to calendar year. However, employees will be permitted to carry over personal leave days into the first seven (7) pay periods of the next calendar year. Any days carried over in accordance with this Section which are not scheduled and used during the first seven (7) pay periods of the next calendar year will be lost.",
            "block_bbox": [
                137,
                931,
                1086,
                1041
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
