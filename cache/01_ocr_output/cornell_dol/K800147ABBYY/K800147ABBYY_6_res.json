                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 1. The workweek shall consist of five consecutive workdays in a pre-established work schedule except for employees in seven-day operations.",
            "block_bbox": [
                137,
                389,
                1083,
                447
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    137.0,
                    389.0
                ],
                [
                    1083.0,
                    389.0
                ],
                [
                    1083.0,
                    447.0
                ],
                [
                    137.0,
                    447.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 2. The workday shall consist of any 24 hours in a pre-established work schedule, beginning with the scheduled reporting time for the employee's shift. In the event of an early a.m. or late p.m. community health activity in the Department of Health, the Employer may flex the starting and quitting time for an employee without incurring an overtime liability. In the event of a training program at an institution or facility, the Employer may flex the starting and quitting time for an employee who so volunteers without incurring an overtime liability. In all cases, the flex schedule must be posted two weeks in advance. The Employer agrees to consider concerns raised by the employee about the impact of the scheduled \"flex\".",
            "block_bbox": [
                137,
                471,
                1085,
                690
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    137.0,
                    471.0
                ],
                [
                    1085.0,
                    471.0
                ],
                [
                    1085.0,
                    690.0
                ],
                [
                    137.0,
                    690.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 3. The work shift shall consist of 7 1/2 or 8 work hours within a work day and the number of hours in a shift on the date of this Agreement shall not be altered by the Employer at any institution, community health district or Health Department Central Office Unit without prior agreement of the Union.",
            "block_bbox": [
                137,
                714,
                1084,
                825
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    137.0,
                    714.0
                ],
                [
                    1084.0,
                    714.0
                ],
                [
                    1084.0,
                    825.0
                ],
                [
                    137.0,
                    825.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Except for emergencies, employees will not be required to work more than 16 consecutive hours, exclusive of meal periods.",
            "block_bbox": [
                137,
                849,
                1082,
                906
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    137.0,
                    849.0
                ],
                [
                    1082.0,
                    849.0
                ],
                [
                    1082.0,
                    906.0
                ],
                [
                    137.0,
                    906.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 4. The regular hours of work for any shift shall be consecutive except that they may be interrupted by a meal period.",
            "block_bbox": [
                137,
                930,
                1083,
                986
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
