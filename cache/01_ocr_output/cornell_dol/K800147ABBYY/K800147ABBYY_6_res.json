            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 5. Except for emergencies, work schedules showing the employees' shifts, workdays, and hours shall be posted on appropriate bulletin boards at the employee's work site two weeks in advance.",
            "block_bbox": [
                137,
                1011,
                1084,
                1068
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
