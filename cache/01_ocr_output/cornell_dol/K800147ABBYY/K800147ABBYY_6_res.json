        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 4\nHOURS OF WORK",
            "block_bbox": [
                508,
                310,
                715,
                364
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
