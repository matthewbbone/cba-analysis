                    1084.0,
                    120.0
                ],
                [
                    1084.0,
                    286.0
                ],
                [
                    137.0,
                    286.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The condition of the clothing or personal property immediately prior to such damage shall be taken into account in determining its value. The incident giving rise to such claims must be verified and not be due to the employee's own negligence.",
            "block_bbox": [
