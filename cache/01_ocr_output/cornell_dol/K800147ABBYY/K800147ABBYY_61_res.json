        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 27\nNON-DISCRIMINATION",
            "block_bbox": [
                477,
                579,
                746,
                633
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
