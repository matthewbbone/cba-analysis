        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 40\nPROFESSIONAL EDUCATION PROGRAM",
            "block_bbox": [
                387,
                605,
                837,
                660
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    387.0,
