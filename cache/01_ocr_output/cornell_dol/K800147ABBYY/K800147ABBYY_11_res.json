            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee who is on long term leave without pay (longer than one full pay period) and returns to active pay status on the day immediately prior and immediately subsequent to a holiday will not be paid for the holiday unless the leave without pay has terminated and the employee continues in active pay status.",
            "block_bbox": [
                136,
