        {
            "block_label": "text",
            "block_content": "Section 3. A permanent full-time employee on a Monday through Friday work week shall be paid for any holiday listed in Section 1 of this Article, provided the employee was scheduled to work on that day and if the employee was in an active pay status on the last half of the employee's scheduled work day immediately prior and the first half of the employee's scheduled work day immediately subsequent thereto. If a holiday occurs while employees are on leave without pay under Article 14, Section 3, they shall be paid for the holiday provided they were scheduled to work on that day and if the employees were in active pay status the last half of their scheduled work day immediately prior and the first half of their scheduled work day immediately subsequent to the leave without pay.",
            "block_bbox": [
                137,
                336,
                1086,
                556
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
