                    423.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b) The training provided by the contractor must cover the physical, behavioral, speech, and performance indicators of probable alcohol misuse and use of controlled substances.",
            "block_bbox": [
                352,
                447,
                1082,
                532
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
