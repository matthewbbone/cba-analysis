        {
            "block_label": "text",
            "block_content": "a) Supervisors/Managers designated to determine whether reasonable suspicion exists to require an employee to undergo controlled substance and/or alcohol testing must receive the Department of Corrections approved training on controlled substances, alcohol misuse and reasonable suspicion determinations.",
            "block_bbox": [
                353,
                281,
                1085,
                423
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
