            "block_label": "text",
            "block_content": "2) The required observations for controlled substances and alcohol reasonable suspicion testing must be made by a supervisor or manager who is trained in accordance with the following requirements:",
            "block_bbox": [
                282,
                170,
                1084,
                256
            ],
            "block_id": 0,
