        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 42\nSUCCESSORS",
            "block_bbox": [
                534,
                769,
                691,
                823
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
