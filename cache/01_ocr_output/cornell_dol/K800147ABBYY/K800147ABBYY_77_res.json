                    1016.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "For informational purposes, the Employer shall notify the new Employer of the existence of this Agreement, and shall notify the new Employer that the Union is the certified bargaining representative of employees covered by this Agreement.",
