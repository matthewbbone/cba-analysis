                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 5. a. Employees hired into classifications covered by this Agreement shall be paid the minimum rate for the pay range assigned to their classification as reflected on the Standard Pay Schedule.",
            "block_bbox": [
                137,
                822,
                1084,
                905
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
