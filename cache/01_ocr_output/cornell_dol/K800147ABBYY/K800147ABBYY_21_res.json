                    173.0,
                    832.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. The initial 20 days (150/160 hours) of absence may be accumulated and the additional leave may be used on an intermittent basis.",
            "block_bbox": [
                174,
                852,
                1045,
                911
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    174.0,
