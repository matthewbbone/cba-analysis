                    174.0,
                    911.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. Proof of the family member’s serious health condition as defined by the Family and Medical Leave Act must be provided on the Commonwealth’s Serious Health Condition Certification form. Proof may be required for each absence during the 20 day (150/160 hour) period and subsequent additional sick family leave period.",
            "block_bbox": [
                173,
                935,
                1047,
                1049
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
