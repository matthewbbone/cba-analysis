                    210.0,
                    698.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. Controlled Substances. The controlled substances covered by this policy include cocaine, marijuana, opiates, phencyclidine (PCP), amphetamines, barbiturates, Benzodiazepine and Quaaludes (Methaqualine).",
            "block_bbox": [
                210,
                723,
                1084,
                808
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
