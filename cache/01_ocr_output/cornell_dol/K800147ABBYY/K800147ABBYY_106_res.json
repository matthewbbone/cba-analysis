                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Alcohol. The intoxicating agent in beverage alcohol, ethyl alcohol (ethanol) or other low molecular weight alcohols, including methyl and isopropyl alcohol.",
            "block_bbox": [
                210,
                421,
                1080,
                477
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    210.0,
                    421.0
                ],
                [
                    1080.0,
                    421.0
                ],
                [
                    1080.0,
                    477.0
                ],
                [
                    210.0,
                    477.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Alcohol use. The consumption of any beverage, mixture, or preparation. For employees in the CDL program this definition also includes the consumption of any medication containing alcohol.",
            "block_bbox": [
                210,
                503,
                1082,
                587
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    210.0,
                    503.0
                ],
