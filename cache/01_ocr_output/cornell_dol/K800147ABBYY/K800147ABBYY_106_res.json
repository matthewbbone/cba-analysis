                [
                    210.0,
                    587.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Breath Alcohol Technician (BAT). An individual who instructs and assists individuals in the alcohol testing process and operates an Evidential Breath Testing (EBT) device.",
            "block_bbox": [
                210,
                614,
                1084,
                698
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    210.0,
                    614.0
                ],
