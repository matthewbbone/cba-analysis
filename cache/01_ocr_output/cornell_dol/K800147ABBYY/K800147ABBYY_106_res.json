        {
            "block_label": "paragraph_title",
            "block_content": "2. DEFINITIONS",
            "block_bbox": [
                138,
                364,
                377,
                392
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
