                ],
                [
                    628.0,
                    278.0
                ],
                [
                    628.0,
                    344.0
                ],
                [
                    106.0,
                    344.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(ii) Employees with three (3) weeks of earned vacation may receive reimbursement from the Company for one (1) to five (5) days of unused vacation. Employees with four (4) or more weeks of earned vacation may receive payment for one (1) to ten (10) days of unused vacation. Only earned vacation which is unused as of the twentieth (20th) month from date of award is subject to this provision.",
            "block_bbox": [
                107,
                349,
                629,
                481
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    107.0,
