            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) All regular full-time and regular part-time employees are eligible to be paid for unused earned vacation days (at least three (3) weeks of earned vacation).",
            "block_bbox": [
                106,
                278,
                628,
                344
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    106.0,
