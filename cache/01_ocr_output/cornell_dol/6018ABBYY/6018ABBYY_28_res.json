                    107.0,
                    481.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(iii) All other vacation days not used at the end of a twenty (20) month period will be forfeited.",
            "block_bbox": [
                107,
                486,
                627,
                531
            ],
            "block_id": 6,
