            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Work performed by an employee required to start on Martin Luther King's Birthday, Good Friday, Memorial Day, Fourth of July, Labor Day, the Day after Thanksgiving;",
            "block_bbox": [
                128,
                275,
                680,
                345
