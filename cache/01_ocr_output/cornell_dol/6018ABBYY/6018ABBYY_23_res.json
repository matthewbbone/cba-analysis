            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) Work performed by an employee scheduled to be started on Saturdays or Sundays, when these days fall within the employee's forty (40) hour work week, employee will be paid at one and one-quarter (1-?) the employee's regular straight-time hourly rate of pay.",
            "block_bbox": [
