            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) Work Hour Limitation – No employee will be required to work more than sixteen (16) consecutive hours (exclusive of non-paid eating time) unless agreed to by the employee.",
            "block_bbox": [
                93,
