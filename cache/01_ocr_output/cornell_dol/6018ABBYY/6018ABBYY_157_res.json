        {
            "block_label": "text",
            "block_content": "Center shall be considered one location. The Ann Arbor, Wyandotte, Hamtramck and Dearborn Business offices shall be considered one location. Such determination shall be made consistent with the forecasted workload and the Company's obligation to maintain a proper working force and to provide adequate service to its customers. The Company shall make a reasonable effort to provide employees an opportunity to take vacations at times desired by them. Vacation shall be opened to each location equally.",
            "block_bbox": [
                54,
                89,
                637,
                266
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
