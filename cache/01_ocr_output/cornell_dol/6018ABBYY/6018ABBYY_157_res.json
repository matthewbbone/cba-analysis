                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Vacation periods shall be scheduled pursuant to the foregoing and the following provisions:",
            "block_bbox": [
                55,
                284,
                635,
                330
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
