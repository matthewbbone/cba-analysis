            ]
        },
        {
            "block_label": "text",
            "block_content": "a) Only those employees shall be eligible for advanced assignment who are in the next lower classification group and who have been rated by the Company (on semi-annual ratings) as qualified and who are satisfactorily performing, or have satisfactorily performed at a group level immediately below the group in which the job opening exists, work of a nature similar to the work to be performed in such higher classified job. If no employee in the next lower classification bids for said job opening, the Company will continue to canvass employees in the next lower classifications who have been rated by the Company (on semi-annual ratings) as qualified and who are satisfactorily performing at a group level, below the group in which the job openings exist, work of a nature similar to the work to be performed in such higher classified job.",
            "block_bbox": [
