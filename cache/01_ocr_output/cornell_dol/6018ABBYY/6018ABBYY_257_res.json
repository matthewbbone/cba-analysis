                ],
                [
                    630.0,
                    585.0
                ],
                [
                    630.0,
                    674.0
                ],
                [
                    45.0,
                    674.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- An employee must have been hospitalized for a serious, life threatening illness to qualify for the elimination period being waived and have a need for the follow-up treatment outlined below.",
