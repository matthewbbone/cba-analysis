            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees wanting to be called for or offered overtime for Night Service will notify Management and be so designated on the overtime list. When it is necessary to solicit for such overtime those employees so designated will be offered the overtime. Those employees with lower seniority on the overtime list will be charged for any solicited overtime. If it is necessary to force overtime for the Night Service the entire overtime list will be used and forcing done by low overtime.",
            "block_bbox": [
                45,
                519,
