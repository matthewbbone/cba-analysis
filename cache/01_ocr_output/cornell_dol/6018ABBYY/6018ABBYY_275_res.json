                    632.0,
                    354.0
                ],
                [
                    632.0,
                    487.0
                ],
                [
                    53.0,
                    487.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Employees reporting to every other station existing on July 20, 1980, who were on the payroll as of that date, and who until such date were classified under the former Detroit District Classification of Work and Wages in resolving conflicting requests for vacation period applicable to each, such other station, except Michigan Avenue Station.",
