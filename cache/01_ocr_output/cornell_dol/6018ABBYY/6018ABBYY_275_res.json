                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "For purpose of Article V (3) of the Collective Bargaining Agreement:",
            "block_bbox": [
                54,
                316,
                564,
                340
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
