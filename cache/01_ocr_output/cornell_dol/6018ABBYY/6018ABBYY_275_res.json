                    242.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "By way of further clarification of our agreement, which we mutually deem appropriate, I have set out the following understanding:",
            "block_bbox": [
                53,
                257,
                631,
                302
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
