                    95.0,
                    355.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• If quality is the measurement not being attained, the CSR II is informed that the Leader will begin (AM) \"Accelerated Monitoring\".",
            "block_bbox": [
                96,
                363,
                674,
                409
            ],
            "block_id": 3,
