                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Paid or unpaid sick self shall be allowed for an employee's medical or dental appointments provided that the following conditions are met:",
            "block_bbox": [
                79,
                628,
                622,
                674
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
