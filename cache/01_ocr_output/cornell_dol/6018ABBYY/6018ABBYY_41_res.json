                ],
                [
                    79.0,
                    674.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) The appointment cannot be scheduled at a time other than the employee's regularly scheduled hours of work; and",
            "block_bbox": [
                108,
                688,
                621,
                734
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    108.0,
                    688.0
                ],
                [
                    621.0,
                    688.0
                ],
                [
                    621.0,
                    734.0
                ],
                [
                    108.0,
                    734.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(ii) The employee's workweek schedule (excluding shift changes and changing days off with other employees) cannot be changed to accommodate the appointment; and",
            "block_bbox": [
                108,
                748,
                622,
                815
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    108.0,
                    748.0
                ],
                [
                    622.0,
                    748.0
                ],
                [
                    622.0,
                    815.0
                ],
                [
                    108.0,
                    815.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(iii) The employee submits written notice to his or her immediate supervisor at least thirty-six hours prior to the scheduled appointment.",
            "block_bbox": [
                108,
                829,
                621,
                874
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
