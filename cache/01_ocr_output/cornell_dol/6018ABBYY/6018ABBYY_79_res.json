            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Effective with the first payroll in March 2001, the Company will match the employee's contributions in accordance with the following schedule:",
            "block_bbox": [
                125,
                444,
                675,
                511
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
