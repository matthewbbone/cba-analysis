                ],
                [
                    671.0,
                    846.0
                ],
                [
                    92.0,
                    846.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9. Unless specified otherwise hereinabove, the terms and conditions set forth in the Collective Bargaining Agreement, which includes but is not limited to, safety shoes, scheduling of Saturdays, etc., shall remain in effect.",
