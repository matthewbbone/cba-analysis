        {
            "block_label": "paragraph_title",
            "block_content": "Welder Classification Agreement",
            "block_bbox": [
                242,
                105,
                529,
                130
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
