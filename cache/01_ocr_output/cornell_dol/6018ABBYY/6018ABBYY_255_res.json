                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If an employee tests positive under the Company's D.O.T. Drug Program and has completed treatment and tests positive for drugs before returning to work, said employee will have the option of being off on voluntary absence for the appropriate amount of time to ensure that he/she is drug free upon returning to work without moving to the next step of the program.",
            "block_bbox": [
                42,
                289,
                625,
                401
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    42.0,
                    289.0
                ],
                [
                    625.0,
                    289.0
                ],
                [
                    625.0,
                    401.0
                ],
                [
                    42.0,
                    401.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If said employee elects to stay on sick leave after testing positive, he/she will advance to the next step of the program and receive the appropriate discipline and then be allowed to continue on with their sick leave for the appropriate amount of time to ensure that he/she is drug free upon returning to work.",
            "block_bbox": [
                42,
                417,
                624,
                506
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    42.0,
                    417.0
                ],
                [
                    624.0,
                    417.0
                ],
                [
                    624.0,
                    506.0
                ],
                [
                    42.0,
                    506.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If said employee is at his third occurrence, this option will not be offered and the program provision shall apply.",
            "block_bbox": [
                42,
                521,
                623,
                568
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
