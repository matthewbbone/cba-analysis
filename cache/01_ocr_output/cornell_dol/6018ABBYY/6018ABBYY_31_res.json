                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(ii) All earned vacation shall be used before the starting date of the leave;",
            "block_bbox": [
                126,
                279,
                673,
                302
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
