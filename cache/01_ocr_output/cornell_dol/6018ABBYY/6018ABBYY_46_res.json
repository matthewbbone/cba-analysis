                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) In all cases involving occupational disabilities, an employee shall follow such rules and regulations as may be in effect with respect thereto and notify the Company as soon as possible in accordance therewith.",
            "block_bbox": [
                77,
                232,
                621,
                321
            ],
            "block_id": 4,
            "block_order": 4,
