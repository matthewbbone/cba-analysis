                    77.0,
                    321.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Give the Company full and correct information, to the best of the employee's ability, regarding the disability.",
            "block_bbox": [
                77,
                335,
                621,
                382
            ],
            "block_id": 5,
