        },
        {
            "block_label": "text",
            "block_content": "It is further agreed that Local #80 shall have the exclusive responsibility for working on situations involving the uncontrolled release of gas into the environment.",
            "block_bbox": [
                45,
                151,
                632,
                220
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
