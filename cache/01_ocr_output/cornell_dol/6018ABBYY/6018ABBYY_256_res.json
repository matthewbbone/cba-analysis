                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. By June, 1998, the Company will begin to conduct Drug Awareness / ReachOut training for all supervisors and Union representatives.",
            "block_bbox": [
                100,
                631,
                680,
                677
            ],
            "block_id": 8,
            "block_order": 8,
