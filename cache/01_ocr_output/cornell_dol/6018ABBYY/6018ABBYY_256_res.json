                [
                    100.0,
                    567.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. EAP vendor(s) selected will be expected to conduct personal presentations at all stations at least once a year.",
            "block_bbox": [
                100,
                576,
                679,
                621
            ],
            "block_id": 7,
