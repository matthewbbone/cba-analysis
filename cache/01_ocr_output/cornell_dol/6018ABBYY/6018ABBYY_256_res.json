        },
        {
            "block_label": "text",
            "block_content": "The purpose of this letter is to confirm the understanding reached between the parties during the 1997 contract negotiations in regards to an Employee ReachOut/Drug Rehabilitation Program. The parties agreed to the following:",
            "block_bbox": [
                100,
                341,
                681,
                410
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    100.0,
                    341.0
                ],
                [
                    681.0,
                    341.0
                ],
                [
                    681.0,
                    410.0
                ],
                [
                    100.0,
                    410.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The Company remains committed to the success of the Employee ReachOut Program.",
            "block_bbox": [
                102,
                420,
                680,
                466
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    102.0,
                    420.0
                ],
                [
                    680.0,
                    420.0
                ],
                [
                    680.0,
                    466.0
                ],
                [
                    102.0,
                    466.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. A Union representative will be assigned to work with the EAPA (Employee Assistance Program Administrator) in selecting drug rehabilitation and ReachOut vendor(s), providing input on program changes and to monitor program on an ongoing basis.",
            "block_bbox": [
                100,
                476,
                680,
                567
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    100.0,
                    476.0
                ],
