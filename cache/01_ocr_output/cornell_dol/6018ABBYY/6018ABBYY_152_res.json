        {
            "block_label": "text",
            "block_content": "The Union and Company recognize that the ever-changing marketplace makes it mutually beneficial to maintain open and meaningful dialogue at the highest Union/Management levels concerning the Company's competitive challenges. Business needs and the Union's desire to provide significant input concerning related Company decisions and actions which may effect and/or impact Union represented employees. Therefore, the parties agree to initiate a joint Training Advisory Team for ensuring such open dialogue and to forge a stronger partnership dedicated to the promotion of mutually beneficial objects.",
            "block_bbox": [
                99,
                130,
                683,
                329
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
