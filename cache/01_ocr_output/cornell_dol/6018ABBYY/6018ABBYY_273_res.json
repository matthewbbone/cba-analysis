        {
            "block_label": "text",
            "block_content": "Any employee on the payroll July 20, 1980, in the Ann Arbor district shall report to his or her station prior to being loaned to any station other than the Michigan Avenue Station. Any employee from the Broadway Station who is loaned to the Michigan Avenue Station shall report directly to the Michigan Avenue Station. Any Michigan Avenue employee who was formerly described as an Ann Arbor District employee and is loaned to the Broadway Station shall report directly to the Broadway Station.",
            "block_bbox": [
                42,
                690,
                626,
                846
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
