        },
        {
            "block_label": "text",
            "block_content": "An employee shall not receive any compensation while on medical leave of absence and shall be paid in full for any and all unused, earned and accrued vacation credits due to him/her before being placed on such leave. While an employee is on a medical leave of absence and upon termination thereof, his/her rights under the Retirement Plan, Group Life Insurance Plan, Traditional Medical Plan or HMO, Group Dental Plan, Prescription Drug, and Surviving Spouse Annuity Benefit shall be governed by the provisions of such plans.",
            "block_bbox": [
