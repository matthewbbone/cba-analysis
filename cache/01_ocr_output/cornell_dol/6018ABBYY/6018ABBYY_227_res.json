            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) Stock management determines the \"loan from\" location. All employees in the required classification will be canvassed by department seniority (high to low) to identify a volunteer, including employees presently on loan. If no one volunteers, the least senior eligible employee will be forced.",
            "block_bbox": [
                127,
                659,
                677,
                769
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
