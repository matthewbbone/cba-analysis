                    505.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) Notify the Company as soon as possible in all cases involving such disabilities and, if possible, on the first day of such disability.",
            "block_bbox": [
                130,
                513,
                674,
                559
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
