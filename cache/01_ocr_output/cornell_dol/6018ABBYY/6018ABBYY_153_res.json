        {
            "block_label": "text",
            "block_content": "The Training Advisory Team will be established for the Customer Service Department, consisting of an equal number of management and Local#80 employees, not to exceed a total of eight (8). The Training Team will work to review and determine the curriculum for training new hires, incumbents and transfers, which will then be referred to the Training Department for implementation of the programs.",
            "block_bbox": [
                47,
                78,
                630,
                213
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
