        {
            "block_label": "paragraph_title",
            "block_content": "5 Excused Absences for Union Duties at Union Request",
            "block_bbox": [
                320,
                567,
                715,
                586
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
