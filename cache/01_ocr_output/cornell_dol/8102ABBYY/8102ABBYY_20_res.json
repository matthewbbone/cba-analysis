                [
                    321.0,
                    366.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) In transferring Union Representatives to meet the needs of the business, consideration will be given to the business needs of the Union.",
            "block_bbox": [
                343,
                373,
                874,
                409
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    343.0,
                    373.0
                ],
                [
                    874.0,
                    373.0
                ],
                [
                    874.0,
                    409.0
                ],
                [
                    343.0,
                    409.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) A Job Steward shall not be transferred when there is, assigned at the same work site or building, another Employee of comparable experience and ability who can be as readily released and transferred at no greater cost to the Company.",
            "block_bbox": [
                343,
                415,
                875,
                485
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    343.0,
                    415.0
