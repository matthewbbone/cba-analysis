                [
                    343.0,
                    485.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) A \"work site\" encompasses a group of Employees normally engaged in a common effort. The work site may be involved in multiple points of work, such as, but not limited to those encountered in outside plant operations.",
            "block_bbox": [
                376,
                491,
                875,
                561
            ],
            "block_id": 7,
