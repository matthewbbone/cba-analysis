        {
            "block_label": "paragraph_title",
            "block_content": "3 Reclassification of Union Representatives",
            "block_bbox": [
                321,
                120,
                632,
                139
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    321.0,
