        {
            "block_label": "paragraph_title",
            "block_content": "7 Access Agreement",
            "block_bbox": [
                320,
                511,
                497,
                530
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
