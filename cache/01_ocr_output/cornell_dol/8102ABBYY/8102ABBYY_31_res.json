        {
            "block_label": "text",
            "block_content": "(a) Upon the written request of the Local, the Company shall furnish the Local each month or quarter, as requested, with a complete list of all Employees represented by the respective Local (including Employees on regular \"man loan\" order), together with their job addresses. The Company will also furnish the Local upon request on either a weekly or bi-weekly basis a list of additions and removals of Employees and their changes of job addresses.",
            "block_bbox": [
                374,
                187,
                909,
                311
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    374.0,
                    187.0
                ],
                [
                    909.0,
                    187.0
                ],
