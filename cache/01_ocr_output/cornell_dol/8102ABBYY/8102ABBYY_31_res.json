                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) When an Employee is reclassified to or from a salary-rated, non-supervisory job in the Installation Field forces of the Company, the Local affected will be given at least one (1) week's advance notice of such reclassification and, upon request, negotiations will take place.",
            "block_bbox": [
                372,
                634,
                907,
                705
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
