        {
            "block_label": "text",
            "block_content": "(b) When transportation is furnished by the Company on a Local Assignment, Employees assigned to travel in the Company- provided vehicle as driver or passenger shall be paid as follows:",
            "block_bbox": [
                375,
                118,
