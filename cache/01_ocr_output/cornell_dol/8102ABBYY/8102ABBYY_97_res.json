        },
        {
            "block_label": "text",
            "block_content": "(1) An Employee assigned to drive a Company-provided vehicle shall be paid as authorized time worked for all time so spent driving over the route specified by his or her Supervisor.",
            "block_bbox": [
                407,
                177,
                910,
                232
