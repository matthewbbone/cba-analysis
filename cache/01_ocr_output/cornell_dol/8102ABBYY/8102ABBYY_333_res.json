        {
            "block_label": "paragraph_title",
            "block_content": "Re: Ad Hoc Pension increase",
            "block_bbox": [
                351,
                341,
                609,
                361
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
