                ],
                [
                    403.0,
                    595.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) the former employee is rehired into a regular full-time or regular part-time job (not term or temporary) via any employment process, or",
            "block_bbox": [
                450,
                606,
                874,
                661
            ],
