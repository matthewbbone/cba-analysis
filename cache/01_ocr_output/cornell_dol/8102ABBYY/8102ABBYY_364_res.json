            ]
        },
        {
            "block_label": "text",
            "block_content": "(ii) the former employee, during the same surplus declaration, refuses a second position for which he/she requested Surplus Placement consideration through the LTP, or",
            "block_bbox": [
                450,
                673,
                874,
                745
            ],
            "block_id": 8,
