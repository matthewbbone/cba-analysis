        },
        {
            "block_label": "text",
            "block_content": "(1) A former employee who has been laid off with recall rights and has not completed sixty (60) day of surplus eligibility in the LTP by the off roll date, will retain surplus eligibility until he/she has achieved 60 days of surplus eligibility.",
            "block_bbox": [
                402,
                422,
                875,
                494
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
