                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) A former employee who is a candidate for Surplus Rehire Placement will be subject to the same requirements and treatment that apply to Surplus Placement as set forth paragraph 4((d)) above, except that his/her surplus status will end when any of the following occur:",
            "block_bbox": [
                403,
                505,
                874,
                595
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
