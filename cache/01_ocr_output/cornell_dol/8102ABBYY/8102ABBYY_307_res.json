                [
                    351.0,
                    612.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In death cases occurring during a Military Leave of Absence, sickness death benefits, where payable, shall be based upon the term of net credited service at the time the leave was granted, plus the elapsed time of Military Leave of Absence to the date of death, and shall be computed at the time the leave began.",
            "block_bbox": [
                350,
                632,
                908,
                706
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
