        },
        {
            "block_label": "text",
            "block_content": "A regular employee (not temporary, term or occasional) who enters the United States Uniformed Services for Active Duty for Military Service shall be granted a Military Leave of Absence for the period of his/her necessary absence. Voluntary extension of military service beyond five (5) years shall not be construed as necessary absence. A regular employee (not temporary, term or occasional) who is a member of a reserve component or organized militia of the state and enters upon Military Training Duty will be granted a Military Leave of Absence for the period of the necessary absence for such training. The term \"Uniformed Services\" as used herein shall mean Uniformed Services of the United States as specified in the Uniformed Services Employment and Reemployment Rights Act of 1994.",
            "block_bbox": [
                351,
                201,
                909,
                395
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    351.0,
                    201.0
                ],
                [
                    909.0,
                    201.0
                ],
                [
                    909.0,
                    395.0
                ],
                [
                    351.0,
                    395.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee, on a Military Leave of Absence for Active Duty for Military Service or military training duty and who has re-employment rights under the Uniformed Services Employment and Reemployment Rights Act of 1994 and who makes application for reinstatement within the period provided in the law, will receive upon reinstatement, full service credit for the period of absence for military service or training duty.",
            "block_bbox": [
                351,
                414,
                909,
                522
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    351.0,
                    414.0
                ],
                [
                    909.0,
                    414.0
                ],
                [
                    909.0,
                    522.0
                ],
                [
                    351.0,
                    522.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Military Leaves of Absence will be with eligibility to sickness disability benefits at the termination of the leave if the employee is then disabled but otherwise entitled to reinstatement in accordance with the terms of the Lucent Benefit Plans.",
            "block_bbox": [
                351,
                540,
                908,
                612
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    351.0,
                    540.0
                ],
                [
                    908.0,
                    540.0
