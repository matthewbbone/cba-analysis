        {
            "block_label": "text",
            "block_content": "The procedures to be followed are listed below:",
            "block_bbox": [
                354,
                139,
                680,
                160
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    354.0,
