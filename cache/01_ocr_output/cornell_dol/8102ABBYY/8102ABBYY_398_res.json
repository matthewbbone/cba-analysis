            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "4 Time Bound",
            "block_bbox": [
                319,
                465,
                450,
                485
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
