        {
            "block_label": "text",
            "block_content": "(a) When an Employee is called during his or her leisure time and given a work assignment not requiring a change in living accommodations, but requiring the Employee to proceed at once to the emergency job, it shall be considered a Call-In. Leisure time respecting Call-Ins is the time during which the Employee is not scheduled to work including observed holidays and vacations.",
            "block_bbox": [
                344,
                348,
                876,
                454
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
