                [
                    435.0,
                    595.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(4) Career Placement future Requests will remain on file for three (3) years from the date of receipt, but will be canceled upon the occurrence of any of the following:",
            "block_bbox": [
                434,
                606,
                908,
                662
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
