                ],
                [
                    908.0,
                    606.0
                ],
                [
                    908.0,
                    662.0
                ],
                [
                    434.0,
                    662.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) the employee no longer meets the LTP eligibility criteria.",
            "block_bbox": [
                483,
                673,
                908,
                711
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
