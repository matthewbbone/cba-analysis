        {
            "block_label": "text",
            "block_content": "Effective May 31, 1998, Social Security Supplement payments, under the Lucent Technologies Inc. Pension Plan (the \"Plan\") that were made available to designated eligible employees who were involuntarily terminated under a force adjustment program during specified periods during the term of the 1995 Memorandum of Understanding shall be made available during the term of this Memorandum of Understanding, with the following changes:",
            "block_bbox": [
                320,
                240,
                878,
                346
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    320.0,
                    240.0
                ],
                [
                    878.0,
                    240.0
                ],
                [
                    878.0,
                    346.0
                ],
                [
                    320.0,
                    346.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Eligibility for the payments under this provision shall be limited to eligible employees who are involuntarily terminated (with less than 30 years of service and at an age under age 55) with service pension eligibility under a force adjustment program at any time during the term of this Memorandum of Understanding.",
            "block_bbox": [
                356,
                352,
                878,
                439
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    356.0,
                    352.0
                ],
                [
                    878.0,
                    352.0
                ],
                [
                    878.0,
                    439.0
                ],
                [
                    356.0,
                    439.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Amount of Social Security Supplement",
            "block_bbox": [
                355,
                445,
                658,
                463
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    355.0,
                    445.0
                ],
                [
                    657.0,
                    445.0
                ],
                [
                    657.0,
                    462.0
                ],
                [
                    355.0,
                    462.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The amount of such Social Security Supplement payments shall equal the amount of the reduction in an employee's monthly annuity payment because of retirement prior to age 55 (but not in excess of an employee's projected Social Security benefit at age 65) and the duration of such payments shall end on the first to occur of the completion of twelve years of payments, the attainment of age 62 or the death of the retired employee.",
            "block_bbox": [
                384,
                469,
                878,
                593
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    384.0,
                    469.0
