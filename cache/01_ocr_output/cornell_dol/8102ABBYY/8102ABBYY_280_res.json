        },
        {
            "block_label": "paragraph_title",
            "block_content": "(3) Company.Healthcare Funding for 2007 and Later.",
            "block_bbox": [
                324,
                330,
                730,
                350
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
