            ]
        },
        {
            "block_label": "text",
            "block_content": "This authorization shall remain in effect when I am employed by Lucent Technologies Inc. unless canceled by me. Such cancellation must be individually sent to my Lucent Technologies Inc. Payroll Office and the Union Local by Certified Mall during the fourteen (14) day period prior to the anniversary date or termination date of the current or subsequent Collective Bargaining Agreement, and shall be effective on the first payroll period in the following month.",
            "block_bbox": [
                351,
                434,
                910,
                528
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
