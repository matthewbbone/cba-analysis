        {
            "block_label": "paragraph_title",
            "block_content": "OTS MAINTENANCE CONTRACTS REQUIRING SECURITY CLEARANCE\nWHICH ARE IMPACTED BY A FORCE ADJUSTMENT\nMEMORANDUM OF UNDERSTANDING",
            "block_bbox": [
                367,
