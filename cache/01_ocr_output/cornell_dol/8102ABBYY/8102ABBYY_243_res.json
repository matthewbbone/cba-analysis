        {
            "block_label": "text",
            "block_content": "1. OTS Maintenance problem markets are defined as Base locations where the company's ability to support On-site Technical Services (OTS) maintenance customers which can be negatively affected by a Force Adjustment impacting OTS Installers with security clearance(s) that have less than ten (10) years of service.",
            "block_bbox": [
                351,
                251,
                907,
                341
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    351.0,
                    251.0
                ],
                [
                    907.0,
