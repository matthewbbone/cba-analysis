        {
            "block_label": "table",
            "block_content": "<table><tr><td>Vacation</td><td>Maximum Allowable</td></tr><tr><td>Eligibility</td><td>Allowance</td></tr><tr><td>1 week</td><td>2 days</td></tr><tr><td>2 weeks</td><td>3 days</td></tr><tr><td>3 weeks</td><td>5 days</td></tr><tr><td>4 weeks</td><td>7 days</td></tr><tr><td>5 weeks</td><td>10 days</td></tr></table>",
