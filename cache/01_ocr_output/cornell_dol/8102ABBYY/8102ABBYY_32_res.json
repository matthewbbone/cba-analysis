        {
            "block_label": "text",
            "block_content": "The Company agrees to inform all accepted applicants for employment as communication equipment workers that (a) the Communications Workers of America represents the Employees doing the work to which they are to be assigned, (b) wages and working conditions are a matter of agreement between the Union and the Company, and (c) a copy of the contract is available on the job or can be obtained from the Job Steward or Representative.",
            "block_bbox": [
