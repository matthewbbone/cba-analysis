        },
        {
            "block_label": "text",
            "block_content": "During the course of bargaining over the Management Performing Bargaining Unit Work Dispute Resolution Procedure memorandum of agreement, the Unions inquired what is intended by the phrase \"every reasonable effort\" in paragraph 2(b)(iii). Per our discussion:",
            "block_bbox": [
                319,
                303,
                877,
                377
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    319.0,
                    303.0
                ],
                [
                    877.0,
                    303.0
                ],
                [
                    877.0,
                    377.0
                ],
                [
                    319.0,
                    377.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "\"It is the Company's intention that when management assigns new work to an employee in paragraph 2(a)(1) of the MOA, or when Workforce Relations becomes aware of the institution of a new work process, Workforce Relations shall have an affirmative obligation to notify the National Union in accordance with the MOA.\"",
            "block_bbox": [
                388,
                390,
                877,
                480
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    388.0,
                    390.0
                ],
                [
                    877.0,
                    390.0
                ],
                [
                    877.0,
                    480.0
                ],
                [
                    388.0,
                    480.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event that a business unit of the Company fails to make every reasonable effort to ensure that the National Union is so notified, the Company shall take immediate and effective action to ensure that such business unit complies with the terms of this agreement.",
            "block_bbox": [
                389,
                494,
                876,
                566
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    389.0,
                    494.0
                ],
                [
                    876.0,
                    494.0
                ],
                [
                    876.0,
                    566.0
                ],
                [
                    389.0,
                    566.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Sincerely,",
            "block_bbox": [
