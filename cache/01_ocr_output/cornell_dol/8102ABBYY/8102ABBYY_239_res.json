        {
            "block_label": "text",
            "block_content": "This will confirm our understanding of March 1, 2003 regarding an on-call pager allowance provision for Employees who are assigned to the On-Site Technical Service (OTS) Organization and who perform maintenance operations.",
            "block_bbox": [
                349,
                207,
                904,
                262
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    349.0,
                    207.0
                ],
                [
                    904.0,
                    207.0
                ],
                [
                    904.0,
                    262.0
                ],
                [
                    349.0,
                    262.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Company may, based on its business needs, assign certain Employee(s) as described herein, to carry a communication device (e.g. pager, cell phone, etc.) as a method to contact an Employee(s) for \"on-call\" assignment situations.",
            "block_bbox": [
                383,
                282,
                904,
                354
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    383.0,
                    282.0
                ],
                [
                    904.0,
                    282.0
                ],
                [
                    904.0,
                    354.0
                ],
                [
                    383.0,
                    354.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Employees with the necessary skills will be solicited on a voluntary basis. However, if there is an insufficient number of volunteers, the company will select Employee(s) for the on-call assignment. Employees cannot be assigned on-call assignment if on vacation, floating holiday or Employee designated EWD days unless the Employee volunteers to do so.",
            "block_bbox": [
                383,
                370,
                905,
                476
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    383.0,
                    370.0
                ],
                [
                    905.0,
                    370.0
                ],
                [
                    905.0,
                    476.0
