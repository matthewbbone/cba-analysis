                [
                    383.0,
                    476.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An Employee selected for an on-call assignment will be paid an allowance for each scheduled daily off tour (i.e. end of a shift to beginning of next shift) during the scheduled weekly tour or Saturday, Sunday or Holidays as follows:",
            "block_bbox": [
                383,
                492,
                905,
                564
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
