                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Associate Communications Services Technician</td><td>$19.00</td></tr><tr><td>Communications Services Technician</td><td>$22.00</td></tr><tr><td>Senior Communication Services Technician</td><td>$26.00</td></tr></table>",
            "block_bbox": [
