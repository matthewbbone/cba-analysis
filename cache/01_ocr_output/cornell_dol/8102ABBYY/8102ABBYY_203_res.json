            "block_label": "paragraph_title",
            "block_content": "DUES DEDUCTIONS WHILE ON INTERNATIONAL ASSIGNMENT\nMEMORANDUM OF UNDERSTANDING",
            "block_bbox": [
                397,
                142,
                865,
                179
