        },
        {
            "block_label": "text",
            "block_content": "(b) An employee hired in the ACST title and granted wage progression step credit for education or work experience shown above shall not be eligible for reassignment to a higher title for a period of 12 months from date of employment in the Installation Bargaining Unit.",
            "block_bbox": [
                344,
                645,
