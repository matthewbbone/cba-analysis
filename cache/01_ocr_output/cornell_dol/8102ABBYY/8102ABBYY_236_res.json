                    345.0,
                    349.0
                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Condition</td><td>ACST Progression Step. Credit Range</td></tr><tr><td>Labor Market Conditions</td><td>Step 2 - Step 7</td></tr><tr><td>Recognized Educational Achievement (Degree or non-degree education or training involving electrical, electronics, telecommunications, radio/TV repair or computer disciplines) and/or (4 year degree in electrical engineering or any business degree)</td><td>Step 7 - Step 11</td></tr><tr><td>Recognized Work Experience and/or Skill Achievement</td><td>Step 7 - Step 15</td></tr></table>",
            "block_bbox": [
                335,
                368,
                833,
                620
            ],
            "block_id": 4,
            "block_order": null,
            "group_id": 4,
            "block_polygon_points": [
