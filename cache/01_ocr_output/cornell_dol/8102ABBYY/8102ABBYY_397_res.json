                    170.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company and the Unions agree that an organizing drive should be and will be met by Company conduct that neither helps nor hinders organizing efforts. This statement is consistent with and reinforces the previously established principle of employee choice. The environment is intended to foster employee choice and information communicated by either party should be fact based and not misleading, distorted or disparaging. Neutrality means the following:",
            "block_bbox": [
                386,
                176,
                910,
                300
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    386.0,
                    176.0
                ],
                [
                    910.0,
                    176.0
                ],
                [
                    910.0,
                    300.0
                ],
                [
                    386.0,
                    300.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) Management will not be anti-Union nor will the Union be anti-management.",
            "block_bbox": [
                386,
                305,
                908,
                342
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    386.0,
                    305.0
                ],
                [
                    908.0,
                    305.0
                ],
                [
                    908.0,
                    342.0
                ],
                [
                    386.0,
                    342.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Management will not advocate that employees should vote against Union representation.",
            "block_bbox": [
                386,
                355,
                908,
                392
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    386.0,
                    355.0
                ],
                [
                    908.0,
                    355.0
                ],
                [
                    908.0,
                    392.0
                ],
                [
                    386.0,
                    392.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) The Union(s) will be afforded reasonable opportunities for access to communicate with employees.",
            "block_bbox": [
                386,
                405,
                907,
                442
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    386.0,
                    405.0
                ],
                [
                    907.0,
                    405.0
                ],
                [
                    907.0,
                    442.0
                ],
                [
                    386.0,
                    442.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(d) Management may respond to individual employee questions, and may correct inaccurate or misunderstood information by employees.",
            "block_bbox": [
                386,
                455,
                907,
                492
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    386.0,
                    455.0
                ],
                [
                    907.0,
                    455.0
                ],
                [
                    907.0,
                    492.0
                ],
                [
                    386.0,
                    492.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(e) The Union(s) will be referred to by name and will not be characterized as a \"third party\" or \"outsider\".",
            "block_bbox": [
                386,
                504,
                907,
                542
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    386.0,
                    504.0
                ],
                [
                    907.0,
                    504.0
                ],
                [
                    907.0,
                    542.0
                ],
                [
                    386.0,
                    542.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(f) Any written information distributed to employees by either party relative to the organizing campaign will be simultaneously shared with the other. The parties' communications with employees will be in accordance with this agreement.",
            "block_bbox": [
                386,
                554,
                907,
                627
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    386.0,
                    554.0
                ],
                [
                    907.0,
                    554.0
                ],
                [
                    907.0,
                    627.0
                ],
                [
                    386.0,
                    627.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(g) Neither party will hire or seek the assistance of consultants who encourage an adversarial relationship.",
            "block_bbox": [
                385,
                639,
                907,
                677
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    385.0,
                    639.0
                ],
                [
                    907.0,
                    639.0
                ],
                [
                    907.0,
                    677.0
                ],
                [
                    385.0,
                    677.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(h) Neither managers nor Union representatives will be personally attacked, by name or by descriptive reference, in campaign literature or discussions.",
            "block_bbox": [
                385,
                689,
                907,
                743
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    385.0,
                    689.0
                ],
                [
                    907.0,
                    689.0
                ],
                [
                    907.0,
                    743.0
                ],
                [
                    385.0,
                    743.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) Neither the Union nor the Company will be attacked as institutions.",
            "block_bbox": [
                385,
                756,
                875,
                777
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
                [
                    385.0,
                    756.0
                ],
                [
                    875.0,
                    756.0
                ],
                [
                    875.0,
                    777.0
                ],
                [
                    385.0,
                    777.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(j) The Company will not conduct \"captive\" audience meetings.",
            "block_bbox": [
                385,
                788,
                830,
                810
            ],
            "block_id": 12,
            "block_order": 12,
            "group_id": 12,
            "block_polygon_points": [
                [
                    385.0,
