        {
            "block_label": "paragraph_title",
            "block_content": "2 Neutrality",
            "block_bbox": [
                353,
                151,
                465,
                171
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
                [
                    353.0,
                    151.0
                ],
                [
                    464.0,
                    151.0
                ],
                [
                    464.0,
                    170.0
                ],
                [
