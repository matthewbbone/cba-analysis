        {
            "block_label": "text",
            "block_content": "This will confirm our understanding to move Job Match Center (JMC) administrative work from Convergys to the ERC/LTP coordinators.",
            "block_bbox": [
                350,
                300,
                907,
                339
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
