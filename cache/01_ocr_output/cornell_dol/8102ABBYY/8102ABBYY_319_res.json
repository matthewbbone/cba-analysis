                    349.0,
                    545.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Detailed planning for the transition of work will begin immediately upon ratification of the 2004 collective bargaining agreements. The effective date for the transfer of work will be 90 days after the signing of the MOU.",
            "block_bbox": [
                349,
                560,
                906,
                616
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
