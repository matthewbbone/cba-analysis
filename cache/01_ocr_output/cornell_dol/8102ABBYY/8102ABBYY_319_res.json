                [
                    350.0,
                    442.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Concurrent with the transfer of the Job Match Center administrative work, the Job Match Center Review Board will be merged into the LTP Review Board.",
            "block_bbox": [
                349,
                456,
                906,
                494
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
