                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The job responsibilities to be transitioned and related information are described in Attachment A.",
            "block_bbox": [
                349,
                508,
                907,
                545
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
