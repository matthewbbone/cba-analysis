                    350.0,
                    339.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties agree to establish a sub-committee to oversee the planning and transitional issues related to the movement of certain Job Match Center administrative work from Convergys to the ERC/LTP coordinators. The sub-committee shall include a representative from Lucent Technologies, the CWA ERC/LTP Coordinator and the IBEW ERC/LTP Coordinator.",
            "block_bbox": [
                350,
                353,
                908,
                442
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    350.0,
                    353.0
