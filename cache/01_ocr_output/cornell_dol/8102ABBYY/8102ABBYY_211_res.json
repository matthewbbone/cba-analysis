        {
            "block_label": "paragraph_title",
            "block_content": "Home Owner's Mortgage Allowance Plan",
            "block_bbox": [
                351,
                244,
                655,
                264
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
