            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The parties shall notify the umpire in writing on the day of agreement or date of arbitration demands in suspension cases to settle a grievance by expedited arbitration. The umpire shall notify the parties in writing of the hearing date.",
            "block_bbox": [
                377,
                477,
                877,
                549
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
