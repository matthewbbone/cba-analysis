                    377.0,
                    549.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) The parties may submit to the umpire prior to the hearing a written stipulation of all facts not in dispute.",
            "block_bbox": [
                376,
                553,
                875,
                590
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
