        },
        {
            "block_label": "text",
            "block_content": "(c) The procedure for expedited arbitration shall be as follows:",
            "block_bbox": [
                344,
                452,
                778,
                473
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
