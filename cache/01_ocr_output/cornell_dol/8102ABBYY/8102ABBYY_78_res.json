        },
        {
            "block_label": "text",
            "block_content": "(c) The approved Job Title of each Employee will be reviewed for reassignment to a higher approved Job Title prior to the first Monday of fiscal March in each year during the term of this agreement. Any reassignment of an Employee to a higher approved Job Title as a result of such review will be effective at the beginning of the first fiscal week in March during the year of reassignment. All assignments and reassignments of approved Job Titles shall be made solely at the discretion of the Company.",
            "block_bbox": [
                343,
                496,
                877,
                637
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
