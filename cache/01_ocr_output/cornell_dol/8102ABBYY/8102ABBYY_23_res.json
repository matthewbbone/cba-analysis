            "block_label": "text",
            "block_content": "7 Leaves of Absence for Union Business at Union Request",
            "block_bbox": [
                350,
                120,
                767,
                140
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
