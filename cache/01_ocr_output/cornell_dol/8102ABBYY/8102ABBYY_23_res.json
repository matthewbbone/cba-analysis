                    369.0,
                    415.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The terms of a Leave of Absence covering such absences and other conditions relating thereto shall be as prescribed in Paragraph 8 below.",
            "block_bbox": [
                406,
                419,
                907,
                474
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    406.0,
