                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This will confirm our discussions and agreement reached in 2004 Bargaining, that the 2 (two) Managed Care Program Coordinator positions will continue during the term of this agreement. The CWA and the IBEW will each select one person to fill the Managed Care Program Coordinator position. In addition the ERC/LTP Coordinator positions will also continue for the term of this agreement with the number of ERC/LTP Coordinators to be determined by the parties.",
            "block_bbox": [
                320,
                346,
                875,
                452
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    320.0,
                    346.0
                ],
                [
                    875.0,
                    346.0
                ],
                [
                    875.0,
                    452.0
                ],
                [
                    320.0,
                    452.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When a Coordinator vacates a position, the parties may agree to a period of overlap between such Coordinator and his/her replacement, if necessary to ensure continuity and the appropriate transfer of knowledge.",
            "block_bbox": [
                320,
                471,
                876,
                527
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    320.0,
                    471.0
                ],
                [
                    876.0,
                    471.0
                ],
                [
                    876.0,
                    527.0
                ],
                [
                    320.0,
                    527.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties agree the job duties and responsibilities for the ERC/LTP Coordinator and the Managed Care Program Coordinator should be reviewed to assure they reflect the current environment. A joint committee of not more than two (2) union appointees (one each from the CWA and IBEW, respectively) and not more than two (2) from the Company shall complete the review no later than April 1, 2005.",
            "block_bbox": [
                319,
                546,
                875,
                636
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    319.0,
                    546.0
                ],
                [
                    875.0,
                    546.0
                ],
                [
                    875.0,
                    636.0
                ],
                [
                    319.0,
                    636.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The pay associated with these titles will be an annual rate of $62,504 ($30.05 per hour) and a pension band of 125 for any and all such individuals. Other terms and conditions associated with these positions are as follows:",
            "block_bbox": [
                319,
                654,
                875,
                709
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    319.0,
                    654.0
                ],
                [
                    875.0,
                    654.0
                ],
                [
                    875.0,
                    709.0
                ],
                [
                    319.0,
                    709.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• eligibility for these titles is limited to Lucent Technologies regular full-time employees.",
            "block_bbox": [
                318,
                730,
                873,
                764
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    318.0,
                    730.0
                ],
                [
                    873.0,
                    730.0
                ],
                [
                    873.0,
                    764.0
                ],
                [
                    318.0,
                    764.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "- the Unions will recommend the employees to be assigned to these positions, and these titles will not be staffed using the Lucent Transfer Program or the article(s) of any applicable collective bargaining agreement.",
            "block_bbox": [
                319,
                766,
                874,
                815
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
