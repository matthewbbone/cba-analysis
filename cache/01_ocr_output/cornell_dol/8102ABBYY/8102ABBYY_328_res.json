        {
            "block_label": "paragraph_title",
            "block_content": "Re: Managed Care Program Coordinators and ERC/LTP Coordinators",
            "block_bbox": [
                320,
                306,
                865,
                326
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
