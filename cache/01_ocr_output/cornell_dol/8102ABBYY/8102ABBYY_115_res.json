                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The Realty Corporation's offer must be accepted within ninety (90) days following the date of the appraisal letter and such offer shall be final.",
            "block_bbox": [
                503,
                289,
                908,
                345
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
