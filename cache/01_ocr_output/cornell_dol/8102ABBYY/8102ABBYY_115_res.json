        {
            "block_label": "text",
            "block_content": "(A) An Employee may make an irrevocable election to sell his or her principal residence to the Realty Company designated by the Company at the Realty Company's appraised value based on the following requirements:",
            "block_bbox": [
                471,
                213,
                909,
                286
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
