            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) The house must not have been given to another Realty Company with an exclusive listing.",
            "block_bbox": [
                502,
                349,
                907,
                388
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
