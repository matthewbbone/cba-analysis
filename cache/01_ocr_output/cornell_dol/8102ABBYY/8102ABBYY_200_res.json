                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5 Tolls and parking fees in connection with such assignments will be reimbursed as reasonably incurred.",
            "block_bbox": [
                320,
                675,
                874,
                711
            ],
            "block_id": 7,
