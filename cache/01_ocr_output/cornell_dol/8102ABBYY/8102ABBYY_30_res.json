            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2 Non-Discrimination",
            "block_bbox": [
                320,
                327,
                480,
                346
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
