        {
            "block_label": "text",
            "block_content": "The Union recognizes the right of the Company (subject to the limitations contained in the provisions of this contract, but otherwise not subject to the provisions of the arbitration clause) to exercise the functions of managing the business which involve, among other things, the hiring and placement of Employees, the termination of employment, the assignment of work, the determination of methods and equipment to be used, and the control of the conduct of the work.",
            "block_bbox": [
                341,
                199,
                876,
                321
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
