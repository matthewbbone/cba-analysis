        {
            "block_label": "text",
            "block_content": "The parties agree to the following in respect to the Lucent Transfer Program (LTP) during the life of the 1998 Agreement.",
            "block_bbox": [
                319,
                225,
                875,
                264
            ],
            "block_id": 4,
