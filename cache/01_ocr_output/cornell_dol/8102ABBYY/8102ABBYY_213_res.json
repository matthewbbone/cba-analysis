                ],
                [
                    906.0,
                    422.0
                ],
                [
                    374.0,
                    422.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "II Staffing",
            "block_bbox": [
                350,
                444,
                435,
                463
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    350.0,
                    444.0
                ],
