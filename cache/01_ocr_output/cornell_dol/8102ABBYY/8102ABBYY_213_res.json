                [
                    350.0,
                    462.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The filling of any maintenance service assignment at an MPOP designated by the Company will be according to the following process:",
            "block_bbox": [
                364,
                465,
                906,
                503
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    364.0,
                    465.0
                ],
                [
                    906.0,
                    465.0
                ],
                [
                    906.0,
                    503.0
                ],
                [
                    364.0,
                    503.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The establishment of an MPOP, as well as the determination and evaluation of the job skills, knowledge, training, and experience required for the maintenance service work functions to be performed at the MPOP, will be made solely by the Company. The Union will be given notification of the establishment of an MPOP prior to its effective date.",
            "block_bbox": [
                349,
                511,
                906,
                601
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    349.0,
                    511.0
                ],
                [
                    906.0,
                    511.0
                ],
                [
                    906.0,
                    601.0
                ],
                [
                    349.0,
                    601.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2 An MPOP assignment will be circulated and/or posted at the work locations within the geographic territory of the Company's Customer Team having the MPOP opening. The job information will include the job skills, knowledge, training, and experience requirements for the opening, including the minimum skills which would be considered in the event that no employee can meet all of the requirements for the position(s). The Local Union will be given copies of the MPOP job assignment and requirements.",
            "block_bbox": [
                348,
                612,
                907,
                738
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
