                [
                    320.0,
                    378.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Due to the complexities of offering this type of service as part of the LTSSP and given the limited amount of time available to the parties during bargaining, we agree to meet as soon as is practicable following the signing of the agreement to consider the feasibility of offering such services in light of the applicable fiduciary requirements, the administrative burdens to Lucent and the plan, and the fees that would be payable by LTSSP participants.",
            "block_bbox": [
