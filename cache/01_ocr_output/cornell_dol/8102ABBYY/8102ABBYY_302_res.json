        {
            "block_label": "text",
            "block_content": "During bargaining, the IBEW and CWA expressed an interest in obtaining certain personal financial and investment counseling, including active money management, for LTSSP participants, distinct from the web-based and personal asset manager services proposed by Lucent.",
            "block_bbox": [
                320,
                305,
                877,
                378
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
