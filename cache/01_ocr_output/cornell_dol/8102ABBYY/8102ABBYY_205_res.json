        {
            "block_label": "text",
            "block_content": "This memorandum sets forth the procedure to be followed in connection with the deduction of Union dues for Installers on International assignments. The definitions contained in the installation contract shall apply to the terms used in this memorandum.",
            "block_bbox": [
                351,
