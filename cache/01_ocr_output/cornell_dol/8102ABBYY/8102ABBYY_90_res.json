        },
        {
            "block_label": "text",
            "block_content": "when the Local Assignment extends across a weekend(s), the Company provided lodging will be terminated on Friday unless (a) the Employee is scheduled to work on the weekend or, (b) the supervisor approves a request from the Employee that he/she be allowed to stay at the location over the weekend, and,",
            "block_bbox": [
                403,
