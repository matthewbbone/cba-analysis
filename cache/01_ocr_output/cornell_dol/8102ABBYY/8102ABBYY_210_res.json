        },
        {
            "block_label": "text",
            "block_content": "This will confirm our understanding of May 31, 1998 regarding a hiring bonus to attract applicants for certain installation job openings.",
            "block_bbox": [
                320,
                404,
                876,
                442
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    320.0,
                    404.0
                ],
