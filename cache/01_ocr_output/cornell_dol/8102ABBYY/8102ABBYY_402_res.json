        {
            "block_label": "paragraph_title",
            "block_content": "9 Acquisitions And Ventures",
            "block_bbox": [
                320,
                707,
                554,
                726
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
