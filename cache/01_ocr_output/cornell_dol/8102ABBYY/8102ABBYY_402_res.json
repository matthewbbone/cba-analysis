                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Lucent and the Union(s) agree that the parties may distribute a decision of the TPN to employees in the selected unit but not outside to the public such as the press.",
            "block_bbox": [
                387,
                479,
                875,
                534
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    387.0,
