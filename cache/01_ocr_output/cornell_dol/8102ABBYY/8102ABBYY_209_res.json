        {
            "block_label": "text",
            "block_content": "- The Daily Transportation Expense Allowance of Article 13, Paragraph 3(a) shall not apply. However, the Daily Miscellaneous Allowance of up to 5 road miles shall be applicable to employees in the Bargaining Unit.",
            "block_bbox": [
                350,
