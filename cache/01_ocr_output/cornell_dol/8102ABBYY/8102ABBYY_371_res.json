                [
                    434.0,
                    338.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) addressing concerns raised as to the staffing of positions through the LTP.",
            "block_bbox": [
                431,
                352,
                907,
                389
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    431.0,
