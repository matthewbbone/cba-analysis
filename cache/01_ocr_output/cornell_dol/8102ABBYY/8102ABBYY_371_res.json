                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) The Board shall meet on a regular basis, but not less than once each quarter.",
            "block_bbox": [
                386,
                401,
                908,
                439
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
