                    910.0,
                    184.0
                ],
                [
                    910.0,
                    274.0
                ],
                [
                    386.0,
                    274.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) monitoring the ongoing operation of the LTP.",
            "block_bbox": [
                433,
                286,
                795,
                307
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
