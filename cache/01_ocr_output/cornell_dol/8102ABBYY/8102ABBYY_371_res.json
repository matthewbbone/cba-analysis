                    306.0
                ],
                [
                    433.0,
                    306.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) analyzing overall LTP results, and",
            "block_bbox": [
                434,
                319,
                719,
                339
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
