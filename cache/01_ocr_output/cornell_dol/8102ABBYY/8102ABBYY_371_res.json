        {
            "block_label": "text",
            "block_content": "(a) The Company and the Unions will establish a Joint LTP Oversight and Review Board. This Board will be comprised of two (2) CWA representatives, two (2) IBEW representatives and two (2) representatives from the Company. The responsibilities of the Board will include:",
            "block_bbox": [
                386,
                184,
                910,
                274
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
