        {
            "block_label": "text",
            "block_content": "- Coordinators will be covered by the collective bargaining agreement which applies to the position from which the employee was temporarily assigned except they will not be entitled to: differentials, allowances, reimbursement provisions or participation in LTP. In addition, they will not be authorized to work overtime or holidays without the prior written agreement of a Workforce Relations Director or his/her designee.",
            "block_bbox": [
                352,
                257,
                910,
                360
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
