            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) sells his or her home at the originating location within nine (9) months of the effective date of the transfer and provides the Company with appropriate documentation to substantiate the sale of the home no later than 45 days after such sale; and",
            "block_bbox": [
                376,
                477,
                875,
                547
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
