        },
        {
            "block_label": "text",
            "block_content": "Both parties agree that employees should be fully informed about all aspects of Union representation. The Union will provide fact-based information to employees as it endeavors to convince prospective members of the merits of being represented by a labor union. Management's role during this process will include:",
            "block_bbox": [
                381,
                206,
                903,
                295
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    381.0,
                    206.0
                ],
                [
                    903.0,
                    206.0
                ],
                [
                    903.0,
                    295.0
                ],
                [
                    381.0,
                    295.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) responding to individual employee inquiries",
            "block_bbox": [
                382,
                300,
                716,
                321
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    382.0,
                    300.0
                ],
                [
                    715.0,
                    300.0
                ],
                [
                    715.0,
                    320.0
                ],
                [
                    382.0,
                    320.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) explaining the organizing process, including any obligations and responsibilities of the parties",
            "block_bbox": [
                382,
                332,
                902,
                371
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    382.0,
                    332.0
                ],
                [
                    902.0,
                    332.0
                ],
                [
                    902.0,
                    371.0
                ],
                [
                    382.0,
                    371.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) correcting any inaccuracies or misstatements or any employee misunderstandings of information disseminated during the campaign process.",
            "block_bbox": [
                380,
                382,
                902,
                437
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
