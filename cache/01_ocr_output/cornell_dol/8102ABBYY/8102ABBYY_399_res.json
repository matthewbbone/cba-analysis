            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "6 Free from Coercion",
            "block_bbox": [
                348,
                465,
                530,
                484
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    348.0,
