        {
            "block_label": "paragraph_title",
            "block_content": "JOINT HEALTH CARE COMMITTEE",
            "block_bbox": [
                501,
                213,
                759,
                233
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
