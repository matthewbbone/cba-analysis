            ]
        },
        {
            "block_label": "text",
            "block_content": "The JHCC is responsible for assuring successful implementation and continued operation of a quality health care program for current bargaining unit members.",
            "block_bbox": [
                348,
                671,
                905,
                710
            ],
            "block_id": 9,
