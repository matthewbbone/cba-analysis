                    232.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company and CWA and IBEW agree to continue their efforts to improve access to quality health care for bargaining unit members and to manage the cost of Lucent's medical benefits through the maintenance of cost effective health care programs. The Joint Health Care Committee (JHCC), formerly known as the Joint Health Care Cost Containment Committee (JHCCCC), will be continued, and will be responsible for overseeing the implementation, expansion and on-going monitoring of the Managed Care Programs (Point of Service), Mental and Health Chemical Dependency Networks and Prescription Drug Networks) of the Medical Expense Plan for Occupational Employees with respect to members of the bargaining units covered by the 1998 National Memorandum.",
            "block_bbox": [
                349,
                255,
                908,
                432
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    349.0,
                    255.0
                ],
                [
                    908.0,
                    255.0
                ],
                [
                    908.0,
                    432.0
                ],
                [
                    349.0,
                    432.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A major focus of the JHCC will be to develop communication strategies designed to promote a greater awareness among employees of being value conscious health care consumers.",
            "block_bbox": [
                348,
                451,
                906,
                506
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
