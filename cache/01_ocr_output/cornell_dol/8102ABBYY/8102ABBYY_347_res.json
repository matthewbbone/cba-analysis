        },
        {
            "block_label": "paragraph_title",
            "block_content": "JHCC Responsibilities",
            "block_bbox": [
                349,
                654,
                520,
                671
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
