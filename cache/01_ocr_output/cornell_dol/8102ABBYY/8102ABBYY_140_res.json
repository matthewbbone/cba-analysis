        {
            "block_label": "text",
            "block_content": "(a) The Employee shall have the option of receiving the Layoff Allowance (1) in periodic installments, less applicable deductions, or (2) in a lump sum, less applicable deductions.",
            "block_bbox": [
                344,
                289,
                874,
