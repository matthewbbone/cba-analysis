                ],
                [
                    909.0,
                    681.0
                ],
                [
                    909.0,
                    755.0
                ],
                [
                    349.0,
                    755.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Following completion of a transfer of excess pension assets, the accrued pension benefits of any participant (including participants who terminated employment during the one-year period ending on the date of transfer) under the Plan shall become nonforfeitable (i.e., 100 percent vested).",
            "block_bbox": [
                349,
