                    319.0,
                    360.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Lucent will make funds available each month for the Alliance on the basis of one-twelfth (1/12) of the annual funding level. Lucent shall credit these funds to an account designated for the Alliance and its activities within 15 days of the end of the month.",
            "block_bbox": [
                319,
                372,
                876,
                444
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
