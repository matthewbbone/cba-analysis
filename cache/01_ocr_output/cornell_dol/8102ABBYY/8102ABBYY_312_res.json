        {
            "block_label": "text",
            "block_content": "Lucent Technologies and the Communications Workers of America (CWA) agree to continue to provide the services of the Alliance for Employee Growth and Development (The Alliance) as described in Attachment A.",
            "block_bbox": [
                319,
                185,
                875,
