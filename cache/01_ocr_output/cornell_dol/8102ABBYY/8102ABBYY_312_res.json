            ]
        },
        {
            "block_label": "text",
            "block_content": "Alliance funding will be established at $550 per each active CWA represented employee per year. For the period November 1, 2004 to December 31, 2005, the annual funding will be based upon the number of such persons on the roll as of October 31, 2004. For 2006 and all subsequent years, during the term of this Memorandum of Understanding, the annual funding will be based upon the number of such persons on the roll as of May 31st of previous year.",
            "block_bbox": [
                319,
                252,
                876,
                360
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
