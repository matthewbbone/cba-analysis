                [
                    399.0,
                    268.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "(e) Negotiations on Scheduled Tours",
            "block_bbox": [
                375,
                272,
                641,
                293
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    375.0,
                    272.0
                ],
                [
