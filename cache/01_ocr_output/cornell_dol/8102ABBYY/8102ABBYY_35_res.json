                [
                    640.0,
                    292.0
                ],
                [
                    375.0,
                    292.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) The matter shall first be discussed by the Job Steward and the Supervisor or the Representative and the Operations Area Manager. Where a mutually satisfactory schedule is not readily established by such discussion, the matter shall be referred to the Local President and the Operations Director for negotiation.",
            "block_bbox": [
                407,
                296,
                908,
                387
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    407.0,
                    296.0
                ],
                [
                    908.0,
                    296.0
                ],
                [
                    908.0,
                    387.0
                ],
                [
                    407.0,
                    387.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) The schedule established by the Company shall remain in effect during such negotiations.",
            "block_bbox": [
                406,
                391,
                908,
                429
            ],
            "block_id": 5,
            "block_order": 5,
