        },
        {
            "block_label": "text",
            "block_content": "A night tour shall be a period of work in which all or any part of the hours of the Employee's Scheduled Daily Tour falls between the hours of 6:00 P.M. and 6:00 A.M. The scheduled starting and stopping time, for the night tour shall be determined by the Company after consideration of such factors as job requirements and transportation facilities. Local negotiations shall take place as outlined in Paragraph 2(e)(1), when requested by the Union.",
            "block_bbox": [
                399,
                143,
                909,
                268
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
