        {
            "block_label": "paragraph_title",
            "block_content": "3 Split or Change in Tour",
            "block_bbox": [
                352,
                433,
                540,
                454
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
