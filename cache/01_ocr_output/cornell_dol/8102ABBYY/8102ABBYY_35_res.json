                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) An Employee whose tour has been changed (day tour to night tour or vice versa) or split (the Scheduled Daily Tour of eight (8) hours is not worked consecutively other than for usual meal period s) during the current Workweek, shall be paid an Expense Allowance of $4.00.",
            "block_bbox": [
                374,
                458,
                909,
                531
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    374.0,
                    458.0
                ],
                [
                    909.0,
                    458.0
                ],
                [
                    909.0,
                    531.0
                ],
                [
                    374.0,
                    531.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) When, as a result of a split or changed tour, an Employee would work less hours then he or she would have worked had there been no split or change in tour, such Employee shall be allowed to make up such deficiency for the Scheduled Tour. Scheduled overtime hours may be made up when job conditions permit.",
            "block_bbox": [
                372,
                536,
                909,
                626
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
