        {
            "block_label": "text",
            "block_content": "(a) Before an Employee is granted pay for absence under any of the provisions of this article, he or she shall submit satisfactory evidence to substantiate the reason for the absence.",
            "block_bbox": [
                375,
                201,
                909,
                255
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    375.0,
                    201.0
                ],
