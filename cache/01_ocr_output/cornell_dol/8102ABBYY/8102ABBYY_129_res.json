                [
                    909.0,
                    435.0
                ],
                [
                    375.0,
                    435.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Pay for such absence will be based on the Employee's Adjusted Rate plus night work bonus when applicable.",
            "block_bbox": [
