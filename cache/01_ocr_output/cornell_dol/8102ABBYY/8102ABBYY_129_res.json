                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) An Employee summoned for jury duty, or to serve as a witness (not as a plaintiff or defendant) in a court case will be paid for such absence, not to exceed eight (8) hours per day, within the Employee's Scheduled Weekly Tour. Such Employee will report for his or her regular duties while temporarily excused from such attendance at court.",
            "block_bbox": [
                375,
                345,
                909,
                435
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    375.0,
                    345.0
                ],
                [
                    909.0,
                    345.0
