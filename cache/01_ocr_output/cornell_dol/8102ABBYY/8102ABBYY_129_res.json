        },
        {
            "block_label": "paragraph_title",
            "block_content": "2 Jury Duty and Other Court Attendance",
            "block_bbox": [
                352,
                320,
                642,
                340
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
