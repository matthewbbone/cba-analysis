                [
                    909.0,
                    255.0
                ],
                [
                    375.0,
                    255.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) It is recognized that there will be no duplication of payment by the Company for the same period of absence, whether to be paid for under the provisions of any contract between the parties, or otherwise.",
            "block_bbox": [
                375,
                261,
                909,
