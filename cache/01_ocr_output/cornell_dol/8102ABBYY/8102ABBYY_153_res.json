                ],
                [
                    386.0,
                    160.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(1) First considered will be ACST, CST and SCST Installers under CWA-24 with recall rights per Article 20 in the Base Location where Communication Services Installers are to be hired. If they accept a job offer, their recall rights to their former job classification will not be affected nor will they be required to repay any termination allowance they received at the time of termination;",
            "block_bbox": [
                422,
                170,
                911,
                296
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
                    422.0,
                    170.0
                ],
                [
                    911.0,
                    170.0
                ],
                [
                    911.0,
                    296.0
                ],
                [
                    422.0,
                    296.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) Next considered will be former Laid Off Installers whose recall rights have expired and/or new hires, at the Company's discretion.",
            "block_bbox": [
                420,
                307,
                909,
                346
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
