        {
            "block_label": "text",
            "block_content": "(b) When there are job vacancies in a Base Location for Communication Services Installers, they will be staffed as follows:",
            "block_bbox": [
                386,
                122,
                910,
                160
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
