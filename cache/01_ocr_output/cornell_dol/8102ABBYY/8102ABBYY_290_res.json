        },
        {
            "block_label": "text",
            "block_content": "(A) Except as provided in subparagraph (B), an employer may not contribute after December 31, 1990, any amount to a health benefits account or welfare benefit fund (as defined in section 419(e)(1)) with respect to qualified current retiree health liabilities for which transferred assets are required to be used under subsection (c)(1)(A).",
            "block_bbox": [
                458,
                460,
                877,
                567
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
