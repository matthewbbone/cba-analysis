        {
            "block_label": "text",
            "block_content": "This Memorandum of Understanding will confirm our agreement regarding mileage payments in lieu of actual airplane fare for Periodic Trips Home.",
            "block_bbox": [
                351,
                180,
                908,
                220
            ],
            "block_id": 2,
