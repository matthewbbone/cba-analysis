                [
                    352.0,
                    276.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2 Employees eligible for a Periodic Trip Home in accordance with Article 13, Paragraph 4(e) will have the option of selecting the transportation expense allowance of $0.36 per mile in lieu of actual airplane fare at an amount obtained by the Company if the total round trip transportation expense allowance is less than or equal to the actual airplane fare.",
            "block_bbox": [
                351,
                299,
                908,
                390
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
