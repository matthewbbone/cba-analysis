                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company will have the sole responsibility for obtaining the actual airplane fare from the starting location to the destination location and return in accordance with Article 13, Paragraph 4(e)(5).",
            "block_bbox": [
                352,
