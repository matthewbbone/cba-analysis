        },
        {
            "block_label": "text",
            "block_content": "1 This agreement shall apply to Employees on Temporary Transfers of at least 250 road miles up to and including 400 road miles.",
            "block_bbox": [
                352,
                238,
                908,
                276
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
