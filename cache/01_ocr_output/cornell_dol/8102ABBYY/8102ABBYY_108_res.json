                    442.0,
                    354.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(B) The Employee shall comply with the vouchering and administrative procedures established by the Company.",
            "block_bbox": [
                440,
                358,
                877,
                396
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
