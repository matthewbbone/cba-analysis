        {
            "block_label": "text",
            "block_content": "4 Wage Treatment on Transfers between Work Locations with Different Wage Schedules",
            "block_bbox": [
                351,
                249,
                910,
                286
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
