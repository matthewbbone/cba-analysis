        {
            "block_label": "text",
            "block_content": "This will confirm our agreement regarding the eligibility of a child of a former employee to continue to receive previously awarded scholarship support under the Academic Awards Program.",
            "block_bbox": [
                320,
                402,
                876,
                457
            ],
            "block_id": 8,
