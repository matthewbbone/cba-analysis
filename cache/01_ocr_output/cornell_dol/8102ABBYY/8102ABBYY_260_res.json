                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Payment of the Signing Bonus is subject to the ratification of the 2004 collective bargaining agreement by December 17, 2004. Payment of the Signing Bonus shall be made no later than four (4) weeks following such date of ratification.",
            "block_bbox": [
                351,
