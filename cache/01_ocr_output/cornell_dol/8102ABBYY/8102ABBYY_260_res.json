        {
            "block_label": "text",
            "block_content": "Effective November 1, 2004, all eligible regular occupational employees will be granted a Signing Bonus of one thousand dollars ($1,000) in the form of a cash payment in accordance with the provisions specified herein.",
            "block_bbox": [
                323,
                190,
                871,
                245
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
