                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) Employees on the active roll on the date of notice to the Company that ratification of the collective bargaining agreement in accordance with the preamble to the National Memorandum of Understanding has taken place, shall be eligible to receive a Signing Bonus.",
            "block_bbox": [
                355,
                373,
                876,
                445
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
