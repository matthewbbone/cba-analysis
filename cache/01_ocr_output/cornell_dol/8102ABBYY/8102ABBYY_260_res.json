                ],
                [
                    355.0,
                    445.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) An eligible part-time employee shall receive a proportionate amount of the applicable full-time Signing Bonus based on the part-time employee's Equivalent Work Week as of November 1, 2004.",
            "block_bbox": [
                355,
                449,
                877,
                504
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
