        {
            "block_label": "text",
            "block_content": "(e) It is understood that every effort will be made to avoid the necessity for working Employees on the day on which an authorized holiday is observed. When an authorized holiday is observed on Saturday, night tours for that week shall commence on the previous Sunday night. When it is considered necessary to schedule regular operations on the day on which an authorized holiday is observed, the Union shall be notified at least seven (7) days in advance unless unknown or unforeseen conditions prevent the Company from giving such notice. The matter shall, upon request of the Union, be subject to negotiation as provided in Subparagraphs 1(c)(1) and 1(c)(2) of this article.",
            "block_bbox": [
                344,
                323,
                879,
                498
            ],
            "block_id": 5,
