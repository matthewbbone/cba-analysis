        {
            "block_label": "text",
            "block_content": "(8) A Surplus Employee or Surplus Rehire candidate who accepts a position that is outside his/her LPA is eligible for a lump sum relocation allowance provided the new reporting location exceeds thirty-five (35) road miles from the employee's old reporting location, and is further in road miles from the employee's current residence than the old reporting location.",
            "block_bbox": [
                356,
                140,
