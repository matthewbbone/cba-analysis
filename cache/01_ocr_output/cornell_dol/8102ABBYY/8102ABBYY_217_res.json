            "block_label": "paragraph_title",
            "block_content": "MODE OF OPERATIONS AGREEMENT MEMORANDUM OF UNDERSTANDING",
            "block_bbox": [
                491,
                121,
                774,
                157
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
