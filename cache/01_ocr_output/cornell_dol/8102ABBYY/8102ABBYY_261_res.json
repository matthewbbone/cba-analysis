            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) The Lucent Performance Plan for Occupational Employees (hereafter referred to as the \"Plan\") consists of two components:",
            "block_bbox": [
                386,
                386,
                907,
                424
            ],
            "block_id": 5,
