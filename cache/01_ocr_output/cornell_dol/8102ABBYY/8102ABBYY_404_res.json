                    878.0,
                    421.0
                ],
                [
                    878.0,
                    511.0
                ],
                [
                    320.0,
                    511.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Following this trial, the Union and the Company will meet to review the success of the trial and to consider possible future use of the mail ballot process.",
