        {
            "block_label": "text",
            "block_content": "This will confirm our agreement that during the life of this collective bargaining agreement, the Union may request and the Company will agree to trial a Mail Ballot process to replace the Consent Election process in the Neutrality and Consent Election agreement in the 1998 Memo. It is further agreed that this trial will occur in a smaller unit (i.e., 50 or fewer employees).",
            "block_bbox": [
                320,
                421,
                878,
                511
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    320.0,
                    421.0
                ],
