        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 22 - DISCIPLINARY SUSPENSION OR TERMINATION OF EMPLOYMENT",
            "block_bbox": [
                440,
                110,
                757,
                145
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
