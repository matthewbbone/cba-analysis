            ]
        },
        {
            "block_label": "text",
            "block_content": "(d) When an Employee's scheduled vacation week or fractional week includes a holiday recognized in accordance with Article 14, Holidays, and observed in accordance therewith on any day Monday through Friday in such week an extra day off with pay will be granted in lieu thereof, which ordinarily shall be taken continuously with other vacation due.",
            "block_bbox": [
