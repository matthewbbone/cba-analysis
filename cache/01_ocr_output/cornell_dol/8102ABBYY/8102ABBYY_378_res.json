        {
            "block_label": "text",
            "block_content": "The parties agree to the following in respect to the Lucent Career Transition Option Program (LCTOP) during the life of the 1998 National Memorandum.",
            "block_bbox": [
                320,
                238,
                875,
                276
            ],
            "block_id": 4,
