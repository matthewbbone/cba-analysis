        },
        {
            "block_label": "text",
            "block_content": "If the Company notifies the Union in writing of a surplus which will necessitate layoffs, the Company may, to the degree necessary to resolve the surplus, in order of seniority, offer employees in the surplus universe the opportunity to elect one (1) of the following options, provided they meet the conditions of the option selected.",
            "block_bbox": [
                320,
                386,
