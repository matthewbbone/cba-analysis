                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Effective October 2, 2005, the Daily Transportation Expense Allowance (DTEA) will increase to $0.375, or the IRS allowable, whichever is less, per mile beginning with road mile band 10 up to 11 through road mile band 64 up to 65. The DTEA will be increased one road mile band (i.e., 11 up to 12, 12 up to 13, etc.) for each cent in excess of $0.375, and any fraction of a cent will be rounded to the next highest cent.",
            "block_bbox": [
                385,
                241,
                908,
                350
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
