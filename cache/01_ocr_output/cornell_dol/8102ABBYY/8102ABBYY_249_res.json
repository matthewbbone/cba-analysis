        {
            "block_label": "text",
            "block_content": "This will confirm our understanding of November 1, 2004 regarding adjustment to the local assignment table contained in Article 13 Paragraph 3 (a).",
            "block_bbox": [
                349,
                189,
                907,
                228
            ],
            "block_id": 3,
            "block_order": 3,
