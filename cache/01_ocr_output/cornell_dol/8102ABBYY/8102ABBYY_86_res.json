        {
            "block_label": "text",
            "block_content": "(a) The Company and the Union agree that the character of installation work makes it necessary for an Employee to move to and from Job Locations and Work Locations. The Company will effect such a move by a Local Assignment, a Temporary Transfer or a Permanent Transfer.",
            "block_bbox": [
                343,
                197,
                875,
                268
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    343.0,
                    197.0
                ],
                [
                    875.0,
                    197.0
                ],
                [
                    875.0,
                    268.0
                ],
                [
                    343.0,
                    268.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) The Company shall designate a Base Location for each Employee. An Employee shall not be eligible to any per diem allowance at the location in which he or she was hired, until the Employee has been transferred to a Base Location on a Permanent Transfer.",
            "block_bbox": [
                344,
                273,
                876,
                344
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    344.0,
                    273.0
                ],
                [
                    876.0,
                    273.0
                ],
                [
                    876.0,
