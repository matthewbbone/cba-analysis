        {
            "block_label": "text",
            "block_content": "It was agreed that any employee who cannot take his or her vacation, paid Excused Work Days (excluding Company Designated Excused Work Day other than those not observed solely due to a transfer) or Floating Holidays in a calendar year, because of reasons beyond the employee's control, may schedule such paid days in the next calendar year, provided such days are taken by July 1 of that year.",
            "block_bbox": [
                319,
                210,
                875,
                316
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    319.0,
                    210.0
