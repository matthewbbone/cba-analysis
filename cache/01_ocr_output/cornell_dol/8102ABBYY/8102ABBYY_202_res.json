        {
            "block_label": "text",
            "block_content": "A lump sum settlement which is agreed to by both the Company and the Union at the National Level, in settlement of a grievance or arbitration, shall have union dues or union dues equivalency deducted from any such settlement, provided:",
            "block_bbox": [
