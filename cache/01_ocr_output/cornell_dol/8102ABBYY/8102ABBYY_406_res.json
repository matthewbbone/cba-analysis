        {
            "block_label": "paragraph_title",
            "block_content": "UNION MANAGEMENT RELATIONS",
            "block_bbox": [
                471,
                207,
                730,
                226
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
                [
