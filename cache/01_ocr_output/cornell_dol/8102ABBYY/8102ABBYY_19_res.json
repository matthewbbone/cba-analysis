        },
        {
            "block_label": "text",
            "block_content": "(a) For the purposes of this article, the following definitions shall apply:",
            "block_bbox": [
                375,
                200,
                866,
                221
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    375.0,
