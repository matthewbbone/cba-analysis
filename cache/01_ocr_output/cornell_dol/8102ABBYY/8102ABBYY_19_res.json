        },
        {
            "block_label": "text",
            "block_content": "(c) The President of each Local or such specific Representatives as may be designated by the Local shall be recognized by the Company as the business agent representing the Employees under the jurisdiction of the respective Local.",
            "block_bbox": [
                374,
                651,
                908,
