        },
        {
            "block_label": "text",
            "block_content": "Dear Mr. Bahr,",
            "block_bbox": [
                352,
                286,
                460,
                306
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
            "block_polygon_points": [
                [
                    351.9999694824219,
                    285.9999694824219
                ],
                [
                    458.9999694824219,
                    285.9999694824219
                ],
                [
                    458.9999694824219,
                    304.9999694824219
                ],
                [
                    351.9999694824219,
                    304.9999694824219
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "I am writing to respond to the expressions of concern raised at the Operations bargaining table regarding the Company's contracting out of work, which have focused on situations in which a layoff is pending or has occurred (and ex-bargaining unit members retain recall rights) within the same force adjustment area where the work is to be contacted, and in job titles whose occupants would traditionally have performed such work.",
            "block_bbox": [
                351,
                322,
                910,
                429
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "block_polygon_points": [
                [
                    351.0,
                    322.0
                ],
                [
                    910.0,
                    322.0
                ],
                [
                    910.0,
                    429.0
                ],
                [
                    351.0,
                    429.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "I do not believe that CWA and AT&T have diverse views on this subject.",
            "block_bbox": [
                350,
                448,
                843,
                468
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
                    350.0,
                    448.0
                ],
                [
                    841.9998779296875,
                    448.0
                ],
                [
                    841.9998779296875,
                    467.0
                ],
                [
                    349.9999694824219,
                    467.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "As to such work normally performed by our employees, we have always preferred not to contract such work out if it would otherwise be performed by bargaining unit employees in job titles in a geographical commuting area (1) where layoffs of such employees are pending; or (2) where a layoff has already occurred and such laid off bargaining unit members retain recall rights and are available to perform such work.",
            "block_bbox": [
                351,
                488,
                910,
                596
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    351.0,
                    488.0
                ],
                [
                    910.0,
                    488.0
                ],
                [
                    910.0,
                    596.0
                ],
                [
                    351.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the future, the Company will not contract out such work, under the conditions outlined above, except when it has no other reasonable alternative. Under such circumstances, the Company will discuss its decision with the Union.",
            "block_bbox": [
                350,
                614,
                908,
                670
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    350.0,
                    614.0
                ],
                [
                    908.0,
                    614.0
                ],
                [
                    908.0,
                    670.0
                ],
                [
                    350.0,
                    670.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Very truly yours,",
            "block_bbox": [
                351,
                684,
                470,
                705
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
