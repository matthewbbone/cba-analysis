                [
                    351.0,
                    489.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Committee shall meet from time to time as required, but at least three (3) times per year. The purposes of the meetings shall be to:",
            "block_bbox": [
                351,
                492,
                908,
                530
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
