            "block_label": "paragraph_title",
            "block_content": "SAFETY ADVISORY COMMITTEE\nMEMORANDUM OF UNDERSTANDING",
            "block_bbox": [
                488,
                123,
                771,
                160
            ],
            "block_id": 1,
