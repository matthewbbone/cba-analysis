                    225.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) \"Hiring Location\" means the place of hiring of an Employee who was hired at other than a Base Location and who has not yet been transferred to his or her designated Base Location on a Permanent Transfer.",
            "block_bbox": [
                374,
                229,
                909,
                284
            ],
            "block_id": 4,
