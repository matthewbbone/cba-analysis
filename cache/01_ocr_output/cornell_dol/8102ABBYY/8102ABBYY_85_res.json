        },
        {
            "block_label": "text",
            "block_content": "(e) \"Computation Point\" means the fixed point in the Work Location designated by the Company for the purpose of computing travel time and transportation expense allowances on Local Assignments and Temporary Transfers.",
            "block_bbox": [
                376,
                391,
                908,
