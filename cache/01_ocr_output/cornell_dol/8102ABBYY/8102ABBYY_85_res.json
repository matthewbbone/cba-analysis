                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) \"Work Location\" means a Base Location (or Hiring Location, if applicable) or any other place to which an Employee was transferred on his or her latest Transfer.",
            "block_bbox": [
                375,
                289,
