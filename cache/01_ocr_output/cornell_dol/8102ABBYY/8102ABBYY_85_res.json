        {
            "block_label": "text",
            "block_content": "(a) \"Base Location\" means a city listed in Appendix 2 attached hereto and made a part hereof. Such cities are so designated because they are focal points for the performance of installation work.",
            "block_bbox": [
                374,
                170,
                908,
                225
            ],
            "block_id": 3,
            "block_order": 3,
            "group_id": 3,
