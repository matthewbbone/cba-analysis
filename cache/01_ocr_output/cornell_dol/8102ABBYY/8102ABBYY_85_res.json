        },
        {
            "block_label": "text",
            "block_content": "(f) \"Compensated Travel Time\" means travel time for which payment is made under the provisions of Paragraphs 3(b)(2), 4(a)(5)(ii), 4(b) (with reference to Paragraphs 4(a)(5)(ii) and 4(b)(1)), 4(b)(1), 5(a)(1) and 5(a)(2).",
            "block_bbox": [
