        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 5. Options in Lieu of Layoff.",
            "block_bbox": [
                105,
                713,
                468,
                738
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
