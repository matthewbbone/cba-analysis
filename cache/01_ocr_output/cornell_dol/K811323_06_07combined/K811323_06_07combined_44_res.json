    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "Agency in which the layoff is to be made have equal service credits, the order of layoff shall be in inverse order of the greatest length of continuous State service. If ties between employees still exist, the order of layoff shall be determined by the Appointing Authority in such a manner as to conserve for the State the services of the most qualified employees.",
            "block_bbox": [
                104,
                109,
                1118,
                210
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
