        {
            "block_label": "text",
            "block_content": "The Agency agrees to inform all new employees hired into positions included in the bargaining unit of the Union's exclusive recognition, and shall provide all present and future employees in the bargaining unit with a copy of its Agreement, provided the parties shall share equally in the costs of preparation and distribution of the Agreement. The Agency agrees to allow duly certified Union Representatives thirty (30) minutes, when new employee orientation classes are held, to speak to new employees about the Union's exclusive recognition, its benefits, and services available to the membership. This time will not be used for discussion of labor-management disputes.",
            "block_bbox": [
                103,
                264,
                1118,
                439
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    103.0,
                    264.0
                ],
                [
                    1118.0,
                    264.0
                ],
                [
                    1118.0,
                    439.0
