                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Accredited representatives of the Local, District Council 75, or International American Federation of State, County and Municipal Employees, AFL-CIO, upon proper introduction and notice, shall have reasonable access to the premises of the Agency during all working hours to conduct Union business (with appropriate observation of the security regulations of the Agency). During periods of bona fide emergency, this provision may be temporarily suspended by the Agency as required for the duration of the emergency.",
            "block_bbox": [
                104,
                541,
                1118,
