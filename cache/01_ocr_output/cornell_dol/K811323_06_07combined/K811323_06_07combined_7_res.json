                [
                    103.0,
                    439.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the Union Representative is an employee of the institution, the representative will be allowed time off without loss of pay to make the presentation.",
            "block_bbox": [
                105,
