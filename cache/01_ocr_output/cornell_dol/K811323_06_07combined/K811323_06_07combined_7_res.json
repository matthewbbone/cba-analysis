        {
            "block_label": "text",
            "block_content": "Unless otherwise provided in this Agreement, the internal business of the Union shall be conducted by the employees during non-duty time.",
            "block_bbox": [
                104,
                742,
                1117,
                792
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
