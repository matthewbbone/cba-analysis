        {
            "block_label": "paragraph_title",
            "block_content": "Section 4. Stewards.",
            "block_bbox": [
                105,
                867,
                322,
                892
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
