        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 2. Union Access.",
            "block_bbox": [
                105,
                515,
                365,
                539
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
