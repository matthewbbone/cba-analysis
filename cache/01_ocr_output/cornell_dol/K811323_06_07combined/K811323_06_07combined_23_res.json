        {
            "block_label": "paragraph_title",
            "block_content": "Section 9. Consequences of Search Results.",
            "block_bbox": [
                105,
                1217,
                556,
                1242
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
