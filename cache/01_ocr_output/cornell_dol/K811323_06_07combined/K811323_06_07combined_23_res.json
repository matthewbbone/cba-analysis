        },
        {
            "block_label": "text",
            "block_content": "d. If an employee who tests positive and has previously committed prohibited conduct specified in Sections 2b, 2c, 2e or 2f, and subsequently is found to have committed such prohibited conduct a second time within three (3) years, he or she shall be subject to discipline up to and including termination. The level of discipline imposed for subsequent instances of such prohibited conduct beyond three (3) years may be termination but shall be determined on a case-by-case basis.",
            "block_bbox": [
                104,
                287,
                1120,
                413
            ],
            "block_id": 2,
