            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Reasonable suspicion searches which do not reveal the presence of alcohol or controlled substances, including marijuana (but excluding any substance lawfully prescribed for the employee's use which has not been obtained for the purpose of abuse), shall result in no further action against the employee related to an alleged violation of Section 2d. The employee shall be informed of such search results in writing.",
            "block_bbox": [
                104,
                1244,
                1118,
                1368
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
