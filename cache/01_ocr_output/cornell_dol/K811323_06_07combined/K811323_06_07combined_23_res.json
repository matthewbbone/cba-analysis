        {
            "block_label": "text",
            "block_content": "c. The first instance of an alcohol test result of .02% to .039% shall not be considered a positive test result for alcohol for the purpose of requiring a medical evaluation by a doctor. An employee may use vacation and/or sick leave benefits for this time period. It will, however, require that the employee be removed from duty until their next scheduled shift. An alcohol test result of a .04% or greater will subject the employee to all provisions of this Agreement.",
            "block_bbox": [
                104,
                160,
                1119,
                285
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
