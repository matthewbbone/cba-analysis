        {
            "block_label": "text",
            "block_content": "1. Eligible employees under this Agreement are employees who are on step one (1) through seven (7) of the pay range of their classification and: a) have been continuously employed since January 1, 2004, or, b) are seasonal employees employed in calendar year 2003 and recalled pursuant to the Agreement for subsequent seasons. Employees shall receive steps on their salary eligibility date pursuant to Article 14 and one (1) additional step as follows:",
            "block_bbox": [
                104,
                318,
                1119,
                445
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    104.0,
                    318.0
                ],
                [
                    1119.0,
                    318.0
                ],
                [
                    1119.0,
                    445.0
                ],
                [
                    104.0,
                    445.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. An employee with a salary eligibility date (SED) between July 1, 2006 and January 31, 2007, shall receive an additional one (1) step increase effective February 1, 2007.\nb. An employee with a salary eligibility date (SED) between February 1, 2007 and June 30, 2007 shall receive an additional step increase effective on their SED.",
            "block_bbox": [
                105,
                468,
                1118,
                570
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
