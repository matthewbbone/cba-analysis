        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 4.",
            "block_bbox": [
                106,
                1070,
                213,
                1094
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
