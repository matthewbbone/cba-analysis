                    105.0,
                    920.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 3.",
            "block_bbox": [
                105,
                943,
                212,
                968
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
