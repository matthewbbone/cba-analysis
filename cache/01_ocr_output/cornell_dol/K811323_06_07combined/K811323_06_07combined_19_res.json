                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. If it is the Agency's determination that the leadwork duties were assigned, the leadwork differential will be effective the date the employee notified the supervisor.",
            "block_bbox": [
                173,
                1372,
