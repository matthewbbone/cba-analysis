        {
            "block_label": "paragraph_title",
            "block_content": "Section 1.",
            "block_bbox": [
                106,
                565,
                212,
                590
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
