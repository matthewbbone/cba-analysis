                ],
                [
                    103.0,
                    1271.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The employee shall notify their supervisor and appropriate Personnel Officer, in writing for a review.",
            "block_bbox": [
                172,
                1272,
                1116,
                1320
            ],
            "block_id": 16,
            "block_order": 17,
            "group_id": 16,
            "block_polygon_points": [
                [
