                    172.0,
                    1320.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The supervisor, on behalf of the Agency, will respond to the employee in writing, within fifteen (15) calendar days from the date of notification.",
            "block_bbox": [
                173,
                1322,
                1116,
                1370
            ],
            "block_id": 17,
            "block_order": 18,
            "group_id": 17,
