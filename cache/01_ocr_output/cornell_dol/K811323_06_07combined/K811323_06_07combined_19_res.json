        },
        {
            "block_label": "text",
            "block_content": "The employee who believes they are performing the duties of a leadworker as defined in Section 1, may request a review of the duties as follows:",
            "block_bbox": [
                103,
                1222,
                1116,
                1271
            ],
            "block_id": 15,
            "block_order": 16,
            "group_id": 15,
            "block_polygon_points": [
                [
                    103.0,
