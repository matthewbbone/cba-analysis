                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Leadwork differential shall not be computed at the rate of time and one-half (1-1/2) for the time worked in an overtime or holiday work situation, or to effect a \"pyramiding\" of work out-of-classification payment.",
            "block_bbox": [
                103,
                969,
                1118,
                1046
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
