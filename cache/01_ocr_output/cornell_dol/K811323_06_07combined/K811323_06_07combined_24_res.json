        {
            "block_label": "paragraph_title",
            "block_content": "Section 1. Work Week.",
            "block_bbox": [
                105,
                515,
                344,
                540
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    105.0,
                    515.0
                ],
                [
                    344.0,
