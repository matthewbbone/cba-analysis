                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 3. Meal Periods at Institutions.",
            "block_bbox": [
                105,
                1221,
                494,
                1246
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
