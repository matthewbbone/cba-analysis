        {
            "block_label": "text",
            "block_content": "The Agency recognizes that, in order to administer the standards and procedures set forth in this Agreement fairly and to minimize the possibility of unwarranted testing and searches, supervisory personnel shall receive training in how to recognize and deal effectively with substance abuse in the work place. Accordingly, the Agency will provide such training to supervisors and designated Union representatives before the requirements of this Agreement are implemented and enforced. Annual in-service training and an updating program will be developed and administered to supervisory personnel within the Agency.",
            "block_bbox": [
                104,
                134,
                1119,
                312
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
