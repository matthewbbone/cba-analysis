                ],
                [
                    104.00029754638672,
                    360.9999694824219
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When the dates requested for pre-retirement leave cannot be granted for the above reason, the Agency shall offer the employee a choice from three (3) other sets of dates. The leave herein discussed may be used to investigate and assemble the employee's retirement program, including PERS, Social Security, insurance and other retirement income.",
            "block_bbox": [
