                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "ARTICLE 36 - LEAVES WITH PAY",
            "block_bbox": [
                418,
                235,
                805,
                262
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
