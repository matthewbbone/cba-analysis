        {
            "block_label": "text",
            "block_content": "In recognition of the Agency’s past practice, the Agency shall reimburse employees for the equivalent cost of an Oregon Class B Commercial Drivers License which shall include initial and renewal licensing and examination fees who are required by the Agency to have a CDL for performing duties. In addition, the Agency shall also reimburse an employee’s insurance co-payment/fees for the required physical examination to obtain the license.",
            "block_bbox": [
                104,
                235,
                1119,
                363
            ],
            "block_id": 2,
            "block_order": 3,
