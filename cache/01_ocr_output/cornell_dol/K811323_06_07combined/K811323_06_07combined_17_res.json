        {
            "block_label": "text",
            "block_content": "Employees who obtain an intermediate certification from DPSST shall have a premium of three percent (3%) per month in addition to their base wages. Employees who obtain an advanced certificate from DPSST shall have a premium of six percent (6%) per month in addition to their base wages (above certificate premiums are non-cumulative). Employees may be required to complete one physical for either the intermediate or advanced certificate, but not both. Employees who currently have the intermediate or advanced certificate will not be subject to the physical.",
            "block_bbox": [
