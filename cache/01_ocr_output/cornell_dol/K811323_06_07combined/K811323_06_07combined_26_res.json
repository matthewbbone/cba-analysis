        {
            "block_label": "text",
            "block_content": "a. All security posts, except those specified as exempt, shall be included in the bid system with seniority prevailing.",
            "block_bbox": [
                104,
                161,
                1115,
                210
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
