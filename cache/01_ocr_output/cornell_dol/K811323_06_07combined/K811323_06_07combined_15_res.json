            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Return from Layoff List. When a former employee who was laid off is recalled, the employee will be paid at the step they were at the time of layoff. Employee's previous salary eligibility date adjusted by the amount of break in service shall be restored",
            "block_bbox": [
                172,
                436,
                1117,
                511
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
