        {
            "block_label": "text",
            "block_content": "When an employee separates from State service and subsequently returns to the State service (except as a temporary employee), the employee's salary eligibility date shall be determined by the Agency as follows:",
            "block_bbox": [
                104,
                361,
                1117,
                436
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
