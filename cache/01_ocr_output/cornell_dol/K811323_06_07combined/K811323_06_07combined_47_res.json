        {
            "block_label": "text",
            "block_content": "Any employee reclassified downward will move into the new range at the step that is nearest the employee's current rate. The employee's anniversary date shall remain the same. If the employee's rate is above the highest step in the lower range, the employee shall receive no reduction in pay. Similarly, such employee shall not receive future salary adjustments until such time as the new range encompasses the employee's salary. At this time, the employee shall have a salary adjustment to the nearest step in the range. The employee shall also be placed on the Layoff List for the previously-held classification.",
            "block_bbox": [
                103,
                210,
                1120,
                388
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
