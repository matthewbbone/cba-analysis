        },
        {
            "block_label": "text",
            "block_content": "For purposes of bidding under Article 25, Working Conditions, seniority is defined as time in class in the security bargaining unit, except that employees in the bargaining unit on July 1, 1994, shall retain the seniority date they have in their current position until such time as the employee leaves that position.",
            "block_bbox": [
                103,
                1092,
                1118,
                1191
            ],
            "block_id": 16,
            "block_order": 17,
            "group_id": 16,
            "block_polygon_points": [
                [
                    103.0,
