                    1118.0,
                    889.0
                ],
                [
                    104.0,
                    889.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "All time trades shall be completed within a thirty (30)-day time period.",
            "block_bbox": [
                173,
                890,
                856,
                915
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
