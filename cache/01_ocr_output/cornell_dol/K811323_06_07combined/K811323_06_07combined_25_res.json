        {
            "block_label": "paragraph_title",
            "block_content": "Section 7. Time Trades.",
            "block_bbox": [
                105,
                612,
                354,
                637
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
