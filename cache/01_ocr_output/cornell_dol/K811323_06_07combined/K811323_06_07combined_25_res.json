                    915.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The notification deadline and/or the completion period may be extended or reduced at individual functional units by mutual agreement between the local Union and the functional unit Manager via the labor/management meeting process.",
            "block_bbox": [
                104,
                916,
                1118,
                990
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
