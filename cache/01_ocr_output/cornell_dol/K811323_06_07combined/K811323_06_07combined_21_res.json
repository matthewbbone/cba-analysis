                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Prohibited conduct described in Sections 2a and 2d above shall result in termination. Prohibited conduct described in Sections 2b, 2c, 2e and 2f shall result in actions specified in Section 6 below.",
            "block_bbox": [
                105,
                764,
                1118,
                840
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
