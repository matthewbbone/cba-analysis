                    104.0,
                    563.0
                ],
                [
                    1119.0,
                    563.0
                ],
                [
                    1119.0,
                    715.0
                ],
                [
                    104.0,
                    715.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 4. Discipline and Other Action.",
            "block_bbox": [
                105,
                739,
                496,
                764
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
