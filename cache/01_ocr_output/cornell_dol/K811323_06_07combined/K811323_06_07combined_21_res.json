    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "d. Possession of any controlled substance including marijuana while on Agency property or in Agency vehicles or equipment at any time, including rest and meal periods. However, this excludes substances that have been legally prescribed for an employee's own use.",
            "block_bbox": [
                176,
                108,
                1117,
                207
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    176.0,
                    108.0
                ],
                [
                    1117.0,
                    108.0
                ],
                [
                    1117.0,
                    207.0
                ],
                [
                    176.0,
                    207.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. Being at work under the influence of any controlled substance, including marijuana, or having such substances present in the body while on Agency property or in Agency vehicles or equipment at any time, including rest and meal periods. An employee has controlled substance present in the body when the employee tests positive in blood or urine tests administered by the Agency for drug and alcohol testing. An employee shall be deemed to test positive for cannabinoids (marijuana or hashish) if his or her urine test indicates fifty (50) or more manograms THC metabolites/ml. However, this excludes substances that have been prescribed for an employee's own use.",
            "block_bbox": [
                175,
                210,
                1118,
                411
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    175.0,
                    210.0
                ],
                [
                    1118.0,
                    210.0
                ],
                [
                    1118.0,
                    411.0
                ],
                [
                    175.0,
                    411.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f. Abusing any substance which is lawfully prescribed by regularly taking it in excessive quantities or by unlawfully obtaining it for purposes of abuse.",
            "block_bbox": [
                176,
                411,
                1116,
                460
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    176.0,
                    411.0
                ],
                [
                    1116.0,
                    411.0
                ],
                [
                    1116.0,
                    460.0
                ],
                [
                    176.0,
                    460.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "g. For purposes of this Agreement, the term controlled substance shall be defined in accordance with ORS 475.005(6).",
            "block_bbox": [
                176,
                462,
                1116,
                512
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    176.0,
                    462.0
                ],
                [
                    1116.0,
