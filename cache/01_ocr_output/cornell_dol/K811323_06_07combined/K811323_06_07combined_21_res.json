                ],
                [
                    1116.0,
                    512.0
                ],
                [
                    176.0,
                    512.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 3. Under the Influence.",
            "block_bbox": [
                105,
                537,
                423,
                561
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    105.0,
                    537.0
                ],
                [
                    423.0,
                    537.0
                ],
                [
                    423.0,
                    561.0
                ],
                [
                    105.0,
                    561.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The term under the influence of controlled substances including marijuana or alcoholic intoxicants covers not only all the well-known and easily recognized conditions and degrees of impairment and intoxication, but any perceptible abnormal mental or physical condition which is the result of indulging to any degree in controlled substances, marijuana or alcoholic intoxicants which perceptibly tend to deprive the use of that clearness of intellect and control the employee would otherwise possess.",
            "block_bbox": [
                104,
                563,
                1119,
                715
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
