            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 5. Reasonable Suspicion Testing.",
            "block_bbox": [
                105,
                864,
                528,
                890
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    105.0,
