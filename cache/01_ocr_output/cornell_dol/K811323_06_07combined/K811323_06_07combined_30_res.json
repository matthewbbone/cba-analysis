        {
            "block_label": "text",
            "block_content": "Bidding Process. Each security staff member who has completed trial service may bid shifts and days off in order of seniority. Seniority is defined in Section 9 of this Article. Employees who fail to successfully bid or who do not apply to bid, will be assigned at the discretion of the institution's management.",
            "block_bbox": [
                103,
                412,
                1117,
                511
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
