                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Effective January 1, 2006, Correctional Officers, Corporals and Sergeants shall receive a one-and-one-quarter percent (1.25%) market adjustment.",
            "block_bbox": [
                106,
                614,
                1114,
                662
            ],
            "block_id": 6,
