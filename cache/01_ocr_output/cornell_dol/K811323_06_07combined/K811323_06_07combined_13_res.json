            ]
        },
        {
            "block_label": "text",
            "block_content": "a. Effective January 1, 2006, salary rates will be adjusted upward by two percent (2%).",
            "block_bbox": [
                175,
                588,
                1068,
                613
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
