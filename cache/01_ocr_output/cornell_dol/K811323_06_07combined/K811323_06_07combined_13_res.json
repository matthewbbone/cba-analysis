        {
            "block_label": "paragraph_title",
            "block_content": "Section 3. Effect of Changes in Law (Other than PERS Litigation).",
            "block_bbox": [
                105,
                184,
                761,
                209
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
