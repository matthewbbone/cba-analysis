        {
            "block_label": "paragraph_title",
            "block_content": "Section 5. Recoupment of Wage and Benefit Overpayments/Underpayments.",
            "block_bbox": [
                105,
                840,
                870,
                865
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
