        },
        {
            "block_label": "text",
            "block_content": "c. Effective December 1, 2006, Compensation Plan salary rates shall be increased by two percent (2%).",
            "block_bbox": [
                105,
                664,
                1116,
                713
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
