                    1117.0,
                    965.0
                ],
                [
                    103.0,
                    965.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Should such a temporary interruption of employment occur, employees so affected will be allowed to use any form of accrued paid leave including vacation, compensatory time off, or personal leave or will be placed on leave without pay where the affected employee(s) have insufficient compensatory time to cover the period of interruption.",
            "block_bbox": [
                103,
                966,
                1118,
                1066
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
