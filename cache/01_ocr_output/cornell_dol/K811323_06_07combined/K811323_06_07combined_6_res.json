                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Such meeting shall occur within fifteen (15) days of:",
            "block_bbox": [
                174,
                411,
                757,
                436
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
