        {
            "block_label": "text",
            "block_content": "1. Agreement that the issue is a mandatory subject, or",
            "block_bbox": [
                245,
                438,
                828,
                461
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
