                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. An Employment Relations Board ruling that the issue is a mandatory subject of bargaining.",
            "block_bbox": [
                243,
                462,
                1116,
                511
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
