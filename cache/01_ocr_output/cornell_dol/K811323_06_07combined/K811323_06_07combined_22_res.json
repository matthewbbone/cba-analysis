            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 6. Consequences of Test Results.",
            "block_bbox": [
                105,
                1016,
                531,
                1041
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
