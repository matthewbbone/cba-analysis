                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "f. If a blood or urine test is confirmed as positive, the Agency will instruct the laboratory to retain the blood or urine sample for a period of not less than thirty (30) calendar days from the date the test results are communicated to the employee for the purpose of allowing the employee to conduct an independent test of the sample at his or her own expense at a laboratory approved by the State of Oregon.",
            "block_bbox": [
                103,
                663,
                1119,
                789
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
