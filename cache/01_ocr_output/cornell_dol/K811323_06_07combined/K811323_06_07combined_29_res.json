            ]
        },
        {
            "block_label": "text",
            "block_content": "1. New Hires - Newly hired employees with the same date of hire shall have their seniority established by a one-time lottery drawing (i.e., draw a number from a hat) with a local union officer present.",
            "block_bbox": [
                248,
                841,
                1117,
                914
            ],
