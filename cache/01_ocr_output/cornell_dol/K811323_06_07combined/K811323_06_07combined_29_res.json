            "block_label": "text",
            "block_content": "3. The parties agree that the intent of this Section is to provide as many work and training opportunities as possible for all security staff, regardless of seniority, while recognizing the importance of seniority and the individual choices of staff.",
            "block_bbox": [
                104,
                110,
                1118,
                185
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
