            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Transfers – When an employee transfers into PRCF with the same date of hire as a current PRCF employee, the current PRCF employee shall be granted the higher seniority within the classification.",
            "block_bbox": [
                247,
                916,
                1117,
                990
