        },
        {
            "block_label": "text",
            "block_content": "If an employee's sick leave accrual should become exhausted, the employee may, at the employee's option, with management's approval, utilize any vacation, or compensatory time they have accrued.",
            "block_bbox": [
                104,
                638,
                1117,
                713
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    104.0,
                    638.0
                ],
                [
                    1117.0,
                    638.0
                ],
                [
                    1117.0,
                    713.0
