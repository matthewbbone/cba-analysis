                [
                    104.0,
                    713.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee may use accrued vacation or compensatory time upon expiration of sick leave credits unless the employee is on a written notice involving attendance problems. Employees on approved FMLA/OFLA leave would continue to be able to use accrued vacation or compensatory time.",
            "block_bbox": [
                104,
                714,
                1118,
                791
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
