            ]
        },
        {
            "block_label": "text",
            "block_content": "All employees who are exempt from overtime under the standards established by the FLSA shall be excluded from overtime. The Agency and the Union shall apply FLSA standards to reach agreement upon exempt employees.",
            "block_bbox": [
                104,
                487,
                1117,
                562
