            "block_label": "text",
            "block_content": "d. Applications for hardship leave shall be in writing and sent to the Agency's Personnel Section and accompanied by the treating physician's written statement certifying the illness or injury. Donated leave may be used intermittently.",
            "block_bbox": [
                104,
                109,
                1115,
                184
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
