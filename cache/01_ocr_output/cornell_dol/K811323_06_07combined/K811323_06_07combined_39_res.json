        {
            "block_label": "text",
            "block_content": "After earned sick leave has been exhausted, the Appointing Authority shall grant sick leave without pay for any job-incurred injury or illness for a period which shall terminate upon demand by the employee for reinstatement accompanied by a certificate issued by the duly licensed attending physician that the employee is physically and/or mentally able to perform the duties of the position.",
            "block_bbox": [
                103,
                843,
                1118,
                944
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
