                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "g. Employees otherwise eligible for or receiving workers compensation or on parental leave will not be considered eligible to receive donations under this Agreement.",
            "block_bbox": [
                105,
                412,
                1115,
                461
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
