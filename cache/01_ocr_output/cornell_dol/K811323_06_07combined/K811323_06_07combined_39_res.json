        {
            "block_label": "text",
            "block_content": "f. Donations shall be credited at the recipient's current regular hourly rate of pay. Donations shall be used to reimburse the Agency for such costs as are incurred for insurance contributions, unless health insurance contributions are mandated under the Family Medical Leave Act (FMLA). In FMLA situations, the Agency will continue to pay for the employee's health insurance contribution until the employee's qualifying FMLA period ends. Donees will be allowed to keep forty (40) hours of donated leave for future use after they return to work. All other unused donated leave will be returned to donors per Agency policy.",
            "block_bbox": [
                104,
                236,
                1117,
                410
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
