                    104.0,
                    737.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The deduction and disbursement to the Union of dues and service fees provided herein shall be accomplished monthly by the State and payment to the Union shall be made on or before the fifteenth day following the date such deductions were made.",
            "block_bbox": [
                105,
                739,
                1117,
                814
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
