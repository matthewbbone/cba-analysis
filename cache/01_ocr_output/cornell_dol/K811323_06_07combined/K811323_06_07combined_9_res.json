        },
        {
            "block_label": "text",
            "block_content": "Section 8. Fair Share.",
            "block_bbox": [
                106,
                436,
                333,
                460
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
