                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Should rates for plan year 2007 exceed the Employer contribution, the parties will jointly petition the Public Employees Benefit Board to use reserve funding to support a portion, or all, of any premium increase above twelve (12) percent.",
            "block_bbox": [
                104,
                537,
                1117,
                613
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    104.0,
                    537.0
                ],
                [
                    1117.0,
                    537.0
                ],
                [
                    1117.0,
                    613.0
                ],
                [
                    104.0,
                    613.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In the event the premium increase in excess of twelve percent (12%) is not covered by PEBB reserves, the two percent (2%) salary schedule adjustment (12/01/2006) shall be reduced by one-quarter of one percent (0.25%) for each one percent (1%) increase in insurance premiums above twelve percent (12%).",
            "block_bbox": [
                104,
                612,
                1118,
                713
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
