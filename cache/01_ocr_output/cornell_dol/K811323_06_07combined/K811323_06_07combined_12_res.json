            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section 2. PEBB Petition.",
            "block_bbox": [
                105,
                511,
                368,
                535
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
