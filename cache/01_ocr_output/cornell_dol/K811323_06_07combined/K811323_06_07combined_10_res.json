        {
            "block_label": "text",
            "block_content": "Provisions of this Agreement not requiring statutory changes or funding by the full legislature before they can be put into effect shall be implemented on the effective date of this Agreement or the date otherwise specified in this Agreement. Necessary bills for implementation of the other provisions shall be submitted promptly by the Department of Administrative Services to the Legislative Assembly and both parties shall jointly recommend passage of the funding and statutory changes.",
            "block_bbox": [
                104,
                414,
                1117,
                543
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
