                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "This Agreement is between the State of Oregon acting through its Department of Administrative Services, hereinafter called the \"Employer,\" on behalf of the Department of Corrections, hereinafter called the \"Agency,\" and the American Federation of State, County and Municipal Employees, hereinafter called the \"Union,\" and is binding upon the Employer, Agency and Union and all designated representatives.",
            "block_bbox": [
                105,
                190,
                1119,
                319
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    105.0,
                    190.0
                ],
                [
                    1119.0,
                    190.0
                ],
                [
                    1119.0,
                    319.0
                ],
                [
                    105.0,
                    319.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The parties agree to the following:",
            "block_bbox": [
                107,
                341,
                446,
                368
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    107.0,
                    341.0
                ],
                [
                    446.0,
                    341.0
                ],
                [
                    446.0,
                    368.0
                ],
                [
                    107.0,
                    368.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "I. The Security Manager or designee may change an employee's shift and days off for valid cause only. When practical, the employee shall receive a seven (7)-day notice of the change.",
            "block_bbox": [
                105,
                391,
                1117,
                445
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    105.0,
                    391.0
                ],
                [
                    1117.0,
                    391.0
                ],
                [
                    1117.0,
                    445.0
                ],
                [
                    105.0,
                    445.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "If the employee believes the change of bid shift and days off was not for valid cause, the employee may appeal the decision to the Labor/Management Resolution Committee.",
            "block_bbox": [
                105,
                467,
                1118,
                521
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    105.0,
                    467.0
                ],
                [
                    1118.0,
                    467.0
                ],
                [
                    1118.0,
                    521.0
                ],
                [
                    105.0,
                    521.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Should the Committee determine that a change of shift and days off was not for valid cause, the employee shall receive the RFM differential for the entire period of the assignment.",
            "block_bbox": [
                105,
                543,
                1118,
                596
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    105.0,
                    543.0
                ],
                [
                    1118.0,
                    543.0
                ],
                [
                    1118.0,
                    596.0
                ],
                [
                    105.0,
                    596.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "II. Employees may not be removed from bid fixed posts, within their shift, except for valid cause. If an employee is so removed, the employee may request review following the chain of command (i.e., shift lieutenant, captain, security manager, and assistant superintendent). If the matter is not resolved, the employee may refer the matter to the Labor/Management Resolution Committee.",
            "block_bbox": [
                104,
                618,
                1118,
                722
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    104.0,
                    618.0
                ],
                [
                    1118.0,
                    618.0
                ],
                [
                    1118.0,
                    722.0
                ],
                [
                    104.0,
                    722.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Should the Committee determine that this change of assignment is not for valid cause, the superintendent shall take appropriate action as necessary.",
            "block_bbox": [
                105,
                745,
                1118,
                798
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    105.0,
                    745.0
                ],
                [
                    1118.0,
                    745.0
                ],
                [
                    1118.0,
                    798.0
                ],
                [
                    105.0,
                    798.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "III. The Labor/Management Resolution Committee shall consist of five (5) members: two (2) Management members will be selected by the AFSCME Council 75 representative; two (2) Labor members will be selected by the DAS Labor Relations Manager. The Superintendent will be a permanent member of the Committee.",
            "block_bbox": [
                105,
                820,
                1119,
                924
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    105.0,
                    820.0
                ],
                [
                    1119.0,
                    820.0
                ],
                [
                    1119.0,
                    924.0
                ],
                [
                    105.0,
                    924.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The decisions of this Committee are final and binding on both parties and cannot be pursued through the grievance procedure.",
            "block_bbox": [
                105,
                946,
                1118,
                999
            ],
            "block_id": 9,
