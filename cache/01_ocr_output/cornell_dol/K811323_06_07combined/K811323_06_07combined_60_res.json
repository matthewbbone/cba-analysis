    "parsing_res_list": [
        {
            "block_label": "doc_title",
            "block_content": "LETTER OF AGREEMENT - Change of Bid Shift and Days Off",
            "block_bbox": [
                429,
                109,
                814,
                166
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
