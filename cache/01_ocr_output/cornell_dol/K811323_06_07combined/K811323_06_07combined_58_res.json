                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Assignment to a Hospital Watch will be accomplished by using the following protocol:",
            "block_bbox": [
                104,
                417,
                942,
                445
            ],
            "block_id": 3,
            "block_order": 4,
