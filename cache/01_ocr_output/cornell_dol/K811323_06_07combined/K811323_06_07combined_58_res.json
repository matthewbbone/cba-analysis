        {
            "block_label": "text",
            "block_content": "All Transportation Security Staff statewide will be assigned the duties and responsibilities of inmate hospital watch on second shift. This assignment will be based on areas of responsibilities assigned to each regional Transportation Office located within the State of Oregon.",
            "block_bbox": [
                105,
                316,
                1118,
                395
            ],
            "block_id": 2,
