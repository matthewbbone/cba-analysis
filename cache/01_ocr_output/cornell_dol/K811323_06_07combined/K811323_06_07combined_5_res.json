                    176.0,
                    665.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Oregon State Penitentiary Minimum - Encompasses all strike-prohibited classified employees, excluding supervisory and confidential employees defined in ORS 243.650, working within the Oregon State Penitentiary Minimum.",
            "block_bbox": [
                175,
                666,
                1116,
                742
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
