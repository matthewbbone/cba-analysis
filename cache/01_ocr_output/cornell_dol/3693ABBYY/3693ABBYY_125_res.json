                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. Involvement in continuous measurable improvement activities such as, collection of data, development and display of metrics and process improvements associated with the employees normal job duties.",
            "block_bbox": [
                97,
                766,
                718,
                842
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
