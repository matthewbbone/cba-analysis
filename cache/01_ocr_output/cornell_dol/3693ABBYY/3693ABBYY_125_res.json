                [
                    97.0,
                    695.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Employees may assist fellow employees on a voluntary basis.",
            "block_bbox": [
                96,
                711,
                717,
                749
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
