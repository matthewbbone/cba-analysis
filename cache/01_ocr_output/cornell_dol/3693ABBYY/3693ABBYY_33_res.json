        {
            "block_label": "text",
            "block_content": "1. Annual vacations are provided for active, full-time employees as a period of rest and relaxation.",
            "block_bbox": [
                119,
                860,
                741,
                899
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
