            ]
        },
        {
            "block_label": "text",
            "block_content": "4. The computation of vacation pay as provided in this Section D shall be at the straight time pay rate in effect during the payroll week immediately preceding the employee's vacation.",
            "block_bbox": [
                118,
                656,
                743,
                730
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
