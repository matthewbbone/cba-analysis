                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Vacation pay for eligible day and swing shift employees shall be computed at their straight time pay rate times the applicable vacation hours earned as provided in Section B of this Article.",
            "block_bbox": [
                119,
                402,
                743,
                476
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    119.0,
                    402.0
                ],
                [
                    743.0,
                    402.0
                ],
                [
                    743.0,
                    476.0
                ],
                [
                    119.0,
                    476.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Vacation pay for eligible graveyard shift employees shall be computed at their straight time pay rate times the third shift hours (32.5 per week) times the applicable number of weeks as provided in Section B of this Article.",
            "block_bbox": [
                119,
                489,
                743,
                563
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
