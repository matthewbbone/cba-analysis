                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The regularly-assigned shift during the workweek prior to the beginning of the vacation shall be used to determine the applicable shift differential as provided in this Section D.",
            "block_bbox": [
                119,
                577,
                743,
                649
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
