        {
            "block_label": "paragraph_title",
            "block_content": "Section D. Vacation Pay Computation",
            "block_bbox": [
                79,
                376,
                451,
                395
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
