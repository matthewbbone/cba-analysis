        },
        {
            "block_label": "text",
            "block_content": "2. Vacations shall be scheduled by the Employer throughout the year so as to cause the least interference with operations. Subject to the foregoing, senior employees shall be given preference in arranging vacation schedules.",
            "block_bbox": [
                119,
                912,
                743,
