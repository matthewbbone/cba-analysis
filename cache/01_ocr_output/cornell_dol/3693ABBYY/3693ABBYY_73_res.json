                    734.0,
                    774.0
                ],
                [
                    146.0,
                    774.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Within fifteen (15) working days following receipt of the above letter, the Union shall acknowledge same by registered or certified mail designating by name and payroll number Department Steward or Stewards being decertified by Shift in the Business Unit or Department where the excess exists.",
            "block_bbox": [
                158,
                781,
                734,
                885
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
