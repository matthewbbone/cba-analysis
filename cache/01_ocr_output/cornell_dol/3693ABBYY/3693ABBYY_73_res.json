        {
            "block_label": "text",
            "block_content": "1. In the event the number of Bargaining Unit employees permanently decreases (more than 90 days) in a particular Business Unit, Department, or Shift to the extent that a decrease in the number of Department Stewards is required by application of the formula in Sections A.1. or 2., or the limitation in Section A.3., the decrease will be effected in the following manner:",
            "block_bbox": [
                113,
                504,
                734,
                626
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    113.0,
                    504.0
                ],
                [
                    734.0,
                    504.0
                ],
                [
                    734.0,
                    626.0
                ],
                [
                    113.0,
                    626.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. A Labor Relations Representative of the Business Unit concerned shall address a registered or certified letter of notification to the Senior Business Representative advising that the decrease of Bargaining Unit personnel in a designated Bargaining Unit, Department or Shift requires the reduction of a specified number of Department Stewards.",
            "block_bbox": [
                146,
                638,
                734,
                774
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
