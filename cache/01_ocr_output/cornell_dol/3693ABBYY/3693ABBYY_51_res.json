            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Employee contributions to the Plan will be a percentage of qualifying compensation. Employees enrolled in the Plan may contribute between one percent (1%) and fifty percent (50%) of their qualifying compensation in one percent (1%) increments (if in contributory retirement, 1% to 50%). Qualifying compensation shall include base weekly wages, Supplemental Wage Payments paid, and all overtime.",
            "block_bbox": [
                152,
                249,
                740,
                408
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
