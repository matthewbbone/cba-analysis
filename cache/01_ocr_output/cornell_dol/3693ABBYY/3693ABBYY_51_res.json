        {
            "block_label": "text",
            "block_content": "(a) In accordance with provisions of the Plan, employees may elect to participate in the Plan upon hire, to be effective as soon as administratively possible.",
            "block_bbox": [
                158,
                152,
                737,
                227
            ],
            "block_id": 1,
