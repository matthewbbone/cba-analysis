                    152.0,
                    408.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) For the first four percent (4%) of the employee's contribution, the Employer will make a contribution equal to one hundred percent (100%) of the employee's contribution. The Company contribution and the employee's contribution may be invested in any option.",
            "block_bbox": [
                165,
                421,
                740,
                529
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
