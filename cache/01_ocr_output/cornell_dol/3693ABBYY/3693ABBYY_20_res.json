        {
            "block_label": "paragraph_title",
            "block_content": "Section H. Report Time",
            "block_bbox": [
                63,
                557,
                304,
                576
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
