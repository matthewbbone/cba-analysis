                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. An employee scheduled and reporting for work at the beginning of the shift shall be assigned a minimum of four (4) hours work. If, in the Employer's determination, no work is available, such an employee shall receive four (4) hours pay, as Report Time, at the rate he or she would have received had he or she worked. Failure of an employee to keep the Employer informed of his or her correct address and telephone number shall relieve the Employer of responsibility for notification and payment of Report Time.",
            "block_bbox": [
                103,
                584,
                726,
                763
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    103.0,
                    584.0
                ],
                [
                    726.0,
                    584.0
                ],
                [
                    726.0,
                    763.0
                ],
                [
                    103.0,
                    763.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Report Time shall not be paid if no work is available due to failure of utilities, fire, storm or flood conditions, damage to buildings or equipment, or any cause beyond the control of the Employer. In such cases the Employer shall not be responsible for notification to employees that no work is available.",
            "block_bbox": [
                101,
                778,
                726,
                886
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
