            ]
        },
        {
            "block_label": "text",
            "block_content": "3. For employees so assigned, their first regularly scheduled day off shall be considered as their \"Saturday\" (1st day); and their second regularly scheduled day off shall be considered their \"Sunday\" (2nd day).",
            "block_bbox": [
                103,
                449,
                728,
                522
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
