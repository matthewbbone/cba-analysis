                    105.0,
                    363.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The term \"special conditions\" in this Section shall also include operations such as the conducting of environmental, reliability, life and related tests of equipment and products.",
            "block_bbox": [
                103,
                369,
                728,
                443
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
