        {
            "block_label": "text",
            "block_content": "1. It is agreed the Employer may schedule days off, other than Saturday or Sunday, and/or shifts other than normal hours of work, (a) in connection with continuous twenty-four (24) hour, seven (7) day operations which have been established by past practice, or (b) are required because of emergencies or special conditions.",
            "block_bbox": [
                105,
                255,
                729,
                363
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
