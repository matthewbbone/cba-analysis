                    140.0,
                    330.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Flight pay is cumulative during any given workday and is computed in 15-minute units of flight time. Fractional units of flight time will be credited at a full quarter hour.",
            "block_bbox": [
                113,
                339,
                739,
                415
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
