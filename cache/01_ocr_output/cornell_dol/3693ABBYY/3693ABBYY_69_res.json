        {
            "block_label": "paragraph_title",
            "block_content": "Section A. Policy",
            "block_bbox": [
                68,
                143,
                256,
                163
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
