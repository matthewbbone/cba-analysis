                    90.0,
                    698.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. Employees may exercise bump rights to a successor classification incorporated as the result of a job consolidation.",
            "block_bbox": [
                90,
                714,
                715,
                772
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
