                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. If, as the result of a reclassification to a lower-rated job, an employee's base rate exceeds the maximum rate of his or her new Job Classification, he or she shall be paid the maximum rate for such lower classification. However, in no case can an employee in a lower Job Classification displace an employee in a higher-paying Job Classification except as provided in Section B.5. below.",
            "block_bbox": [
                90,
                550,
                715,
                698
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
