                    117.0,
                    448.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Deductions for time off, due to tardiness or other causes, shall be at the rate of one-tenth (1/10th) of an hour's pay for each one-tenth (1/10th) of an hour or fractions thereof lost from work.",
            "block_bbox": [
                116,
                464,
                739,
                538
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
