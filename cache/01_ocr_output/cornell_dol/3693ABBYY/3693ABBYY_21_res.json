                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Part-time employees shall be paid Holiday, Sick Leave and Vacation benefits in accordance with Company Standard Practice.",
            "block_bbox": [
                117,
                554,
                739,
                610
            ],
            "block_id": 5,
