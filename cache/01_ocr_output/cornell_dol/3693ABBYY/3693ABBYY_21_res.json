        },
        {
            "block_label": "text",
            "block_content": "1. When an employee is injured while working on his or her job and unable to continue work, the employee shall receive his or her normal pay for hours worked to the time of injury. On the shift the injury occurs, the employee shall also be paid for assigned hours he or she is unable to work because of the injury, at the employee's hourly pay rate, including any applicable shift differential or overtime premium.",
            "block_bbox": [
                117,
                300,
                739,
                448
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    117.0,
                    300.0
                ],
                [
                    739.0,
                    300.0
                ],
                [
                    739.0,
                    448.0
