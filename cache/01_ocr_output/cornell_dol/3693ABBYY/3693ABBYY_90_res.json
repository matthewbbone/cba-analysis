            ]
        },
        {
            "block_label": "text",
            "block_content": "This will confirm our understanding regarding the Interstate Sleeper-Cab Trucking Operations.",
            "block_bbox": [
                81,
                344,
                747,
                385
            ],
            "block_id": 5,
            "block_order": 5,
