                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "It is mutually agreed by the parties hereto that the following provisions will apply to all Interstate Sleeper-Cab runs:",
            "block_bbox": [
                81,
                399,
                747,
                439
            ],
            "block_id": 6,
            "block_order": 6,
            "group_id": 6,
            "block_polygon_points": [
                [
                    81.0,
                    399.0
                ],
                [
                    747.0,
                    399.0
                ],
                [
                    747.0,
                    439.0
                ],
                [
                    81.0,
                    439.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Two (2) employees shall be assigned to each run and shall remain with the truck at all times between terminal points, unless relieved from duty.",
            "block_bbox": [
                91,
                454,
                746,
                511
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
                [
                    91.0,
                    454.0
                ],
                [
                    746.0,
                    454.0
                ],
                [
                    746.0,
                    511.0
                ],
                [
                    91.0,
                    511.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Employees shall be assigned on the basis of their qualifications and job performance as determined by the Employer.",
            "block_bbox": [
                91,
                526,
                747,
                583
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
                [
                    91.0,
                    526.0
                ],
                [
                    747.0,
                    526.0
                ],
                [
                    747.0,
                    583.0
                ],
                [
                    91.0,
                    583.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The employees assigned will be classified as Truck Driver-Combination, and be paid within the rate range for that classification as provided in the Classification Appendices of the Collective Bargaining Agreement.",
            "block_bbox": [
                91,
                599,
                746,
                674
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    91.0,
                    599.0
                ],
                [
                    746.0,
                    599.0
                ],
                [
                    746.0,
                    674.0
                ],
                [
                    91.0,
                    674.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Each employee while on a run is required to rest a minimum of eight (8) hours, which may be on an accumulative basis, in each twenty-four (24) hour period, commencing from the time the employee begins the sleeper-cab run.",
            "block_bbox": [
                89,
                691,
                746,
                766
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
