        {
            "block_label": "paragraph_title",
            "block_content": "Section A. Mutual Pledge of Accord",
            "block_bbox": [
                81,
                363,
                442,
                383
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
