                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Any work which is not interrupted for a period of more than three (3) hours shall be considered \"consecutive hours.",
            "block_bbox": [
                120,
                459,
                739,
                512
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    120.0,
                    459.0
                ],
                [
                    739.0,
                    459.0
                ],
                [
                    739.0,
                    512.0
                ],
                [
                    120.0,
                    512.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. When an employee returns to work and more than three (3) hours have elapsed since the completion of his or her shift, the employee shall be paid as follows:",
            "block_bbox": [
                118,
                513,
                739,
                570
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    118.0,
                    513.0
                ],
                [
                    739.0,
                    513.0
                ],
                [
                    739.0,
                    570.0
                ],
                [
                    118.0,
                    570.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. If the return assignment exceeds four (4) hours, the applicable shift differential shall apply for the hours worked.",
            "block_bbox": [
                152,
                581,
                740,
                638
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    152.0,
                    581.0
                ],
                [
                    740.0,
                    581.0
                ],
                [
                    740.0,
                    638.0
                ],
                [
                    152.0,
                    638.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. If the return assignment is four (4) hours or less, the shift differential shall be the same as the employee received, if any, during the initial work period.",
