        {
            "block_label": "paragraph_title",
            "block_content": "Section A. Workweek and Workday",
            "block_bbox": [
                80,
                152,
                410,
                172
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
