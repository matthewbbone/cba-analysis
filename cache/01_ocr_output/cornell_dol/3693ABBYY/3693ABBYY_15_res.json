                    117.99993896484375,
                    413.9999694824219
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section B. Consecutive Hours of Work",
            "block_bbox": [
                80,
                426,
                459,
                446
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
