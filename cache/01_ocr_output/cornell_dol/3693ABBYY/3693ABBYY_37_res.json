            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Extended Paid Time Off pay shall be computed at the straight time pay rate of the employee on the work-day immediately preceding the Extended Paid Time Off leave.",
            "block_bbox": [
                122,
                687,
                745,
                743
