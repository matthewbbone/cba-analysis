        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section G. Extended Paid Time Off Pay Computation",
            "block_bbox": [
                81,
                657,
                594,
                677
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
