            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Alternate Stewards shall be recognized upon receipt by the Employer of an official Union letter indicating such designation, as provided in Section B.1., above. Seniority of the alternate Stewards shall not be affected by virtue of their temporary appointment.",
            "block_bbox": [
