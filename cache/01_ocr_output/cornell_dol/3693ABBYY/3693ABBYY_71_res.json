        {
            "block_label": "text",
            "block_content": "3. The Union shall select alternate Stewards to temporarily act in place of absentee certified Department and Senior Stewards when such certified Department or Senior Stewards are off the clock and off the premises. Selection of Alternate Stewards shall be made from the active employees in the same general area and shift as the absentee Steward.",
            "block_bbox": [
                114,
                204,
                736,
                326
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
