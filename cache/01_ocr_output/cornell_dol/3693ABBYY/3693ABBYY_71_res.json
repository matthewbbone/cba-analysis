        {
            "block_label": "paragraph_title",
            "block_content": "Section C. Steward Qualifications and Preferential Seniority",
            "block_bbox": [
                74,
                442,
                694,
                462
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
