        {
            "block_label": "text",
            "block_content": "1. All active employees in the above classifications within Department 22-38-xx will be combined into one (1) new PDT Microwave Technician Microwave / RF Devices successor classification \"A\" and \"Senior\" (Job Codes 88683 & 88686) family (LG 22/24). This will be done no later than January 25, 2002. Both parties may agree to mutually extend this date if necessary.",
            "block_bbox": [
                94,
                544,
                703,
                670
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
