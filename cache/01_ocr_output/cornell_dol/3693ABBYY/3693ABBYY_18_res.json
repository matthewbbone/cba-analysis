        {
            "block_label": "paragraph_title",
            "block_content": "Section F. Apportionment of Overtime",
            "block_bbox": [
                53,
                265,
                433,
                283
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
