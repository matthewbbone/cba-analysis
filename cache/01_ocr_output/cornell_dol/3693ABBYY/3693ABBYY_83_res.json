            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The parties shall contribute equally to the fee and expenses of the arbitration provided that any fee or expense shall be decided upon in advance of the arbitration hearing. Notwithstanding the foregoing, if one party requests and obtains a postponement of a scheduled hearing date that results in the assessment of fees or other expenses, that party shall be liable for the payment of any such fees or expenses.",
            "block_bbox": [
