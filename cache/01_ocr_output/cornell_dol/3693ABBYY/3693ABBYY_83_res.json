        {
            "block_label": "text",
            "block_content": "1. Each of the parties to this Agreement shall pay for the time and the expense of its respective representatives or witnesses through all stages of the Arbitration Procedure.",
            "block_bbox": [
                120,
                391,
                746,
                466
            ],
