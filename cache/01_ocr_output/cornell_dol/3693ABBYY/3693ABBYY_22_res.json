        {
            "block_label": "text",
            "block_content": "1. The term \"base rate\" is defined as those hourly rates of pay established for the various Job Classifications listed in the Appendices of this Agreement.",
            "block_bbox": [
                103,
                167,
                726,
                222
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
