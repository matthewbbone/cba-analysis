        {
            "block_label": "text",
            "block_content": "1. Effective on the pay day following the pay period commencing May 21, 2005, payment to all active employees on the payroll a gross amount of $3000.",
            "block_bbox": [
                101,
                429,
                702,
                485
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
