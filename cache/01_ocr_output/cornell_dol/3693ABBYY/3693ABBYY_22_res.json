                    726.0,
                    222.0
                ],
                [
                    103.0,
                    222.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The term \"pay rate\" is defined as an employee's base rate plus any amount of bonus, premium or differential payment which is paid on a continuing hourly basis for work performed.",
            "block_bbox": [
                102,
                233,
                726,
                305
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
