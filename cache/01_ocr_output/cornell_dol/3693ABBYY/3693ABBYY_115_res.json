        {
            "block_label": "text",
            "block_content": "As a result of the 2001 contract negotiations, the parties have agreed that for the duration of this collective bargaining agreement, employees who are represented by E.A.S.T., Local 1553 will participate in the existing Raytheon Educational Assistance Program, as outlined in General Policy and Procedure No. 36-1002-112.",
            "block_bbox": [
                90,
