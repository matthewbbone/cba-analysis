            "block_content": "<table><tr><td></td><td>Labor Grade</td><td>Job Code</td></tr><tr><td>Assembler Electronic Experimental Lab A</td><td>11</td><td>41303</td></tr><tr><td>Assembler Electronic Developmental</td><td>11</td><td>41253</td></tr><tr><td>Assembler Electronic MW Devices</td><td>11</td><td>41373</td></tr><tr><td>Assembler Electrical Electronics Division</td><td>11</td><td>41393</td></tr></table>",
