            ]
        },
        {
            "block_label": "text",
            "block_content": "2) The parties agree that recall of the above four (4) job classifications will be as follows:",
            "block_bbox": [
                114,
                678,
                711,
                718
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
