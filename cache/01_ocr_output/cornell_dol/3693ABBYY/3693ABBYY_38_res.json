                    108.0,
                    286.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Employees may not take Sick Leave for regularly scheduled days off (6th or 7th day) whether worked or not.",
            "block_bbox": [
                108,
                301,
                731,
                340
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    108.0,
