        {
            "block_label": "text",
            "block_content": "1. Sick Leave benefits shall not be paid during a Leave of Absence for the purpose of collecting Holiday pay. In the event Sick Leave is taken in connection with a Leave of Absence, the Leave of Absence shall follow the Sick Leave.",
            "block_bbox": [
                110,
                120,
                732,
                196
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
