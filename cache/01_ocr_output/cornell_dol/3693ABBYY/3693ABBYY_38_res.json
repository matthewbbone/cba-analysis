                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. An hourly paid employee who earned and has unused Extended Paid Time Off and is thereafter reclassified to a salaried position, shall be credited with all of the unused hourly Extended Paid Time Off on the date of reclassification.",
            "block_bbox": [
                108,
                355,
                732,
                430
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    108.0,
