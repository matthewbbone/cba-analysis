                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. If a Holiday falls during a period in which an employee is receiving Extended Paid Time Off benefits, such an employee receives the regular Holiday pay. The Holiday is not charged against the employee's accrual.",
            "block_bbox": [
                107,
                445,
                730,
                521
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
