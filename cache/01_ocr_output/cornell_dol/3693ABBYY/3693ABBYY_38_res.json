                    196.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. In the event an employee absent on paid Sick Leave or extended paid time off terminates, the effective date of the termination for the computation of benefits under this Agreement shall be the last day actually worked.",
            "block_bbox": [
                108,
                211,
                732,
                286
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    108.0,
                    211.0
                ],
                [
                    732.0,
                    211.0
                ],
                [
                    732.0,
