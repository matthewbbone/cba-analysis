        },
        {
            "block_label": "text",
            "block_content": "The Company's Informal Representative for purposes of grievance processing in (A) and (B) above will be the Section Head of Labor Relations or a designee assigned to handle such grievances at this step.",
            "block_bbox": [
                150,
                441,
                697,
