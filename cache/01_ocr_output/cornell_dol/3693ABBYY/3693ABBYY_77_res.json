                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The two (2) representatives so designated shall confer on the issues and make an effort to settle the matter. They shall have fifteen (15) working days following the receipt of the Union's notice designating the Union Informal Representative within which to settle the matter. At the conclusion of this meeting, if an agreement is not reached, either party may request that an arbitrator be selected in accordance with Article XXV, Section B.",
            "block_bbox": [
