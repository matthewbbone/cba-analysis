                ],
                [
                    108.0,
                    624.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The dependent care reimbursement account will allow employees to make an annual election to defer up to $5,000 of base pay which may be used to pay for allowable dependent care expenses.",
            "block_bbox": [
                108,
                639,
                735,
                715
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
