        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section D. General",
            "block_bbox": [
                68,
                400,
                265,
                419
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
