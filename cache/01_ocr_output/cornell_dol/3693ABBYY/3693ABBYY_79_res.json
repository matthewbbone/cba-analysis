                    108.0,
                    694.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. In the event a Union Steward or Officer is the aggrieved party, his or her grievance shall be signed and processed by a Business Representative of the Union and immediately processed into Step Two of the Grievance Procedure.",
            "block_bbox": [
                147,
                710,
                727,
                803
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
