            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Should a Department Steward, Senior Steward, or Officer of the Union be issued a formal reprimand, a Business Representative shall be the representative for the Department Steward, Senior Steward or Officer.",
            "block_bbox": [
