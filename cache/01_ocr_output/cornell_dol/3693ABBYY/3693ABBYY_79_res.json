                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. All processing of grievances shall be handled only by the Union and Employer Representative stipulated in the Grievance Procedure herein. An alleged violation that occurs outside the employee's assigned department will be processed in the department where the alleged violation occurred.",
            "block_bbox": [
                108,
                436,
                734,
                548
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    108.0,
                    436.0
                ],
                [
                    734.0,
                    436.0
                ],
                [
                    734.0,
                    548.0
                ],
                [
                    108.0,
                    548.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. All grievances shall be fully described on the standard form provided, clearly stating the facts, the Articles, Sections and paragraphs allegedly violated, the name of the aggrieved employee(s) when and where the alleged violation occurred, signed and dated by the aggrieved employee(s), and the respective Union Representative(s) designated herein.",
            "block_bbox": [
                108,
                564,
                733,
                694
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    108.0,
