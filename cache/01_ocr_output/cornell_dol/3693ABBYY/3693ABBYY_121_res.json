        {
            "block_label": "text",
            "block_content": "1) As a basic criteria for distinguishing bargaining unit from non-bargaining unit work, the Company will identify salaried support engineers that appear to be spending the preponderance of their time doing A, B, or C above, within that defined structure",
            "block_bbox": [
                79,
                458,
                716,
                548
            ],
            "block_id": 7,
            "block_order": 7,
            "group_id": 7,
            "block_polygon_points": [
