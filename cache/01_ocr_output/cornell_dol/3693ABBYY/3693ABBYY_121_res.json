                    726.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5) All non-exempt technical support personnel as set forth in the attached appendix will be assigned to be a Bargaining Unit Job Classification. The necessary administrative tasks to convert the employees currently classified, as Engineering Support Specialists to bargaining unit status will be completed no later than December 31, 2001.",
            "block_bbox": [
                80,
                736,
                717,
                843
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
