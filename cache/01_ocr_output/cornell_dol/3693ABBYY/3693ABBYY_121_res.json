            ]
        },
        {
            "block_label": "text",
            "block_content": "4) The parties agree that non-exempt technical support personnel will not perform bargaining unit work as described in this Memorandum of Understanding.",
            "block_bbox": [
                80,
                671,
                636,
                726
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
