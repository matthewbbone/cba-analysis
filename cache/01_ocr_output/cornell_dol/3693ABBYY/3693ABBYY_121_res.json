                    548.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2) Management will distribute these guidelines and train supervision on the above criteria and identify work and personnel that meet those criteria",
            "block_bbox": [
                79,
                558,
                678,
                614
            ],
            "block_id": 8,
