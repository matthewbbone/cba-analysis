                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3) If the work is determined to be bargaining unit work, it will be appropriately assigned",
            "block_bbox": [
                80,
                623,
                686,
                660
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
