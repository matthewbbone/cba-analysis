        {
            "block_label": "text",
            "block_content": "1. Eligible hourly job openings will be made available to all Bargaining Unit employees through appropriate means as determined by the cognizant Human Resources organization for a minimum of five (5) working days. The parties agree exceptions to the 5-day positing will be discussed with the Union.",
            "block_bbox": [
                90,
                573,
                716,
                685
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
