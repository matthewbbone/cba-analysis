            ]
        },
        {
            "block_label": "text",
            "block_content": "2. An employee may file for an announced job opening subject to the following requirements:",
            "block_bbox": [
                90,
                701,
                715,
                739
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    90.0,
