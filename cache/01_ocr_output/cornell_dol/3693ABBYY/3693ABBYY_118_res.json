                ],
                [
                    137.0,
                    848.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The employee must have a satisfactory attendance, conduct and work performance record and must possess the qualifications and ability necessary to perform the duties of the applied job opening.",
            "block_bbox": [
                135,
                864,
                719,
                939
            ],
            "block_id": 11,
            "block_order": 11,
            "group_id": 11,
            "block_polygon_points": [
