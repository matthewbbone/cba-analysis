        {
            "block_label": "text",
            "block_content": "7. Solely for the purpose of computing pay during runs, each twenty-four (24) hour workday will be divided into three (3) eight (8) hour periods. One (1) at straight time, one (1) at time and one-half, and one (1) at no pay. Payment at time and one-half will begin only after eight (8) hours of work at straight time in each such workday.",
            "block_bbox": [
                100,
                230,
                740,
                343
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
