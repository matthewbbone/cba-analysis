        {
            "block_label": "text",
            "block_content": "This letter will confirm the parties' understanding concerning a drug-free workplace policy.",
            "block_bbox": [
                77,
                356,
                722,
                397
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "block_polygon_points": [
                [
