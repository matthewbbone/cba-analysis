        {
            "block_label": "text",
            "block_content": "1. Continuous employment begins on the employee's anniversary date as adjusted according to this Article VI and ends at the completion of the shift immediately preceding the date on which vacation is earned.",
            "block_bbox": [
                125,
                186,
                748,
                263
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
