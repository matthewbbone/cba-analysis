        {
            "block_label": "paragraph_title",
            "block_content": "Section A. New and Rehired Employees",
            "block_bbox": [
                74,
                176,
                457,
                196
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
