                    113.0,
                    644.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. The Working Leader premium shall be included in the computation of Holiday pay for an employee who is classified as Working Leader during the workweek in which the Holiday is observed.",
