        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section C. Holiday Eligibility",
            "block_bbox": [
                73,
                752,
                394,
                772
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
