    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "Section B. Holiday Pay",
            "block_bbox": [
                73,
                96,
                313,
                117
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
