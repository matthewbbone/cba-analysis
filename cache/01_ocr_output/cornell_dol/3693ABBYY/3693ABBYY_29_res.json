                [
                    115.0,
                    938.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. On paid Vacation during the workweek in which the Holiday is observed.",
            "block_bbox": [
                162,
                952,
                737,
                992
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
