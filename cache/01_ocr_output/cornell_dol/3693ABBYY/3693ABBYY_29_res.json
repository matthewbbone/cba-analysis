            ]
        },
        {
            "block_label": "text",
            "block_content": "1. An employee is eligible for Holiday pay provided he or she was an active employee on the payroll on the day the Holiday was observed and the employee worked a full scheduled shift either (a) the regular workday immediately preceding the Holiday or (b) the regular workday immediately following the Holiday. An employee is also eligible for Holiday pay provided the employee qualifies under one of the following conditions:",
            "block_bbox": [
                115,
                788,
                738,
                938
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    115.0,
                    788.0
