                    103.0,
                    201.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Upon recall or subsequent upgrading, the employee's rate of pay shall be at the same relative position within the rate range as he or she previously held.",
            "block_bbox": [
                103,
                210,
                728,
                264
            ],
            "block_id": 2,
            "block_order": 2,
            "group_id": 2,
            "block_polygon_points": [
                [
