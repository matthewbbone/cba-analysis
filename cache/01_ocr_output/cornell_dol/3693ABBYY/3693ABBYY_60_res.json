        {
            "block_label": "text",
            "block_content": "1. Recall of eligible laid-off employees shall be in the order of their seniority. It is agreed that the \"date of recall\" for the purposes of this Article and the entire Agreement shall be the date a recalled employee actually commences work on a job assignment in the Plant.",
            "block_bbox": [
                103,
                112,
                729,
                201
            ],
            "block_id": 1,
            "block_order": 1,
            "group_id": 1,
            "block_polygon_points": [
