        },
        {
            "block_label": "text",
            "block_content": "1. An employee who becomes physically disabled as a result of a job-incurred illness or injury shall continue to accumulate seniority while on Leave of Absence.",
            "block_bbox": [
                109,
                107,
                735,
                163
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
