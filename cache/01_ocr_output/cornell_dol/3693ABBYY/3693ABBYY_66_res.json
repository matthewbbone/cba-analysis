            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Sections D.1. and D.2. above shall apply only to employees who have completed their Probationary Period in accordance with the provisions of Article XVII. The Employer agrees to comply with State and Federal laws regarding workers' compensation.",
            "block_bbox": [
                107,
                346,
                734,
                439
            ],
            "block_id": 3,
