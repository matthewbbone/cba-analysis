                ],
                [
                    735.0,
                    107.0
                ],
                [
                    735.0,
                    163.0
                ],
                [
                    109.0,
                    163.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. If an employee is capable of performing some other duties which will not endanger his or her recovery, the employee may apply for and shall be offered suitable employment in a job classification in his/her Division and at a base rate that is not less than the same relative percentage within the rate range as the employee was in his/her former rate range, but does not exceed the maximum of the new rate range, and in accordance with his or her qualifications, safety factors and relative seniority.",
            "block_bbox": [
                109,
                171,
                735,
                337
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
