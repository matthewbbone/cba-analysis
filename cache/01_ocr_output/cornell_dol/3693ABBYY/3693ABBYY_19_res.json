        },
        {
            "block_label": "text",
            "block_content": "4. In connection with the apportionment of overtime, as agreed to above, employees who are hired, rehired, or recalled from layoff will be credited on the overtime records with the maximum number of hours credited to the employees in the work group to which they are assigned. Employees who are transferred from one work group to another will be credited on the overtime records with the average* number of hours credited to the employees in the work group to which they are assigned.",
            "block_bbox": [
                126,
                211,
                750,
                378
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
