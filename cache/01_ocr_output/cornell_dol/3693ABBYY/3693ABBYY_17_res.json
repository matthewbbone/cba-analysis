        },
        {
            "block_label": "text",
            "block_content": "4. Employees shall receive overtime premiums for work performed on the Saturday (1st day) and Sunday (2nd day) of the workweek, as provided for herein.",
            "block_bbox": [
                123,
                228,
                745,
                287
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
