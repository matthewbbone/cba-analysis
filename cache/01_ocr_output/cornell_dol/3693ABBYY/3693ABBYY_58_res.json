                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. In the event of layoff an employee is credited with seniority, in his or her present Job Classification and in previous Job Classifications held under the conditions outlined in Section B.2., below.",
            "block_bbox": [
                103,
                324,
                729,
                398
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    103.0,
                    324.0
                ],
                [
                    729.0,
                    324.0
                ],
                [
                    729.0,
                    398.0
                ],
                [
                    103.0,
                    398.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Present Job Classification seniority is measured by length of service in the presently-held Job Classification. In addition, an employee is also credited with seniority in his or her presently-held Job Classifications for his or her length of service in previously-held Job Classifications in accordance with the following:",
            "block_bbox": [
                102,
                405,
                729,
                535
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    102.0,
                    405.0
                ],
                [
                    729.0,
                    405.0
                ],
                [
                    729.0,
                    535.0
                ],
                [
                    102.0,
                    535.0
                ]
            ]
        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td>Labor Grades of Present Job Classification</td><td>Minimum Length in Presently Held Job Classification to Qualify for Accrued Seniority</td></tr><tr><td>1 through 7</td><td>30 Calendar Days</td></tr><tr><td>8 through 13</td><td>60 Calendar Days</td></tr><tr><td>14 through 24</td><td>90 Calendar Days</td></tr></table>",
            "block_bbox": [
                168,
                551,
                705,
                683
            ],
            "block_id": 6,
            "block_order": null,
            "group_id": 6,
            "block_polygon_points": [
