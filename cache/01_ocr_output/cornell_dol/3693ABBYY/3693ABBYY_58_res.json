        {
            "block_label": "paragraph_title",
            "block_content": "Section B. Application of Seniority During Layoff",
            "block_bbox": [
                63,
                287,
                578,
                308
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
