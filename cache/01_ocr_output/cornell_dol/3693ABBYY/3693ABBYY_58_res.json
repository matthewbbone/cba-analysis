        {
            "block_label": "text",
            "block_content": "3. In the event of a reduction in force, employees will be laid off in the following manner:",
            "block_bbox": [
                100,
                792,
                722,
                831
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
