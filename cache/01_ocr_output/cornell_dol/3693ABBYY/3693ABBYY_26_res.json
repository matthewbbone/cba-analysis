        {
            "block_label": "text",
            "block_content": "5. A new Bargaining Unit Job Classification will not be added during the term of this Agreement where an existing Job Classification duplicates it to the extent of prescribing the identical duties and qualifications.",
            "block_bbox": [
                90,
                275,
                721,
                348
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    90.0,
