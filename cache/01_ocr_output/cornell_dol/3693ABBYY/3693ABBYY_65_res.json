                ],
                [
                    113.0,
                    603.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section C. Medical Leave of Absence",
            "block_bbox": [
                73,
                614,
                444,
                632
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
