                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee whose disability is approved by the designated employer representative shall be granted a medical leave of absence for a period of up to twenty-four (24) months.",
            "block_bbox": [
                142,
                639,
                736,
                711
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
