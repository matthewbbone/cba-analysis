                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. An employee who is absent from work shall be responsible for promptly notifying on the day of absence, either his or her supervisor and in cases of disability, the designated employer representative, if such exists. An employee who fails to report for work for three (3) consecutive regular working days without such notification may be removed from the payroll.",
            "block_bbox": [
                113,
                479,
                739,
                603
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
