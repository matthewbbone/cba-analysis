        {
            "block_label": "text",
            "block_content": "1. The term \"Leave of Absence\" as used in this Agreement, is defined as an approved absence for more than seven (7) consecutive calendar days beginning with the first day the employee is unable to report to work.",
            "block_bbox": [
                114,
                367,
                739,
                439
            ],
            "block_id": 8,
            "block_order": 9,
