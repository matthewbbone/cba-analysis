                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. For the employees first 12 months of approved medical leave the company will pay for the employees medical/vision and dental insurance.",
            "block_bbox": [
                113,
                720,
                738,
                775
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
                [
                    113.0,
