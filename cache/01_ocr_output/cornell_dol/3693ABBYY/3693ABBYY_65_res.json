                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. For the second 12 months of approved leave the employee may pay for their own medical/vision and dental at the employee contribution rate.",
            "block_bbox": [
                113,
                781,
                738,
                836
            ],
            "block_id": 14,
            "block_order": 15,
            "group_id": 14,
            "block_polygon_points": [
