            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "Section B. Failure to Report for Work",
            "block_bbox": [
                73,
                450,
                466,
                470
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
