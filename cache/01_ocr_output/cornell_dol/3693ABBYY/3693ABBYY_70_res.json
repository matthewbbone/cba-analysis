        {
            "block_label": "paragraph_title",
            "block_content": "Section A. Number of Stewards",
            "block_bbox": [
                70,
                118,
                381,
                137
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
