                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Department Stewards may be designated in a ratio not to exceed one (1) Steward to each eighty (80) Bargaining Unit employees by shift within each Division designated in this Agreement.",
            "block_bbox": [
                111,
                148,
                737,
                221
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    111.0,
                    148.0
                ],
                [
                    737.0,
                    148.0
                ],
                [
                    737.0,
                    221.0
                ],
                [
                    111.0,
                    221.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. In determining the maximum number of allowable Department Stewards by shift within a Business Unit, the following formula shall apply:",
            "block_bbox": [
                110,
                230,
                735,
                287
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    110.0,
                    230.0
                ],
                [
                    735.0,
                    230.0
                ],
                [
                    735.0,
                    287.0
                ],
                [
                    110.0,
                    287.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Number of Bargaining Unit Employees by Shift (Rounded to the Nearest Multiple of 80) 80",
            "block_bbox": [
                174,
                302,
                626,
                357
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    174.0,
                    302.0
                ],
                [
                    626.0,
