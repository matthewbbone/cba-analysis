        },
        {
            "block_label": "text",
            "block_content": "Each employee shall also be reimbursed for reasonable lodging expense incurred during a layover. The lodging expense must be accompanied by a receipt. When the cost of meals is claimed for reimbursement as a business conference expense or is otherwise paid by the Company, the standard per diem amount will be decremented using the following factors: 50% dinner; 30% lunch; and 20% for breakfast.",
            "block_bbox": [
