        {
            "block_label": "text",
            "block_content": "6. If work is performed, the employee shall receive the minimum compensation referenced in Article 6, Section 6.6, for each instance that they are called from home. In addition, the employee shall be paid overtime computed from the time the employee leaves home until returning home. The employee shall receive a minimum/maximum of one (1) hour pay at the overtime rate if the work performed is cleared remotely from the employee's home.",
            "block_bbox": [
                129,
                92,
                1000,
                293
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
