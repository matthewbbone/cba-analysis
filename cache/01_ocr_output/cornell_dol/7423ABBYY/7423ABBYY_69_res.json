                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "11. It is not the intent of this agreement to circumvent vacation or holiday scheduling, payment, premiums or overtime provisions.",
            "block_bbox": [
                129,
                788,
                960,
                849
