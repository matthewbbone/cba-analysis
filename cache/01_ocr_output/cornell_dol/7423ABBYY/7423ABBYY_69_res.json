                    375.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8. Employees assigned to such duty must be available and accessible during the term of assignment in order to receive compensation.",
            "block_bbox": [
                128,
                399,
                947,
                458
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    128.0,
