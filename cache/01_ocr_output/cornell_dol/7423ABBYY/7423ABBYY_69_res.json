                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9. When assigned \"Compensated Availability\" the employee may be granted permission where practical to take a Company vehicle home if not already participating in Home dispatch. The employee shall exercise reasonable care for the security and safety of the vehicle and tools. It is understood the vehicle and tools are not available for personal use.",
            "block_bbox": [
                128,
                482,
                1002,
                626
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    128.0,
                    482.0
                ],
                [
                    1002.0,
                    482.0
                ],
                [
                    1002.0,
                    626.0
