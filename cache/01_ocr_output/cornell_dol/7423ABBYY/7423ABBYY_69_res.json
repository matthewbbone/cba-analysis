                    129.0,
                    293.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7. This practice does not supersede normal call-out procedures if additional employees are required to work.",
            "block_bbox": [
                129,
                315,
                1004,
                375
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    129.0,
                    315.0
                ],
                [
                    1004.0,
