                    128.0,
                    626.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "10. If \"Compensated Availability\" assignments conflict with the employees personal calendar, he or she will be afforded the opportunity to trade days or weeks with supervisory approval. Solicitation of the trade will be the responsibility of the employee.",
            "block_bbox": [
                129,
                649,
                999,
                765
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
