        {
            "block_label": "text",
            "block_content": "SECTION 13.1. An informal leave of absence for a period not exceeding 30 calendar days may be granted at the discretion of Management. Formal leaves of absence of a duration in excess of 30 calendar days may be granted in accordance with Company rules and regulations. Application for leaves of absence shall be presented to Management on forms provided by the Company.",
            "block_bbox": [
                176,
                817,
                1048,
                961
            ],
            "block_id": 13,
            "block_order": 14,
            "group_id": 13,
            "block_polygon_points": [
