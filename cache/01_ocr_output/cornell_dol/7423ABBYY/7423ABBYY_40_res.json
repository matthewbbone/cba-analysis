        },
        {
            "block_label": "text",
            "block_content": "SECTION 13.1.1. Any employee remaining away from duty beyond the time specified in the leave, or any employee who shall accept employment other than with the Company during such leave, shall be subject to discharge.",
            "block_bbox": [
