        {
            "block_label": "text",
            "block_content": "SECTION 7.11. The Company will not require Service, Engineering and Construction, Supply and Transportation (Formerly Plant) Department employees to do construction or maintenance work in exposed locations out-of-doors during heavy rain, wet snow, or excessively cold weather, as will interfere with the safe performance of work by outside employees; unless such work is necessary to protect life, property or continuity of essential service. When scheduled work is suspended, other suitable work will be assigned.",
            "block_bbox": [
                139,
                458,
                1021,
                660
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
