                    660.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Once all suitable work is exhausted and there is an agreement between the affected employee(s) and their supervisor that work is impractical due to inclement weather, the following payments will apply.",
            "block_bbox": [
                139,
                682,
                959,
                771
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
