                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) If the agreement is made prior to and/or within the first 30 minutes of the tour, the employee will be released and be paid a maximum of two (2) hours 'show-up pay' at the basic wage rate.",
            "block_bbox": [
                232,
                794,
