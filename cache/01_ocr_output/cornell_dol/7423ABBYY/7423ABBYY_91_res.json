        {
            "block_label": "paragraph_title",
            "block_content": "FAMILY AND MEDICAL LEAVES OF ABSENCE (FMLA)",
            "block_bbox": [
                258,
                370,
                884,
                400
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
