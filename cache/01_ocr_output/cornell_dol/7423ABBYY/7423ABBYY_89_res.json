        {
            "block_label": "text",
            "block_content": "Verizon North Inc. (North Central Region) and the International Brotherhood of Electrical Workers, Local 986 agree to the following:",
            "block_bbox": [
                129,
                453,
                1009,
                513
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
