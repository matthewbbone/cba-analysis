                ],
                [
                    276.0,
                    176.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) A vote of 50% + 1 of those votes, validated by the Third Party Neutral (TPN), will determine the outcome.",
            "block_bbox": [
                276,
                175,
                1039,
                232
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    276.0,
                    175.0
                ],
                [
                    1039.0,
                    175.0
                ],
                [
                    1039.0,
                    232.0
                ],
                [
                    276.0,
                    232.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) If the Union is not successful, another election will not be scheduled for twelve months.",
            "block_bbox": [
                276,
                233,
                990,
                286
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
