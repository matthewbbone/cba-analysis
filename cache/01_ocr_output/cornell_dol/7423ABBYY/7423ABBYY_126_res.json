        {
            "block_label": "paragraph_title",
            "block_content": "4. Time Bound",
            "block_bbox": [
                188,
                397,
                416,
                429
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
