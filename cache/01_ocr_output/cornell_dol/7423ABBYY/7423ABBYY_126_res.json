            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "5. Informed Decision",
            "block_bbox": [
                185,
                1010,
                477,
                1041
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
