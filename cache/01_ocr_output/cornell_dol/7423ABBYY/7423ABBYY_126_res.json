    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "The procedures to be followed are listed below:",
            "block_bbox": [
                278,
                65,
                797,
                97
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
