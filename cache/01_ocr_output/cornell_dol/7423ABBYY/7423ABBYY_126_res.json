                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) The Union must show a minimum of 50% + 1 show of interest on signature cards of the appropriate unit.",
            "block_bbox": [
                276,
                121,
                1073,
                176
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
