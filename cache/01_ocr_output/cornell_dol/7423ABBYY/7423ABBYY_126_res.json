                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(d) The TPN will resolve any issue concerning challenged ballots in similar fashion to the National Labor Relations Board (NLRB) process.",
            "block_bbox": [
                274,
                288,
                1063,
