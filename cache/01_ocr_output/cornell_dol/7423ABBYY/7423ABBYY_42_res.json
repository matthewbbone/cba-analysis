    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "WHEREAS other employers in Verizon's industry permit similarly situated employees greater pension benefits credit than does Verizon/GTE:",
            "block_bbox": [
                189,
                38,
                1053,
                99
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
