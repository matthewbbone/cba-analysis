                ],
                [
                    189.0,
                    99.0
                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "NOW THEREFORE VERIZON AND IBEW LOCAL 986 AGREE AS FOLLOWS:",
            "block_bbox": [
                190,
                121,
                1069,
                151
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    190.0,
                    121.0
                ],
                [
                    1069.0,
                    121.0
                ],
                [
                    1069.0,
                    151.0
                ],
                [
                    190.0,
                    151.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Any full time employee of a Verizon/GTE Company in an IBEW bargaining unit who becomes a full-time employee of either IBEW or a IBEW local affiliate (a \"Verizon/GTE-Union employee\") shall be entitled to be on leave of absence status from Verizon/GTE. While on such leave status, the Verizon/GTE-Union employee shall continue to accumulate seniority and shall retain return rights to the bargaining unit.",
            "block_bbox": [
                188,
                176,
                1065,
                376
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    188.0,
                    176.0
                ],
                [
                    1065.0,
                    176.0
                ],
                [
                    1065.0,
                    376.0
                ],
                [
                    188.0,
                    376.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. While on leave of absence status, a Verizon/GTE-Union employee shall accrue Accredited Service under the Verizon/GTE Pension Plan in which the employee actively participated while a bargaining unit employee until either:",
            "block_bbox": [
                182,
                399,
                1067,
                514
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    182.0,
                    399.0
                ],
                [
                    1067.0,
                    399.0
                ],
                [
                    1067.0,
                    514.0
                ],
                [
                    182.0,
                    514.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The Verizon/GTE-Union employee ends his/her full time employment with the IBEW or a local affiliate; or",
            "block_bbox": [
                276,
                539,
                1001,
                594
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    276.0,
                    539.0
                ],
                [
                    1001.0,
                    539.0
                ],
                [
                    1001.0,
                    594.0
                ],
                [
                    276.0,
                    594.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. The Verizon/GTE-Union employee retires from GTE or otherwise affirmatively relinguishes his/her leave of absence; or",
            "block_bbox": [
                276,
                596,
                985,
                678
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    276.0,
                    596.0
                ],
                [
                    985.0,
                    596.0
                ],
                [
                    985.0,
                    678.0
                ],
                [
                    276.0,
                    678.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. The aggregate length of all such leaves of absence equals fifteen (15) years.",
            "block_bbox": [
                275,
                679,
                1029,
                732
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    275.0,
                    679.0
                ],
                [
                    1029.0,
                    679.0
                ],
                [
                    1029.0,
                    732.0
                ],
                [
                    275.0,
                    732.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "d. Effective January 1, 2003, the aggregate length of all such leaves of absence equals eighteen (18) years.",
            "block_bbox": [
                275,
                734,
                1027,
                790
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    275.0,
                    734.0
                ],
                [
                    1027.0,
                    734.0
                ],
                [
                    1027.0,
                    790.0
                ],
                [
                    275.0,
                    790.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "e. Effective January 1, 2005, the aggregate length of all such leaves of absence equals twenty (20) years.",
            "block_bbox": [
                273,
                791,
                1027,
                847
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    273.0,
                    791.0
                ],
                [
                    1027.0,
                    791.0
                ],
                [
                    1027.0,
                    847.0
                ],
                [
                    273.0,
                    847.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. In the event that any court of competent jurisdiction finds this\nSection 13.5 to be unlawful, it shall be null and void as of the date-\nof its execution, but Verizon/GTE and the IBEW will immediately\nnegotiate in good faith to provide the most equivalent lawful benefit\nfor Verizon/GTE-union employees.",
            "block_bbox": [
                180,
                873,
                1068,
                1015
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
                [
                    180.0,
                    873.0
                ],
                [
                    1068.0,
                    873.0
                ],
                [
                    1068.0,
                    1015.0
                ],
                [
                    180.0,
                    1015.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "No more than one (1) such employee shall be granted leave of absence for full-time Union business.",
            "block_bbox": [
                179,
                1040,
                1042,
                1097
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
                    179.0,
                    1040.0
                ],
                [
                    1042.0,
                    1040.0
                ],
                [
                    1042.0,
                    1097.0
                ],
                [
                    179.0,
                    1097.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Upon return on or before the expiration date from a leave of absence for Union activities, an employee shall be reengaged in his/her former job classification. If no vacancies exist in his/her former job classification, he/she shall be reengaged in a job of comparable compensation within the district.",
            "block_bbox": [
                179,
                1122,
                1054,
                1237
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
                [
                    179.0,
                    1122.0
                ],
                [
                    1054.0,
                    1122.0
                ],
                [
                    1054.0,
                    1237.0
                ],
                [
                    179.0,
                    1237.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "An employee granted a leave for Union activities will be ineligible for wages or benefits from the Company during the period of the leave.",
            "block_bbox": [
                177,
                1261,
                1027,
                1319
            ],
            "block_id": 12,
            "block_order": 13,
            "group_id": 12,
            "block_polygon_points": [
                [
                    177.0,
