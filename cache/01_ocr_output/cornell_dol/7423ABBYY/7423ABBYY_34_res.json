            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) With supervisory approval, an employee may take Personal holidays in four (4) hour increments.",
            "block_bbox": [
                280,
                372,
                1014,
                431
            ],
            "block_id": 1,
