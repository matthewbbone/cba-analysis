        {
            "block_label": "text",
            "block_content": "SECTION 6.5. In event a full time employee shall be called for work outside of regular working hours, after having left for the day, the employee shall be paid overtime computed from the time the employee leaves home until returning home, allowing a reasonable time for travel to and from the job. The minimum compensation shall be two hours at the overtime rate on a weekday.",
            "block_bbox": [
                179,
                510,
                1042,
                655
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
