                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The Minerva Agreement will expire on November 20, 1993 and all employees covered thereunder will be recognized under the Primary Agreement upon its ratification.",
            "block_bbox": [
                176,
                754,
                1002,
                841
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    176.0,
                    754.0
                ],
                [
                    1002.0,
                    754.0
