                    451.0
                ],
                [
                    1067.0,
                    569.0
                ],
                [
                    185.0,
                    569.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The Company reserves the right at any time, and from time to time, by action of the Board of Directors, to modify or amend in whole or in part, any or all of the provisions of the HSP, but no such amendment or modification shall have the effect of reducing the accrued benefits of members, retired members, former members or their beneficiaries or of diverting any part of the Trust Fund to any purpose other than for the exclusive benefit of members, retired members, former members, or their beneficiaries and the payment of reasonable HSP administration expenses.",
            "block_bbox": [
                180,
                592,
                1062,
                844
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
