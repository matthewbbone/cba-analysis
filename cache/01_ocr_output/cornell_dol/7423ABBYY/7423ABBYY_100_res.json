            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The Company reserves the right, by action of the Board of Directors, to terminate or partially terminate the HSP at any time. Upon the termination or partial termination of the HSP or upon the complete discontinuance of contributions under the HSP, the member accounts of the members affected by the termination, partial termination, or complete discontinuance of contributions, as the case may be, shall be nonforfeitable.",
            "block_bbox": [
                178,
                868,
                1059,
                1064
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
