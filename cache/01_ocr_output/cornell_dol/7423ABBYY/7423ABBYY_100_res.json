        {
            "block_label": "text",
            "block_content": "1. Verizon North Inc. (North Central Region) will make the GTE Hourly Savings Plan (HSP) available to regular full or part-time hourly employees of the Company who are covered by the Collective Bargaining Agreement.",
            "block_bbox": [
                185,
                451,
                1067,
                569
