        },
        {
            "block_label": "text",
            "block_content": "18. The provisions of this Memorandum of Agreement are not subject to the grievance or arbitration procedure of the Collective Bargaining Agreement except for the application for reinstatement by employees on leave.",
            "block_bbox": [
                134,
