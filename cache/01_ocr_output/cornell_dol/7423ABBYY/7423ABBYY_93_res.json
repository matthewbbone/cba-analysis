                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "14. Subject to Item 15 below, at the end of the approved leave (or each segment of the leave, as applicable), employees shall be guaranteed reinstatement to the same or equivalent job.",
            "block_bbox": [
                135,
                179,
                985,
                268
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    135.0,
