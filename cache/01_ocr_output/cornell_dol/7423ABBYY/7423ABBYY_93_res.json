            ]
        },
        {
            "block_label": "text",
            "block_content": "17. Employees, while on leave, shall be considered to have terminated employment if they accept employment with another employer, engage in business for profit, and/or apply for unemployment insurance benefits.",
            "block_bbox": [
                133,
                514,
                1006,
                630
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
