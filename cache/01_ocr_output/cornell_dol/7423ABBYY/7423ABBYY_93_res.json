                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "16. Employees who wish to change their projected return date, may request the change, in advance, and the Company will endeavor to accommodate such requests.",
            "block_bbox": [
                133,
                403,
                1017,
                491
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
