                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Service Fee Employee - means a covered employee who elects not to become a member of the Union, or who withdraws membership from the Union, and is required in lieu of membership to pay the representation fee.",
            "block_bbox": [
                221,
