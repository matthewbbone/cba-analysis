                [
                    1049.0,
                    421.0
                ],
                [
                    1049.0,
                    537.0
                ],
                [
                    179.0,
                    537.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company will determine the individuals and/or work groups to which home dispatch will be offered.",
            "block_bbox": [
                261,
                560,
                1053,
                619
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    261.0,
                    560.0
                ],
                [
                    1053.0,
                    560.0
                ],
                [
                    1053.0,
                    619.0
                ],
                [
                    261.0,
                    619.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The election to participate in the Home Dispatch Program will be voluntary on the part of the employee. The employee will commit to participation in the program for a specified time period, such period to be mutually agreed to by the employee and supervisor.",
            "block_bbox": [
                260,
                643,
                1052,
                760
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    260.0,
                    643.0
                ],
                [
                    1052.0,
                    643.0
                ],
                [
                    1052.0,
                    760.0
                ],
                [
                    260.0,
                    760.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Company vehicles will be used only for business purposes. The employees paid time will start and end at the job site.",
            "block_bbox": [
                261,
                782,
                962,
                842
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    261.0,
                    782.0
                ],
                [
                    962.0,
                    782.0
                ],
                [
                    962.0,
                    842.0
                ],
                [
                    261.0,
                    842.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The employee will be responsible for maintaining his/her assigned vehicle in accordance with the Company's maintenance procedures during non-working hours at Company expense. Breakdowns or other vehicle problems occurring during working hours will be corrected during working hours.",
            "block_bbox": [
                258,
                865,
                1047,
                1009
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
