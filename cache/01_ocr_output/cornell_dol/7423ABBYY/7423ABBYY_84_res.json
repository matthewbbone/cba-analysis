        },
        {
            "block_label": "text",
            "block_content": "7. The Company agrees to delete the portion of the consent form that reads \"I hereby release Verizon, its employees and any such designated institution or person from any liability resulting from the medical procedures outlined below\".",
            "block_bbox": [
                181,
