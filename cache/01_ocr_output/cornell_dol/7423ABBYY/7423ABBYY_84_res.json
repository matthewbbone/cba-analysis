        },
        {
            "block_label": "text",
            "block_content": "8. The Company agrees to hold harmless and indemnify the Union against liabilities resulting from the implementation and administration of the Company's Drug and Alcohol Policy.",
            "block_bbox": [
                180,
                649,
                1051,
                737
            ],
            "block_id": 4,
