        {
            "block_label": "text",
            "block_content": "Effective October 27, 2002, Verizon North Inc. (North Central Region) and the International Brotherhood of Electrical Workers, Local No. 986 agree to provide the Retail Sales Consultants the opportunity to participate in a Sales Incentive Compensation Plan with the following administrative guidelines for application of the plan:",
            "block_bbox": [
                127,
                461,
                1002,
                605
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    127.0,
