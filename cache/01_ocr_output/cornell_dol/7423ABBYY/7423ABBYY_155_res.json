                [
                    130.0,
                    688.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The Company shall have the responsibility to establish and administer the standards to be used.",
            "block_bbox": [
                128,
                713,
                973,
                771
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
