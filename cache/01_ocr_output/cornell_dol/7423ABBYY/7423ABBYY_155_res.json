                [
                    1002.0,
                    605.0
                ],
                [
                    127.0,
                    605.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. All regular full-time and regular part-time Retail Sales Consultants assigned to a Marketing Verizon Plus will be eligible.",
            "block_bbox": [
                130,
                629,
                926,
                688
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
