                    685.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "SECTION 6.2.1. The Company recognizes that employees obligated or assigned to work overtime may at times be unavailable due to extenuating circumstances, and such circumstances shall be taken into consideration by the Company.",
            "block_bbox": [
                233,
                707,
                1013,
                824
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
