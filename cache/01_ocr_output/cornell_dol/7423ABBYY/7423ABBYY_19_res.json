            ]
        },
        {
            "block_label": "text",
            "block_content": "SECTION 6.2.2. Employees will not ordinarily work more than fourteen (14) hours in any twenty-four (24) hour period except as may be required by the service situation involved.",
            "block_bbox": [
                233,
                847,
                1009,
                936
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
