                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) When an employee works 14 or more hours in a 24-hour period, he/she shall be entitled to a rest period of 8 consecutive hours before returning to work.",
            "block_bbox": [
                235,
                958,
