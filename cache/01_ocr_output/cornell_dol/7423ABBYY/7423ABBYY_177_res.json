        {
            "block_label": "text",
            "block_content": "9. Upon return to work, employees granted a Voluntary Layoff Leave of Absence shall receive accredited service and seniority for the period of the Voluntary Layoff Leave of Absence.",
            "block_bbox": [
                121,
