                ],
                [
                    177.0,
                    654.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9. Employees shall be required to present, to the satisfaction of the Company's Human Resources Services Department, documentation concerning the basis for the requested leave of absence. Failure to provide medical certification within 25 days of the request for leave may result in denial of leave.",
            "block_bbox": [
                175,
                676,
                1061,
                820
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
