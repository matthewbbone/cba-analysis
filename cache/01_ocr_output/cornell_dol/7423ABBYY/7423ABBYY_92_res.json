        {
            "block_label": "text",
            "block_content": "6. Leave may be taken on an intermittent or reduced schedule basis for reasons specified in paragraphs 2.b and 2.c if determined to be “medically necessary” as defined in the Departments of Labor Regulations 29 CFR Part 825. It may not be taken intermittently or on a reduced schedule basis for reasons specified in paragraph 2.a unless approved by the Company.",
            "block_bbox": [
                179,
                203,
                1066,
                375
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    179.0,
