                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "10. Employees shall provide the Company with at least thirty (30) days advance notice of intent to take-leave when foreseeable.",
            "block_bbox": [
                175,
                843,
                1006,
                903
            ],
            "block_id": 5,
