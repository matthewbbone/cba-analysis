        },
        {
            "block_label": "text",
            "block_content": "2. The attached position profile provides some information concerning the duties and qualifications of the classification. It is understood that this does not constitute an inclusive job description or indicate that the qualifications will not change over time.",
            "block_bbox": [
                181,
