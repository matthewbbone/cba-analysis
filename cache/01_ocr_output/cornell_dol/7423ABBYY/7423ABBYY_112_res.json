            "block_label": "text",
            "block_content": "LIVING BENEFIT RIDER (LBR)",
            "block_bbox": [
                452,
                367,
                801,
                399
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
