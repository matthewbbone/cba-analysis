            ]
        },
        {
            "block_label": "text",
            "block_content": "When mutually agreed between supervisor and employee(s), the employee(s) may work a flexible work week schedule, without overtime until after 40 hours are worked. This would be without loss of any other applicable premium. The request for a flexible work schedule may be initiated by either party.",
            "block_bbox": [
                261,
                566,
