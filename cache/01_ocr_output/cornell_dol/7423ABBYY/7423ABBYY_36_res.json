        },
        {
            "block_label": "text",
            "block_content": "SECTION 11.3. Vacation time off shall be on the basis of full calendar week and shall not extend beyond the week in which December 31 occurs. When an employee's earned vacation pay allowance is less than normal full amount, the employee upon personal request may be permitted to take proportionate reduced vacation time off.",
            "block_bbox": [
