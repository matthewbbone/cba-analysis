        {
            "block_label": "text",
            "block_content": "SECTION 11.2. Effective January 1, 1997 the annual vacation eligibility period will be January 1st of each calendar year.",
            "block_bbox": [
                185,
                257,
                1052,
                317
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
