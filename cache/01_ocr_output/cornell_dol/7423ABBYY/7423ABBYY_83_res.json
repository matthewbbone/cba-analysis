        {
            "block_label": "doc_title",
            "block_content": "MEMORANDUM OF AGREEMENT\nBetween\nVERIZON NORTH INC. (NORTH CENTRAL REGION)\nAnd\nINTERNATIONAL BROTHERHOOD OF ELECTRICAL WORKERS, LOCAL 986\nDRUG AND ALCOHOL POLICY",
            "block_bbox": [
                278,
                71,
                876,
                391
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
