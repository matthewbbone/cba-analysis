    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "(i.e., the nature, event, time, location, individuals involved, etc.) the TPN will fully investigate all relevant facts surrounding the question or dispute. The TPN will then call the parties together and attempt to facilitate resolution of or otherwise mediate the matter.",
            "block_bbox": [
