                    209.0,
                    822.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(e) Regardless of the type of question or dispute that is submitted to the TPN, the parties will each be given a full opportunity to present their positions and supporting factual information prior to the issuance of any opinion. No written briefs will be submitted. There shall be no ex parte contact with the TPN without the concurrence of all parties. Verizon and IBEW believe that matters pertaining to these values are best handled by and between the parties themselves and resort to a TPN should be necessary in only a limited number of cases.",
            "block_bbox": [
                208,
                844,
                996,
                1101
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
