        },
        {
            "block_label": "text",
            "block_content": "SECTION 20.2. The Company agrees to furnish within thirty days after the signing of this Agreement, to the Financial Secretary and the Business Manager of the Union a current list of all of its employees included in the bargaining unit, and quarterly thereafter a list of additions and deletions.",
            "block_bbox": [
                137,
                348,
