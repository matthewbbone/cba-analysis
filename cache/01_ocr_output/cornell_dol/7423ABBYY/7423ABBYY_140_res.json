        {
            "block_label": "text",
            "block_content": "The MetPay program is a voluntary program which allows employees to purchase Automobile Insurance, Homeowner Insurance, Renter's Insurance, Excess Personal Liability, and other personal property insurance through payroll deduction.",
            "block_bbox": [
                183,
                367,
