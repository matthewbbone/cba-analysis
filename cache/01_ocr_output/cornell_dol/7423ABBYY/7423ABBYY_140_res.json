        },
        {
            "block_label": "text",
            "block_content": "The MetPay program offers group discounts to Verizon employees. The amount of the discount is governed by the state insurance regulations. Therefore, the discount varies by state.",
            "block_bbox": [
                181,
                505,
                1064,
                593
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
