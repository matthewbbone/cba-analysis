                ],
                [
                    991.0,
                    820.0
                ],
                [
                    991.0,
                    909.0
                ],
                [
                    124.0,
                    909.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The Company will not be required to deduct Union Dues/Service Fees by any other method, and/or procedure except by mutual consent in writing of the parties hereto.",
