                ],
                [
                    930.0,
                    1093.0
                ],
                [
                    930.0,
                    1151.0
                ],
                [
                    117.0,
                    1151.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "a. The Performance Differential will be applied only to hours actually worked, including overtime hours actually worked, and will be included in the computation of any overtime compensation that may be due employees.",
            "block_bbox": [
                194,
