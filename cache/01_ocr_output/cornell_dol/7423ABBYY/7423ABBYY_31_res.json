            ]
        },
        {
            "block_label": "text",
            "block_content": "SECTION 9.6. An employee who has been laid off and subsequently recalled, when recalled, shall notify the Company in writing by certified mail or orally, of availability for work within three (3) days after notice to report, and shall report for work within ten (10) days after said notice from the Company. Failure to give the notice of availability or failure to report for work after said notice to report for work shall terminate all of the employee's rights under this Contract except as provided in Section 9.7.",
            "block_bbox": [
                139,
                576,
                1025,
                775
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
