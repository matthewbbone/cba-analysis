                    140.0,
                    912.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 12.7. Management will reserve the right to investigate any case of disability due to illness or injury, for which benefits are requested. The Company may require a second opinion from a physician other than the one in regular attendance at Company expense.",
            "block_bbox": [
                140,
                934,
                1010,
                1052
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
            "block_polygon_points": [
