                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 12.4. A second waiting period will not be required if a regular employee is again forced because of illness or injury to be absent from work within fourteen (14) calendar days following the end of the prior absence for which benefits were paid.",
            "block_bbox": [
                142,
                347,
                1024,
                463
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
            "block_polygon_points": [
                [
