                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Section 12.5. An employee may elect with supervisory approval to offset scheduled lost time through sickness disability by using earned day-at-a-time vacation and/or personal holiday(s).",
            "block_bbox": [
                141,
                487,
                981,
                576
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
            "block_polygon_points": [
                [
