        {
            "block_label": "text",
            "block_content": "For regular employees with over one (1) year of accredited service, all days of the waiting period will be waived if the employee has not been absent for personal illness and/or injury in the previous six (6) months or; the employee is hospitalized on the first scheduled day of absence or; a surgical procedure in an outpatient surgical facility or hospital when the employee provides documentation of the surgical procedure performed.",
            "block_bbox": [
                143,
                151,
                994,
                325
            ],
            "block_id": 3,
            "block_order": 1,
            "group_id": 3,
            "block_polygon_points": [
                [
