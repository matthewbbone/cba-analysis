                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(i) Neither the Union nor the Company will be attacked as institutions.",
            "block_bbox": [
                212,
                1128,
                898,
                1183
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
            "block_polygon_points": [
