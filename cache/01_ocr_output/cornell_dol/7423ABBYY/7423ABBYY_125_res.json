                [
                    213.0,
                    878.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(f) Any written information distributed to employees by either party relative to the organizing campaign will be shared with the other. The parties' communications with employees will be shared with the other. The parties' communications with employees will be in accordance with this agreement.",
            "block_bbox": [
                212,
                879,
                1000,
                1015
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
