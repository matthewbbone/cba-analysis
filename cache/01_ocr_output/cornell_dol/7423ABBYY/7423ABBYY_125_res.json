    "parsing_res_list": [
        {
            "block_label": "text",
            "block_content": "parties' mutual recognition of this fundamental tenet, the following provisions are intended to establish, encourage and nurture an environment during a union organizing drive that will allow employees to choose whether or not to become represented in a fully informed and uncoerced manner. All negotiations concerning appropriate unit, access, conduct and voting will be performed by Verlzon Labor Relations staff in conjunction with local management and designated Union representatives.",
            "block_bbox": [
                212,
                42,
                1004,
                269
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
