        {
            "block_label": "text",
            "block_content": "(j) The Company will not conduct meetings for the sole purpose of discussing organizing activities without inviting appropriate Union representatives to attend.",
            "block_bbox": [
                213,
                1184,
                1007,
                1270
            ],
            "block_id": 12,
            "block_order": 13,
