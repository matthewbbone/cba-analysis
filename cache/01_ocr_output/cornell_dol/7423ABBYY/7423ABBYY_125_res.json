                    212.0,
                    1015.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(g) Neither party will hire consultants who encourage an adversarial relationship.",
            "block_bbox": [
                213,
                1017,
                997,
                1072
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
