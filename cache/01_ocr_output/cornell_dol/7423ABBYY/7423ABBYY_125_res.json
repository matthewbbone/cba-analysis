            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "2. Neutrality",
            "block_bbox": [
                128,
                292,
                327,
                323
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    128.0,
                    292.0
                ],
                [
                    327.0,
                    292.0
                ],
                [
                    327.0,
                    323.0
                ],
                [
                    128.0,
                    323.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company and the Union agree that an organizing drive will be met by a neutral position by the Company. This statement is consistent with and reinforces the previously established principle of employee choice. It should follow that an environment intended to foster employee choice would be a neutral environment and that information communicated by either party would be fact based and not misleading, distorted or disparaging. Neutrality means the following:",
            "block_bbox": [
                210,
                348,
                1009,
                550
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    210.0,
                    348.0
                ],
                [
                    1009.0,
                    348.0
                ],
                [
                    1009.0,
                    550.0
                ],
                [
                    210.0,
                    550.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) Management will not be anti-Union nor will the Union be anti-management.",
            "block_bbox": [
                212,
                570,
                965,
                626
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    212.0,
                    570.0
                ],
                [
                    965.0,
                    570.0
                ],
                [
                    965.0,
                    626.0
                ],
                [
                    212.0,
                    626.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Management will not advocate that employees should not vote for a Union to represent them.",
            "block_bbox": [
                212,
                628,
                982,
                682
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    212.0,
                    628.0
                ],
                [
                    982.0,
                    628.0
                ],
                [
                    982.0,
                    682.0
                ],
                [
                    212.0,
                    682.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) The Unions will be afforded reasonable opportunities for access to employees to get their message communicated.",
            "block_bbox": [
                213,
                683,
                993,
                739
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    213.0,
                    683.0
                ],
                [
                    993.0,
                    683.0
                ],
                [
                    993.0,
                    739.0
                ],
                [
                    213.0,
                    739.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(d) Management will respond to employee questions and is obligated to correct inaccurate or misunderstood information by employees.",
            "block_bbox": [
                213,
                739,
                988,
                820
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    213.0,
                    739.0
                ],
                [
                    988.0,
                    739.0
                ],
                [
                    988.0,
                    820.0
                ],
                [
                    213.0,
                    820.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(e) The Union(s) will be referred to by name and will not be characterized as a \"third party\" or \"outsider\".",
            "block_bbox": [
                213,
                822,
                908,
                878
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    213.0,
                    822.0
                ],
                [
                    908.0,
                    822.0
                ],
                [
                    908.0,
                    878.0
