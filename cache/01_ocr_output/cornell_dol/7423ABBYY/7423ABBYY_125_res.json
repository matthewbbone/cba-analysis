                [
                    213.0,
                    1072.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(h) Neither managers nor Union representatives will be personally attacked.",
            "block_bbox": [
                212,
                1072,
                980,
                1128
            ],
            "block_id": 10,
            "block_order": 11,
            "group_id": 10,
            "block_polygon_points": [
                [
