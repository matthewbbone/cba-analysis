            ]
        },
        {
            "block_label": "text",
            "block_content": "SECTION 2.5. A \"full-time employee\" is a regular or temporary employee who is normally scheduled to work a forty-hour work week.",
            "block_bbox": [
                183,
                396,
                1063,
                456
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
