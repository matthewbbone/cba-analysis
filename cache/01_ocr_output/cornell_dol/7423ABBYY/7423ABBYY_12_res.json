        {
            "block_label": "text",
            "block_content": "SECTION 2.7. The \"basic wage rate\" of an employee is the rate paid pursuant to Exhibit B, exclusive of any additional pay for (a) night differentials, (b) overtime, (c) holidays, (d) work on Sundays, and (e) work outside of scheduled time.",
            "block_bbox": [
                182,
                564,
                1068,
                652
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
