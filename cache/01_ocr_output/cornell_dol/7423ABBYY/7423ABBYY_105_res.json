        {
            "block_label": "text",
            "block_content": "1. Verizon North Inc. (North Central Region) and International Brotherhood of Electrical Workers, Local 986 recognize the need for technological change in the business and hereby enter into this Memorandum of Agreement (hereinafter referred to as the Agreement). In order to lessen the economic impact upon regular employees who become surplus due to technological change, the Company and the Union agree to establish the INCOME SECURITY PLAN (the Plan). \"Technological change\" shall be defined as a change in plant or equipment, or a change in a method of operation, diminishing the total number of regular employees required to supply the same services to the Company or its subscribers. \"Technological change\" shall not include layoffs or force realignments caused by business conditions, variations in subscribers' requirements, or temporary or seasonal interruptions of work.",
            "block_bbox": [
                120,
                485,
                1002,
                851
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    120.0,
                    485.0
                ],
                [
                    1002.0,
                    485.0
                ],
                [
                    1002.0,
                    851.0
                ],
                [
                    120.0,
                    851.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When technological change brings about any of the following conditions, the Plan shall apply:",
            "block_bbox": [
                200,
                875,
                983,
                935
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
