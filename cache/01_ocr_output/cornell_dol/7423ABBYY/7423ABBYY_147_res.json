            ]
        },
        {
            "block_label": "text",
            "block_content": "5. Effective January 1, 2004, eligible employees purchasing prescription medications from non-network pharmacies will have an annual $75.00 deductible and a twenty (20) percent (%) co-payment.",
            "block_bbox": [
                105,
                1044,
                1016,
                1132
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
