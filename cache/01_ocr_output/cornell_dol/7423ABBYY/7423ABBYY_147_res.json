                    104.0,
                    856.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Effective January 1, 2004, eligible employees may purchase prescription medications from participating network pharmacies at a Verizon discounted rate. Employees who use participating network pharmacies will have an annual $25.00 deductible and a twenty (20 percent) co-payment.",
            "block_bbox": [
                103,
                877,
                1004,
                1022
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
