                ],
                [
                    209.0,
                    1208.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "E. The employee and the domestic partner live together at the same permanent residence.",
            "block_bbox": [
                208,
                1234,
                1000,
                1294
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
