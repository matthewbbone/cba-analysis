            "block_label": "paragraph_title",
            "block_content": "DOMESTIC PARTNER BENEFITS",
            "block_bbox": [
                386,
                399,
                770,
                430
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
