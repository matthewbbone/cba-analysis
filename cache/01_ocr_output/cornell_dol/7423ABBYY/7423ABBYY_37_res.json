        {
            "block_label": "text",
            "block_content": "(a) Management is encouraged to commence and administer the vacation selection process in a timely manner to accommodate the needs of the work group, such that all employees have a reasonable amount of time to select their vacations.",
            "block_bbox": [
                141,
                319,
                1005,
                434
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
