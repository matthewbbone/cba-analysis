        {
            "block_label": "text",
            "block_content": "SECTION 6.9. Any employee who at their own request is assigned to a job classification which carries a lower rate of pay per hour shall be paid the rate per hour for the classification of work performed but without loss in accredited service.",
            "block_bbox": [
                147,
                290,
                1022,
                404
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
