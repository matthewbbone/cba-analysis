        },
        {
            "block_label": "text",
            "block_content": "SECTION 6.10. Any employee who is determined by Management to be unable to perform the work for the job classification to which they are assigned, may be transferred to a lower job classification by the Company and paid the rate for such classification. If the employee so transferred is not in agreement with the new classification and rate of pay assigned, they may take the matter up under the provisions of Article 4.",
            "block_bbox": [
                146,
                429,
                1018,
                604
            ],
            "block_id": 2,
