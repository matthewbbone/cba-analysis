                    131.0,
                    517.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Mediation will be requested within 15 working days following the notice of the Demand for Arbitration.",
            "block_bbox": [
                132,
                542,
                1010,
                601
            ],
            "block_id": 5,
