    "parsing_res_list": [
        {
            "block_label": "doc_title",
            "block_content": "MEMORANDUM OF AGREEMENT\nBetween\nVERIZON NORTH INC. (NORTH CENTRAL REGION)\nAnd\nINTERNATIONAL BROTHERHOOD OF ELECTRICAL WORKERS, LOCAL 986\nVACATION DONATION",
            "block_bbox": [
                321,
                63,
                931,
                393
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    321.0,
