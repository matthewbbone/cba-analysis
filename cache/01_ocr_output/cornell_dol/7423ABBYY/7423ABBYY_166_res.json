                ],
                [
                    931.0,
                    63.0
                ],
                [
                    931.0,
                    393.0
                ],
                [
                    321.0,
                    393.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company and the Union agree to permit employees, on a trial basis, to donate their vacation time to their coworkers subject to the following guidelines:",
            "block_bbox": [
                180,
                449,
                1055,
                536
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
                [
                    180.0,
                    449.0
                ],
                [
                    1055.0,
                    449.0
                ],
                [
                    1055.0,
                    536.0
                ],
                [
                    180.0,
                    536.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The need to receive donated vacation time must be related to the catastrophic illness or injury of the employee or a member of their immediate family as defined in Article 13, Section 13.3 or due to an unexpected dire situation.",
            "block_bbox": [
                179,
                561,
                1053,
                675
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    179.0,
                    561.0
                ],
                [
                    1053.0,
                    561.0
                ],
                [
                    1053.0,
                    675.0
                ],
                [
                    179.0,
                    675.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. Employees must exhaust all eligible paid time prior to utilizing donated vacation.",
            "block_bbox": [
                178,
                699,
                1002,
                757
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    178.0,
                    699.0
                ],
                [
                    1002.0,
                    699.0
                ],
                [
                    1002.0,
                    757.0
                ],
                [
                    178.0,
                    757.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. The maximum number of donated vacation days an employee can receive is twenty (20) days, unless expanded by mutual agreement.",
            "block_bbox": [
                177,
                784,
                1055,
                842
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    177.0,
                    784.0
                ],
                [
                    1055.0,
                    784.0
                ],
                [
                    1055.0,
                    842.0
                ],
                [
                    177.0,
                    842.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "4. Each employee may donate up to the maximum number of days provided for by Company policy. Donating employees must be from the same department as the receiving employee.",
            "block_bbox": [
                175,
                866,
                1016,
                951
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    175.0,
                    866.0
                ],
                [
                    1016.0,
                    866.0
                ],
                [
                    1016.0,
                    951.0
                ],
                [
                    175.0,
                    951.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. Once the Company determines that an employee's situation qualifies to receive donated vacation, the Department Manager and local Union Representative will let employees know about the option to donate a vacation day to their coworker. The situation should be handled as discreetly as possible to avoid embarrassment to the employee in need and to avoid coworkers feeling obligated to donate their time.",
            "block_bbox": [
                174,
                976,
                1053,
                1173
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
                [
                    174.0,
                    976.0
                ],
                [
                    1053.0,
                    976.0
                ],
                [
                    1053.0,
                    1173.0
                ],
                [
                    174.0,
                    1173.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. The employee in need cannot personally solicit other employees to donate their vacation.",
            "block_bbox": [
                173,
                1196,
                1052,
                1254
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
                    173.0,
                    1196.0
                ],
                [
                    1052.0,
                    1196.0
                ],
                [
                    1052.0,
                    1254.0
                ],
                [
                    173.0,
                    1254.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7. None of the provisions of this agreement are subject to the grievance or arbitration process.",
            "block_bbox": [
                173,
                1278,
                958,
                1338
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
                [
                    173.0,
                    1278.0
                ],
                [
                    958.0,
                    1278.0
                ],
                [
                    958.0,
                    1338.0
                ],
                [
                    173.0,
                    1338.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "8. This agreement can be cancelled by either party with 30 days",
            "block_bbox": [
