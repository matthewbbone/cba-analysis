        {
            "block_label": "text",
            "block_content": "Verizon North Inc. (North Central Region) and the International Brotherhood of Electrical Workers, Local 986 agree to modify the Plan for Hourly Employees' Pensions. Such modifications are subject to the Company's Board of Directors and the United States Department of the Treasury approvals and, therefore, the effective date of July 1, 2003 for the modifications will be contingent upon receipt of all necessary approvals.",
            "block_bbox": [
                124,
                454,
                1007,
                627
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
