        },
        {
            "block_label": "table",
            "block_content": "<table><tr><td></td><td>Present</td><td>Effective July 1, 2003</td></tr><tr><td>Years of Accredited Service</td><td>Minimum</td><td>Minimum</td></tr><tr><td>15 but less than 20 years</td><td>$ 4,700</td><td>$ 4,900</td></tr><tr><td>20 but less than 25 years</td><td>$ 6,100</td><td>$ 6,300</td></tr><tr><td>25 but less than 30 years</td><td>$ 7,500</td><td>$ 7,800</td></tr><tr><td>30 but less than 35 years</td><td>$ 8,900</td><td>$ 9,300</td></tr><tr><td>35 but less than 40 years</td><td>$ 10,300</td><td>$ 10,700</td></tr><tr><td>40 or more years</td><td>$ 11,700</td><td>$ 12,200</td></tr></table>",
