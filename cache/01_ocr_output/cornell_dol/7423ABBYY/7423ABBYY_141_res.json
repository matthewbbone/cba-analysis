                ],
                [
                    130.0,
                    614.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. For a summary of details, refer to the attachment entitled Point of Service Medical Plan.",
            "block_bbox": [
                126,
                638,
