                [
                    128.0,
                    752.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. Where feasible, a network of managed care providers will be established to provide benefits as outlined in \"In-Network HMO\".",
            "block_bbox": [
                211,
                779,
                996,
                837
            ],
            "block_id": 9,
            "block_order": 9,
            "group_id": 9,
            "block_polygon_points": [
                [
                    211.0,
                    779.0
                ],
                [
                    996.0,
                    779.0
                ],
                [
                    996.0,
