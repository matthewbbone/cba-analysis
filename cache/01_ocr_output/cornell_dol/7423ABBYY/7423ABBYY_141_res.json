            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Some of the major provisions include:",
            "block_bbox": [
                128,
                722,
                625,
                752
            ],
            "block_id": 8,
            "block_order": 8,
            "group_id": 8,
            "block_polygon_points": [
