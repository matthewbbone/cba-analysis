                ],
                [
                    211.0,
                    837.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "B. Employees who reside or work in a Network Area and opt to use non-network providers, will receive benefits as outlined in \"Out-of-Network\" benefits.",
            "block_bbox": [
                212,
                862,
                999,
                947
            ],
            "block_id": 10,
            "block_order": 10,
            "group_id": 10,
            "block_polygon_points": [
                [
                    212.0,
