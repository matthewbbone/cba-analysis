            ]
        },
        {
            "block_label": "text",
            "block_content": "The design and coordination of communication vehicles, in conjunction with NACTEL, to encourage employee and prospective employee participation in the AAS degree in Telecommunications or other programs developed.",
            "block_bbox": [
