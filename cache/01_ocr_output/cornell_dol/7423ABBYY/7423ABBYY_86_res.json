        {
            "block_label": "text",
            "block_content": "WHEREAS the International Brotherhood of Electrical Workers (hereafter \"IBEW\" or \"the Union\") and Verizon Communications companies which were subsidiaries of the former GTE Corporation (hereafter \"Verizon North Inc. (North Central Region)/GTE Companies\" or \"the Companies\" or \"the Company\") have collective bargaining relationships throughout the United States;",
            "block_bbox": [
                176,
                451,
                1049,
                620
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
                [
                    176.0,
                    451.0
                ],
                [
                    1049.0,
                    451.0
                ],
                [
                    1049.0,
                    620.0
                ],
                [
                    176.0,
                    620.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "NOW THEREFORE VERIZON NORTH INC. (NORTH CENTRAL REGION)/GTE COMPANIES AND INTERNATIONAL BROTHERHOOD OF ELECTRICAL WORKERS, LOCAL 986 agree as follows:",
            "block_bbox": [
                173,
                645,
                1055,
                731
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    173.0,
                    645.0
                ],
                [
                    1055.0,
                    645.0
                ],
                [
                    1055.0,
                    731.0
                ],
                [
                    173.0,
                    731.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The Company and the Union agree to continue joint efforts (including the 100% tuition reimbursement and the 100% prepaid feature), which allow employees additional opportunities to learn and enhance their knowledge of the jobs being performed. On an “as needed” basis as determined jointly by the parties, a joint study team, consisting of management and union officials, will be created to explore opportunities for joint educational programs. Joint study teams will explore issues such as:",
            "block_bbox": [
                172,
                757,
                1052,
                955
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    172.0,
                    757.0
                ],
                [
                    1052.0,
                    757.0
                ],
                [
                    1052.0,
                    955.0
                ],
                [
                    172.0,
                    955.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "The level of employee awareness of the Verizon Communications, Inc. tuition assistance program.",
            "block_bbox": [
                219,
                977,
                1053,
                1034
            ],
            "block_id": 5,
            "block_order": 6,
            "group_id": 5,
            "block_polygon_points": [
                [
                    219.0,
                    977.0
                ],
                [
                    1053.0,
                    977.0
                ],
                [
                    1053.0,
                    1034.0
                ],
                [
                    219.0,
                    1034.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• The role of education assistance in the attraction and retention of bargaining unit employees.",
            "block_bbox": [
                220,
                1060,
                1048,
                1117
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
