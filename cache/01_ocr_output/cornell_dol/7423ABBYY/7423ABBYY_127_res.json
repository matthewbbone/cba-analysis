    "parsing_res_list": [
        {
            "block_label": "paragraph_title",
            "block_content": "6. Free from Coercion",
            "block_bbox": [
                131,
                44,
                436,
                74
            ],
            "block_id": 0,
            "block_order": 1,
            "group_id": 0,
            "block_polygon_points": [
                [
                    131.0,
