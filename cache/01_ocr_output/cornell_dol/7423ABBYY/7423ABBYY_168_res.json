                    990.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5. The cost of the Vision Plan coverage will be paid by the Company.",
            "block_bbox": [
                173,
                1014,
                1029,
                1046
            ],
            "block_id": 11,
            "block_order": 12,
            "group_id": 11,
