        {
            "block_label": "text",
            "block_content": "1. Effective July 1, 2003 Verizon North Inc. (North Central Region) and International Brotherhood of Electrical Workers, Local 986 agree to implement the provisions of the Vision Plan set forth in this Memorandum of Agreement.",
            "block_bbox": [
                178,
                456,
                1046,
                570
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
