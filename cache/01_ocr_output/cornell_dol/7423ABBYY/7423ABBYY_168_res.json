            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Some of the major provisions include:",
            "block_bbox": [
                175,
                678,
                711,
                709
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
