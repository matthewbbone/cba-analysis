                ],
                [
                    175.0,
                    709.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• No annual deductible.",
            "block_bbox": [
                259,
                735,
                576,
                762
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
