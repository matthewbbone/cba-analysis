                ],
                [
                    259.0,
                    762.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• Eye exam every twelve months.",
            "block_bbox": [
                260,
                766,
                685,
                792
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
