                    792.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "• One pair of prescription eyeglasses or contact lenses every 24 months.",
            "block_bbox": [
                259,
                794,
                1043,
                849
            ],
            "block_id": 9,
            "block_order": 10,
            "group_id": 9,
            "block_polygon_points": [
