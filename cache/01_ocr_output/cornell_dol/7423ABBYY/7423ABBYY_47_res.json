                    435.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "SECTION 16.2. Concession rates shall be applicable to telephone service at the employee's place of residence with listing in the employee's name.",
            "block_bbox": [
                133,
                456,
                1012,
                518
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
