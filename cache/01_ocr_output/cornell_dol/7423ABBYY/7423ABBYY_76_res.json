                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6. Day-at-a-time vacation shall not be carried over to the next vacation year.",
            "block_bbox": [
                186,
                1090,
                1066,
                1121
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
