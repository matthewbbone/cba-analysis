        {
            "block_label": "text",
            "block_content": "SECTION 11.1. Vacations will be granted to regular employees in accordance with the following schedule:",
            "block_bbox": [
                141,
                766,
                992,
                826
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
