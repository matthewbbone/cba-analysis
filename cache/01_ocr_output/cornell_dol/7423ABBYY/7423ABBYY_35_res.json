                    141.0,
                    826.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) Employees who complete 1 year of accredited service with the Company will be granted two (2) weeks of vacation at their basic rate of pay.",
            "block_bbox": [
                141,
                850,
                1023,
                912
            ],
            "block_id": 7,
            "block_order": 8,
            "group_id": 7,
            "block_polygon_points": [
                [
