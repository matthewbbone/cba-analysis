                    141.0,
                    912.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) Employees who have completed 5 years of accredited service with the Company will be granted three (3) weeks vacation at their basic rate of pay.",
            "block_bbox": [
                141,
                933,
                997,
                1021
            ],
            "block_id": 8,
            "block_order": 9,
            "group_id": 8,
            "block_polygon_points": [
