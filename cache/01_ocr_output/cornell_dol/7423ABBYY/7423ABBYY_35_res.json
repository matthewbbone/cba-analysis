            ]
        },
        {
            "block_label": "text",
            "block_content": "(c) Employees who have completed 15 years of accredited service with the Company will be granted four (4) weeks of vacation at their basic rate of pay.",
            "block_bbox": [
                141,
                1045,
                1006,
                1133
            ],
