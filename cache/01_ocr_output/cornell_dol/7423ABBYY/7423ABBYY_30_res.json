        {
            "block_label": "text",
            "block_content": "SECTION 9.4.2.4. The employee shall not be permitted either \"job hopping\" or seeking of new job experience by repetitive bumping.",
            "block_bbox": [
                356,
                232,
                1033,
                319
            ],
