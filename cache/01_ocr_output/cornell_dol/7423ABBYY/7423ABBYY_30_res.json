        {
            "block_label": "text",
            "block_content": "(a) An employee may not bump into a new job title classification when there is opportunity within twenty-five (25) miles of his/her current reporting location to bump in his/her own classification or into one previously occupied by him.",
            "block_bbox": [
                356,
                343,
                1060,
                486
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
                    356.0,
