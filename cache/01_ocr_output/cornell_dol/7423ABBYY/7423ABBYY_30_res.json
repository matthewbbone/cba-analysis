                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(b) When the selected job requires the employee to relocate, and more than one choice of location is possible, the Company may exercise discretion as to permitted location, or alternate location, based on best meeting the needs of the business, giving due weight to the employee's desires.",
            "block_bbox": [
                355,
                510,
                1051,
                679
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
