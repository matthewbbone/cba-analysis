        },
        {
            "block_label": "text",
            "block_content": "G. All ladders are to be staggered not straight up and down; adequate lighting is to be provided to insure safety when ascending or descending ladders. Stopping off place to be provided every twenty feet with a back rest. An emergency ladder to be suspended from the top in all blast furnaces. There shall be platforms placed inside and outside of tuyere holds for bricklayers to enter and leave blast furnaces.",
            "block_bbox": [
                47,
                315,
                491,
                453
            ],
            "block_id": 3,
            "block_order": 4,
            "group_id": 3,
            "block_polygon_points": [
                [
