        },
        {
            "block_label": "text",
            "block_content": "It is hereby agreed that employees shall be paid on the job before 4:00 P.M. on Wednesday of the week following the week in which the work was performed, except where a holiday is celebrated on a Monday of the week in which payment is made, in which case payment shall be made before 4:00 P.M. Thursday of the said week. All payroll checks issued must have the contractor's name, his office or home address, and telephone number printed thereon. A detachable stub recording social security taxes and other authorized deductions shall be attached to all pay checks.",
            "block_bbox": [
                26,
                335,
                468,
                531
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
