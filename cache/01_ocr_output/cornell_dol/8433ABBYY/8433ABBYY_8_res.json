        {
            "block_label": "text",
            "block_content": "The work week, for pay purposes, shall commence at 8:00 A.M., on Monday and end at 8:00 A.M., the following Monday. Upon mutual agreement between the Employer and the Union, which mutual agreement shall be reduced to writing, the starting time on a particular job may be advanced to, but not earlier than 7:00 A.M., and the quitting time shall be eight and one-half hours after the starting time. However, no job shall start earlier than 7:00 A.M., and no Union nor Employer shall be responsible for obtaining or paying premium pay if a bricklayer reports for work earlier than 7:00 A.M.",
            "block_bbox": [
                26,
                105,
                468,
                301
            ],
            "block_id": 2,
            "block_order": 3,
            "group_id": 2,
            "block_polygon_points": [
