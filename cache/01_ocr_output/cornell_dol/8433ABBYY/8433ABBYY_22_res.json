                    55.0,
                    414.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(a) The joint trusteeship of industry promotion or advancement funds shall be determined to be lawful by a final judgment issued by any federal court.",
            "block_bbox": [
                128,
                429,
                494,
                507
            ],
            "block_id": 3,
