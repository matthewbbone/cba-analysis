        {
            "block_label": "text",
            "block_content": "A. Informing the other party of such submission and requesting the American Arbitration Association to submit a panel of five (5) arbitrators available to hear and decide the issue. The party requesting such panel shall upon receipt of the five (5) names, strike one (1) name from the list and submit the remaining four (4) names to the other party, who shall strike one (1) additional name. The parties shall alternately strike names thereafter until one remains, who shall be the arbitrator.",
            "block_bbox": [
                29,
                101,
                468,
                274
            ],
            "block_id": 1,
            "block_order": 2,
            "group_id": 1,
            "block_polygon_points": [
