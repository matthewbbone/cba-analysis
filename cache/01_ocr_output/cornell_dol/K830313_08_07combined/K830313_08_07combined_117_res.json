        {
            "block_label": "text",
            "block_content": "1-2-1 The Warren Occupational Technical Center Salary Schedule for degreed teachers shall be the same format as the classroom teachers' salary schedule, with levels and steps multiplied by a factor of 1.167 to accommodate an extended teaching day (except as outlined in Section 1-2-3 below).",
            "block_bbox": [
                95,
                65,
                1126,
                130
