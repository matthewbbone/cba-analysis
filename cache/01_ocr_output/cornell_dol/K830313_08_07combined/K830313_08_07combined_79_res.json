        },
        {
            "block_label": "text",
            "block_content": "34-4-3 Vacancies which occur after the last posting in June through September 15 and are not filled with an involuntary transferee or leave returnee, shall be filled with a continuing contract teacher with the approval of the area administrator and subject to review by the Transfer Oversight Committee.",
            "block_bbox": [
                95,
                1215,
                1090,
                1281
            ],
            "block_id": 15,
