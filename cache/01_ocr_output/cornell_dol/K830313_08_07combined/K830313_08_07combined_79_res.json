        },
        {
            "block_label": "text",
            "block_content": "34-4-2 All vacancies in the District, which occur between September 15 and June 30, will be advertised. The teacher employment administrator will first determine if an open position is restricted or unrestricted. During February and March, all positions for voluntary transfer will be advertised in the established District electronic medium available at all sites as well as in the District's current communication media. Involuntary transfers and unassigned leave returnees will be placed in accordance with Article 34-7-1. All openings occurring after the placement of unassigned leave returnees and involuntaries will be advertised through June 30. However, those open positions requiring special skills, e.g., SERS personnel, counselors, library information specialists and teachers-on-special-assignment, may be advertised and filled anytime during the calendar year.",
            "block_bbox": [
                94,
                1054,
                1132,
                1200
            ],
            "block_id": 14,
            "block_order": 13,
            "group_id": 14,
            "block_polygon_points": [
