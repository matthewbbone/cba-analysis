        {
            "block_label": "paragraph_title",
            "block_content": "34-1 Reassignment",
            "block_bbox": [
                35,
                174,
                199,
                198
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
