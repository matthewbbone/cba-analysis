                ]
            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "7-4-3 Level Three",
            "block_bbox": [
                93,
                200,
                244,
                223
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
