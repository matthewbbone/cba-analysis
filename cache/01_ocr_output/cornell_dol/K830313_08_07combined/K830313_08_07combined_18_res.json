                    799.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7-4-3-5 The report of the arbitrator shall be submitted in writing to the District and the Association only, and shall set forth his/her findings of fact, reasoning, conclusions and recommendations, which shall be consistent with law and with the terms of this Agreement.",
            "block_bbox": [
                152,
                824,
                1071,
                888
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
