                    151.0,
                    622.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7-4-3-3 The arbitrator will have the authority to hold hearings and make procedural rules. He/She will issue a report within a reasonable time, not to exceed thirty (30) calendar days from the date of the close of the hearings, or if oral hearings have been waived, then from the date the final state-ments and evidence are submitted to the arbitrator.",
            "block_bbox": [
                152,
                646,
                1066,
                730
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
                [
                    152.0,
                    646.0
                ],
                [
                    1066.0,
                    646.0
                ],
                [
                    1066.0,
                    730.0
                ],
                [
                    152.0,
                    730.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "7-4-3-4 All hearings held by the arbitrator shall be in open sessions, and no news releases shall be made concerning progress of the hearing.",
            "block_bbox": [
                152,
                755,
                1001,
                799
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
            "block_polygon_points": [
                [
                    152.0,
                    755.0
                ],
                [
                    1001.0,
                    755.0
                ],
                [
                    1001.0,
