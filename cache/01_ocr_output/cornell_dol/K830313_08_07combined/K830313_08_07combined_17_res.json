        },
        {
            "block_label": "text",
            "block_content": "7-3-1 No grievance shall be recognized by the District or the Association unless it shall have been presented at the appropriate level within thirty (30) school days after the aggrieved person knew, or should have known, of the act or condition on which the grievance is based, and if not so presented, the grievance will be considered as waived, except by mutual agreement of the Association and the Office of Employee Relations.",
            "block_bbox": [
