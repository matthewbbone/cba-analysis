        {
            "block_label": "text",
            "block_content": "7-4-1-1 A formal grievance is initiated when the Association's Executive Director, UniServ Director, and/or building Association representative signs the grievance and it is transmitted in writing, using the appropriate form, to the Office of Employee Relations, to the grievant's immediate supervisor and to the Association.",
            "block_bbox": [
                154,
                682,
                1072,
                749
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
