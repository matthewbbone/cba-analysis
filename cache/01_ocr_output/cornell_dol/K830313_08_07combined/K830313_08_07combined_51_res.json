                    96.0,
                    426.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "D. Conduct departmental meetings and act as a resource to members of the department regarding school and District policies and procedures.",
            "block_bbox": [
                97,
                450,
                1110,
                495
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
