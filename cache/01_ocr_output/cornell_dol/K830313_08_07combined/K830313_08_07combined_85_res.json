                    93.0,
                    247.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "35-1-1-1 Teachers whose work year is one hundred eighty-five (185) days will be granted nine (9) days of leave per year.",
            "block_bbox": [
                152,
                271,
                1050,
                317
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
                [
                    152.0,
