                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "35-1-1-2 Teachers whose work year exceeds one hundred eighty-five (185) days will be granted one (1) additional day of leave for each additional twenty (20) days, or major portion thereof.",
            "block_bbox": [
                153,
                340,
                1071,
                385
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
