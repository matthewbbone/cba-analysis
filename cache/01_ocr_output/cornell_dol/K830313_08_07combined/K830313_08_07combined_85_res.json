        },
        {
            "block_label": "text",
            "block_content": "35-1-1-3 Annual sick leave advancement will be available as of the first official day of the school year or the first official day of employment, whichever shall occur first. Advancement shall be the equivalent of one (1) day per month, or major fraction thereof, provided the first official day of employment occurs on or before the 15th of the month.",
            "block_bbox": [
                153,
                409,
                1052,
                494
