        {
            "block_label": "text",
            "block_content": "35-1-1 The District will grant sick leave to all teachers for personal illness or serious illness in the immediate family.",
            "block_bbox": [
                93,
                222,
                1014,
                247
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
