        {
            "block_label": "text",
            "block_content": "2-3 Teacher grievances alleging discriminatory treatment by the District based, or believed to be based, on the complainant's race, religion, color, national origin, gender, age, disabilities, sexual orientation, marital status, and/or ancestry may be filed with either the District's Administrator, Office of Employee Relations or the JCEA Executive Director.",
            "block_bbox": [
                34,
                329,
                1153,
                394
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
