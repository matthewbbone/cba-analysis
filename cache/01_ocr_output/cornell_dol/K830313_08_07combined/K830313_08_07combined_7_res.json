            ]
        },
        {
            "block_label": "text",
            "block_content": "2-2 The Association agrees to admit persons to its membership without discrimination on the basis of race, religion, color, national origin, gender, age, disabilities, sexual orientation, marital status, ancestry and shall represent equally all teachers without regard to membership or non-membership in any teacher organization.",
            "block_bbox": [
                33,
                240,
                1166,
                306
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
