        {
            "block_label": "text",
            "block_content": "2-1 The District shall not discriminate against any teacher on the basis of race, religion, color, national origin, gender, age, disabilities, sexual orientation, marital status, ancestry, or membership or non-membership in any teacher organization.",
            "block_bbox": [
                33,
                171,
                1167,
                216
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
