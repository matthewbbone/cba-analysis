        {
            "block_label": "text",
            "block_content": "35-10-5-1 The teacher's request to extend leave will be considered as follows:",
            "block_bbox": [
                155,
                1166,
                787,
                1190
            ],
            "block_id": 15,
            "block_order": 13,
            "group_id": 15,
