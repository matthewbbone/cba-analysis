        },
        {
            "block_label": "text",
            "block_content": "35-10-5 A teacher who requests to amend his/her initial leave shall submit, in writing, his/her request to the District's Human Resources division not less than thirty (30) days prior to the teacher's original date of return.",
            "block_bbox": [
                94,
