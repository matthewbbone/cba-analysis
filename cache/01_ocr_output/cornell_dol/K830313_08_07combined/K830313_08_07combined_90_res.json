        {
            "block_label": "text",
            "block_content": "35-9-1 Leave will be given to teachers for appearance in court as a witness, to serve on a jury, or to respond to an official order from another governmental jurisdiction for reasons not brought about through the connivance or miscon-duct of the teacher.",
            "block_bbox": [
                91,
                97,
                1116,
                143
            ],
            "block_id": 3,
            "block_order": 1,
            "group_id": 3,
            "block_polygon_points": [
