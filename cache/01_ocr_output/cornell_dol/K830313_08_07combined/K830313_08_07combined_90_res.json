                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. Each individual request will be judged on its own merits.",
            "block_bbox": [
                216,
                1215,
                692,
                1239
            ],
            "block_id": 16,
            "block_order": 14,
            "group_id": 16,
