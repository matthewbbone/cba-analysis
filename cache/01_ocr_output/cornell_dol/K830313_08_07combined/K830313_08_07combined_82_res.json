                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "I. Teachers who have been identified as possible involuntary transferees may seek a voluntary transfer through June 30, as outlined in Section 34-5-2.",
            "block_bbox": [
                153,
                956,
                1049,
                1001
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
                [
                    153.0,
