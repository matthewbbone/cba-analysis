                    154.0,
                    1229.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. In the event that ties still exist after the application of paragraph 1 above, teachers shall be ranked as to when they signed their employment contract with the District.",
            "block_bbox": [
                154,
                1251,
                1059,
                1298
            ],
            "block_id": 12,
