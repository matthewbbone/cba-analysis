        },
        {
            "block_label": "text",
            "block_content": "34-6-5 In the event two (2) or more potential involuntary transferees under Section 34-6-4 have the same length of service in the District, the teacher with the least length of service, using the following criteria, shall be identified as the potential involuntary transferee.",
            "block_bbox": [
                94,
                1094,
                1126,
                1159
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
