            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Teachers shall be ranked in order of the greatest length of service as a teacher in the building, provided this criteria shall not apply to Section 34-6-4 (D) or (F).",
            "block_bbox": [
                154,
                1183,
                1043,
                1229
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "block_polygon_points": [
