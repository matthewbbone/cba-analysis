        {
            "block_label": "text",
            "block_content": "transferee, unless, by the transferring of the teacher with the least length of service in the District, the school or, in the case of SERS personnel, the area, is unable to meet identified instructional needs within the grade level, department or team.",
            "block_bbox": [
                152,
                59,
                1071,
                124
            ],
            "block_id": 2,
            "block_order": 1,
            "group_id": 2,
            "block_polygon_points": [
