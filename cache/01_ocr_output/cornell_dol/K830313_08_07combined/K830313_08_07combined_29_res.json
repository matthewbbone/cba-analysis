        {
            "block_label": "text",
            "block_content": "12-1 The parties seek to educate young people in the democratic tradition, to foster a recognition of individual freedom and social responsibility, to inspire meaningful awareness of, and respect for, the Constitution and the Bill of Rights, and to instill appreciation of the value of individual personality. It is recognized that these democratic values can best be transmitted in an atmosphere which is free from censorship and artificial restraints upon free inquiry and learning, and in which academic freedom for teacher and student is encouraged.",
            "block_bbox": [
                33,
                171,
                1185,
                259
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
                    33.0,
                    171.0
                ],
