        {
            "block_label": "paragraph_title",
            "block_content": "PREAMBLE",
            "block_bbox": [
                530,
                297,
                706,
                325
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
                [
