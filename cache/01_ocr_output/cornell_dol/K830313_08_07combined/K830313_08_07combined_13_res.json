        {
            "block_label": "paragraph_title",
            "block_content": "5-1 Representation",
            "block_bbox": [
                34,
                171,
                196,
                194
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
