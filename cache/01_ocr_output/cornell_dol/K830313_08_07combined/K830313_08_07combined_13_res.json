            ]
        },
        {
            "block_label": "paragraph_title",
            "block_content": "5-3 Conducting Negotiations",
            "block_bbox": [
                36,
                862,
                271,
                887
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "block_polygon_points": [
                [
                    36.0,
