                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5-3-3 During negotiations, the Board and the Association, through their representatives, will present relevant data, exchange points of view, and make proposals and counterproposals. Upon request of either party, the other will make available for inspection its records and data pertinent to the subject of negotiations.",
            "block_bbox": [
                95,
                1109,
                1099,
                1175
            ],
            "block_id": 15,
            "block_order": 14,
            "group_id": 15,
