                [
                    92.0,
                    374.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6-1-4 The composition of the task force will include an equal number of teachers and administrative personnel. The number of members shall be mutually agreed upon by the District and the Association.",
            "block_bbox": [
                93,
                398,
                1102,
                442
            ],
            "block_id": 8,
            "block_order": 6,
            "group_id": 8,
