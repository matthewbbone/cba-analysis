                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6-1-1 The task force shall be formed for a specific problem, if and when these problems in need of study arise.",
            "block_bbox": [
                86,
                220,
                976,
                245
            ],
            "block_id": 5,
            "block_order": 3,
            "group_id": 5,
            "block_polygon_points": [
                [
                    86.0,
                    220.0
                ],
                [
                    976.0,
                    220.0
                ],
                [
                    976.0,
                    245.0
                ],
                [
                    86.0,
                    245.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6-1-2 The task force will be established when the District and the Association agree to the need for a study and recommendations.",
            "block_bbox": [
                92,
                269,
                986,
                313
            ],
            "block_id": 6,
            "block_order": 4,
            "group_id": 6,
            "block_polygon_points": [
                [
                    92.0,
                    269.0
                ],
                [
                    986.0,
                    269.0
                ],
                [
                    986.0,
                    313.0
                ],
                [
                    92.0,
                    313.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6-1-3 The task force will be dissolved when the study of the specific problem is finished and a report and recommendation are made to the District and the Association.",
            "block_bbox": [
                92,
                329,
                1100,
                374
            ],
            "block_id": 7,
            "block_order": 5,
            "group_id": 7,
            "block_polygon_points": [
                [
                    92.0,
                    329.0
                ],
                [
                    1100.0,
