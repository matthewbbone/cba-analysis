                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "6-1-5 Interested members of the community may be included on any task force, if the District and the Association mutually agree that such inclusion will provide significant contribution to the resolution of the problems being considered:",
            "block_bbox": [
                93,
                467,
                1121,
                511
            ],
            "block_id": 9,
