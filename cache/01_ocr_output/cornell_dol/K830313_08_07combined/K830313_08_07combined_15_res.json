        {
            "block_label": "paragraph_title",
            "block_content": "6-1 Establishment of Task Forces",
            "block_bbox": [
                33,
                171,
                309,
                194
            ],
            "block_id": 4,
            "block_order": 2,
            "group_id": 4,
