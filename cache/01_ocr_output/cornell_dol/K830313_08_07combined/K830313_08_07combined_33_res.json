                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "14-4 Immediately upon receipt of a request or recommendation for non-renewal of contract of a teacher, the Board shall notify the Association, and the non-renewal of contract shall be subject to the grievance process.",
            "block_bbox": [
                34,
                503,
                1175,
                548
