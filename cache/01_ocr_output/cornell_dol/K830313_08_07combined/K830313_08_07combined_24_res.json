        {
            "block_label": "text",
            "block_content": "9-9 Scheduled parent-teacher conferences shall be conducted within the forty (40) hour workweek with the following provisions:",
            "block_bbox": [
                32,
                284,
                1058,
                308
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
