                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "A. Lunch time scheduled in excess of the thirty (30) minute duty-free lunch period shall not be counted within the forty (40) hour workweek.",
            "block_bbox": [
                92,
                334,
