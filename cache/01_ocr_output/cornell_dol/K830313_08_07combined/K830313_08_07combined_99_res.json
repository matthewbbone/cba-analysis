        {
            "block_label": "text",
            "block_content": "39-1-1 \"Teacher\" for the purpose of this Article shall mean any person who is regularly licensed by the teacher licensing authority for the State of Colorado, and who is employed full-time by the District, except those persons holding letters of authorization and the Chief Administra-tive Officer of the District.",
            "block_bbox": [
                93,
                222,
                1127,
                287
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
                [
                    93.0,
                    222.0
                ],
                [
                    1127.0,
                    222.0
                ],
                [
                    1127.0,
                    287.0
                ],
                [
                    93.0,
                    287.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "39-1-2 \"Cancellation of employment\" shall mean the termination of employment of a teacher when there is a justifiable reduction in the number of teaching positions in the District.",
            "block_bbox": [
                94,
                311,
                1125,
                355
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
                [
                    94.0,
                    311.0
                ],
                [
                    1125.0,
                    311.0
                ],
                [
                    1125.0,
