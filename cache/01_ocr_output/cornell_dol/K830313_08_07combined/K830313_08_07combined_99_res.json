                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "39-1-3 \"Layoff\" shall mean a removal from active service to the District because of a reduction of teacher(s).",
            "block_bbox": [
                94,
                381,
                965,
                405
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    94.0,
