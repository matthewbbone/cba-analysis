        },
        {
            "block_label": "text",
            "block_content": "15-3-1 All inservice course work for inservice credit for advancement on the salary schedule shall be presented to the principal for his/her approval prior to taking courses, except in cases of emergency.",
            "block_bbox": [
                93,
                569,
                1109,
                615
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
