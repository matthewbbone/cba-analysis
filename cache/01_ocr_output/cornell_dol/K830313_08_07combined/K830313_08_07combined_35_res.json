        {
            "block_label": "text",
            "block_content": "15-3 After-school courses, workshops, conferences, and programs designed to improve the quality of instruction will be provided. Every effort will be made to obtain people with the highest qualifications to participate in the presentation of such programs. All teachers desiring to attend shall be allowed to do so. District inservice credit will be granted under the following guidelines:",
            "block_bbox": [
                32,
                481,
                1170,
                546
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
