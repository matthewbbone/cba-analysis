        {
            "block_label": "text",
            "block_content": "15-1 The parties support the principle of continuing the training of teachers, participation by teachers in professional organizations in the areas of their specialization, and leaves for work on advanced degrees in special studies.",
            "block_bbox": [
                33,
                172,
                1181,
                218
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
