        {
            "block_label": "text",
            "block_content": "15-3-3 Any inservice credit courses for which the above criteria do not apply may be accorded credit for advancement on the salary schedule only upon application and approval by the building principal and the Registrar/Staff Development. This application must include a description of the course, including course number and credit value, with a statement explaining how this course will enhance the value of the individual's service function.",
            "block_bbox": [
                94,
