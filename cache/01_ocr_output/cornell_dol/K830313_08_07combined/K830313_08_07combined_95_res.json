        {
            "block_label": "text",
            "block_content": "37-1 The District agrees to deduct from teachers' salaries com-bined dues for the JCEA, CEA and NEA, as teachers individ-ually and voluntarily authorize, and to transmit the monies to the JCEA or it's designated agent.",
            "block_bbox": [
                34,
                173,
                1189,
                219
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
            "block_polygon_points": [
