                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "37-2 The Jefferson County Education Association will certify to the Board, in writing, the current rate of membership dues. The District will be notified of any change in the rate of membership dues thirty (30) days prior to the effective date of such change.",
            "block_bbox": [
                33,
                242,
                1163,
                288
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
                [
