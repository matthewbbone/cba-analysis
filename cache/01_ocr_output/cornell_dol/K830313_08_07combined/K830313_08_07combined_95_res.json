            ]
        },
        {
            "block_label": "text",
            "block_content": "37-4 Not later than October 31 of each year, the District will provide the Association with a list of those teachers who have voluntarily authorized the District to deduct dues for the organizations named in Section 37-1 above. The District will also submit amended lists to the Association each succeeding month.",
            "block_bbox": [
