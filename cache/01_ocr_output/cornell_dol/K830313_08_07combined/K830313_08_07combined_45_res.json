                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "3. Upon receipt of the appeal, the principal will attempt to rectify the situation by hiring additional teaching staff, if at all possible, and will involve the teacher(s) who requested the adjustment and the liaison chairperson. If a satisfactory resolution is reached, the parties shall reduce the resolution to writing and each shall sign it.",
            "block_bbox": [
                123,
                315,
                1082,
                375
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
