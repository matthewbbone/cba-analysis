                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. The principal will review his/her staffing at the beginning of each school year and will make adjustments to conform to the ranges established herein.",
            "block_bbox": [
                123,
                233,
                1129,
                274
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
