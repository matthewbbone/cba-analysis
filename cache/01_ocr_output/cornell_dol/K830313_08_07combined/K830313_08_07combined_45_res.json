                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. If the class size standard is exceeded when school starts, a primary (K-2) teacher may appeal to his/her principal to adjust his/her class size to conform to said standard.",
            "block_bbox": [
                123,
                275,
                1136,
                315
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
