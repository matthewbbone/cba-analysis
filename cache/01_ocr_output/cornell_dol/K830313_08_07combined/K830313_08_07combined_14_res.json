        },
        {
            "block_label": "paragraph_title",
            "block_content": "5-6 Conducting Mediation/Fact-finding",
            "block_bbox": [
                34,
                541,
                348,
                566
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
