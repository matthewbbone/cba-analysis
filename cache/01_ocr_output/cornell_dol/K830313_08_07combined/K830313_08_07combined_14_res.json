                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "5-6-5 Within five (5) school days after receiving the fact-finding report of the mediator/fact-finder or the fact-finder, the District and the Association, through their representatives, will meet to discuss the report. Public release of the report may be made any time after the conclusion of such meeting. Thereafter, such report shall be declared a public document.",
            "block_bbox": [
                94,
                906,
                1133,
                971
            ],
            "block_id": 12,
            "block_order": 11,
            "group_id": 12,
            "block_polygon_points": [
                [
