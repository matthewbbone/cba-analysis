        {
            "block_label": "text",
            "block_content": "44-6-3 Level 3 is a bachelor's degree with a regular license valid for teaching assignments and forty (40) semester hours of credit earned after the date the bachelor's degree was awarded, or master's degree. (At least one-half (1/2) of the forty (40) hours must be graduate credit.)",
            "block_bbox": [
                94,
                902,
                1135,
                967
