        {
            "block_label": "text",
            "block_content": "44-6-2 Level 2 is a bachelor's degree with a regular license valid for teaching assignments and twenty (20) semester hours of credit earned after the date the bachelor's degree was awarded. These hours may be any combination of graduate or undergraduate hours.",
            "block_bbox": [
                94,
                813,
                1104,
                878
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
