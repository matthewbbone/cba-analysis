        {
            "block_label": "text",
            "block_content": "44-6-1 Level 1 is a bachelor's degree with a regular license valid for teaching assignments or in a state recognized program for teacher in residence or an alternative licensure program.",
            "block_bbox": [
                93,
                745,
                1115,
                789
            ],
            "block_id": 9,
