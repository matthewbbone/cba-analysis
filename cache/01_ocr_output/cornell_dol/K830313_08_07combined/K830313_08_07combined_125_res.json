                    37.0,
                    790.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "When presented with an appeal, the Coordinating Committee, using the standards set for all schools/sites, will determine if the appeal is a co-operative decision-making issue. It is not the purpose of the Coordinating Committee to review site decisions, but to assist in assuring a co-operative process has taken place.",
            "block_bbox": [
                38,
                815,
                1171,
                880
            ],
            "block_id": 12,
            "block_order": 10,
            "group_id": 12,
            "block_polygon_points": [
                [
