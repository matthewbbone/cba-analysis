        {
            "block_label": "text",
            "block_content": "The second function proposed for the Coordinating Committee is to provide an appeals process for schools/sites. The Coordinating Committee should be composed of Board of Education appointees and representatives of JCEA, JCAA, CSEA District Accountability, Parent/Teacher/Student Associations, volunteers and community organizations.",
            "block_bbox": [
                37,
                727,
                1178,
                790
            ],
            "block_id": 11,
            "block_order": 9,
            "group_id": 11,
            "block_polygon_points": [
