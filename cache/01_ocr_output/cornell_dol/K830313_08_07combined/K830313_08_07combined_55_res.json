                    347.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "23-3 Each teacher shall be provided with adequate and suitable work space, storage space, and parking space, to the extent the budget will allow.",
            "block_bbox": [
                38,
                372,
                1165,
                416
            ],
            "block_id": 6,
            "block_order": 5,
            "group_id": 6,
            "block_polygon_points": [
