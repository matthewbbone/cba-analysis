            ]
        },
        {
            "block_label": "text",
            "block_content": "23-4 With prior approval from the principal or his/her desig-nee, teachers shall have access, without cost, to school physical education equipment and facilities for the purpose of improving physical well-being.",
            "block_bbox": [
                38,
                441,
                1116,
