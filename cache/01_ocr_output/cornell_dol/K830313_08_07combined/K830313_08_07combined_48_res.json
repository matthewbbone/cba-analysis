        },
        {
            "block_label": "text",
            "block_content": "19-7-1 Time lost by a teacher in connection with any incident mentioned in Article 19-7 shall not be charged against the teacher.",
            "block_bbox": [
                97,
                255,
                1125,
                279
            ],
            "block_id": 5,
            "block_order": 4,
            "group_id": 5,
            "block_polygon_points": [
