        {
            "block_label": "text",
            "block_content": "19-7 If any teacher is assaulted, complained against, or sued, as a result of acting within the scope of his/her employment, the District will provide legal counsel and render all necessary assistance to the teacher in his/her defense.",
            "block_bbox": [
                36,
                186,
                1142,
                231
            ],
            "block_id": 4,
            "block_order": 3,
            "group_id": 4,
