        {
            "block_label": "text",
            "block_content": "35-4-1 Teachers will be entitled to two (2) days leave of absence without loss of pay each school year. Notice to the teacher's principal or other immediate super-visor that personal leave is to be taken will be given at least one (1) day before taking such leave (except in cases of emergencies).",
            "block_bbox": [
                94,
                472,
                1104,
                537
            ],
            "block_id": 7,
            "block_order": 6,
