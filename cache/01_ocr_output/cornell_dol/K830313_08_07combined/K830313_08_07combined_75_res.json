            ]
        },
        {
            "block_label": "text",
            "block_content": "32-1-2 Each teacher who has been an applicant and wishes to apply for an administrative position for which a vacancy may occur during the summer vacation period shall submit his/her application to the teacher employment administrator, or his/her designee, and provide an address where he/she can be reached during the summer vacation period. The teacher employment administrator, or his/her designee, shall notify such teacher of any vacancy.",
            "block_bbox": [
                36,
                334,
                1186,
                419
            ],
            "block_id": 6,
