                    420.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "25-1-3 In order to assure effective utilization of the library information center by providing for an equitable distribution of teacher aides, the District and JCEA agree as follows:",
            "block_bbox": [
                97,
                444,
                1120,
                489
            ],
            "block_id": 7,
            "block_order": 6,
            "group_id": 7,
            "block_polygon_points": [
                [
                    97.0,
                    444.0
                ],
                [
                    1120.0,
                    444.0
                ],
                [
                    1120.0,
                    489.0
                ],
                [
                    97.0,
                    489.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. An area administrator will work with individual building principals to assure that each principal will provide a percentage of the building allocated aide hours to the library information center. This percentage will be provided as follows:",
            "block_bbox": [
                157,
                513,
                1063,
                577
            ],
            "block_id": 8,
            "block_order": 7,
            "group_id": 8,
            "block_polygon_points": [
                [
                    157.0,
                    513.0
                ],
                [
                    1063.0,
                    513.0
                ],
                [
                    1063.0,
                    577.0
                ],
                [
                    157.0,
                    577.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Elementary 6.7% - 12.7%",
            "block_bbox": [
                159,
                593,
                374,
                615
            ],
            "block_id": 9,
            "block_order": 8,
            "group_id": 9,
