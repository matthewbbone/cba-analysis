            ]
        },
        {
            "block_label": "text",
            "block_content": "2. The provisions of this article will not be used as rationale for reducing the percentage of the building allocated aide hours allocated to the library information center.",
            "block_bbox": [
                156,
                661,
                1058,
                707
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "block_polygon_points": [
