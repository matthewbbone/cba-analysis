                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "Secondary 15.0% - 21.0%",
            "block_bbox": [
                159,
                615,
                377,
                638
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
