        {
            "block_label": "text",
            "block_content": "15-7-5 The amount of credit granted for advancement of the salary schedule for junior or community college courses shall be accepted in accordance with credit granted by the junior or community college to a maximum of three (3) semester hours. Credit exceeding three (3) semester hours shall be granted only at the amount that a four (4) year approved training institution granted for a similar course.",
            "block_bbox": [
