                    396.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "24-4 No teacher shall be prevented from wearing pins or other identification of membership in the Association or any of its affiliates.",
            "block_bbox": [
                36,
                419,
                1088,
                443
            ],
            "block_id": 7,
