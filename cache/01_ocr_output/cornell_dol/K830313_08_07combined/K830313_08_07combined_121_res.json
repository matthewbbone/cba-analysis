        },
        {
            "block_label": "text",
            "block_content": "The purpose of these goals is to establish standards for the assignment of elementary visual arts, music and physical education teachers. These goals strive for equity throughout the District regarding teaching loads, frequency of class contact, and length of contact sessions to meet the standards of Board policy relative to the instructional day.",
            "block_bbox": [
                37,
                706,
                1195,
                771
            ],
            "block_id": 14,
            "block_order": 10,
            "group_id": 14,
            "block_polygon_points": [
