                    925.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. To the extent possible, class size of the visual arts, music and physical education teacher should be consistent with the teaching load of a classroom teacher within the building.",
            "block_bbox": [
                63,
                925,
                1185,
                965
            ],
            "block_id": 17,
            "block_order": 13,
            "group_id": 17,
            "block_polygon_points": [
