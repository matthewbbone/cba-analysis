                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "1. Insofar as possible, the goals will be to assign eighteen (18) sections per teacher. *Note: Class size relief may be applied for if the number of sections exceeds nineteen (19).",
            "block_bbox": [
                63,
                883,
                1137,
                925
            ],
            "block_id": 16,
            "block_order": 12,
            "group_id": 16,
            "block_polygon_points": [
                [
                    63.0,
