                    771.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "These goals are to be utilized by area administrators and principals as goals for elementary visual arts, music and physical education program implementation effective August, 1995. In the event that an unexpected increase in pupil enrollment or a lack of facilities dictates that these goals cannot be honored, area administrators and principals will take note and initiate adjustments as soon as educationally feasible.",
            "block_bbox": [
                37,
                795,
                1176,
                859
            ],
            "block_id": 15,
            "block_order": 11,
            "group_id": 15,
            "block_polygon_points": [
