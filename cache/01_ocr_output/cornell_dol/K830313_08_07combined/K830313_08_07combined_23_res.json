                    701.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9-3 Faculty and other meetings during orientation days at the beginning of the school year shall be kept to a minimum to enable teachers to complete their classroom preparations, and teachers agree to utilize this time effectively to prepare for classroom instruction.",
            "block_bbox": [
                35,
                725,
                1153,
                770
            ],
            "block_id": 10,
            "block_order": 9,
            "group_id": 10,
            "block_polygon_points": [
