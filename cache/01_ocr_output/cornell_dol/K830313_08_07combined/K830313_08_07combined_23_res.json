                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "9-4 Teachers shall have a duty-free lunch period of no less than thirty (30) minutes, exclusive of passing and inter--school travel time. Teachers may leave the building during their duty-free lunch period, provided such absence from the building does not interfere with their regular assignment. The principal's office must be notified prior to such absence from the building.",
            "block_bbox": [
                36,
                794,
                1187,
                859
            ],
            "block_id": 11,
            "block_order": 10,
            "group_id": 11,
            "block_polygon_points": [
                [
                    36.0,
                    794.0
