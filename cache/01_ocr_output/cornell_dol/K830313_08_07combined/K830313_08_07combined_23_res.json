        {
            "block_label": "text",
            "block_content": "9-5-2 Classroom teacher-pupil contact days shall be a minimum of one hundred seventy-five (175) days, but no more than one hundred-eighty (180) days as determined by District policy.",
            "block_bbox": [
                95,
                1081,
                1111,
                1125
