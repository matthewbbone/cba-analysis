        {
            "block_label": "text",
            "block_content": "1. A written request from the teacher for Extended Sick Leave coverage, stating the reason or the name of the illness and the anticipated date for returning to work.",
            "block_bbox": [
                333,
                58,
                843,
                123
            ],
