                    123.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "2. A written statement from a licensed physician verifying that the teacher is under the physician's care for the particular illness and the physician's recommendation for the teacher's recovery period, subject to the provisions outlined in Section 35-3.",
            "block_bbox": [
                334,
                147,
                892,
                234
            ],
            "block_id": 3,
            "block_order": 2,
            "group_id": 3,
            "block_polygon_points": [
