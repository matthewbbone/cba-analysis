            ]
        },
        {
            "block_label": "text",
            "block_content": "41-6 Teachers interested in job sharing shall be responsible for identifying teachers who would be willing to job share with them. Teachers agreeing to job share shall submit a completed application form to the Human Resources division with a copy to JCEA. The Human Resources division shall be responsible for determining job sharing eligibility.",
            "block_bbox": [
                36,
                897,
                1181,
                962
            ],
            "block_id": 11,
            "block_order": 9,
            "group_id": 11,
            "block_polygon_points": [
