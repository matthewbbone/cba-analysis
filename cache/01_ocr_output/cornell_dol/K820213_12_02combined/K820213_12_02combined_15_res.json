                    168.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Each employee covered under this Agreement who works thirty-five (35) hours per week shall receive pay at the regular hourly rate of pay for each hour or part thereof between the thirty-fifth (35th) and fortieth (40th) hour or shall receive compensatory time at the rate of straight time for each hour or part thereof worked between the thirty-fifth (35th) or fortieth (40th) hour. The employee shall select the option desired and shall inform the employer on a form given to the employee at the time the overtime assignment is scheduled of which option.",
            "block_bbox": [
                886,
                183,
                1499,
                295
            ],
            "block_id": 16,
            "block_order": 16,
            "group_id": 16,
            "block_polygon_points": [
