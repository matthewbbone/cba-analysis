                    295.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "c. The County shall make every effort to pay an employee who performs an overtime assignment for such work at the rate of pay set forth in this Section on the first pay day following the payroll period in which the overtime was worked. If the County does not pay the employee on the first pay day, the County, without fail, shall pay the employee on the second pay day following the payroll period in which the overtime was worked.",
            "block_bbox": [
                885,
                308,
                1503,
                401
            ],
            "block_id": 17,
            "block_order": 17,
            "group_id": 17,
            "block_polygon_points": [
