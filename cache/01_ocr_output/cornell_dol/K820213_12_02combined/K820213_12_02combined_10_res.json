        {
            "block_label": "text",
            "block_content": "A leave of absence with pay shall be granted to an employee who is absent from duty because of the death of a member of the immediate family. The immediate family of an employee shall include spouse, mother, father, sisters, brothers, children, grandparents, spouse's grandparents, brothers-in-law, sisters-in-law, daughters-in-law, sons-in-law, grandchildren, father-in-law and mother-in-law or any person occupying the position of a parent of the employee or spouse.",
            "block_bbox": [
                99,
                243,
                712,
                336
            ],
            "block_id": 4,
            "block_order": 5,
            "group_id": 4,
            "block_polygon_points": [
                [
                    99.0,
                    243.0
                ],
                [
                    712.0,
                    243.0
                ],
                [
                    712.0,
                    336.0
