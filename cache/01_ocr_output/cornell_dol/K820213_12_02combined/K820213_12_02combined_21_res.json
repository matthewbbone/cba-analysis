        },
        {
            "block_label": "text",
            "block_content": "The Director of Human Resources shall ensure that all employees covered by this agreement receive a copy of this County policy and educational materials that explain the requirements of the drug and alcohol testing procedures prior to the start of alcohol and illegal substance testing. Union Representatives shall also be notified of the distribution of this information.",
            "block_bbox": [
