            ]
        },
        {
            "block_label": "text",
            "block_content": "b. Any action/incident which an employee reasonably believes may lead to a claim against the employee or the County must be reported, in writing, by that employee to the immediate supervisor within seventy-two (72) hours.",
            "block_bbox": [
                130,
                535,
