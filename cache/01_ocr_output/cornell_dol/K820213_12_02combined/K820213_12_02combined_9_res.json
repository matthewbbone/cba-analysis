        },
        {
            "block_label": "text",
            "block_content": "c. Sick leave may also be used by an employee for medical and dental visits in accordance with the guidelines established in this Section 1.",
            "block_bbox": [
                95,
                266,
                709,
                305
            ],
            "block_id": 2,
