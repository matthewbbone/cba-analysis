                    95.0,
                    682.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "In order that absence, because of personal illness may be charged to accumulated sick leave, it must be reported by the employee, to the immediate supervisor, on the first working day of such absence and within one-half (1/2) hour of starting time. Absence for illness on Saturday shall not be charged unless Saturday is designated as a working day for the employee.",
            "block_bbox": [
                94,
                694,
                712,
                771
            ],
            "block_id": 6,
            "block_order": 7,
            "group_id": 6,
            "block_polygon_points": [
